    private void jam() {

    ActionListener taskPerformer = new ActionListener() {

        private int nilai_jam;
        private int nilai_menit;
        private int nilai_detik;
        private boolean jalanAwal = true;

        public void actionPerformed(ActionEvent e) {
            
            final int DELAY_MS = 3000;  
            int batchCount = 0;

            String nol_jam = "";
            String nol_menit = "";
            String nol_detik = "";

            Date now = Calendar.getInstance().getTime();

            nilai_jam = now.getHours();
            nilai_menit = now.getMinutes();
            nilai_detik = now.getSeconds();

            if (nilai_jam <= 9) nol_jam = "0";
            if (nilai_menit <= 9) nol_menit = "0";
            if (nilai_detik <= 9) nol_detik = "0";

            String jam = nol_jam + Integer.toString(nilai_jam);
            String menit = nol_menit + Integer.toString(nilai_menit);
            String detik = nol_detik + Integer.toString(nilai_detik);

            // reset log tiap jam 01:01:01 (boleh tetap)
            if (jam.equals("01") && menit.equals("01") && detik.equals("01")) {
                TeksArea.setText("");
            }

            // jalankan sekali saat startup, setelah itu update berikutnya tiap menit 01 detik 01
            if (jalanAwal || ((nilai_menit == 1) && detik.equals("01"))) {
                jalanAwal = false;

                try {
                    koneksi = koneksiDB.condb();
                    TeksArea.append("Memulai update Siranap Kemenkes\n");

                    ps = koneksi.prepareStatement(
                        "select distinct kamar_tt.kd_ruang,kamar.kd_bangsal,bangsal.nm_bangsal,kamar.kelas," +
                        "sirs_mapping_kamar.id_t_tt,sirs_mapping_kamar.tt_kelas,sirs_mapping_kamar.nm_ruang " +
                        "from kamar_tt inner join kamar on kamar_tt.kd_kamar=kamar.kd_kamar " +
                        "inner join bangsal on bangsal.kd_bangsal=kamar.kd_bangsal " +
                        "inner join sirs_mapping_kamar on sirs_mapping_kamar.kd_bangsal=kamar_tt.kd_ruang " +
                        "left join sirs_update_kamar on sirs_update_kamar.kd_bangsal=sirs_mapping_kamar.kd_bangsal " +
                        "where kamar.statusdata='1'"
                    );

                    rs = ps.executeQuery();

                    while (rs.next()) {
                        try {

                            SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
                            String waktuUpdate = sdf.format(new Date());

                            long unixTimestamp = System.currentTimeMillis() / 1000;
                            String timestampnya = String.valueOf(unixTimestamp);

                            ObjectMapper mapper = new ObjectMapper();
                            ObjectNode jsonPayload = mapper.createObjectNode();

                            jsonPayload.put("id_t_tt", rs.getString("id_t_tt"));
                            jsonPayload.put("ruang", rs.getString("nm_ruang"));
                            jsonPayload.put("jumlah_ruang", 0);

                            int jumlah = Sequel.cariInteger(
                                "select count(kamar_tt.kd_ruang) from kamar_tt " +
                                "inner join kamar on kamar_tt.kd_kamar=kamar.kd_kamar " +
                                "where kamar.statusdata='1' and kamar_tt.kd_ruang=?",
                                rs.getString("kd_ruang")
                            );

                            int terpakai = Sequel.cariInteger(
                                "select count(kamar_tt.kd_ruang) from kamar_tt " +
                                "inner join kamar on kamar_tt.kd_kamar=kamar.kd_kamar " +
                                "where kamar.statusdata='1' and kamar.status='ISI' and kamar_tt.kd_ruang=?",
                                rs.getString("kd_ruang")
                            );

                            jsonPayload.put("jumlah", jumlah);
                            jsonPayload.put("terpakai", terpakai);
                            jsonPayload.put("terpakai_suspek", 0);
                            jsonPayload.put("terpakai_konfirmasi", 0);
                            jsonPayload.put("antrian", 0);
                            jsonPayload.put("prepare", 0);
                            jsonPayload.put("prepare_plan", 0);
                            jsonPayload.put("covid", 0);
                            jsonPayload.put("terpakai_dbd", 0);
                            jsonPayload.put("terpakai_dbd_anak", 0);
                            jsonPayload.put("jumlah_dbd", 0);

                            String fullUrl = link + "/Fasyankes";
                            String jsonString = mapper.writeValueAsString(jsonPayload);

                            String responseJson = null;
                            int maxRetry = 3;
                            String kodeBangsal = rs.getString("kd_ruang");

                            boolean sukses = false;
                            int retryCount = 0;

                            while (!sukses && retryCount < maxRetry) {
                                try {
                                    responseJson = api.getRest().execute(
                                        fullUrl,
                                        HttpMethod.PUT,
                                        request -> {
                                            request.getHeaders().add("Content-Type", "application/json");
                                            request.getHeaders().add("X-rs-id", idrs);
                                            request.getHeaders().add("X-Timestamp", timestampnya);
                                            request.getHeaders().add("X-pass", passrs);
                                            try (OutputStream os = request.getBody()) {
                                                os.write(jsonString.getBytes(StandardCharsets.UTF_8));
                                            }
                                        },
                                        response -> {
                                            int statusCode = response.getStatusCode().value();
                                            System.out.println("Status Code: " + statusCode);
                                            
                                            if (response.getBody() != null) {
                                                return new BufferedReader(
                                                    new InputStreamReader(response.getBody(), StandardCharsets.UTF_8)
                                                ).lines().collect(Collectors.joining("\n"));
                                            }
                                            return "";
                                        }
                                    );
                                    sukses = true;
                                } catch (Exception ex) {
                                    retryCount++;
                                    Thread.sleep(3000);
                                }
                            }

                            if (sukses) {
                                TeksArea.append("Response : " + responseJson);
                                System.out.println("Raw Response : " + responseJson);
                                Sequel.meghapus("sirs_update_kamar", "kd_bangsal", kodeBangsal);
                                Sequel.menyimpan(
                                    "sirs_update_kamar", "?,?,?",
                                    "Kode Kamar", 3,
                                    new String[]{kodeBangsal, "Sukses", waktuUpdate}
                                );
                            } else {
                                Sequel.menyimpan(
                                    "sirs_update_kamar", "?,?,?",
                                    "Kode Kamar", 3,
                                    new String[]{kodeBangsal, "Gagal kirim ke SIRANAP", waktuUpdate}
                                );
                            }

                            //batchCount++;
                            Thread.sleep(DELAY_MS);

                        } catch (Exception exLoop) {
                            exLoop.printStackTrace();
                        }
                    }

                } catch (Exception ex) {
                    ex.printStackTrace();
                } finally {
                    try {
                        if (rs != null) rs.close();
                        if (ps != null) ps.close();
                        //if (koneksi != null) koneksi.close();
                    } catch (Exception exClose) {
                        exClose.printStackTrace();
                    }
                }
            }
        }
    };


    taskPerformer.actionPerformed(null);
    new Timer(1000, taskPerformer).start();
}

}

