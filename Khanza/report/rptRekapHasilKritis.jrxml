	<style name="styleTAT" pattern="">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{TAT_Menit_Int} > 30]]></conditionExpression>
			<style forecolor="#FF0000"/>
		</conditionalStyle>
	</style>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="tanggal1" class="java.lang.String"/>
	<parameter name="tanggal2" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
  b.*,
  CASE WHEN b.TAT_Menit_Int < 30 THEN 1 ELSE 0 END AS Flag_LT30,
  -- agregat konsisten dari dataset yang sama (b)
  SUM(CASE WHEN b.TAT_Menit_Int < 30 THEN 1 ELSE 0 END) OVER () AS jml_lt_30,
  COUNT(*) OVER () AS total_kejadian,
  ROUND(
    100.0 * SUM(CASE WHEN b.TAT_Menit_Int < 30 THEN 1 ELSE 0 END) OVER () 
          / NULLIF(COUNT(*) OVER (),0),
    2
  ) AS persen_lt_30
FROM (
    SELECT  
      DATE(pl.tgl_periksa) AS Tanggal,
      rp.no_rkm_medis AS No_RM,
      p.nm_pasien AS Nama,
      IFNULL(
        (SELECT b.nm_bangsal
         FROM kamar_inap ki
         JOIN kamar k  ON ki.kd_kamar = k.kd_kamar
         JOIN bangsal b ON k.kd_bangsal = b.kd_bangsal
         WHERE ki.no_rawat = rp.no_rawat
         ORDER BY ki.tgl_masuk DESC
         LIMIT 1),
        (SELECT pol.nm_poli
         FROM poliklinik pol
         WHERE pol.kd_poli = rp.kd_poli
         LIMIT 1)
      ) AS Ruangan,
      mk.hasilkritis AS Hasil,
      TIME(mk.jam_validasi) AS Jam_validasi,
      TIME(mk.jam_lapor)    AS Jam_Pelaporan,

      TIMESTAMPDIFF(MINUTE, mk.jam_validasi, mk.jam_lapor) AS TAT_Menit_Int,
      CASE 
        WHEN TIMESTAMPDIFF(SECOND, mk.jam_validasi, mk.jam_lapor) < 60 THEN 
          CONCAT(TIMESTAMPDIFF(SECOND, mk.jam_validasi, mk.jam_lapor), ' detik') 
        WHEN TIMESTAMPDIFF(MINUTE, mk.jam_validasi, mk.jam_lapor) < 60 THEN 
          CONCAT(TIMESTAMPDIFF(MINUTE, mk.jam_validasi, mk.jam_lapor), ' menit') 
        WHEN TIMESTAMPDIFF(HOUR, mk.jam_validasi, mk.jam_lapor) < 24 THEN 
          CONCAT(TIMESTAMPDIFF(HOUR, mk.jam_validasi, mk.jam_lapor), ' jam') 
        ELSE 
          CONCAT(TIMESTAMPDIFF(DAY, mk.jam_validasi, mk.jam_lapor), ' hari')
      END AS TAT_Menit
    FROM periksa_lab pl
    JOIN reg_periksa rp       ON pl.no_rawat = rp.no_rawat
    JOIN pasien p             ON rp.no_rkm_medis = p.no_rkm_medis
    JOIN permintaan_lab pm    ON pm.no_rawat = pl.no_rawat 
                              AND pm.tgl_permintaan = pl.tgl_periksa
    JOIN rsaj_monev_kritis mk ON mk.no_rawat = pl.no_rawat 
                              AND mk.tgl_periksa = pl.tgl_periksa
                              AND mk.jam = pl.jam
    -- kalau 2 join ini tidak dibutuhkan, boleh dihapus untuk mempercepat;
    -- kalau dipakai, BIARKAN di sini DAN di fallback agar konsisten.
    JOIN detail_periksa_lab dpl   ON pl.no_rawat = dpl.no_rawat 
                                 AND pl.tgl_periksa = dpl.tgl_periksa
    JOIN template_laboratorium tl ON dpl.id_template = tl.id_template

    WHERE pl.kategori = 'PK'
      AND pl.tgl_periksa BETWEEN $P{tanggal1} AND $P{tanggal2}
      AND mk.jam_validasi IS NOT NULL
      AND mk.jam_lapor    IS NOT NULL
    GROUP BY pl.no_rawat, pl.tgl_periksa, pl.jam
) AS b
ORDER BY b.Tanggal, b.Jam_validasi;]]>
	</queryString>
