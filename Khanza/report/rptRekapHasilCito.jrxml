	<style name="Style1">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{TAT_Menit_Int} > 60]]></conditionExpression>
			<style forecolor="#FF0400"/>
		</conditionalStyle>
	</style>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="tanggal1" class="java.lang.String"/>
	<parameter name="tanggal2" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
  b.*,
  CASE WHEN b.TAT_Menit_Int < 60 THEN 1 ELSE 0 END AS Flag_LT60,
  -- agregat global dari dataset yang sama (b)
  SUM(CASE WHEN b.TAT_Menit_Int < 60 THEN 1 ELSE 0 END) OVER () AS jml_lt_60,
  COUNT(*) OVER () AS total_kejadian,
  ROUND(
    100.0 * SUM(CASE WHEN b.TAT_Menit_Int < 60 THEN 1 ELSE 0 END) OVER () 
          / NULLIF(COUNT(*) OVER (),0),
    2
  ) AS persen_lt_60,
  CASE 
    WHEN 
      (100.0 * SUM(CASE WHEN b.TAT_Menit_Int < 60 THEN 1 ELSE 0 END) OVER () 
       / NULLIF(COUNT(*) OVER (),0)) >= 80 
    THEN 'Tercapai' ELSE 'Tidak Tercapai' 
  END AS Capai_Target_80
FROM ( 
	SELECT  
    DATE(periksa_lab.tgl_periksa) AS Tanggal,
    reg_periksa.no_rkm_medis AS No_RM,
    pasien.nm_pasien AS Nama,
    IFNULL(
        (
            SELECT bangsal.nm_bangsal
            FROM kamar_inap
            JOIN kamar ON kamar_inap.kd_kamar = kamar.kd_kamar
            JOIN bangsal ON kamar.kd_bangsal = bangsal.kd_bangsal
            WHERE kamar_inap.no_rawat = reg_periksa.no_rawat
            ORDER BY kamar_inap.tgl_masuk DESC
            LIMIT 1
        ),
        (
            SELECT poliklinik.nm_poli
            FROM poliklinik
            WHERE poliklinik.kd_poli = reg_periksa.kd_poli
            LIMIT 1
        )
    ) AS Ruangan,
    
    rsaj_monev_cito.hasilcito AS Pemeriksaan,
    TIME(rsaj_monev_cito.jam_regis) AS Jam_Regis,
    TIME(rsaj_monev_cito.jam_lapor) AS Jam_Pelaporan,

    -- Menit numerik
    TIMESTAMPDIFF(MINUTE, rsaj_monev_cito.jam_regis, rsaj_monev_cito.jam_lapor) AS TAT_Menit_Int,

    -- Format readable
    CASE 
        WHEN TIMESTAMPDIFF(SECOND, rsaj_monev_cito.jam_regis, rsaj_monev_cito.jam_lapor) < 60 THEN 
            CONCAT(TIMESTAMPDIFF(SECOND, rsaj_monev_cito.jam_regis, rsaj_monev_cito.jam_lapor), ' detik') 
        WHEN TIMESTAMPDIFF(MINUTE, rsaj_monev_cito.jam_regis, rsaj_monev_cito.jam_lapor) < 60 THEN 
            CONCAT(TIMESTAMPDIFF(MINUTE, rsaj_monev_cito.jam_regis, rsaj_monev_cito.jam_lapor), ' menit') 
        WHEN TIMESTAMPDIFF(HOUR, rsaj_monev_cito.jam_regis, rsaj_monev_cito.jam_lapor) < 24 THEN 
            CONCAT(TIMESTAMPDIFF(HOUR, rsaj_monev_cito.jam_regis, rsaj_monev_cito.jam_lapor), ' jam') 
        ELSE 
            CONCAT(TIMESTAMPDIFF(DAY, rsaj_monev_cito.jam_regis, rsaj_monev_cito.jam_lapor), ' hari')
    END AS TAT_Menit

FROM periksa_lab
JOIN reg_periksa ON periksa_lab.no_rawat = reg_periksa.no_rawat
JOIN pasien ON reg_periksa.no_rkm_medis = pasien.no_rkm_medis
JOIN permintaan_lab ON permintaan_lab.no_rawat = periksa_lab.no_rawat 
    AND permintaan_lab.tgl_permintaan = periksa_lab.tgl_periksa
JOIN rsaj_monev_cito ON rsaj_monev_cito.no_rawat = periksa_lab.no_rawat 
    AND rsaj_monev_cito.tgl_periksa = periksa_lab.tgl_periksa
    AND rsaj_monev_cito.jam = periksa_lab.jam
JOIN detail_periksa_lab ON periksa_lab.no_rawat = detail_periksa_lab.no_rawat 
    AND periksa_lab.tgl_periksa = detail_periksa_lab.tgl_periksa
JOIN template_laboratorium ON detail_periksa_lab.id_template = template_laboratorium.id_template
WHERE periksa_lab.kategori = 'PK'
  AND periksa_lab.tgl_periksa BETWEEN $P{tanggal1} AND $P{tanggal2}
GROUP BY periksa_lab.no_rawat, periksa_lab.tgl_periksa, periksa_lab.jam
ORDER BY periksa_lab.tgl_periksa, periksa_lab.jam
) AS b
ORDER BY b.Tanggal, b.Jam_Pelaporan;]]>
	</queryString>
