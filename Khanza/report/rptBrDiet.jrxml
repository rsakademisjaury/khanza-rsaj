	<queryString>
		<![CDATA[select detail_beri_diet1.no_rawat, reg_periksa.no_rkm_medis, pasien.nm_pasien,
       concat(detail_beri_diet1.kd_kamar, ', ', bangsal.nm_bangsal) as namakamar,
       detail_beri_diet1.tanggal, detail_beri_diet1.waktu, jam_diet_pasien.jam, diet.nama_diet,
       detail_beri_diet1.kd_kamar_real, detail_beri_diet1.status as status_titipan
from detail_beri_diet1
inner join reg_periksa on detail_beri_diet1.no_rawat=reg_periksa.no_rawat
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
inner join diet on detail_beri_diet1.kd_diet=diet.kd_diet
inner join kamar on detail_beri_diet1.kd_kamar=kamar.kd_kamar
inner join bangsal on kamar.kd_bangsal=bangsal.kd_bangsal
inner join jam_diet_pasien on detail_beri_diet1.waktu=jam_diet_pasien.waktu]]>
	</queryString>
