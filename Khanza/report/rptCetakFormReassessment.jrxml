	<field name="tanggal" class="java.sql.Timestamp"/>
	<field name="kd_dokter" class="java.lang.String"/>
	<field name="subjective" class="java.lang.String"/>
	<field name="objective" class="java.lang.String"/>
	<field name="assesment" class="java.lang.String"/>
	<field name="goal" class="java.lang.String"/>
	<field name="tindakan" class="java.lang.String"/>
