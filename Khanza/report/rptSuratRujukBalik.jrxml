				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isBlankWhenNull="true">
				<reportElement x="110" y="16" width="430" height="25">
					<printWhenExpression><![CDATA[$P{kop} == null]]></printWhenExpression>
