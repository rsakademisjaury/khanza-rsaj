	<queryString language="SQL">
		<![CDATA[SELECT
				reg_periksa.no_rawat,
				pasien.no_rkm_medis,
				pasien.nm_pasien,
				date_format( pasien.tgl_lahir, '%d-%m-%Y' ) AS lahir,
				reg_periksa.umurdaftar,
				reg_periksa.sttsumur,
				pasien.jk,
				date_format( lembar_kfr_program_terapi.tanggal, '%d-%m-%Y' ) AS periksa,
				lembar_kfr_program_terapi.subjektif,
				lembar_kfr_program_terapi.objektif,
				lembar_kfr_program_terapi.asesmen,
				lembar_kfr_program_terapi.prosedur_modalitas,
				lembar_kfr_program_terapi.kd_dokter,
				dokter.nm_dokter,
				dokter.no_ijn_praktek,
				lembar_kfr_program_terapi.kd_petugas,
				petugas.nama 
			FROM
				lembar_kfr_program_terapi
				INNER JOIN reg_periksa ON lembar_kfr_program_terapi.no_rawat = reg_periksa.no_rawat
				INNER JOIN pasien ON reg_periksa.no_rkm_medis = pasien.no_rkm_medis
				INNER JOIN dokter ON lembar_kfr_program_terapi.kd_dokter = dokter.kd_dokter
				INNER JOIN petugas ON lembar_kfr_program_terapi.kd_petugas = petugas.nip]]>
	</queryString>
