					<font fontName="Segoe UI" size="9" isBold="false" isItalic="false" isUnderline="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Demikian surat keterangan ini dibuat berdasarkan dengan penguraian yang sejujur-jujurnya dan menggunakan pengetahuan yang sebaik-baiknya serta mengingat sumpah pada saat menerima jabatan.]]></text>
			</staticText>
			<staticText>
