				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Segoe UI" size="9" isBold="false" isUnderline="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["a) Tempat dan Tanggal dikeluarkan Surat Visum et Repertum :   "+ $F{tempat_keluar_ver} 
+ ", " 
+ $F{tgl_keluar_ver_fmt}]]></textFieldExpression>
			</textField>
		</band>
