	<queryString>
		<![CDATA[SELECT
                noindex,
                no_rawat,
                tgl_byr,
                `no`,
                nm_perawatan,
                pemisah,
                biaya,
                jumlah,
                tambahan,
                totalbiaya,
                status
            FROM billing
            WHERE no_rawat = $P{P_NO_RAWAT}
            ORDER BY noindex ASC]]>
	</queryString>
	<field name="noindex" class="java.lang.Integer"/>
	<field name="no_rawat" class="java.lang.String"/>
	<field name="tgl_byr" class="java.sql.Date"/>
	<field name="no" class="java.lang.String"/>
	<field name="nm_perawatan" class="java.lang.String"/>
	<field name="pemisah" class="java.lang.String"/>
	<field name="biaya" class="java.math.BigDecimal"/>
	<field name="jumlah" class="java.math.BigDecimal"/>
	<field name="tambahan" class="java.math.BigDecimal"/>
	<field name="totalbiaya" class="java.math.BigDecimal"/>
	<field name="status" class="java.lang.String"/>
	<variable name="V_GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalbiaya} == null ? java.math.BigDecimal.ZERO : $F{totalbiaya}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="V_TAGIHAN_PPN" class="java.math.BigDecimal" calculation="System">
		<variableExpression><![CDATA[$V{V_GRAND_TOTAL}.add($P{P_PPN})]]></variableExpression>
	</variable>
