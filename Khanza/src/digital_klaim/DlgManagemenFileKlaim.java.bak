private void tampilRanap() {
    this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
    int jumlahBelumCoding = 0;
    int jumlahBelumGabung = 0;

    mulaiIsiTabelCepat(tbListPasienRanap);
    try {
        Valid.tabelKosong(TabModePasienRanap);

        String kataKunci = TCariKunjungan.getText().trim();
        boolean pakaiPencarian = !kataKunci.isEmpty();
        String filterCari = "";

        if (pakaiPencarian) {
            filterCari =
                "  AND ( " +
                "       rp.no_rawat LIKE ? " +
                "    OR rp.no_rkm_medis LIKE ? " +
                "    OR p.nm_pasien LIKE ? " +
                "    OR COALESCE(bs.no_sep,'') LIKE ? " +
                "    OR rp.status_bayar LIKE ? " +
                "    OR COALESCE(d.nm_dokter,'') LIKE ? " +
                "    OR EXISTS (SELECT 1 " +
                "                 FROM diagnosa_pasien dpc " +
                "                 LEFT JOIN penyakit pyc ON pyc.kd_penyakit=dpc.kd_penyakit " +
                "                WHERE dpc.no_rawat=rp.no_rawat " +
                "                  AND (dpc.kd_penyakit LIKE ? OR COALESCE(pyc.nm_penyakit,'') LIKE ?)) " +
                "    OR EXISTS (SELECT 1 FROM kamar_inap kis " +
                "                 JOIN kamar ks ON ks.kd_kamar=kis.kd_kamar " +
                "                 JOIN bangsal bis ON bis.kd_bangsal=ks.kd_bangsal " +
                "                WHERE kis.no_rawat=rp.no_rawat AND bis.nm_bangsal LIKE ?) " +
                "      ) ";
        }

        String sql =
            "SELECT " +
            "  rp.no_rawat, rp.no_rkm_medis, rp.tgl_registrasi, p.nm_pasien, rp.status_bayar, " +
            // Bangsal terakhir dieksekusi hanya untuk pasien hasil filter periode.
            "  COALESCE((SELECT b.nm_bangsal " +
            "             FROM kamar_inap kil " +
            "             JOIN kamar k ON k.kd_kamar=kil.kd_kamar " +
            "             JOIN bangsal b ON b.kd_bangsal=k.kd_bangsal " +
            "            WHERE kil.no_rawat=rp.no_rawat " +
            "            ORDER BY kil.tgl_masuk DESC, IFNULL(kil.jam_masuk,'00:00:00') DESC LIMIT 1), '-') AS kamar, " +
            "  COALESCE(d.nm_dokter, '-') AS dpjp, " +
            "  COALESCE((SELECT GROUP_CONCAT(DISTINCT CONCAT(dpd.kd_penyakit, " +
            "                   IF(pyd.nm_penyakit IS NULL OR pyd.nm_penyakit='', '', CONCAT(' - ',pyd.nm_penyakit))) " +
            "                   SEPARATOR ', ') " +
            "             FROM diagnosa_pasien dpd " +
            "             LEFT JOIN penyakit pyd ON pyd.kd_penyakit=dpd.kd_penyakit " +
            "            WHERE dpd.no_rawat=rp.no_rawat), 'Kosong') AS diagnosa, " +
            "  IFNULL(bs.no_sep, 'SEP belum terbit/ditarik') AS no_sep, " +
            "  IFNULL(bs.tglsep, '-') AS tglsep, " +
            "  IFNULL(bs.klsrawat, '-') AS hakkelas, " +
            "  CASE " +
            "    WHEN EXISTS (SELECT 1 FROM inacbg_grouping_final gf WHERE gf.no_sep=bs.no_sep) THEN 'Final Klaim' " +
            "    WHEN EXISTS (SELECT 1 FROM inacbg_final fin WHERE fin.no_sep=bs.no_sep) THEN 'Final INACBG' " +
            "    WHEN EXISTS (SELECT 1 FROM inacbg_grouping_stage2 g2 WHERE g2.no_sep=bs.no_sep) " +
            "      OR EXISTS (SELECT 1 FROM inacbg_grouping_stage1 g1 WHERE g1.no_sep=bs.no_sep) THEN 'Grouping INACBG' " +
            "    WHEN EXISTS (SELECT 1 FROM inacbg_idrg_final iif WHERE iif.no_sep=bs.no_sep) THEN 'Final IDRG' " +
            "    WHEN EXISTS (SELECT 1 FROM idrg_grouper ig WHERE ig.no_sep=bs.no_sep) THEN 'Grouping IDRG' " +
            "    ELSE 'Belum Coding' " +
            "  END AS status_coding, " +
            "  CASE WHEN EXISTS (SELECT 1 FROM inacbg_kirim_online ko WHERE ko.no_sep=bs.no_sep) " +
            "       THEN 'Terkirim' ELSE '-' END AS kirim_online, " +
            "  CASE WHEN EXISTS (SELECT 1 FROM berkas_digital_perawatan bdp " +
            "                    WHERE bdp.no_rawat=rp.no_rawat AND bdp.kode='009') " +
            "       THEN 'Terupload' ELSE '-' END AS individual, " +
            "  CASE WHEN EXISTS (SELECT 1 FROM inacbg_gabung_berkas igb WHERE igb.no_rawat=rp.no_rawat) " +
            "       THEN 'OK' ELSE '-' END AS berkas, " +
            "  plg.tglpulang, IFNULL(icb.catatan, '-') AS catatan " +
            "FROM reg_periksa rp " +
            // Filter tanggal keluar dipindah ke derived table agar kamar_inap yang diproses
            // hanya episode yang memang berada pada periode pilihan.
            "JOIN ( " +
            "   SELECT ki.no_rawat, MAX(ki.tgl_keluar) AS tglpulang " +
            "     FROM kamar_inap ki " +
            "    WHERE ki.stts_pulang NOT IN ('-','Pindah Kamar') " +
            "      AND ki.tgl_keluar BETWEEN ? AND ? " +
            "    GROUP BY ki.no_rawat " +
            ") plg ON plg.no_rawat=rp.no_rawat " +
            "JOIN pasien p ON p.no_rkm_medis=rp.no_rkm_medis " +
            "LEFT JOIN penjab pj ON pj.kd_pj=rp.kd_pj " +
            "LEFT JOIN bridging_sep bs ON bs.no_rawat=rp.no_rawat AND bs.jnspelayanan='1' " +
            "LEFT JOIN resume_pasien_ranap rpr ON rpr.no_rawat=rp.no_rawat " +
            "LEFT JOIN dokter d ON d.kd_dokter=rpr.kd_dokter " +
            "LEFT JOIN inacbg_catatan_berkas icb ON icb.no_sep=bs.no_sep " +
            "WHERE rp.status_lanjut='Ranap' " +
            "  AND (rp.kd_pj='BPJ' " +
            "       OR (pj.png_jawab IS NOT NULL " +
            "           AND LOWER(pj.png_jawab) LIKE '%bpjs%' " +
            "           AND LOWER(pj.png_jawab) LIKE '%cob%' " +
            "           AND LOWER(pj.png_jawab) NOT LIKE '%kerja%')) " +
            "  AND rp.stts<>'Batal' " +
            filterCari +
            "GROUP BY rp.no_rawat " +
            "ORDER BY p.nm_pasien ASC";

        try (PreparedStatement ps = koneksi.prepareStatement(sql)) {
            ps.setFetchSize(FETCH_SIZE_KLAIM);
            int urut = 1;
            ps.setString(urut++, Valid.SetTgl(DTPTglAwal.getSelectedItem() + ""));
            ps.setString(urut++, Valid.SetTgl(DTPTglAkhir.getSelectedItem() + ""));

            if (pakaiPencarian) {
                String kw = "%" + kataKunci + "%";
                for (int n = 0; n < 9; n++) {
                    ps.setString(urut++, kw);
                }
            }

            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    String statusCoding = rs.getString("status_coding");
                    String statusBerkas = rs.getString("berkas");
                    if ("Belum Coding".equalsIgnoreCase(statusCoding)) jumlahBelumCoding++;
                    if ("-".equals(statusBerkas)) jumlahBelumGabung++;

                    TabModePasienRanap.addRow(new Object[]{
                        false,
                        rs.getString("no_rawat"),
                        rs.getString("no_rkm_medis"),
                        rs.getString("nm_pasien"),
                        rs.getString("kamar"),
                        rs.getString("dpjp"),
                        rs.getString("no_sep"),
                        rs.getString("tglsep"),
                        rs.getString("hakkelas"),
                        rs.getString("status_bayar"),
                        rs.getString("diagnosa"),
                        statusCoding,
                        rs.getString("kirim_online"),
                        rs.getString("individual"),
                        statusBerkas,
                        rs.getString("tglpulang"),
                        rs.getString("catatan")
                    });
                }
            }
        }
    } catch (Exception e) {
        System.out.println("Notifikasi tampil Ranap : " + e);
    } finally {
        selesaiIsiTabelCepat(tbListPasienRanap);
        LCount.setText(String.valueOf(tbListPasienRanap.getRowCount()));
        LCountBelum.setText(String.valueOf(jumlahBelumCoding));
        LCountBelumGabung.setText(String.valueOf(jumlahBelumGabung));
        this.setCursor(Cursor.getDefaultCursor());
    }
}


private void tampilBukaKunci() { 
    this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
    try {
        Valid.tabelKosong(TabModeBukaKunci);

        String sql =
            "SELECT " +
            "  rp.no_rawat, rp.tgl_registrasi, rp.no_rkm_medis, p.nm_pasien, pl.nm_poli, rp.status_bayar, " +
            "  IFNULL(GROUP_CONCAT(DISTINCT " +
            "         CONCAT(dp.kd_penyakit, " +
            "                IF(py.nm_penyakit IS NULL OR py.nm_penyakit='', '', CONCAT(' - ', py.nm_penyakit))" +
            "         ) SEPARATOR ', '), 'Kosong') AS diagnosa, " +
            "  IFNULL(bs.no_sep, 'SEP belum terbit/ditarik') AS no_sep, " +
            "  IFNULL(bs.tglsep, '-') AS tglsep, " +
            "  CASE " +
            "    WHEN bs.no_sep IS NOT NULL AND idt.no_sep IS NOT NULL THEN 'Sudah Coding' " +
            "    ELSE 'Belum Coding' " +
            "  END AS status_kirim, " +
            "  IFNULL(icb.catatan, '-') AS catatan " +                         // kolom catatan
            "FROM reg_periksa rp " +
            "JOIN pasien p ON rp.no_rkm_medis = p.no_rkm_medis " +
            "LEFT JOIN penjab pj ON rp.kd_pj = pj.kd_pj " +                    // JOIN penjab    
            "JOIN poliklinik pl ON rp.kd_poli = pl.kd_poli " +
            "LEFT JOIN diagnosa_pasien dp ON rp.no_rawat = dp.no_rawat " +
            "LEFT JOIN penyakit py ON dp.kd_penyakit = py.kd_penyakit " +     // cari nama penyakit
            "LEFT JOIN bridging_sep bs ON rp.no_rawat = bs.no_rawat " +
            "LEFT JOIN inacbg_final_klaim idt ON bs.no_sep = idt.no_sep " +
            "LEFT JOIN inacbg_catatan_berkas icb ON icb.no_sep = bs.no_sep " +// relasi catatan
            "JOIN rsaj_hapus_nota_salah hns ON hns.no_rawat = rp.no_rawat " + // hanya no_rawat yg pernah dihapus
            "WHERE rp.status_lanjut IN ('Ralan','Ranap') " +                  // Ralan & Ranap
            "  AND rp.tgl_registrasi BETWEEN ? AND ? " +
            // === FILTER BPJS & COB ===
            "  AND ( " +
            "        rp.kd_pj = 'BPJ' " +
            "        OR (pj.png_jawab IS NOT NULL " +
            "            AND LOWER(pj.png_jawab) LIKE '%bpjs%' " +
            "            AND LOWER(pj.png_jawab) LIKE '%cob%'" +
            "            AND LOWER(pj.png_jawab) NOT LIKE '%kerja%'" +        
            "           ) " +
            "      ) " +
            "  AND rp.stts <> 'Batal' " +
            "  AND ( " +
            "     rp.no_rawat LIKE ? " +                    // cari no_rawat
            "     OR rp.no_rkm_medis LIKE ? " +             // cari no_rkm_medis
            "     OR p.nm_pasien LIKE ? " +                 // cari nm_pasien
            "     OR COALESCE(bs.no_sep, '') LIKE ? " +     // cari no_sep
            "     OR COALESCE(dp.kd_penyakit, '') LIKE ? " +// cari diagnosa kode
            "     OR COALESCE(py.nm_penyakit, '') LIKE ? " +// cari diagnosa nama
            "     OR pl.nm_poli LIKE ? " +                  // cari nm_poli
            "     OR rp.status_bayar LIKE ? " +             // cari status_bayar
            "      ) " +
            "GROUP BY rp.no_rawat " +
            "ORDER BY pl.nm_poli ASC, p.nm_pasien ASC";

        try (PreparedStatement ps = koneksi.prepareStatement(sql)) {
            String kw = "%" + TCariKunjungan.getText().trim() + "%";

            ps.setString(1, Valid.SetTgl(DTPTglAwal.getSelectedItem() + ""));
            ps.setString(2, Valid.SetTgl(DTPTglAkhir.getSelectedItem() + ""));
            ps.setString(3, kw); // no_rawat
            ps.setString(4, kw); // no_rkm_medis
            ps.setString(5, kw); // nm_pasien
            ps.setString(6, kw); // no_sep
            ps.setString(7, kw); // kd_penyakit
            ps.setString(8, kw); // nm_penyakit
            ps.setString(9, kw); // nm_poli
            ps.setString(10, kw); // status_bayar

            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    TabModeBukaKunci.addRow(new Object[]{
                        false,
                        rs.getString("no_rawat"),
                        rs.getString("no_rkm_medis"),
                        rs.getString("nm_pasien"),
                        rs.getString("nm_poli"),
                        rs.getString("no_sep"),
                        rs.getString("tglsep"),
                        rs.getString("status_bayar"),
                        rs.getString("diagnosa"),
                        rs.getString("status_kirim"),
                        rs.getString("catatan")
                    });
                }
            }
        }
    } catch (Exception e) {
        System.out.println("Notifikasi : " + e);
    }
    LCount.setText(String.valueOf(tbBukaKunci.getRowCount()));
    this.setCursor(Cursor.getDefaultCursor());
}

private static String nvl(String s, String alt) {
    return (s == null || s.trim().isEmpty()) ? alt : s;
}
private static BigDecimal toNumber(String s) {
    if (s == null) return BigDecimal.ZERO;
    // buang pemisah ribuan dan normalisasi desimal bila ada
    String cleaned = s.replace(".", "").replace(",", ".");
    try { return new BigDecimal(cleaned); } catch (Exception e) { return BigDecimal.ZERO; }
}

private static String normJenisRawat(String v){
    if(v==null) return "";
    String s = v.trim().toUpperCase();
    if(s.contains("Ralan")) return "RJ";
    if(s.contains("Ranap"))  return "RI";
    return s; // sudah "RJ"/"RI" atau custom
}

private void tampilLaporan() {


    this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
    try {
        Valid.tabelKosong(TabModeLaporan);

        String jenisSel  = (String) cbJenis.getSelectedItem();
        boolean filterJenis = jenisSel != null && !jenisSel.trim().isEmpty()
                              && !jenisSel.equalsIgnoreCase("Semua");
        String jenisNorm = normJenisRawat(jenisSel);

        StringBuilder sb = new StringBuilder();
        sb.append("SELECT t.tglmasuk, t.tglpulang, t.no_sep, t.code_cbg, ")
          .append("       t.tarif_inacbg, t.billing_rs, t.jenis_rawat, ")
          .append("       t.nik, t.waktu, ")
          // nama petugas: t.nik -> inacbg_coder_nik.no_ik -> inacbg_coder_nik.nik -> petugas.nip -> petugas.nama
          .append("       COALESCE(pt.nama, t.nik) AS nm_petugas, ")
          .append("       p.no_rkm_medis, p.nm_pasien ")
          .append("FROM inacbg_final_klaim t ")
          .append("LEFT JOIN bridging_sep bs ON bs.no_sep = t.no_sep ")
          .append("LEFT JOIN reg_periksa   rp ON rp.no_rawat = bs.no_rawat ")
          .append("LEFT JOIN pasien        p  ON p.no_rkm_medis = rp.no_rkm_medis ")
          // mapping: t.nik = icn.no_ik
          .append("LEFT JOIN inacbg_coder_nik icn ON icn.no_ik = t.nik ")
          // mapping: icn.nik = petugas.nip
          .append("LEFT JOIN petugas pt ON pt.nip = icn.nik ")
          .append("WHERE t.tglmasuk BETWEEN ? AND ? ");
        if (filterJenis) {
            sb.append("AND t.jenis_rawat = ? ");
        }
        sb.append("AND (t.no_sep LIKE ? OR t.code_cbg LIKE ? OR p.nm_pasien LIKE ? OR p.no_rkm_medis LIKE ?) ")
          .append("ORDER BY t.tglmasuk, p.nm_pasien");

        try (PreparedStatement ps = koneksi.prepareStatement(sb.toString())) {
            int i = 1;

            // 1–2: periode tglmasuk
            ps.setString(i++, Valid.SetTgl(DTPTglAwal.getSelectedItem() + ""));
            ps.setString(i++, Valid.SetTgl(DTPTglAkhir.getSelectedItem() + ""));

            // 3 (opsional): filter jenis rawat
            if (filterJenis) {
                ps.setString(i++, jenisNorm);
            }

            // 4–7: kata kunci pencarian
            String cari = "%" + TCariKunjungan.getText().trim() + "%";
            ps.setString(i++, cari); // t.no_sep LIKE ?
            ps.setString(i++, cari); // t.code_cbg LIKE ?
            ps.setString(i++, cari); // p.nm_pasien LIKE ?
            ps.setString(i++, cari); // p.no_rkm_medis LIKE ?

            try (ResultSet rs = ps.executeQuery()) {
                Locale id = new Locale("id", "ID");
                DecimalFormat df = new DecimalFormat("#,##0", new DecimalFormatSymbols(id));
                SimpleDateFormat fDate = new SimpleDateFormat("d MMM yyyy", id);
                SimpleDateFormat fDT   = new SimpleDateFormat("d MMM yyyy HH:mm", id);

                int no = 0;
                while (rs.next()) {
                    no++;

                    Date tglMasuk  = rs.getDate("tglmasuk");
                    Date tglPulang = rs.getDate("tglpulang");

                    String nm = rs.getString("nm_pasien");
                    String rm = rs.getString("no_rkm_medis");
                    String pasienCell = "-";
                    if (nm != null && !nm.isEmpty()) {
                        pasienCell = ((rm != null && !rm.isEmpty()) ? "\n" + rm : "") + "  "+ nm.toUpperCase();
                    }

                    BigDecimal bdTarif   = toNumber(rs.getString("tarif_inacbg"));
                    BigDecimal bdBilling = toNumber(rs.getString("billing_rs"));

                    Timestamp wt = rs.getTimestamp("waktu");
                    String petugasCell = nvl(rs.getString("nm_petugas"), " - ");
                    // jarak 1 baris kosong sebelum waktu
                    if (wt != null) {
                        petugasCell = petugasCell + "\n\n - " + fDT.format(wt);
                    } else {
                        petugasCell = petugasCell + " - ";
                    }

                    TabModeLaporan.addRow(new Object[]{
                        no,
                        (tglMasuk  != null ? fDate.format(tglMasuk)  : "-"),
                        (tglPulang != null ? fDate.format(tglPulang) : "-"),
                        nvl(rs.getString("no_sep"), "-"),
                        pasienCell,
                        nvl(rs.getString("code_cbg"), "-"),
                        (bdTarif   != null && bdTarif.signum()   != 0 ? df.format(bdTarif)   : "-"),
                        (bdBilling != null && bdBilling.signum() != 0 ? df.format(bdBilling) : "-"),
                        nvl(rs.getString("jenis_rawat"), "-"),
                        petugasCell
                    });
                }
            }
        }
    } catch (Exception e) {
        System.out.println("Notifikasi : " + e);
    }
    LCount.setText(String.valueOf(tbListLaporan.getRowCount()));
    this.setCursor(Cursor.getDefaultCursor());
}

