//                deleteDir(f);
//            }
//        }
//    }
//    file.delete();
    }

    private void mergerFile() {
    // Bersihkan hanya ZIP temp; JANGAN hapus arsip PDF
    try { deleteDir("berkasklaimzip"); }
    catch (IOException ex) { Logger.getLogger(DlgManagemenFileKlaim.class.getName()).log(Level.SEVERE, null, ex); }

    final String baseUrl = "http://" + koneksiDB.HOSTHYBRIDWEB() + ":" + koneksiDB.PORTWEB() + "/webapps/berkasrawat/";

    // ===== Mapping fallback kode -> nama (kalau join master tidak ketemu) =====
    final java.util.Map<String,String> KODE2NAMA = new java.util.HashMap<>();
    KODE2NAMA.put("001","Berkas SEP");
    KODE2NAMA.put("007","Berkas Resume");
    KODE2NAMA.put("144","Billing");    
    KODE2NAMA.put("009","Berkas Klaim Individual Pasien");
    KODE2NAMA.put("005","Berkas Lab");
    KODE2NAMA.put("006","Berkas Radiologi");

    // Kelompok wajib (billing: salah satu 144/125 cukup)
    final String[][] GROUPS = {
        {"001"},          // SEP
        {"007"},          // RESUME
        {"144"},    // BILLING (salah satu)
        {"009"},          // INDIVIDUAL
        {"005"},          // LAB
        {"006"}           // RADIOLOGI
    };
    final java.util.Set<String> WAJIB = new java.util.HashSet<>(java.util.Arrays.asList("001","007","144","009","005","006"));

    // ====== PRECHECK ======
    StringBuilder rpt = new StringBuilder();
    int problems = 0, pasienDicek = 0;

    Calendar start = Calendar.getInstance();
    start.setTime(DTPTglAwal.getDate());
    Calendar end = Calendar.getInstance();
    end.setTime(DTPTglAkhir.getDate());

    for (Date date = start.getTime(); !start.after(end); start.add(Calendar.DATE, 1), date = start.getTime()) {
        String ymd = new SimpleDateFormat("yyyy-MM-dd").format(date);

        if (TabRawat.getSelectedIndex() == 0) {
            // ---------- RALAN PRECHECK ----------
            for (int r = 0; r < tbListPasienRalan.getRowCount(); r++) {
                if (!"true".equals(String.valueOf(tbListPasienRalan.getValueAt(r, 0)))) continue;
                String noSep   = String.valueOf(tbListPasienRalan.getValueAt(r, 6));
                String tglReg  = String.valueOf(tbListPasienRalan.getValueAt(r, 7));
                String noRawat = String.valueOf(tbListPasienRalan.getValueAt(r, 1));
                if ("-".equals(noSep) || !ymd.equals(tglReg)) continue;

                pasienDicek++;

                // Ambil SEMUA berkas + nama dari master
                java.util.Map<String, java.util.List<String>> allLokasi = new java.util.HashMap<>();
                java.util.Map<String, String> namaByKode = new java.util.HashMap<>();
                String q = MERGE_ONLY_WAJIB
                            ? "SELECT bdp.*, COALESCE(mbd.nama,'') AS nama_berkas " +
                              "FROM berkas_digital_perawatan bdp " +
                              "LEFT JOIN master_berkas_digital mbd ON mbd.kode = bdp.kode " +
                              "WHERE bdp.no_rawat=? AND bdp.kode IN ('001','007','144','125','009','005','006') " +
                              "ORDER BY FIELD(bdp.kode,'001','007','144','125','009','005','006'), bdp.kode ASC"
                            : "SELECT bdp.*, COALESCE(mbd.nama,'') AS nama_berkas " +
                              "FROM berkas_digital_perawatan bdp " +
                              "LEFT JOIN master_berkas_digital mbd ON mbd.kode = bdp.kode " +
                              "WHERE bdp.no_rawat=? " +
                              "ORDER BY FIELD(bdp.kode,'001','007','144','125','009','005','006'), bdp.kode ASC";


                try (PreparedStatement psC = koneksi.prepareStatement(q)) {
                    psC.setString(1, noRawat);
                    try (ResultSet rsC = psC.executeQuery()) {
                        while (rsC.next()) {
                            String kd  = rsC.getString("kode");
                            String lok = rsC.getString("lokasi_file");
                            String nm  = rsC.getString("nama_berkas");
                            allLokasi.computeIfAbsent(kd, k -> new java.util.ArrayList<>()).add(lok);
                            if (nm != null && !nm.isEmpty()) namaByKode.put(kd, nm);
                        }
                    }
                } catch (Exception e) {
                    rpt.append("\\n[RALAN ").append(noSep).append("] Gagal query berkas: ").append(e.getMessage());
                    problems++; continue;
                }

                boolean okAll = true;
                StringBuilder perPasien = new StringBuilder();
                perPasien.append("\\n[RALAN ").append(noSep).append("]");

                // cek 6 kelompok wajib (tampilkan kode + nama)
                for (String[] codes : GROUPS) {
                    StringBuilder labelGrp = new StringBuilder();
                    if (codes.length == 1) {
                        String kd = codes[0];
                        String nm = namaByKode.containsKey(kd) ? namaByKode.get(kd) : KODE2NAMA.getOrDefault(kd, kd);
                        labelGrp.append(nm).append(" (").append(kd).append(")");
                    } else {
                        labelGrp.append("Billing (");
                        for (int ci = 0; ci < codes.length; ci++) {
                            String kd = codes[ci];
                            String nm = namaByKode.containsKey(kd) ? namaByKode.get(kd) : KODE2NAMA.getOrDefault(kd, kd);
                            if (ci > 0) labelGrp.append(" / ");
                            labelGrp.append(kd).append("–").append(nm);
                        }
                        labelGrp.append(")");
                    }

                    String chosenCode = null;
                    String lokasi = null;
                    for (String kd : codes) {
                        if (allLokasi.containsKey(kd) && !allLokasi.get(kd).isEmpty()) { chosenCode = kd; lokasi = allLokasi.get(kd).get(0); break; }
                    }

                    if (chosenCode == null) {
                        okAll = false;
                        perPasien.append("\\n  ✗ ").append(labelGrp).append(" : TIDAK DITEMUKAN");
                    } else {
                        String nm = namaByKode.containsKey(chosenCode) ? namaByKode.get(chosenCode) : KODE2NAMA.getOrDefault(chosenCode, chosenCode);
                        String safe = encodeLokasi(lokasi);
                        int http = probeHttp(baseUrl + safe);
                        if (isHttpOk(http)) {
                            perPasien.append("\\n  ✓ ").append(nm).append(" (").append(chosenCode).append(") : ada & akses OK");
                        } else {
                            okAll = false;
                            perPasien.append("\\n  ! ").append(nm).append(" (").append(chosenCode).append(") : ada tetapi HTTP ")
                                     .append(http).append(" → ").append(baseUrl).append(safe);
                        }
                    }
                }

                // tampilkan BERKAS TAMBAHAN (di luar wajib) + duplikat per kode, dengan nama
                StringBuilder extras = new StringBuilder();
                for (java.util.Map.Entry<String, java.util.List<String>> e : allLokasi.entrySet()) {
                    String kd = e.getKey();
                    java.util.List<String> list = e.getValue();
                    if (!WAJIB.contains(kd) || list.size() > 1) {
                        String nm = namaByKode.containsKey(kd) ? namaByKode.get(kd) : KODE2NAMA.getOrDefault(kd, kd);
                        extras.append("\\n  • ").append(nm).append(" (").append(kd).append(") — ").append(list.size()).append(" berkas:");
                        for (int idx = 0; idx < list.size(); idx++) {
                            String loc  = encodeLokasi(list.get(idx));
                            int http    = probeHttp(baseUrl + loc);
                            extras.append("\\n      - [").append(idx + 1).append("] HTTP ").append(http)
                                  .append(" → ").append(baseUrl).append(loc);
                        }
                    }
                }
                if (extras.length() > 0) perPasien.append("\\n  (Tambahan)").append(extras);

                if (!okAll) { problems++; rpt.append(perPasien); }
            }
        } else {
            // ---------- RANAP PRECHECK ----------
            for (int r = 0; r < tbListPasienRanap.getRowCount(); r++) {
                if (!"true".equals(String.valueOf(tbListPasienRanap.getValueAt(r, 0)))) continue;
                String noSep   = String.valueOf(tbListPasienRanap.getValueAt(r, 6));
                String tglReg  = String.valueOf(tbListPasienRanap.getValueAt(r, 7));
                String noRawat = String.valueOf(tbListPasienRanap.getValueAt(r, 1));
                if ("-".equals(noSep) || !ymd.equals(tglReg)) continue;

                pasienDicek++;

                java.util.Map<String, java.util.List<String>> allLokasi = new java.util.HashMap<>();
                java.util.Map<String, String> namaByKode = new java.util.HashMap<>();
                String q = MERGE_ONLY_WAJIB
                            ? "SELECT bdp.*, COALESCE(mbd.nama,'') AS nama_berkas " +
                              "FROM berkas_digital_perawatan bdp " +
                              "LEFT JOIN master_berkas_digital mbd ON mbd.kode = bdp.kode " +
                              "WHERE bdp.no_rawat=? AND bdp.kode IN ('001','007','144','125','009','005','006') " +
                              "ORDER BY FIELD(bdp.kode,'001','007','144','125','009','005','006'), bdp.kode ASC"
                            : "SELECT bdp.*, COALESCE(mbd.nama,'') AS nama_berkas " +
                              "FROM berkas_digital_perawatan bdp " +
                              "LEFT JOIN master_berkas_digital mbd ON mbd.kode = bdp.kode " +
                              "WHERE bdp.no_rawat=? " +  // <-- semua kode
                              "ORDER BY FIELD(bdp.kode,'001','007','144','125','009','005','006'), bdp.kode ASC";

                try (PreparedStatement psC = koneksi.prepareStatement(q)) {
                    psC.setString(1, noRawat);
                    try (ResultSet rsC = psC.executeQuery()) {
                        while (rsC.next()) {
                            String kd  = rsC.getString("kode");
                            String lok = rsC.getString("lokasi_file");
                            String nm  = rsC.getString("nama_berkas");
                            allLokasi.computeIfAbsent(kd, k -> new java.util.ArrayList<>()).add(lok);
                            if (nm != null && !nm.isEmpty()) namaByKode.put(kd, nm);
                        }
                    }
                } catch (Exception e) {
                    rpt.append("\\n[RANAP ").append(noSep).append("] Gagal query berkas: ").append(e.getMessage());
                    problems++; continue;
                }

                boolean okAll = true;
                StringBuilder perPasien = new StringBuilder();
                perPasien.append("\\n[RANAP ").append(noSep).append("]");

                for (String[] codes : GROUPS) {
                    StringBuilder labelGrp = new StringBuilder();
                    if (codes.length == 1) {
                        String kd = codes[0];
                        String nm = namaByKode.containsKey(kd) ? namaByKode.get(kd) : KODE2NAMA.getOrDefault(kd, kd);
                        labelGrp.append(nm).append(" (").append(kd).append(")");
                    } else {
                        labelGrp.append("Billing (");
                        for (int ci = 0; ci < codes.length; ci++) {
                            String kd = codes[ci];
                            String nm = namaByKode.containsKey(kd) ? namaByKode.get(kd) : KODE2NAMA.getOrDefault(kd, kd);
                            if (ci > 0) labelGrp.append(" / ");
                            labelGrp.append(kd).append("–").append(nm);
                        }
                        labelGrp.append(")");
                    }

                    String chosenCode = null;
                    String lokasi = null;
                    for (String kd : codes) {
                        if (allLokasi.containsKey(kd) && !allLokasi.get(kd).isEmpty()) { chosenCode = kd; lokasi = allLokasi.get(kd).get(0); break; }
                    }

                    if (chosenCode == null) {
                        okAll = false;
                        perPasien.append("\\n  ✗ ").append(labelGrp).append(" : TIDAK DITEMUKAN");
                    } else {
                        String nm = namaByKode.containsKey(chosenCode) ? namaByKode.get(chosenCode) : KODE2NAMA.getOrDefault(chosenCode, chosenCode);
                        String safe = encodeLokasi(lokasi);
                        int http = probeHttp(baseUrl + safe);
                        if (isHttpOk(http)) {
                            perPasien.append("\\n  ✓ ").append(nm).append(" (").append(chosenCode).append(") : ada & akses OK");
                        } else {
                            okAll = false;
                            perPasien.append("\\n  ! ").append(nm).append(" (").append(chosenCode).append(") : ada tetapi HTTP ")
                                     .append(http).append(" → ").append(baseUrl).append(safe);
                        }
                    }
                }

                StringBuilder extras = new StringBuilder();
                for (java.util.Map.Entry<String, java.util.List<String>> e : allLokasi.entrySet()) {
                    String kd = e.getKey();
                    java.util.List<String> list = e.getValue();
                    if (!WAJIB.contains(kd) || list.size() > 1) {
                        String nm = namaByKode.containsKey(kd) ? namaByKode.get(kd) : KODE2NAMA.getOrDefault(kd, kd);
                        extras.append("\\n  • ").append(nm).append(" (").append(kd).append(") — ").append(list.size()).append(" berkas:");
                        for (int idx = 0; idx < list.size(); idx++) {
                            String loc  = encodeLokasi(list.get(idx));
                            int http    = probeHttp(baseUrl + loc);
                            extras.append("\\n      - [").append(idx + 1).append("] HTTP ").append(http)
                                  .append(" → ").append(baseUrl).append(loc);
                        }
                    }
                }
                if (extras.length() > 0) perPasien.append("\\n  (Tambahan)").append(extras);

                if (!okAll) { problems++; rpt.append(perPasien); }
            }
        }
    }

    // Konfirmasi jika ada masalah
    if (problems > 0) {
        String header = "Hasil Cek Berkas — " + pasienDicek + " pasien dicek; " + problems + " pasien belum lengkap/URL error."
        + System.lineSeparator()
        + "Lengkapi dulu jika perlu. Mau lanjut merge sekarang?"
        + System.lineSeparator() + System.lineSeparator();
        javax.swing.JTextArea ta = new javax.swing.JTextArea(header + "\\n\\n" + rpt.toString(), 25, 100);
        ta.setFont(new java.awt.Font(java.awt.Font.MONOSPACED, java.awt.Font.PLAIN, 12));
        ta.setLineWrap(false);
        ta.setWrapStyleWord(true);
        javax.swing.JScrollPane sp = new javax.swing.JScrollPane(ta);
        sp.setPreferredSize(new java.awt.Dimension(1000, 520));

        Object[] options = {"Lanjutkan Merge", "Batal"};
        int choice = javax.swing.JOptionPane.showOptionDialog(
                this, sp, "Cek Berkas Sebelum Merge",
                javax.swing.JOptionPane.YES_NO_OPTION,
                javax.swing.JOptionPane.WARNING_MESSAGE,
                null, options, options[1]
        );
        if (choice != javax.swing.JOptionPane.YES_OPTION) return; // batal
    }


    // ====== MERGE (lanjut jika: tidak ada masalah atau user setuju lanjut) ======
    start.setTime(DTPTglAwal.getDate()); // reset tanggal
    for (Date date = start.getTime(); !start.after(end); start.add(Calendar.DATE, 1), date = start.getTime()) {
        String formattedDate = new SimpleDateFormat("yyyy-MM-dd").format(date);
        String[] ymd = formattedDate.split("-");
        final String pathRoot = "berkasklaim" + File.separator + ymd[0] + File.separator + ymd[1] + File.separator + ymd[2];

        if (TabRawat.getSelectedIndex() == 0) {
            // ---------- MERGE RALAN ----------
            for (int r = 0; r < tbListPasienRalan.getRowCount(); r++) {
                if (!"true".equals(String.valueOf(tbListPasienRalan.getValueAt(r, 0)))) continue;
                String noSep   = String.valueOf(tbListPasienRalan.getValueAt(r, 6));
                String tglReg  = String.valueOf(tbListPasienRalan.getValueAt(r, 7));
                String noRawat = String.valueOf(tbListPasienRalan.getValueAt(r, 1));
                if ("-".equals(noSep) || !formattedDate.equals(tglReg)) continue;

                PreparedStatement ps = null; ResultSet rs = null;
                try {
                    String q = "SELECT bdp.*, COALESCE(mbd.nama,'') AS nama_berkas " +
                               "FROM berkas_digital_perawatan bdp " +
                               "LEFT JOIN master_berkas_digital mbd ON mbd.kode = bdp.kode " +
                               "WHERE bdp.no_rawat=? AND bdp.kode IN ('001','007','144','009','005','006') " +
                               "ORDER BY FIELD(bdp.kode,'001','007','144','009','005','006'), bdp.kode ASC";
                    ps = koneksi.prepareStatement(q);
                    ps.setString(1, noRawat);
                    rs = ps.executeQuery();

                    PDFMergerUtility ut = new PDFMergerUtility();
                    java.util.List<java.nio.file.Path> tempFiles = new java.util.ArrayList<>();
                    int added = 0;
                    java.util.List<String> okList = new java.util.ArrayList<>();
                    java.util.List<String> failList = new java.util.ArrayList<>();

                    while (rs.next()) {
                        String safeLokasi = encodeLokasi(rs.getString("lokasi_file"));
                        try {
                            addSourceResolved(baseUrl, safeLokasi, ut, tempFiles);
                            added++;
                            okList.add(safeLokasi);
                        } catch (Exception ex) {
                            System.out.println("FAIL addSource → " + baseUrl + safeLokasi + " :: " + ex.getMessage());
                            failList.add(safeLokasi + " :: " + ex.getClass().getSimpleName() + " : " + ex.getMessage());
                        }
                    }

                    System.out.println("MERGE " + noSep + " — OK=" + added + ", FAIL=" + failList.size());
                    for (String s : okList)   System.out.println("  + " + s);
                    for (String s : failList) System.out.println("  - " + s);

                    if (added == 0) {
                        javax.swing.JOptionPane.showMessageDialog(null,
                            "Tidak ada berkas yang berhasil diunduh/konversi untuk No.SEP ini.\\n" +
                            "Cek lagi sumber berkas di server dokumen.", "Info", javax.swing.JOptionPane.INFORMATION_MESSAGE);
                        for (java.nio.file.Path p : tempFiles) { try { java.nio.file.Files.deleteIfExists(p); } catch (Exception ignore) {} }
                        continue;
                    }

                    File dir = new File(pathRoot); dir.mkdirs();
                    File out = new File(dir, noSep + ".pdf");
                    int v = 2; while (out.exists()) { out = new File(dir, noSep + "_v" + v + ".pdf"); v++; }

                    ut.setDestinationFileName(out.getAbsolutePath());
                    ut.mergeDocuments(org.apache.pdfbox.io.MemoryUsageSetting.setupTempFileOnly());
                    System.out.println("WRITE => " + out.getAbsolutePath());


                    for (java.nio.file.Path p : tempFiles) { try { java.nio.file.Files.deleteIfExists(p); } catch (Exception ignore) {} }

                } catch (SQLException e) {
                    System.out.println("Notif : " + e);
                } catch (IOException e) {
                    System.out.println("Notif : " + e);
                    javax.swing.JOptionPane.showMessageDialog(null, "Gagal menggabungkan file: " + e.getMessage());
                } catch (Exception e) {
                    System.out.println("Notifikasi : " + e);
                } finally {
                    if (rs != null) try { rs.close(); } catch (Exception ex) {}
                    if (ps != null) try { ps.close(); } catch (Exception ex) {}
                }
            }
        } else {
            // ---------- MERGE RANAP ----------
            for (int r = 0; r < tbListPasienRanap.getRowCount(); r++) {
                if (!"true".equals(String.valueOf(tbListPasienRanap.getValueAt(r, 0)))) continue;
                String noSep   = String.valueOf(tbListPasienRanap.getValueAt(r, 6));
                String tglReg  = String.valueOf(tbListPasienRanap.getValueAt(r, 7));
                String noRawat = String.valueOf(tbListPasienRanap.getValueAt(r, 1));
                if ("-".equals(noSep) || !formattedDate.equals(tglReg)) continue;

                PreparedStatement ps = null; ResultSet rs = null;
                try {
                    String q = "SELECT bdp.*, COALESCE(mbd.nama,'') AS nama_berkas " +
                               "FROM berkas_digital_perawatan bdp " +
                               "LEFT JOIN master_berkas_digital mbd ON mbd.kode = bdp.kode " +
                               "WHERE bdp.no_rawat=? AND bdp.kode IN ('001','007','144','009','005','006') " +
                               "ORDER BY FIELD(bdp.kode,'001','007','144','009','005','006'), bdp.kode ASC";
                    ps = koneksi.prepareStatement(q);
                    ps.setString(1, noRawat);
                    rs = ps.executeQuery();

                    org.apache.pdfbox.multipdf.PDFMergerUtility ut = new org.apache.pdfbox.multipdf.PDFMergerUtility();
                    java.util.List<java.nio.file.Path> tempFiles = new java.util.ArrayList<>();
                    int added = 0;

                    while (rs.next()) {
                        String safeLokasi = encodeLokasi(rs.getString("lokasi_file"));
                        try {
                            addSourceResolved(baseUrl, safeLokasi, ut, tempFiles);
                            added++;
                        } catch (Exception ex) {
                            System.out.println("FAIL addSource → " + baseUrl + safeLokasi + " :: " + ex.getMessage());
                        }
                    }

                    if (added == 0) {
                        javax.swing.JOptionPane.showMessageDialog(null,
                            "Tidak ada berkas yang berhasil diunduh/konversi untuk No.SEP ini.\\n" +
                            "Cek lagi sumber berkas di server dokumen.", "Info", javax.swing.JOptionPane.INFORMATION_MESSAGE);
                        for (java.nio.file.Path p : tempFiles) { try { java.nio.file.Files.deleteIfExists(p); } catch (Exception ignore) {} }
                        continue;
                    }

                    File dir = new File(pathRoot); dir.mkdirs();
                    File out = new File(dir, noSep + ".pdf");
                    int v = 2; while (out.exists()) { out = new File(dir, noSep + "_v" + v + ".pdf"); v++; }

                    ut.setDestinationFileName(out.getAbsolutePath());
                    ut.mergeDocuments(org.apache.pdfbox.io.MemoryUsageSetting.setupTempFileOnly());
                    System.out.println("WRITE => " + out.getAbsolutePath());


                    for (java.nio.file.Path p : tempFiles) { try { java.nio.file.Files.deleteIfExists(p); } catch (Exception ignore) {} }

                } catch (SQLException e) {
                    System.out.println("Notif : " + e);
                } catch (IOException e) {
                    System.out.println("Notif : " + e);
                    javax.swing.JOptionPane.showMessageDialog(null, "Gagal menggabungkan file: " + e.getMessage());
                } catch (Exception e) {
                    System.out.println("Notifikasi : " + e);
                } finally {
                    if (rs != null) try { rs.close(); } catch (Exception ex) {}
                    if (ps != null) try { ps.close(); } catch (Exception ex) {}
                }
            }
        }
    }
}

private void downloadFile(String namaFile) {
    try {
        java.nio.file.Path root = java.nio.file.Paths.get("berkasklaim");
        if (!java.nio.file.Files.exists(root)) {
            javax.swing.JOptionPane.showMessageDialog(null, "Direktori 'berkasklaim' tidak ditemukan. Belum ada hasil merge.");
            return;
        }
        long countPdf;
        try (java.util.stream.Stream<java.nio.file.Path> walk = java.nio.file.Files.walk(root)) {
            countPdf = walk.filter(p -> java.nio.file.Files.isRegularFile(p) && p.toString().toLowerCase().endsWith(".pdf")).count();
        }
        if (countPdf == 0) {
            javax.swing.JOptionPane.showMessageDialog(null, "Tidak ada file PDF hasil merge di 'berkasklaim'. Pastikan proses merge menghasilkan file.");
            return;
        }

        java.nio.file.Path outDir = java.nio.file.Paths.get("berkasklaimzip");
        java.nio.file.Files.createDirectories(outDir);
        java.nio.file.Path zipPath = outDir.resolve(namaFile + ".zip");

        try (java.util.zip.ZipOutputStream zos = new java.util.zip.ZipOutputStream(java.nio.file.Files.newOutputStream(zipPath))) {
            java.nio.file.Files.walk(root).forEach(p -> {
                try {
                    if (java.nio.file.Files.isRegularFile(p)) {
                        String entryName = root.relativize(p).toString().replace('\\','/');
                        zos.putNextEntry(new java.util.zip.ZipEntry(entryName));
                        java.nio.file.Files.copy(p, zos);
                        zos.closeEntry();
                    }
                } catch (Exception ex) {
                    System.out.println("ZIP WARN: gagal menambah " + p + " -> " + ex.getMessage());
                }
            });
        }

        javax.swing.JFileChooser fileChooser = new javax.swing.JFileChooser();
        fileChooser.setDialogTitle("Simpan ZIP");
        fileChooser.setSelectedFile(new java.io.File(namaFile + ".zip"));
        int userSelection = fileChooser.showSaveDialog(new javax.swing.JFrame());
        if (userSelection == javax.swing.JFileChooser.APPROVE_OPTION) {
            java.io.File dest = fileChooser.getSelectedFile();
            java.nio.file.Files.copy(zipPath, dest.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
            javax.swing.JOptionPane.showMessageDialog(null, "ZIP berhasil disimpan.");
        } else {
            javax.swing.JOptionPane.showMessageDialog(null, "Penyimpanan ZIP dibatalkan.");
        }

        try { deleteDir("berkasklaimzip"); } catch (Exception ignore) {}

    } catch (Exception ex) {
        javax.swing.JOptionPane.showMessageDialog(null, "Gagal membuat ZIP: " + ex.getMessage());
    }
} 

// ======== AUTO-ADDED HELPERS (merger/HTTP/image) ========
private static final boolean FIT_TO_A4 = true;
private static final float JPEG_QUALITY = 0.78f;

// Deteksi header PDF cepat
private static boolean isPdfHeader(java.nio.file.Path p) {
    try (java.io.InputStream in = java.nio.file.Files.newInputStream(p)) {
        byte[] head = new byte[5];
        int r = in.read(head);
        if (r >= 5) {
            String s = new String(head, java.nio.charset.StandardCharsets.US_ASCII);
            return s.startsWith("%PDF-");
        }
        return false;
    } catch (Exception e) {
        return false;
    }
}

// Probe HTTP: HEAD → GET Range 0-0. Kembalikan 200 utk OK (full/partial), selain itu kode asli / -1 kalau error
private static int probeHttp(String urlStr) {
    java.net.HttpURLConnection c = null;
    try {
        java.net.URL u = new java.net.URL(urlStr);

        // 1) HEAD
        c = (java.net.HttpURLConnection) u.openConnection();
        c.setConnectTimeout(5000);
        c.setReadTimeout(5000);
        c.setInstanceFollowRedirects(true);
        c.setRequestMethod("HEAD");
        int code = c.getResponseCode();
        if (code == 200 || code == 204) return 200;
        // fallback GET + Range
        if (code == 405 || code == 501 || code == 400 || code == 403 || code == 404) {
            try { c.disconnect(); } catch (Exception ignore) {}
            c = (java.net.HttpURLConnection) u.openConnection();
            c.setConnectTimeout(5000);
            c.setReadTimeout(5000);
            c.setInstanceFollowRedirects(true);
            c.setRequestMethod("GET");
            c.setRequestProperty("Range", "bytes=0-0");
            int g = c.getResponseCode();
            if (g == 200 || g == 206) return 200;
            return g;
        }
        return code;
    } catch (Exception e) {
        return -1;
    } finally {
        if (c != null) try { c.disconnect(); } catch (Exception ignore) {}
    }
}

private static boolean isHttpOk(int code) {
    return code == 200 || code == 206;
}

// Sampling ringan utk deteksi “banyak warna”
private static boolean hasManyColors(java.awt.image.BufferedImage img) {
    int w = img.getWidth(), h = img.getHeight();
    int stepX = Math.max(1, w / 64), stepY = Math.max(1, h / 64);
    java.util.HashSet<Integer> colors = new java.util.HashSet<>();
    for (int y = 0; y < h; y += stepY) {
        for (int x = 0; x < w; x += stepX) {
            colors.add(img.getRGB(x, y));
            if (colors.size() > 256) return true;
        }
    }
    return colors.size() > 32;
}

// Konversi gambar → PDF (smart) + opsi fit A4
private static java.nio.file.Path imageToPdf(java.awt.image.BufferedImage img) throws java.io.IOException {
    try (org.apache.pdfbox.pdmodel.PDDocument doc = new org.apache.pdfbox.pdmodel.PDDocument()) {

        boolean opaque = img.getColorModel().getTransparency() == java.awt.Transparency.OPAQUE;
        boolean manyColors = hasManyColors(img);

        org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject pdImg =
                (opaque && manyColors)
                        ? org.apache.pdfbox.pdmodel.graphics.image.JPEGFactory.createFromImage(doc, img, JPEG_QUALITY)
                        : org.apache.pdfbox.pdmodel.graphics.image.LosslessFactory.createFromImage(doc, img);

        float w = pdImg.getWidth();
        float h = pdImg.getHeight();

        if (!FIT_TO_A4) {
            org.apache.pdfbox.pdmodel.common.PDRectangle rect = new org.apache.pdfbox.pdmodel.common.PDRectangle(w, h);
            org.apache.pdfbox.pdmodel.PDPage page = new org.apache.pdfbox.pdmodel.PDPage(rect);
            doc.addPage(page);
            try (org.apache.pdfbox.pdmodel.PDPageContentStream cs = new org.apache.pdfbox.pdmodel.PDPageContentStream(doc, page)) {
                cs.drawImage(pdImg, 0, 0, w, h);
            }
        } else {
            org.apache.pdfbox.pdmodel.common.PDRectangle A4P = org.apache.pdfbox.pdmodel.common.PDRectangle.A4;
            org.apache.pdfbox.pdmodel.common.PDRectangle A4L = new org.apache.pdfbox.pdmodel.common.PDRectangle(A4P.getHeight(), A4P.getWidth());
            boolean landscape = w > h;
            org.apache.pdfbox.pdmodel.common.PDRectangle pageRect = landscape ? A4L : A4P;

            org.apache.pdfbox.pdmodel.PDPage page = new org.apache.pdfbox.pdmodel.PDPage(pageRect);
            doc.addPage(page);

            float margin = 18f;
            float maxW = pageRect.getWidth() - 2*margin;
            float maxH = pageRect.getHeight() - 2*margin;
            float scale = Math.min(maxW / w, maxH / h);
            float drawW = w * scale;
            float drawH = h * scale;
            float ox = (pageRect.getWidth() - drawW) / 2f;
            float oy = (pageRect.getHeight() - drawH) / 2f;

            try (org.apache.pdfbox.pdmodel.PDPageContentStream cs = new org.apache.pdfbox.pdmodel.PDPageContentStream(doc, page)) {
                cs.drawImage(pdImg, ox, oy, drawW, drawH);
            }
        }

        java.nio.file.Path out = java.nio.file.Files.createTempFile("klaim_img_", ".pdf");
        doc.save(out.toFile());
        return out;
    }
}

// Unduh/resolve satu sumber lalu tambahkan ke merger (mendukung PDF & gambar)
private static void addSourceResolved(String baseUrl,
                                      String lokasiSafe,
                                      org.apache.pdfbox.multipdf.PDFMergerUtility ut,
                                      java.util.List<java.nio.file.Path> tempFiles) throws Exception {
    String urlStr = baseUrl + lokasiSafe;
    String lower  = lokasiSafe.toLowerCase();

    // Unduh dgn header & timeout yang baik
    java.net.URL url = new java.net.URL(urlStr);
    java.net.HttpURLConnection hc = (java.net.HttpURLConnection) url.openConnection();
    hc.setConnectTimeout(15000);
    hc.setReadTimeout(30000);
    hc.setInstanceFollowRedirects(true);
    hc.setRequestProperty("User-Agent", "Mozilla/5.0 (Windows) KLAIM-MERGER");

    int code = hc.getResponseCode();
    if (!(code == 200 || code == 206)) {
        throw new java.io.IOException("HTTP " + code + " saat unduh: " + urlStr);
    }

    // Simpan sementara dulu (lebih stabil untuk ImageIO & PDFBox)
    String suf = lower.endsWith(".pdf") ? ".pdf" : ".bin";
    java.nio.file.Path tmp = java.nio.file.Files.createTempFile("klaim_dl_", suf);
    try (java.io.InputStream in = hc.getInputStream();
         java.io.OutputStream out = java.nio.file.Files.newOutputStream(tmp)) {
        byte[] buf = new byte[8192];
        int r; while ((r = in.read(buf)) != -1) out.write(buf, 0, r);
    } finally {
        try { hc.disconnect(); } catch (Exception ignore) {}
    }

    // --- Jika PDF murni, langsung add ---
    String ct = ""; // content-type (kalau ada)
    try { ct = hc.getContentType(); } catch (Exception ignore) {}
    boolean looksPdf = (ct != null && ct.toLowerCase().contains("pdf"))
                       || lower.endsWith(".pdf")
                       || isPdfByHeaderOrOpen(tmp);

    if (looksPdf) {
        tempFiles.add(tmp);
        ut.addSource(tmp.toFile());
        return;
    }

    // --- Coba sebagai gambar → konversi ke PDF ---
    java.awt.image.BufferedImage img = null;
    try { img = javax.imageio.ImageIO.read(tmp.toFile()); } catch (Exception ignore) {}
    if (img != null) {
        java.nio.file.Path conv = imageToPdf(img); // helper “smart” + A4
        tempFiles.add(conv);
        ut.addSource(conv.toFile());
        return;
    }

    throw new java.io.IOException("Konten bukan PDF/gambar (atau korup): " + urlStr);
}


// ======== END AUTO-ADDED HELPERS ========

// Encode lokasi_file agar URL aman (spasi & karakter khusus di-encode per segmen)
private static String encodeLokasi(String lokasi) {
    if (lokasi == null) return "";
    String p = lokasi.replace("\\", "/");
    StringBuilder sb = new StringBuilder();
    for (String seg : p.split("/")) {
        if (sb.length() > 0) sb.append("/");
        try {
            sb.append(java.net.URLEncoder.encode(seg, "UTF-8").replace("+", "%20"));
        } catch (Exception e) {
            sb.append(seg);
        }
    }
    return sb.toString();
}

// Cek header PDF tetapi toleran terhadap BOM/whitespace di awal
private static boolean isPdfHeaderLoose(java.nio.file.Path p) {
    try (java.io.InputStream in = java.nio.file.Files.newInputStream(p)) {
        byte[] buf = new byte[2048];
        int n = in.read(buf);
        if (n <= 0) return false;
        int i = 0;
        // lewati BOM UTF-8 & whitespace/kontrol
        while (i < n && (buf[i] == (byte)0xEF || buf[i] == (byte)0xBB || buf[i] == (byte)0xBF || buf[i] <= 0x20)) i++;
        if (i + 5 <= n) {
            return (buf[i] == '%' && buf[i+1] == 'P' && buf[i+2] == 'D' && buf[i+3] == 'F' && buf[i+4] == '-');
        }
        return false;
    } catch (Exception e) {
        return false;
    }
}

// Anggap PDF jika header lolos ATAU benar-benar bisa dibuka oleh PDFBox
private static boolean isPdfByHeaderOrOpen(java.nio.file.Path p) {
    if (isPdfHeaderLoose(p)) return true;
    org.apache.pdfbox.pdmodel.PDDocument doc = null;
    try {
        doc = org.apache.pdfbox.pdmodel.PDDocument.load(p.toFile());
        return true; // bisa dibuka → treat as PDF
    } catch (Exception e) {
        return false;
    } finally {
        if (doc != null) try { doc.close(); } catch (Exception ignore) {}
    }
}

