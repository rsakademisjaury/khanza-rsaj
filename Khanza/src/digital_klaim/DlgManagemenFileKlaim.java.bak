                            String kunjungan = tbListPasienRalan.getValueAt(row, 1).toString();
                            TCariKunjungan.setText(kunjungan);
                        } else if (column == 6) { // Kolom No. SEP di klik
                            String kunjungan = tbListPasienRalan.getValueAt(row, 6).toString();
                            TCariKunjungan.setText(kunjungan);
