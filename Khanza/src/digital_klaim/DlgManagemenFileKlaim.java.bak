private void tampilRalan() {
    this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
    int jumlahBelumCoding = 0;
    int jumlahBelumGabung = 0;

    mulaiIsiTabelCepat(tbListPasienRalan);
    try {
        Valid.tabelKosong(TabModePasienRalan);

        String kataKunci = TCariKunjungan.getText().trim();
        boolean pakaiPencarian = !kataKunci.isEmpty();
        String filterCari = "";

        // Saat kata kunci kosong, jangan kirim OR ... LIKE '%%'. Selain tidak
        // diperlukan, pola tersebut membuat optimizer database bekerja lebih berat.
        if (pakaiPencarian) {
            filterCari =
                "  AND ( " +
                "       rp.no_rawat LIKE ? " +
                "    OR rp.no_rkm_medis LIKE ? " +
                "    OR p.nm_pasien LIKE ? " +
                "    OR COALESCE(bs.no_sep,'') LIKE ? " +
                "    OR pl.nm_poli LIKE ? " +
                "    OR rp.status_bayar LIKE ? " +
                "    OR COALESCE(d.nm_dokter,'') LIKE ? " +
                "    OR EXISTS (SELECT 1 " +
                "                 FROM diagnosa_pasien dpc " +
                "                 LEFT JOIN penyakit pyc ON pyc.kd_penyakit=dpc.kd_penyakit " +
                "                WHERE dpc.no_rawat=rp.no_rawat " +
                "                  AND (dpc.kd_penyakit LIKE ? OR COALESCE(pyc.nm_penyakit,'') LIKE ?)) " +
                "      ) ";
        }

        String sql =
            "SELECT " +
            "  rp.no_rawat, rp.tgl_registrasi, rp.no_rkm_medis, p.nm_pasien, pl.nm_poli, " +
            "  COALESCE(d.nm_dokter, '-') AS dpjp, " +
            "  rp.status_bayar, " +
            // Diagnosa dibuat setelah pasien terfilter; tidak lagi membuat join besar
            // diagnosa_pasien x reg_periksa sebelum GROUP BY.
            "  COALESCE((SELECT GROUP_CONCAT(DISTINCT CONCAT(dpd.kd_penyakit, " +
            "                   IF(pyd.nm_penyakit IS NULL OR pyd.nm_penyakit='', '', CONCAT(' - ',pyd.nm_penyakit))) " +
            "                   SEPARATOR ', ') " +
            "             FROM diagnosa_pasien dpd " +
            "             LEFT JOIN penyakit pyd ON pyd.kd_penyakit=dpd.kd_penyakit " +
            "            WHERE dpd.no_rawat=rp.no_rawat), 'Kosong') AS diagnosa, " +
            "  IFNULL(bs.no_sep, 'SEP belum terbit/ditarik') AS no_sep, " +
            "  IFNULL(bs.tglsep, '-') AS tglsep, " +
            "  CASE " +
            "    WHEN EXISTS (SELECT 1 FROM inacbg_grouping_final gf WHERE gf.no_sep=bs.no_sep) THEN 'Final Klaim' " +
            "    WHEN EXISTS (SELECT 1 FROM inacbg_final fin WHERE fin.no_sep=bs.no_sep) THEN 'Final INACBG' " +
            "    WHEN EXISTS (SELECT 1 FROM inacbg_grouping_stage2 g2 WHERE g2.no_sep=bs.no_sep) " +
            "      OR EXISTS (SELECT 1 FROM inacbg_grouping_stage1 g1 WHERE g1.no_sep=bs.no_sep) THEN 'Grouping INACBG' " +
            "    WHEN EXISTS (SELECT 1 FROM inacbg_idrg_final iif WHERE iif.no_sep=bs.no_sep) THEN 'Final IDRG' " +
            "    WHEN EXISTS (SELECT 1 FROM idrg_grouper ig WHERE ig.no_sep=bs.no_sep) THEN 'Grouping IDRG' " +
            "    ELSE 'Belum Coding' " +
            "  END AS status_coding, " +
            "  CASE WHEN EXISTS (SELECT 1 FROM inacbg_kirim_online ko WHERE ko.no_sep=bs.no_sep) " +
            "       THEN 'Terkirim' ELSE '-' END AS kirim_online, " +
            "  CASE WHEN EXISTS (SELECT 1 FROM berkas_digital_perawatan bdp " +
            "                    WHERE bdp.no_rawat=rp.no_rawat AND bdp.kode='009') " +
            "       THEN 'Terupload' ELSE '-' END AS individual, " +
            "  CASE WHEN EXISTS (SELECT 1 FROM inacbg_gabung_berkas igb WHERE igb.no_rawat=rp.no_rawat) " +
            "       THEN 'OK' ELSE '-' END AS berkas, " +
            "  IFNULL(icb.catatan, '-') AS catatan " +
            "FROM reg_periksa rp " +
            "JOIN pasien p ON p.no_rkm_medis=rp.no_rkm_medis " +
            "JOIN poliklinik pl ON pl.kd_poli=rp.kd_poli " +
            "LEFT JOIN penjab pj ON pj.kd_pj=rp.kd_pj " +
            "LEFT JOIN bridging_sep bs ON bs.no_rawat=rp.no_rawat " +
            "LEFT JOIN resume_pasien rps ON rps.no_rawat=rp.no_rawat " +
            "LEFT JOIN dokter d ON d.kd_dokter=rps.kd_dokter " +
            "LEFT JOIN inacbg_catatan_berkas icb ON icb.no_sep=bs.no_sep " +
            "WHERE rp.status_lanjut='Ralan' " +
            "  AND rp.tgl_registrasi BETWEEN ? AND ? " +
            "  AND (rp.kd_pj='BPJ' " +
            "       OR (pj.png_jawab IS NOT NULL " +
            "           AND LOWER(pj.png_jawab) LIKE '%bpjs%' " +
            "           AND LOWER(pj.png_jawab) LIKE '%cob%' " +
            "           AND LOWER(pj.png_jawab) NOT LIKE '%kerja%')) " +
            "  AND rp.stts<>'Batal' " +
            filterCari +
            "GROUP BY rp.no_rawat " +
            "ORDER BY pl.nm_poli ASC, p.nm_pasien ASC";

        try (PreparedStatement ps = koneksi.prepareStatement(sql)) {
            ps.setFetchSize(FETCH_SIZE_KLAIM);
            int urut = 1;
            ps.setString(urut++, Valid.SetTgl(DTPTglAwal.getSelectedItem() + ""));
            ps.setString(urut++, Valid.SetTgl(DTPTglAkhir.getSelectedItem() + ""));

            if (pakaiPencarian) {
                String kw = "%" + kataKunci + "%";
                for (int n = 0; n < 9; n++) {
                    ps.setString(urut++, kw);
                }
            }

            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    String statusCoding = rs.getString("status_coding");
                    String statusBerkas = rs.getString("berkas");
                    if ("Belum Coding".equalsIgnoreCase(statusCoding)) jumlahBelumCoding++;
                    if ("-".equals(statusBerkas)) jumlahBelumGabung++;

                    TabModePasienRalan.addRow(new Object[]{
                        false,
                        rs.getString("no_rawat"),
                        rs.getString("no_rkm_medis"),
                        rs.getString("nm_pasien"),
                        rs.getString("nm_poli"),
                        rs.getString("dpjp"),
                        rs.getString("no_sep"),
                        rs.getString("tglsep"),
                        rs.getString("status_bayar"),
                        rs.getString("diagnosa"),
                        statusCoding,
                        rs.getString("kirim_online"),
                        rs.getString("individual"),
                        statusBerkas,
                        rs.getString("catatan")
                    });
                }
            }
        }
    } catch (Exception e) {
        System.out.println("Notifikasi tampil Ralan : " + e);
    } finally {
        selesaiIsiTabelCepat(tbListPasienRalan);
        LCount.setText(String.valueOf(tbListPasienRalan.getRowCount()));
        LCountBelum.setText(String.valueOf(jumlahBelumCoding));
        LCountBelumGabung.setText(String.valueOf(jumlahBelumGabung));
        this.setCursor(Cursor.getDefaultCursor());
    }
}

