    private void ppBridgingEklaimActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_ppBridgingEklaimActionPerformed
        /*
         * Optimasi buka form INACBG:
         * 1) cegah klik ganda,
         * 2) validasi tetap sama,
         * 3) dialog dibuat dan ditampilkan lebih dahulu,
         * 4) pengisian data dijalankan pada event berikutnya agar frame sudah
         *    sempat ter-render. Alur modal dan seluruh data yang dipanggil
         *    tetap sama seperti sebelumnya.
         */
        if (membukaFormINACBG) {
            return;
        }

        membukaFormINACBG = true;
        setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
        ppBridgingEklaim.setEnabled(false);

        try {
            String noRawat = "", norm = "", nmpasien = "";
            int selectedTab = TabRawat.getSelectedIndex();

            if (selectedTab == 0) { // Rawat Jalan
                if (TabModePasienRalan.getRowCount() == 0) {
                    JOptionPane.showMessageDialog(null, "Maaf, table masih kosong...!!!!");
                    return;
                }
                int row = tbListPasienRalan.getSelectedRow();
                if (row == -1) {
                    JOptionPane.showMessageDialog(null, "Maaf, silakan pilih dulu data pasien...!!!!");
                    return;
                }

                noRawat  = tbListPasienRalan.getValueAt(row, 1).toString();
                norm     = tbListPasienRalan.getValueAt(row, 2).toString();
                nmpasien = tbListPasienRalan.getValueAt(row, 3).toString();

            } else if (selectedTab == 1) { // Rawat Inap
                if (TabModePasienRanap.getRowCount() == 0) {
                    JOptionPane.showMessageDialog(null, "Maaf, table masih kosong...!!!!");
                    return;
                }
                int row = tbListPasienRanap.getSelectedRow();
                if (row == -1) {
                    JOptionPane.showMessageDialog(null, "Maaf, silakan pilih dulu data pasien...!!!!");
                    return;
                }

                noRawat  = tbListPasienRanap.getValueAt(row, 1).toString();
                norm     = tbListPasienRanap.getValueAt(row, 2).toString();
                nmpasien = tbListPasienRanap.getValueAt(row, 3).toString();
            } else {
                JOptionPane.showMessageDialog(null, "Silakan pilih data Rawat Jalan atau Rawat Inap.");
                return;
            }

            if (noRawat == null || noRawat.trim().isEmpty()) {
                JOptionPane.showMessageDialog(null, "Maaf, No. Rawat tidak ditemukan...!!!!");
                return;
            }

            /*
             * Tetap satu kali query untuk validasi awal: billing, SEP, dan
             * verifikator. Query ini ringan dan mencegah form besar dibuat
             * bila data belum memenuhi syarat.
             */
            final String sql =
                "SELECT " +
                "  EXISTS(SELECT 1 FROM billing b WHERE b.no_rawat = ?) AS billing_ada, " +
                "  IFNULL((SELECT bs.no_sep " +
                "          FROM bridging_sep bs " +
                "          WHERE bs.no_rawat = ? " +
                "          ORDER BY bs.tglsep DESC " +
                "          LIMIT 1),'') AS no_sep, " +
                "  IFNULL((SELECT ik.no_ik " +
                "          FROM inacbg_coder_nik ik " +
                "          WHERE ik.nik = ? " +
                "          LIMIT 1),'') AS no_ik";

            boolean billingAda = false;
            String noSep = "";
            String verifikator = "";

            try (PreparedStatement ps = koneksi.prepareStatement(sql)) {
                ps.setString(1, noRawat);
                ps.setString(2, noRawat);
                ps.setString(3, akses.getkode());

                try (ResultSet rs = ps.executeQuery()) {
                    if (rs.next()) {
                        billingAda = rs.getBoolean("billing_ada");
                        noSep = rs.getString("no_sep");
                        verifikator = rs.getString("no_ik");
                    }
                }
            }

            if (!billingAda) {
                JOptionPane.showMessageDialog(null, "Maaf, Billing belum ditutup silahkan hubungi kasir");
                return;
            }

            if (noSep == null || noSep.trim().isEmpty()) {
                JOptionPane.showMessageDialog(null,
                    "Pasien dengan No. Rawat " + noRawat + " belum memiliki No. SEP...!!!!");
                return;
            }

            if (verifikator == null || verifikator.trim().isEmpty()) {
                JOptionPane.showMessageDialog(null, "Maaf, Anda bukan VERIFIKATOR KLAIM !!!!");
                return;
            }

            final String fNoRawat = noRawat;
            final String fNorm = norm;
            final String fNamaPasien = nmpasien;
            final boolean isRanap = (selectedTab == 1);

            final INACBGDataIDRG1 idrg = new INACBGDataIDRG1(null, true);
            idrg.setNoRawat(fNoRawat, isRanap);
            idrg.setSize(internalFrame1.getWidth(), internalFrame1.getHeight());
            idrg.setLocationRelativeTo(internalFrame1);

            /*
             * Beri kesempatan dialog tampil/paint dulu. Data dan logika
             * setDiagnosa tetap dipanggil persis sekali di EDT agar aman
             * terhadap komponen Swing.
             */
            final String judulAsli = (idrg.getTitle() == null || idrg.getTitle().trim().isEmpty())
                    ? "INACBG / iDRG" : idrg.getTitle();
            idrg.setTitle(judulAsli + " - Memuat data klaim...");
            idrg.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));

            javax.swing.Timer timerMuat = new javax.swing.Timer(80, e -> {
                if (!idrg.isDisplayable()) {
                    return;
                }
                try {
                    idrg.setDiagnosa(fNoRawat, fNorm, fNamaPasien);
                    idrg.refreshDataPendukungSetelahMuat();
                } catch (Exception ex) {
                    ex.printStackTrace();
                    JOptionPane.showMessageDialog(idrg,
                        "Terjadi kesalahan saat memuat data klaim: " + ex.getMessage());
                } finally {
                    idrg.setCursor(Cursor.getDefaultCursor());
                    idrg.setTitle(judulAsli);
                }
            });
            timerMuat.setRepeats(false);
            timerMuat.start();

            idrg.setVisible(true);

        } catch (Exception ex) {
            ex.printStackTrace();
            JOptionPane.showMessageDialog(null, "Terjadi kesalahan: " + ex.getMessage());
        } finally {
            setCursor(Cursor.getDefaultCursor());
            ppBridgingEklaim.setEnabled(true);
            membukaFormINACBG = false;
        }

    }//GEN-LAST:event_ppBridgingEklaimActionPerformed

