        } else if (TabRawat.getSelectedIndex() == 1) {
            tampilRanap();
        } else if (TabRawat.getSelectedIndex() == 2) {
            tampilLaporan();   
        } else if (TabRawat.getSelectedIndex() == 3) {
            tampilBukaKunci();     
        }
}//GEN-LAST:event_BtnCariTindakanActionPerformed

