    private void ppBerkasKlaimActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_ppBerkasKlaimActionPerformed
    setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
    try {
        String noRawat = getSelectedNoRawatFromRalanOrRanap();
        if (noRawat == null || noRawat.trim().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Silakan pilih dulu data pasien (Ralan atau Ranap).");
            return;
        }

        // === SEP (skip kalau sudah ada) ===
//            if (!isSepAlreadyUploaded(noRawat)) {
//                BPJSDataSEP frmSEP = new BPJSDataSEP(null, false); // sesuaikan ctor
//                frmSEP.runUploadSepFor(noRawat);
//            } else {
////                System.out.println("INFO: SEP untuk no_rawat " + noRawat + " sudah ada. Skip upload.");
//            }                      
            
            String noSEP = "";

            if (TabRawat.getSelectedIndex() == 0) { // Rawat Jalan
                int row = tbListPasienRalan.getSelectedRow();
                if (row > -1) {
                    noSEP = tbListPasienRalan.getValueAt(row, 6).toString();
                }
            } else if (TabRawat.getSelectedIndex() == 1) { // Rawat Inap
                int row = tbListPasienRanap.getSelectedRow();
                if (row > -1) {
                    noSEP = tbListPasienRanap.getValueAt(row, 6).toString();
                }
            }
   
        
            // === CODER (user SIMRS yang klik) ===
            String coder = akses.getkode(); // PALING VALID
            
            BPJSDataSEP frmSEP = new BPJSDataSEP(null, false); // sesuaikan ctor
            frmSEP.runUploadSepFor(noRawat);

            // === Auto-upload Billing ke Berkas Digital ===
            try { 
                
            INACBGDataIDRG1 formBilling = new INACBGDataIDRG1(null, false); // sesuaikan ctor
            formBilling.autoUploadBillingForNoRawat(noRawat);    
            
            } catch (Exception ex) {
                System.err.println("WARN: autoUploadBilling gagal: " + ex.getMessage());
            }                        
            
            String payload = noRawat + "|" + noSEP + "|" + coder;        

            // === Buka viewer klaim + kirim DATA PENTING ===
            String url = "berkasklaim/login.php?act=login"
                        + "&usere="      + URLEncoder.encode(koneksiDB.USERHYBRIDWEB(), StandardCharsets.UTF_8.name())
                        + "&passwordte=" + URLEncoder.encode(koneksiDB.PASHYBRIDWEB(),  StandardCharsets.UTF_8.name())
                        + "&no_rawat="   + URLEncoder.encode(noRawat, StandardCharsets.UTF_8.name())
                        + "&no_sep="     + URLEncoder.encode(noSEP == null ? "" : noSEP, StandardCharsets.UTF_8.name())
                        + "&coder="      + URLEncoder.encode(coder, StandardCharsets.UTF_8.name());                    

            Valid.panggilUrl(url);

    } catch (Exception e) {
        JOptionPane.showMessageDialog(this, "Gagal membuka halaman: " + e.getMessage());
    } finally {
        setCursor(Cursor.getDefaultCursor());
    }
    }//GEN-LAST:event_ppBerkasKlaimActionPerformed

