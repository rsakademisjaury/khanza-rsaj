/*
 * Adapter renderer untuk kolom DPJP.
 *
 * Source ori memakai WarnaTableSelected/WarnaTableSelectedRanap. Renderer tersebut
 * sudah memiliki warna yang dipakai pengguna, namun membaca data dengan indeks kolom
 * lama. Kolom DPJP disisipkan setelah Poli, sehingga indeks No. SEP sampai Catatan
 * bergeser satu posisi. Adapter ini menyajikan urutan kolom lama kepada renderer ori,
 * tanpa mengubah class renderer ori maupun menghilangkan warna yang sudah berlaku.
 */
private static final class ModelWarnaLegacy extends javax.swing.table.AbstractTableModel {
    private final JTable sumber;
    private final int[] indeksLamaKeBaru;

    private ModelWarnaLegacy(JTable sumber, int[] indeksLamaKeBaru) {
        this.sumber = sumber;
        this.indeksLamaKeBaru = indeksLamaKeBaru;
    }

    @Override
    public int getRowCount() {
        return sumber == null ? 0 : sumber.getRowCount();
    }

    @Override
    public int getColumnCount() {
        return indeksLamaKeBaru.length;
    }

    @Override
    public Object getValueAt(int rowIndex, int columnIndex) {
        if (sumber == null || rowIndex < 0 || rowIndex >= sumber.getRowCount()
                || columnIndex < 0 || columnIndex >= indeksLamaKeBaru.length) {
            return null;
        }
        return sumber.getValueAt(rowIndex, indeksLamaKeBaru[columnIndex]);
    }
}

private static final class TabelWarnaLegacy extends JTable {
    private JTable sumber;

    private TabelWarnaLegacy(JTable sumber, int[] indeksLamaKeBaru) {
        super(new ModelWarnaLegacy(sumber, indeksLamaKeBaru));
        this.sumber = sumber;
    }

    @Override
    public int getSelectedRow() {
        return sumber == null ? -1 : sumber.getSelectedRow();
    }

    @Override
    public boolean isRowSelected(int row) {
        return sumber != null && sumber.isRowSelected(row);
    }

    @Override
    public int convertRowIndexToModel(int viewRowIndex) {
        return viewRowIndex;
    }

    @Override
    public int convertColumnIndexToModel(int viewColumnIndex) {
        return viewColumnIndex;
    }
}

private void pasangRendererWarnaKompatibelDPJP(
        final JTable tabel,
        final javax.swing.table.TableCellRenderer rendererOri,
        final int[] indeksLamaKeBaru) {

    final int[] indeksBaruKeLama = new int[tabel.getColumnCount()];
    for (int i = 0; i < indeksBaruKeLama.length; i++) {
        indeksBaruKeLama[i] = -1;
    }
    for (int indeksLama = 0; indeksLama < indeksLamaKeBaru.length; indeksLama++) {
        int indeksBaru = indeksLamaKeBaru[indeksLama];
        if (indeksBaru >= 0 && indeksBaru < indeksBaruKeLama.length) {
            indeksBaruKeLama[indeksBaru] = indeksLama;
        }
    }

    final JTable tabelLegacy = new TabelWarnaLegacy(tabel, indeksLamaKeBaru);
    final javax.swing.table.DefaultTableCellRenderer rendererDPJP
            = new javax.swing.table.DefaultTableCellRenderer();

    tabel.setDefaultRenderer(Object.class, new javax.swing.table.TableCellRenderer() {
        @Override
        public java.awt.Component getTableCellRendererComponent(
                JTable table, Object value, boolean isSelected, boolean hasFocus,
                int row, int column) {

            int indeksLama = (column >= 0 && column < indeksBaruKeLama.length)
                    ? indeksBaruKeLama[column] : -1;

            // Semua kolom lama memakai renderer ori langsung, tetapi data tabel yang
            // diterima renderer dikembalikan ke susunan sebelum kolom DPJP ditambah.
            if (indeksLama >= 0) {
                return rendererOri.getTableCellRendererComponent(
                        tabelLegacy, value, isSelected, hasFocus, row, indeksLama
                );
            }

            // Kolom DPJP sendiri belum ada pada renderer ori. Ambil warna baris dari
            // kolom Poli/Kamar (indeks 4 pada susunan lama), agar DPJP menyatu dengan
            // warna status baris yang sama dan tidak menghapus indikator visual lama.
            Object nilaiAcuan = tabelLegacy.getValueAt(row, 4);
            java.awt.Component warnaAcuan = rendererOri.getTableCellRendererComponent(
                    tabelLegacy, nilaiAcuan, isSelected, hasFocus, row, 4
            );
            java.awt.Component komponen = rendererDPJP.getTableCellRendererComponent(
                    table, value, isSelected, hasFocus, row, column
            );
            komponen.setBackground(warnaAcuan.getBackground());
            komponen.setForeground(warnaAcuan.getForeground());
            return komponen;
        }
    });
}

// Optimasi pengisian JTable: RowSorter bawaan JTable sangat mahal bila aktif
// saat ribuan addRow() dipanggil satu per satu. Setelah selesai, sorter dipasang lagi.
private void mulaiIsiTabelCepat(JTable table) {
    if (table != null) {
        table.setAutoCreateRowSorter(false);
        table.setRowSorter(null);
    }
}

private void selesaiIsiTabelCepat(JTable table) {
    if (table != null) {
        table.setAutoCreateRowSorter(true);
    }
}


