private void showInputCatatanDialog(String noSEP) {
    java.awt.Window owner = javax.swing.SwingUtilities.getWindowAncestor(this);
    if (owner == null && internalFrame1 != null) {
        owner = javax.swing.SwingUtilities.getWindowAncestor(internalFrame1);
    }

    InputCatatan.setModal(true);
    InputCatatan.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
    InputCatatan.setTitle("Catatan Kelengkapan Berkas — SEP: " + noSEP);

    // >>> ISI FIELD NO SEP DI DIALOG <<<
    SEP.setText(noSEP);
    SEP.setEditable(false);
    SEP.setCaretPosition(0); // biar muncul dari awal kalau kepanjangan

    // (opsional) prefill catatan lama
    // TextCatatan.setText(Sequel.cariIsi(
    //     "select catatan from inacbg_catatan_berkas where no_sep=?", noSEP));

    try { InputCatatan.pack(); } catch (Exception ignore) {}
    if (InputCatatan.getWidth() < 600 || InputCatatan.getHeight() < 380) {
        InputCatatan.setSize(760, 480);
    }
    if (owner != null) InputCatatan.setLocationRelativeTo(owner);
    else InputCatatan.setLocationRelativeTo(null);

    InputCatatan.setAlwaysOnTop(true);
    InputCatatan.toFront();
    InputCatatan.setVisible(true);
    InputCatatan.setAlwaysOnTop(false);
}
    
// Panggil ini dari action BtnSimpan
private void simpanCatatanBerkas() {
    final String noSep   = SEP.getText() == null ? "" : SEP.getText().trim();
    final String catatan = TextCatatan.getText();

    if (noSep.isEmpty()) {
        JOptionPane.showMessageDialog(this, "No. SEP kosong.");
        SEP.requestFocus();
        return;
    }

    String sql = 
        "INSERT INTO inacbg_catatan_berkas (no_sep, catatan) " +
        "VALUES (?, ?) " +
        "ON DUPLICATE KEY UPDATE catatan = VALUES(catatan)";

    try (PreparedStatement ps = koneksi.prepareStatement(sql)) {
        ps.setString(1, noSep);
        ps.setString(2, catatan);

        long t0 = System.currentTimeMillis();
        ps.executeUpdate();
        long t1 = System.currentTimeMillis();
//        System.out.println("DEBUG simpanCatatanBerkas (local ps): " + (t1 - t0) + " ms");
        refreshSetelahSimpanCatatan();

        JOptionPane.showMessageDialog(this, "Catatan tersimpan ✓");
        InputCatatan.dispose();
    } catch (SQLException e) {
        e.printStackTrace();
        JOptionPane.showMessageDialog(this, "Gagal simpan catatan: " + e.getMessage());
    }
}
  
// ==== Letakkan di class INACBGDataIDRG1 (field) ====
private static final String UPSERT_CATATAN_SQL =
    "INSERT INTO inacbg_catatan_berkas(no_sep, catatan) VALUES (?,?) " +
    "ON DUPLICATE KEY UPDATE catatan=VALUES(catatan)";
private java.sql.PreparedStatement psUpsertCatatan;

// Panggil sekali (mis. di constructor atau sebelum dipakai)
private void initUpsertCatatanStmt() throws java.sql.SQLException {
    if (psUpsertCatatan == null || psUpsertCatatan.isClosed()) {
        psUpsertCatatan = koneksi.prepareStatement(UPSERT_CATATAN_SQL);
    }
}

private String getSelectedNoRawatFromRalanOrRanap() {
    try {
        if (tbListPasienRalan != null) {
            int selRalan = tbListPasienRalan.getSelectedRow();
            if (selRalan != -1) {
                return String.valueOf(tbListPasienRalan.getValueAt(selRalan, 1));
            }
        }
    } catch (Exception ignore) {}

    try {
        if (tbListPasienRanap != null) {
            int selRanap = tbListPasienRanap.getSelectedRow();
            if (selRanap != -1) {
                return String.valueOf(tbListPasienRanap.getValueAt(selRanap, 1));
            }
        }
    } catch (Exception ignore) {}

    return null;
}

private String getSelectedNoSEPFromRalanOrRanap() {
    try {
        if (tbListPasienRalan != null) {
            int selRalan = tbListPasienRalan.getSelectedRow();
            if (selRalan != -1) {
                return String.valueOf(tbListPasienRalan.getValueAt(selRalan, 6));
            }
        }
    } catch (Exception ignore) {}

    try {
        if (tbListPasienRanap != null) {
            int selRanap = tbListPasienRanap.getSelectedRow();
            if (selRanap != -1) {
                return String.valueOf(tbListPasienRanap.getValueAt(selRanap, 6));
            }
        }
    } catch (Exception ignore) {}

    return null;
}

private boolean isSepAlreadyUploaded(String noRawat) {
    // Ambil kode SEP
    String kodeSep = Sequel.cariIsi(
        "SELECT kode FROM master_berkas_digital WHERE UPPER(nama) LIKE UPPER('%SEP%') LIMIT 1"
    );
    if (kodeSep == null || kodeSep.trim().isEmpty()) {
        // fallback aman (sering dipakai untuk SEP)
        kodeSep = Sequel.cariIsi("SELECT kode FROM master_berkas_digital WHERE kode='001' LIMIT 1");
    }
    if (kodeSep == null || kodeSep.trim().isEmpty()) {
        // kalau mapping belum ada, kita anggap belum ada (biar proses tetap jalan)
        System.out.println("WARN: kode SEP belum terdefinisi di master_berkas_digital.");
        return false;
    }

    // Cek sudah ada record?
    // Jika Sequel.cariInteger versi 2-parameter tersedia:
    int cnt;
    try {
        cnt = Sequel.cariInteger(
             "SELECT COUNT(*) FROM berkas_digital_perawatan WHERE no_rawat=? AND lokasi_file LIKE ?",
            noRawat, "pages/upload/%_BERKAS_SEP%.jpg"
        );
    } catch (Throwable t) {
          cnt = Sequel.cariInteger(
            "SELECT COUNT(*) FROM berkas_digital_perawatan WHERE no_rawat='" 
            + noRawat.replace("'", "''") + "' AND lokasi_file LIKE 'pages/upload/%_BERKAS_SEP%.jpg'"
        );
    }

    return cnt > 0;   
    
}
    
