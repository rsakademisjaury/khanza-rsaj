private boolean isBillingAlreadyUploaded(String noRawat) {
    String kodeBill = Sequel.cariIsi(
        "SELECT kode FROM master_berkas_digital WHERE UPPER(nama) LIKE UPPER('%BILLING%') LIMIT 1"
    );
    if (kodeBill == null || kodeBill.trim().isEmpty()) {
        kodeBill = Sequel.cariIsi("SELECT kode FROM master_berkas_digital WHERE kode='144' LIMIT 1");
    }
    if (kodeBill == null || kodeBill.trim().isEmpty()) return false; // biar proses tetap jalan

    int cnt;
    try {
        cnt = Sequel.cariInteger(
            "SELECT COUNT(*) FROM berkas_digital_perawatan WHERE no_rawat=? AND kode=?",
            noRawat, kodeBill
        );
    } catch (Throwable t) {
        String q = "SELECT COUNT(*) FROM berkas_digital_perawatan WHERE no_rawat='"
                 + noRawat.replace("'", "''") + "' AND kode='" + kodeBill.replace("'", "''") + "'";
        cnt = Sequel.cariInteger(q);
    }
    return cnt > 0;
}

private boolean runUploadBillingFor(String noRawat) {
    try {
        // RJ / RI
        String st = Sequel.cariIsi("SELECT status_lanjut FROM reg_periksa WHERE no_rawat=?", noRawat);
        boolean isRalan = "Ralan".equalsIgnoreCase(st);

        String fileName = buildBillingFileName(noRawat, isRalan);   // tanpa .pdf
        String localPdf = "tmpPDF" + File.separator + fileName + ".pdf";

        // 1) Ambil PDF dari web/bridge
        byte[] pdf = downloadBillingPdfBytes(noRawat, isRalan);
        if (!isPdfBytes(pdf)) {
            JOptionPane.showMessageDialog(
                this,
                "Billing tidak mengembalikan PDF. Cek bridge di server (Dompdf/wkhtmltopdf) atau coba ulang.",
                "Peringatan",
                JOptionPane.WARNING_MESSAGE
            );
            return false;
        }

        // 2) Simpan lokal dulu
        File tmpPDFDir = new File(System.getProperty("user.dir") + File.separator + "tmpPDF");
        if (!tmpPDFDir.exists()) tmpPDFDir.mkdir();
        java.nio.file.Files.write(java.nio.file.Paths.get(localPdf), pdf);

        // 3) Upload ke berkas digital
        String kodeBill = resolveKodeBilling(); // %BILLING% → fallback 144
        boolean ok = uploadPdfToBerkas(localPdf, fileName + ".pdf",
                "berkasrawat/pages/upload/", noRawat, kodeBill);

        if (ok) {
            javax.swing.JOptionPane.showMessageDialog(
                this, "Upload Billing selesai.", "Informasi",
                javax.swing.JOptionPane.INFORMATION_MESSAGE
            );
        }
        return ok;

    } catch (Exception e) {
        System.out.println("runUploadBillingFor err: " + e.getMessage());
        return false;
    }
}

private String buildBillingFileName(String noRawat, boolean isRalan) {
    java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("ddMMyyyy_HHmmss");
    String ts = sdf.format(new java.util.Date());
    return ts + "_" + noRawat.replace("/", "") + (isRalan ? "_BILLING_RJ" : "_BILLING_RI");
}

private boolean isPdfBytes(byte[] b) {
    try {
        if (b == null || b.length < 5) return false;
        String sig = new String(b, 0, 5, java.nio.charset.StandardCharsets.ISO_8859_1);
        return sig.startsWith("%PDF-");
    } catch (Exception e) { return false; }
}

private String resolveKodeBilling() {
    String kode = Sequel.cariIsi(
        "SELECT kode FROM master_berkas_digital WHERE UPPER(nama) LIKE UPPER('%BILLING%') LIMIT 1"
    );
    if (kode == null || kode.trim().isEmpty()) {
        kode = Sequel.cariIsi("SELECT kode FROM master_berkas_digital WHERE kode='144' LIMIT 1");
    }
    return (kode == null ? "" : kode);
}

private byte[] downloadBillingPdfBytes(String noRawat, boolean isRalan) {
    try {
        String encNo = java.net.URLEncoder.encode(noRawat, "UTF-8");
        String url = "billing/BillingPdfBridge.php"
                   + "?jenis=" + (isRalan ? "ralan" : "ranap")
                   + "&no_rawat=" + encNo
                   + "&usere=" + java.net.URLEncoder.encode(koneksiDB.USERHYBRIDWEB(),"UTF-8")
                   + "&passwordte=" + java.net.URLEncoder.encode(koneksiDB.PASHYBRIDWEB(),"UTF-8");

        // kalau billing kamu butuh ini, buka komentar:
        // url += "&petugas=" + java.net.URLEncoder.encode(akses.getkode(), "UTF-8");
        // url += "&tanggal=" + java.net.URLEncoder.encode(DTPTgl.getSelectedItem().toString(), "UTF-8");

        // Ambil via fetchWithLogin (sudah kamu perbaiki)
        byte[] bytes = fetchWithLogin(url);

        // Log singkat untuk debug
        if (bytes == null || bytes.length < 5) {
            System.out.println("downloadBillingPdfBytes: empty body");
            return null;
        }
        if (!isPdfBytes(bytes)) {
            String head = new String(bytes, 0, Math.min(bytes.length, 200),
                    java.nio.charset.StandardCharsets.ISO_8859_1);
            System.out.println("Non-PDF body preview: " + head.replaceAll("\\s+"," ").trim());
        }
        return bytes;
    } catch (Exception e) {
        System.out.println("downloadBillingPdfBytes err: " + e.getMessage());
        return null;
    }
}

private boolean uploadPdfToBerkas(String localPdfPath, String remoteFileName, String docpath, String noRawat, String kodeBerkas) {
    try {
        java.io.File file = new java.io.File(localPdfPath);
        if (!file.exists()) {
            System.out.println("PDF lokal tidak ditemukan: " + localPdfPath);
            return false;
        }
        byte[] data = org.apache.commons.io.FileUtils.readFileToByteArray(file);

        // Upload ke web via upload.php
        org.apache.http.impl.client.DefaultHttpClient httpClient = new org.apache.http.impl.client.DefaultHttpClient();
        org.apache.http.client.methods.HttpPost postRequest = new org.apache.http.client.methods.HttpPost(
            "http://" + koneksiDB.HOSTHYBRIDWEB() + ":" + koneksiDB.PORTWEB() + "/" + koneksiDB.HYBRIDWEB() + "/upload.php?doc=" + docpath
        );
        org.apache.http.entity.mime.MultipartEntity reqEntity = new org.apache.http.entity.mime.MultipartEntity(
            org.apache.http.entity.mime.HttpMultipartMode.BROWSER_COMPATIBLE
        );
        reqEntity.addPart("file", new org.apache.http.entity.mime.content.ByteArrayBody(data, remoteFileName));
        postRequest.setEntity(reqEntity);
        httpClient.execute(postRequest);

        // Simpan ke DB
        String lokasi_file = "pages/upload/" + remoteFileName; // contoh: pages/upload/ts_NoRw_BILLING_RJ.pdf

        boolean ok;
        if (Sequel.cariInteger("SELECT COUNT(no_rawat) FROM berkas_digital_perawatan WHERE lokasi_file=?", lokasi_file) > 0) {
            ok = Sequel.mengedittf(
                "berkas_digital_perawatan",
                "lokasi_file=?",
                "no_rawat=?,kode=?,lokasi_file=?",
                4,
                new String[]{ noRawat, kodeBerkas, lokasi_file, lokasi_file }
            );
        } else {
            ok = Sequel.menyimpantf(
                "berkas_digital_perawatan",
                "?,?,?",
                "No.Rawat",
                3,
                new String[]{ noRawat, kodeBerkas, lokasi_file }
            );
        }
        return ok;
    } catch (Exception e) {
        System.out.println("uploadPdfToBerkas err: " + e.getMessage());
        return false;
    }
}

private byte[] fetchWithLogin(String pathAndQuery) {
    org.apache.http.client.CookieStore cookieStore = new org.apache.http.impl.client.BasicCookieStore();
    org.apache.http.client.protocol.HttpClientContext context = org.apache.http.client.protocol.HttpClientContext.create();
    context.setCookieStore(cookieStore);

    try (org.apache.http.impl.client.CloseableHttpClient client =
             org.apache.http.impl.client.HttpClients.custom().setDefaultCookieStore(cookieStore).build()) {

        String base = "http://" + koneksiDB.HOSTHYBRIDWEB() + ":" + koneksiDB.PORTWEB()
                    + "/" + koneksiDB.HYBRIDWEB() + "/";

        // Login dulu
        org.apache.http.client.methods.HttpGet loginGet =
                new org.apache.http.client.methods.HttpGet(base + "login.php?act=login"
                        + "&usere=" + java.net.URLEncoder.encode(koneksiDB.USERHYBRIDWEB(), "UTF-8")
                        + "&passwordte=" + java.net.URLEncoder.encode(koneksiDB.PASHYBRIDWEB(),  "UTF-8"));
        try (org.apache.http.client.methods.CloseableHttpResponse loginResp = client.execute(loginGet, context)) {
            org.apache.http.util.EntityUtils.consumeQuietly(loginResp.getEntity());
        }

        // GET resource
        org.apache.http.client.methods.HttpGet get = new org.apache.http.client.methods.HttpGet(base + pathAndQuery);
        get.setHeader("Accept", "application/pdf,*/*;q=0.9");
        get.setHeader("User-Agent", "Mozilla/5.0");

        try (org.apache.http.client.methods.CloseableHttpResponse resp = client.execute(get, context)) {
            int sc = resp.getStatusLine().getStatusCode();
            org.apache.http.Header ct = resp.getFirstHeader("Content-Type");
            System.out.println("Billing HTTP status: " + sc + "; CT=" + (ct!=null?ct.getValue():"-"));
            if (resp.getEntity() == null) return null;
            return org.apache.commons.io.IOUtils.toByteArray(resp.getEntity().getContent());
        }
    } catch (Exception e) {
        System.out.println("fetchWithLogin err: " + e.getMessage());
        return null;
    }
}

// Sesuaikan nama tabbedPane & urutan index tab dengan punyamu
private void refreshSetelahSimpanCatatan() {
    try {
        // Misal nama tabbedPane: TabData
        int idx = TabRawat.getSelectedIndex();

        // Kalau mau kasih tanda sibuk sebentar boleh:
        setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));

        switch (idx) {
            case 0:
                // Tab Ralan
                tampilRalan();
                break;
            case 1:
                // Tab Ranap
                tampilRanap();
                break;
            case 2:
                // Tab Laporan
                tampilLaporan();
                break;
            case 3:
                // Tab Buka Kunci
                tampilBukaKunci();
                break;
            default:
                // Tidak ada yang perlu di-refresh
                break;
        }
    } catch (Exception ex) {
        ex.printStackTrace();
        System.out.println("DEBUG refreshSetelahSimpanCatatan: " + ex.getMessage());
    } finally {
        setCursor(Cursor.getDefaultCursor());
    }
}

private void hitungBelumCodingRalan() {
    int jumlahBelumCoding = 0;

    for (int i = 0; i < tbListPasienRalan.getRowCount(); i++) {
        Object value = tbListPasienRalan.getValueAt(i, 10);
        if (value != null && "Belum Coding".equalsIgnoreCase(value.toString().trim())) {
            jumlahBelumCoding++;
        }
    }

    LCountBelum.setText(String.valueOf(jumlahBelumCoding));
}

