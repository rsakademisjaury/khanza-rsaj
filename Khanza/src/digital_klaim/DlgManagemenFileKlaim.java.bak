    private void ppBuatCatatanActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_ppBuatCatatanActionPerformed
    String noSEP = null;

    // 1. Ambil No. SEP dari baris terpilih (boleh pakai WAIT_CURSOR sebentar saja)
    try {
        setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
        noSEP = getSelectedNoSEPFromRalanOrRanap();
    } catch (Exception ex) {
        ex.printStackTrace();
        javax.swing.JOptionPane.showMessageDialog(
            this,
            "Gagal mengambil No. SEP: " + ex.getMessage()
        );
    } finally {
        setCursor(Cursor.getDefaultCursor());
    }

    if (noSEP == null || noSEP.trim().isEmpty()) {
        javax.swing.JOptionPane.showMessageDialog(
            this,
            "Silakan pilih dulu data pasien (Ralan atau Ranap)."
        );
        return;
    }
    noSEP = noSEP.trim();

    try {
        // 2. Tentukan owner WINDOW (bukan JInternalFrame)
        java.awt.Window owner = javax.swing.SwingUtilities.getWindowAncestor(this);
        if (owner == null && internalFrame1 != null) {
            owner = javax.swing.SwingUtilities.getWindowAncestor(internalFrame1);
        }

        // 3. Konfigurasi dialog
        InputCatatan.setModal(true);
        InputCatatan.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
        InputCatatan.setTitle("Catatan Kelengkapan Berkas — SEP: " + noSEP);

        // 4. Isi field No. SEP di dialog
        try {
            // pastikan ini adalah field SEP di dalam JDialog
            SEP.setText(noSEP);
            SEP.setEditable(false);
            SEP.setCaretPosition(0);
        } catch (Exception ignore) {
            // fallback kalau komponen SEP agak nyeleneh
            if (javax.swing.SwingUtilities.isDescendingFrom(SEP, InputCatatan.getContentPane())) {
                SEP.setText(noSEP);
                SEP.setEditable(false);
                SEP.setCaretPosition(0);
            }
        }

        // 5. Reset / prefill catatan (pilih salah satu sesuai kebutuhan)

        // a) Reset kosong setiap buka dialog:
//        TextCatatan.setText("");

        // b) (OPSIONAL) Prefill catatan lama kalau ada:
        
        try {
            String catatanLama = Sequel.cariIsi(
                "SELECT catatan FROM inacbg_catatan_berkas WHERE no_sep=?",
                noSEP
            );
            TextCatatan.setText(catatanLama);
            TextCatatan.setCaretPosition(TextCatatan.getText().length());
        } catch (Exception exPrefill) {
            exPrefill.printStackTrace();
        }
        

        // 6. Ukuran & posisi dialog
        try {
            InputCatatan.pack();
        } catch (Exception ignore) {}

        if (InputCatatan.getWidth() < 600 || InputCatatan.getHeight() < 380) {
            InputCatatan.setSize(800, 400);
        }

        if (owner != null) {
            InputCatatan.setLocationRelativeTo(owner);
        } else {
            InputCatatan.setLocationRelativeTo(null);
        }

        // 7. Fokuskan ke TextCatatan segera setelah dialog muncul
        java.awt.EventQueue.invokeLater(() -> {
            TextCatatan.requestFocusInWindow();
        });

        // 8. Tampilkan dialog (TANPA WAIT_CURSOR)
        InputCatatan.toFront();
        InputCatatan.setVisible(true);   // modal, tapi tidak mengunci kursor sibuk

    } catch (Exception e) {
        e.printStackTrace();
        javax.swing.JOptionPane.showMessageDialog(
            this,
            "Gagal membuka dialog catatan: " + e.getMessage()
        );
    }
    }//GEN-LAST:event_ppBuatCatatanActionPerformed

