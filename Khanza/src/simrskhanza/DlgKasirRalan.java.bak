            Valid.editTable(tabModekasir,"reg_periksa","no_rawat",TNoRw,"status_poli='Baru'");
            if(tbKasirRalan.getSelectedRow()>-1){
                tabModekasir.setValueAt("Baru",tbKasirRalan.getSelectedRow(),16);
            }
        }
