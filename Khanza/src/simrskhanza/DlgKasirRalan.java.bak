    /**
     * Tambahan menu manual: Bridging > Rujukan Rawat Jalan Satu Sehat.
     * Dibuat manual agar tidak mengganggu source GUI Builder NetBeans.
     */
    private void initMenuRujukanSatuSehatRalan() {
        javax.swing.JMenuItem ppRujukanSatuSehatRalan = new javax.swing.JMenuItem();
        ppRujukanSatuSehatRalan.setBackground(new java.awt.Color(255, 255, 254));
        ppRujukanSatuSehatRalan.setFont(new java.awt.Font("Tahoma", 0, 11));
        ppRujukanSatuSehatRalan.setForeground(new java.awt.Color(50, 50, 50));
        ppRujukanSatuSehatRalan.setIcon(IKON_CATEGORY_KASIR);
        ppRujukanSatuSehatRalan.setText("Rujukan Rawat Jalan Satu Sehat");
        ppRujukanSatuSehatRalan.setHorizontalAlignment(javax.swing.SwingConstants.LEFT);
        ppRujukanSatuSehatRalan.setHorizontalTextPosition(javax.swing.SwingConstants.RIGHT);
        ppRujukanSatuSehatRalan.setName("ppRujukanSatuSehatRalan");
        ppRujukanSatuSehatRalan.setPreferredSize(new java.awt.Dimension(320, 26));
        ppRujukanSatuSehatRalan.addActionListener(new java.awt.event.ActionListener() {
            public void actionPerformed(java.awt.event.ActionEvent evt) {
                ppRujukanSatuSehatRalanActionPerformed(evt);
            }
        });
        try {
            MnBridging.insert(ppRujukanSatuSehatRalan, 2); // tepat setelah Data SEP BPJS
        } catch (Exception e) {
            MnBridging.add(ppRujukanSatuSehatRalan);
        }
    }

    private void ppRujukanSatuSehatRalanActionPerformed(java.awt.event.ActionEvent evt) {
        if (tabModekasir.getRowCount() == 0) {
            JOptionPane.showMessageDialog(null, "Maaf, data pasien masih kosong...!!!!");
            TCari.requestFocus();
            return;
        }
        if (tbKasirRalan.getSelectedRow() == -1) {
            JOptionPane.showMessageDialog(null, "Maaf, silahkan pilih pasien rawat jalan yang akan dibuatkan rujukan...!!!!");
            tbKasirRalan.requestFocus();
            return;
        }

        this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
        try {
            int row = tbKasirRalan.getSelectedRow();
            String noRawat = nilaiTabel(tbKasirRalan, row, 11);
            String noRm = nilaiTabel(tbKasirRalan, row, 2);
            String namaPasien = nilaiTabel(tbKasirRalan, row, 3);
            String kdDokter = nilaiTabel(tbKasirRalan, row, 0);
            String kdPoliRs = nilaiTabel(tbKasirRalan, row, 18);
            String nmPoli = nilaiTabel(tbKasirRalan, row, 4);
            String noSep = nilaiTabel(tbKasirRalan, row, 20);

            if (noRawat.trim().equals("")) {
                JOptionPane.showMessageDialog(null, "No.Rawat tidak ditemukan dari baris yang dipilih.");
                return;
            }
            if (noSep.trim().equals("")) {
                noSep = Sequel.cariIsi("select bridging_sep.no_sep from bridging_sep where bridging_sep.no_rawat=? order by bridging_sep.tglsep desc limit 1", noRawat);
            }
            if (noSep.trim().equals("")) {
                JOptionPane.showMessageDialog(null, "No.SEP belum ditemukan untuk No.Rawat : " + noRawat + "\nSilahkan buat/buka Data SEP terlebih dahulu.");
                return;
            }

            String kdPenyakit = Sequel.cariIsi(
                    "select diagnosa_pasien.kd_penyakit from diagnosa_pasien where diagnosa_pasien.no_rawat=? and diagnosa_pasien.status='Ralan' order by diagnosa_pasien.prioritas asc limit 1",
                    noRawat);
            if (kdPenyakit.trim().equals("")) {
                kdPenyakit = Sequel.cariIsi(
                        "select diagnosa_pasien.kd_penyakit from diagnosa_pasien where diagnosa_pasien.no_rawat=? order by diagnosa_pasien.prioritas asc limit 1",
                        noRawat);
            }
            String nmPenyakit = "";
            if (!kdPenyakit.trim().equals("")) {
                nmPenyakit = Sequel.cariIsi("select penyakit.nm_penyakit from penyakit where penyakit.kd_penyakit=?", kdPenyakit);
            }

            String kdPoliBpjs = Sequel.cariIsi("select maping_poli_bpjs.kd_poli_bpjs from maping_poli_bpjs where maping_poli_bpjs.kd_poli_rs=?", kdPoliRs);
            if (kdPoliBpjs.trim().equals("")) {
                kdPoliBpjs = kdPoliRs;
            }

            BPJSRujukanSatuSehat dlg = new BPJSRujukanSatuSehat(null, false);
            dlg.setDataSEP(noSep, noRawat, noRm, namaPasien, kdPenyakit, nmPenyakit, kdPoliBpjs, nmPoli, kdDokter);
            dlg.setSize(internalFrame1.getWidth() - 20, internalFrame1.getHeight() - 20);
            dlg.setLocationRelativeTo(internalFrame1);
            dlg.setVisible(true);
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(null, "Gagal membuka form Rujukan Rawat Jalan Satu Sehat:\n" + ex.getMessage());
            ex.printStackTrace();
        } finally {
            this.setCursor(Cursor.getDefaultCursor());
        }
    }

    private String nilaiTabel(javax.swing.JTable tabel, int row, int col) {
        try {
            Object nilai = tabel.getValueAt(row, col);
            return nilai == null ? "" : nilai.toString();
        } catch (Exception e) {
            return "";
        }
    }
