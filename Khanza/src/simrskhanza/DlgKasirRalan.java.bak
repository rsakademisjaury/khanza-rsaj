private void MnSudahActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_MnSudahActionPerformed
    if (tbKasirRalan.getSelectedRow() == -1) {
        JOptionPane.showMessageDialog(rootPane, "Pilih data terlebih dahulu.");
        return;
    }

    String noRawat = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 11).toString();

    boolean isAdminUtama = akses.getkode().equals("Admin Utama");
    boolean isBPJ = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 17).toString().equals("BPJ");
                    
    // Validasi jika bukan admin utama dan pasien BPJS, cek apakah SEP sudah diterbitkan
    if (!isAdminUtama && isBPJ) {
        if (Sequel.cariInteger("SELECT COUNT(bs.no_sep) FROM bridging_sep bs WHERE bs.no_rawat = ?", noRawat) == 0) {
            JOptionPane.showMessageDialog(rootPane, "Maaf, SEP belum diterbitkan, mohon hubungi Admisi.");
            return;
        }
    }

//    // Validasi jika bukan admin utama dan pasien BPJS, cek apakah pasien sudah dipanggil
//    if (!isAdminUtama && isBPJ) {
//        if (Sequel.cariInteger("SELECT COUNT(antripoli.no_rawat) FROM antripoli WHERE antripoli.no_rawat = ?", noRawat) == 0) {
//            JOptionPane.showMessageDialog(rootPane, "Maaf, klik Panggil Pasien terlebih dahulu sebelum set status sudah.");
//            return;
//        }
//    }
    
    // Validasi apakah TNoRw kosong
    if (TNoRw.getText().trim().equals("")) {
        Valid.textKosong(TNoRw, "No.Rawat");
        return;
    }

    // Cek apakah pasien sudah masuk Kamar Inap
    if (Sequel.cariInteger("SELECT COUNT(kamar_inap.no_rawat) FROM kamar_inap WHERE kamar_inap.no_rawat = ?", TNoRw.getText()) > 0) {
        JOptionPane.showMessageDialog(null, "Maaf, Pasien sudah masuk Kamar Inap. Gunakan billing Ranap.");
        return;
    }
    
    // Ubah status menjadi "Sudah" dan simpan perubahan
    if (Valid.editTabletf(tabModekasir, "reg_periksa", "no_rawat", TNoRw, "stts='Sudah'")) {
        tabModekasir.setValueAt("Sudah", tbKasirRalan.getSelectedRow(), 10);
        Sequel.menyimpan(
            "mutasi_berkas",
            "'" + TNoRw.getText() + "','Sudah Kembali',NOW(),'0000-00-00 00:00:00',NOW(),'0000-00-00 00:00:00','0000-00-00 00:00:00'",
            "status='Sudah Kembali',kembali=NOW()",
            "no_rawat='" + TNoRw.getText() + "'"
        );
    }

//if (Sequel.cariInteger("SELECT COUNT(antripoli.no_rawat) FROM antripoli WHERE antripoli.no_rawat = ?", tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 11).toString()) == 0) {
//            JOptionPane.showMessageDialog(rootPane, "Maaf, klik Panggil Pasien terlebih dahulu sebelum melakukan pengisian SOAP / Tindakan.!!");
//}
//    if(TNoRw.getText().trim().equals("")){
//            Valid.textKosong(TNoRw,"No.Rawat");
//        }else{
//            if(Sequel.cariInteger("select count(kamar_inap.no_rawat) from kamar_inap where kamar_inap.no_rawat=?",TNoRw.getText())>0){
//                JOptionPane.showMessageDialog(null,"Maaf, Pasien sudah masuk Kamar Inap. Gunakan billing Ranap..!!!");
//            }else {
//                if(tbKasirRalan.getSelectedRow()>-1){
//                    if(Valid.editTabletf(tabModekasir,"reg_periksa","no_rawat",TNoRw,"stts='Sudah'")==true){
//                        tabModekasir.setValueAt("Sudah",tbKasirRalan.getSelectedRow(),10);
//                        Sequel.menyimpan("mutasi_berkas","'"+TNoRw.getText()+"','Sudah Kembali',now(),'0000-00-00 00:00:00',now(),'0000-00-00 00:00:00','0000-00-00 00:00:00'","status='Sudah Kembali',kembali=now()","no_rawat='"+TNoRw.getText()+"'");
//                    }
//                }
//            }            
//        }
}//GEN-LAST:event_MnSudahActionPerformed

private void MnBelumActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_MnBelumActionPerformed
       if(TNoRw.getText().trim().equals("")){
            Valid.textKosong(TNoRw,"No.Rawat");
        }else{
           if(Sequel.cariInteger("select count(kamar_inap.no_rawat) from kamar_inap where kamar_inap.no_rawat=?",TNoRw.getText())>0){
                JOptionPane.showMessageDialog(null,"Maaf, Pasien sudah masuk Kamar Inap. Gunakan billing Ranap..!!!");
           }else {
                Valid.editTable(tabModekasir,"reg_periksa","no_rawat",TNoRw,"stts='Belum'");
                if(tbKasirRalan.getSelectedRow()>-1){
                    tabModekasir.setValueAt("Belum",tbKasirRalan.getSelectedRow(),10);
                }
           }
            
        }
}//GEN-LAST:event_MnBelumActionPerformed

private void MnDataRalanActionPerformed(java.awt.event.ActionEvent evt) {                                            
    final long perfKlikRawatJalan = System.nanoTime();
    if (tabModekasir.getRowCount() == 0) {
        JOptionPane.showMessageDialog(null, "Maaf, table masih kosong...!!!!");
        TCari.requestFocus();
    } else {
        if (tbKasirRalan.getSelectedRow() != -1) {
            if (Sequel.cariInteger("select count(kamar_inap.no_rawat) from kamar_inap where kamar_inap.no_rawat=?", TNoRw.getText()) > 0) {
                JOptionPane.showMessageDialog(null, "Maaf, Pasien sudah masuk Kamar Inap. Gunakan billing Ranap..!!!");
                return; // Tambahkan return untuk menghentikan eksekusi
            } 
            
            if (Sequel.cariInteger("select count(reg_periksa.no_rawat) from reg_periksa where reg_periksa.no_rawat=? and reg_periksa.stts = 'Batal'", TNoRw.getText()) > 0) {
                JOptionPane.showMessageDialog(null, "Maaf, Pasien Batal Periksa..!!!");
                return; // Tambahkan return untuk menghentikan eksekusi
            } 
            
            if (Sequel.cariInteger("SELECT COUNT(rs.id) FROM rsaj_setting rs WHERE rs.id = '1' AND rs.status = '1'") > 0) {
                boolean isAdminUtama = akses.getkode().equals("Admin Utama");
                boolean isBPJ = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 17).toString().equals("BPJ");

                // Melakukan pengecekan lainnya
                if (!isAdminUtama && isBPJ) {
                    if (Sequel.cariInteger("SELECT COUNT(bs.no_sep) FROM bridging_sep bs WHERE bs.no_rawat = '" + tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 11).toString() + "'") == 0) {
                        JOptionPane.showMessageDialog(rootPane, "Maaf, SEP belum diterbitkan, mohon hubungi Admisi ..!!");
                        return;
                    }
                }

//                if (!isAdminUtama && isBPJ) {
//                    if (Sequel.cariInteger("SELECT COUNT(antripoli.no_rawat) FROM antripoli WHERE antripoli.no_rawat = ?", tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 11).toString()) == 0) {
//                        JOptionPane.showMessageDialog(rootPane, "Maaf, klik Panggil Pasien terlebih dahulu sebelum melakukan pengisian SOAP / Tindakan.!!");
//                        return;
//                    }
//                }

                // PATCH PERFORMA RSAJ - ambil instance sekali agar jalur pembukaan konsisten
                // dan tidak memanggil accessor berulang pada satu aksi.
                System.out.println("[PERFORMA BUKA RAWAT JALAN] Pra-form/validasi: "+
                        ((System.nanoTime()-perfKlikRawatJalan)/1_000_000L)+" ms");

                long perfTahapRawatJalan = System.nanoTime();
                final DlgRawatJalan rawatJalan = getRawatJalan();
                System.out.println("[PERFORMA BUKA RAWAT JALAN] getRawatJalan/constructor: "+
                        ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                perfTahapRawatJalan = System.nanoTime();
                rawatJalan.isCek();
                System.out.println("[PERFORMA BUKA RAWAT JALAN] isCek: "+
                        ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                perfTahapRawatJalan = System.nanoTime();
                rawatJalan.emptTeks();
                System.out.println("[PERFORMA BUKA RAWAT JALAN] emptTeks: "+
                        ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                perfTahapRawatJalan = System.nanoTime();
                rawatJalan.setSize(internalFrame1.getWidth() - 20, internalFrame1.getHeight() - 20);
                rawatJalan.setLocationRelativeTo(internalFrame1);
                System.out.println("[PERFORMA BUKA RAWAT JALAN] size/location: "+
                        ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                perfTahapRawatJalan = System.nanoTime();
                rawatJalan.SetPoli(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 18).toString());
                rawatJalan.SetPj(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 17).toString());
                System.out.println("[PERFORMA BUKA RAWAT JALAN] SetPoli/SetPj: "+
                        ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                perfTahapRawatJalan = System.nanoTime();
                rawatJalan.setNoRm(TNoRw.getText(), DTPCari1.getDate(), DTPCari2.getDate());
                System.out.println("[PERFORMA BUKA RAWAT JALAN] setNoRm: "+
                        ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                perfTahapRawatJalan = System.nanoTime();
                rawatJalan.setVisible(true);
                System.out.println("[PERFORMA BUKA RAWAT JALAN] setVisible: "+
                        ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");
                System.out.println("[PERFORMA BUKA RAWAT JALAN] TOTAL sinkron klik->setVisible selesai: "+
                        ((System.nanoTime()-perfKlikRawatJalan)/1_000_000L)+" ms");
                javax.swing.SwingUtilities.invokeLater(new Runnable() {
                    @Override
                    public void run() {
                        System.out.println("[PERFORMA BUKA RAWAT JALAN] TOTAL klik->EDT/render berikutnya: "+
                                ((System.nanoTime()-perfKlikRawatJalan)/1_000_000L)+" ms");
                    }
                });
            }
        }
    }
}                                           

private void bukaRiwayatICare() {
        if(tabModekasir.getRowCount()==0){
            JOptionPane.showMessageDialog(null,"Maaf, table masih kosong...!!!!");
            TCari.requestFocus();
        }else if(TNoRw.getText().trim().equals("")){
            JOptionPane.showMessageDialog(null,"Maaf, Silahkan anda pilih dulu dengan menklik data pada table...!!!");
            tbKasirRalan.requestFocus();
        }else{
            if(tbKasirRalan.getSelectedRow()!= -1){
                this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
                variabel=Sequel.cariIsi("select maping_dokter_dpjpvclaim.kd_dokter_bpjs from maping_dokter_dpjpvclaim where maping_dokter_dpjpvclaim.kd_dokter=?",tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),0).toString());
                if(!variabel.equals("")){
                    akses.setform("DlgReg");
                    ICareRiwayatPerawatan dlgki=new ICareRiwayatPerawatan(null,false);
                    dlgki.setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
                    dlgki.setLocationRelativeTo(internalFrame1);
                    dlgki.setPasien(Sequel.cariIsi("select pasien.no_ktp from pasien where pasien.no_rkm_medis=?",TNoRMCari.getText()),variabel);   
                    dlgki.setVisible(true);
                }else{
                    JOptionPane.showMessageDialog(null,"Maaf, Dokter tidak terdaftar di mapping dokter BPJS...!!!");  
                }
                this.setCursor(Cursor.getDefaultCursor());
            }
        }
}

