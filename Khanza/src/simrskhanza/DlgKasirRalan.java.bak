private void tampilkasir() {
    if(sedangMemuatData){
        return;
    }

    sedangMemuatData=true;
    batalkanCekStatusHasilPenunjangKasir();
    cacheStatusHasilPenunjangKasir.clear();
    Valid.tabelKosong(tabModekasir);

    // Semua nilai Swing diambil di EDT sebelum worker berjalan.
    final String tanggalAwal=Valid.SetTgl(DTPCari1.getSelectedItem()+"");
    final String tanggalAkhir=Valid.SetTgl(DTPCari2.getSelectedItem()+"");
    final String penjabSaatIni=caripenjab;
    final String poliSaatIni=CrPoli.getText().trim();
    final String dokterSaatIni=CrPtg.getText().trim();
    final String statusSaatIni=cmbStatus.getSelectedItem().toString();
    final String statusBayarSaatIni=cmbStatusBayar.getSelectedItem().toString();
    final String kataCari=TCari.getText().trim();
    final String diagnosaSaatIni=tampildiagnosa;
    final String sepSaatIni=terbitsep;
    final String urutanSaatIni=order;
    final boolean semuaSaatIni=penjabSaatIni.equals("") &&
            poliSaatIni.equals("") &&
            dokterSaatIni.equals("") &&
            statusSaatIni.equals("Semua") &&
            statusBayarSaatIni.equals("Semua") &&
            kataCari.equals("");
    final long mulaiMuat=System.nanoTime();

    new SwingWorker<Void,Object[]>() {
        private int jumlahBaris=0;

        @Override
        protected Void doInBackground() {
            PreparedStatement perintah=null;
            ResultSet hasil=null;
            try {
                perintah=koneksi.prepareStatement(
                    "select DISTINCT reg_periksa.no_reg,"
                    + "reg_periksa.no_rawat,"
                    + "reg_periksa.tgl_registrasi,"
                    + "reg_periksa.jam_reg,"
                    + "reg_periksa.kd_dokter,"
                    + "dokter.nm_dokter,"
                    + "reg_periksa.no_rkm_medis,"
                    + "pasien.nm_pasien,"
                    + "poliklinik.nm_poli,"
                    + "reg_periksa.p_jawab,"
                    + "reg_periksa.almt_pj,"
                    + "reg_periksa.hubunganpj,"
                    + "reg_periksa.biaya_reg,"
                    + "reg_periksa.stts,"
                    + "penjab.png_jawab,"
                    + "concat(reg_periksa.umurdaftar,' ',reg_periksa.sttsumur) as umur,"
                    + "reg_periksa.status_bayar,"
                    + "reg_periksa.status_poli,"
                    + "reg_periksa.kd_pj,"
                    + "reg_periksa.kd_poli,"
                    + "pasien.no_tlp,"
                    + "bsr.no_sep,"
                    + "DATE_FORMAT(pasien.tgl_lahir,'%d-%m-%Y') AS tgl_lahir,"
                    + "IF(rmb.validasi='0000-00-00 00:00:00','Belum Check In',IF(rmb.validasi IS NULL,"
                    + "CONCAT(reg_periksa.tgl_registrasi,' ',reg_periksa.jam_reg,' - Antrian Onsite'),"
                    + "CONCAT(rmb.validasi,' - Antrian MJKN'))) AS jam_checkin,"
                    + "IF(rsm.no_rawat IS NULL,'Tidak Ada','Ada') AS status_resume,"
                    + "IF(reg_periksa.kd_pj='BPJ',IF(sdk.no_rawat IS NULL,'Belum Sidik Jari',sdk.jam_val),'-') AS jam_sidik_jari,"
                    + "IF(reg_periksa.kd_pj='BPJ',IF(rbsr.no_rawat IS NULL,'Belum Ada Data',rbsr.waktu),'-') AS jam_sep,"
                    + "latest_rujukan.tglrujukan_terbaru AS tgl_rujukan,"
                    + "CONCAT(DATEDIFF(DATE_SUB(DATE_ADD(latest_rujukan.tglrujukan_terbaru,INTERVAL 3 MONTH),INTERVAL 3 DAY),CURDATE()),"
                    + "' Hari - ',DATE_FORMAT(DATE_SUB(DATE_ADD(latest_rujukan.tglrujukan_terbaru,INTERVAL 3 MONTH),INTERVAL 3 DAY),'%d/%m/%Y')) AS info_habis_rujukan,"
                    + "pasien.no_peserta "
                    + "FROM reg_periksa "
                    + "inner join dokter on reg_periksa.kd_dokter=dokter.kd_dokter "
                    + "inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis "
                    + "inner join poliklinik on reg_periksa.kd_poli=poliklinik.kd_poli "
                    + "inner join penjab on reg_periksa.kd_pj=penjab.kd_pj "
                    + "LEFT JOIN (SELECT bs.no_rawat,MAX(bs.no_sep) AS no_sep FROM bridging_sep bs "
                    + "WHERE bs.jnspelayanan='2' GROUP BY bs.no_rawat) bsr ON bsr.no_rawat=reg_periksa.no_rawat "
                    + "LEFT JOIN (SELECT no_rawat,norm,MAX(validasi) AS validasi FROM referensi_mobilejkn_bpjs "
                    + "WHERE status NOT IN ('Batal','Gagal') AND tanggalperiksa BETWEEN ? and ? "
                    + "GROUP BY no_rawat,norm) rmb ON reg_periksa.no_rawat=rmb.no_rawat "
                    + "AND reg_periksa.no_rkm_medis=rmb.norm "
                    + "LEFT JOIN (SELECT rs.no_rawat,rs.kd_dokter FROM resume_pasien rs) rsm "
                    + "ON reg_periksa.no_rawat=rsm.no_rawat and reg_periksa.kd_dokter=rsm.kd_dokter "
                    + "LEFT JOIN (SELECT sj.no_rawat,MAX(sj.validasi) AS jam_val FROM sidik_jari_bpjs sj "
                    + "WHERE sj.validasi>=? AND sj.validasi<DATE_ADD(?,INTERVAL 1 DAY) GROUP BY sj.no_rawat) sdk "
                    + "ON reg_periksa.no_rawat=sdk.no_rawat "
                    + "LEFT JOIN (SELECT rbs.no_rawat,MAX(rbs.no_sep) AS no_sep,MAX(rbs.waktu) AS waktu "
                    + "FROM sep_bpjs rbs WHERE rbs.jnspelayanan='2' GROUP BY rbs.no_rawat) rbsr "
                    + "ON rbsr.no_rawat=reg_periksa.no_rawat "
                    + "LEFT JOIN (SELECT no_rawat,MAX(tglrujukan) AS tglrujukan_terbaru FROM bridging_sep "
                    + "GROUP BY no_rawat) latest_rujukan ON reg_periksa.no_rawat=latest_rujukan.no_rawat "
                    + "WHERE reg_periksa.tgl_registrasi between ? and ? "
                    + "and reg_periksa.status_lanjut='Ralan' "
                    + diagnosaSaatIni
                    + (semuaSaatIni ? "" :
                        "and reg_periksa.kd_pj like ? and "
                      + "poliklinik.nm_poli like ? and "
                      + "dokter.nm_dokter like ? and "
                      + "reg_periksa.stts like ? and "
                      + "reg_periksa.status_bayar like ? and "
                      + "(reg_periksa.no_reg like ? or reg_periksa.no_rawat like ? or "
                      + "reg_periksa.tgl_registrasi like ? or reg_periksa.kd_dokter like ? or "
                      + "dokter.nm_dokter like ? or reg_periksa.no_rkm_medis like ? or "
                      + "pasien.nm_pasien like ? or poliklinik.nm_poli like ? or "
                      + "reg_periksa.p_jawab like ? or penjab.png_jawab like ? or "
                      + "reg_periksa.almt_pj like ? or reg_periksa.status_bayar like ? or "
                      + "reg_periksa.hubunganpj like ?) ")
                    + sepSaatIni
                    + " order by "+urutanSaatIni
                );

                perintah.setString(1,tanggalAwal);
                perintah.setString(2,tanggalAkhir);
                perintah.setString(3,tanggalAwal);
                perintah.setString(4,tanggalAkhir);
                perintah.setString(5,tanggalAwal);
                perintah.setString(6,tanggalAkhir);

                if(!semuaSaatIni){
                    perintah.setString(7,"%"+penjabSaatIni+"%");
                    perintah.setString(8,"%"+poliSaatIni+"%");
                    perintah.setString(9,"%"+dokterSaatIni+"%");
                    perintah.setString(10,"%"+statusSaatIni.replaceAll("Semua","")+"%");
                    perintah.setString(11,"%"+statusBayarSaatIni.replaceAll("Semua","")+"%");
                    for(int nomorParameter=12;nomorParameter<=24;nomorParameter++){
                        perintah.setString(nomorParameter,"%"+kataCari+"%");
                    }
                }

                hasil=perintah.executeQuery();
                while(hasil.next()){
                    jumlahBaris++;
                    publish(new Object[]{
                        hasil.getString(5),
                        hasil.getString(6),
                        hasil.getString(7),
                        hasil.getString(8)+" ("+hasil.getString("umur")+")",
                        hasil.getString(9),
                        hasil.getString(10),
                        hasil.getString(11),
                        hasil.getString(12),
                        Valid.SetAngka(hasil.getDouble(13)),
                        hasil.getString("png_jawab"),
                        hasil.getString(14),
                        hasil.getString("no_rawat"),
                        hasil.getString("tgl_registrasi"),
                        hasil.getString("tgl_registrasi")+" "+hasil.getString("jam_reg"),
                        hasil.getString("no_reg"),
                        hasil.getString("status_bayar"),
                        hasil.getString("status_poli"),
                        hasil.getString("kd_pj"),
                        hasil.getString("kd_poli"),
                        hasil.getString("no_tlp"),
                        hasil.getString("no_sep"),
                        hasil.getString("tgl_lahir"),
                        hasil.getString("jam_checkin"),
                        hasil.getString("status_resume"),
                        hasil.getString("jam_sidik_jari"),
                        hasil.getString("jam_sep"),
                        hasil.getString("tgl_rujukan"),
                        hasil.getString("info_habis_rujukan"),
                        hasil.getString("no_peserta")
                    });
                }
            } catch(Exception e){
                System.out.println("Notifikasi muat Rawat Jalan : "+e);
            } finally {
                try{
                    if(hasil!=null){
                        hasil.close();
                    }
                    if(perintah!=null){
                        perintah.close();
                    }
                }catch(Exception e){
                    System.out.println("Notifikasi tutup query Rawat Jalan : "+e);
                }
            }
            return null;
        }

        @Override
        protected void process(List<Object[]> data) {
            for(Object[] baris:data){
                tabModekasir.addRow(baris);
            }
            LCount.setText(""+tabModekasir.getRowCount());
        }

        @Override
        protected void done() {
            sedangMemuatData=false;
            LCount.setText(""+jumlahBaris);
            refreshTombolHasilLabRadKasir();
            System.out.println("[PERFORMA MODUL] Data Rawat Jalan selesai dalam "+
                    ((System.nanoTime()-mulaiMuat)/1_000_000L)+" ms ("+jumlahBaris+" baris)");
        }
    }.execute();
}
    
    private void tampilkasir2() {         
        Valid.tabelKosong(tabModekasir2);
    try {
        semua = CrPoli.getText().trim().equals("") && CrPtg.getText().trim().equals("") &&
                cmbStatus.getSelectedItem().toString().equals("Semua") && TCari.getText().trim().equals("");
        
        String query = "SELECT DISTINCT reg_periksa.no_rawat, reg_periksa.no_reg," +
                       "DATE_FORMAT(reg_periksa.tgl_registrasi, '%d-%m-%Y') AS tgl_registrasi," +
                       "reg_periksa.jam_reg, konsultasi_medik.kd_dokter_dikonsuli, dokter.nm_dokter, " +
                       "reg_periksa.no_rkm_medis, pasien.nm_pasien, poliklinik.nm_poli, " +
                       "jadwal.kd_poli, reg_periksa.p_jawab, reg_periksa.almt_pj, reg_periksa.hubunganpj, " +
                       "reg_periksa.biaya_reg, reg_periksa.status_bayar, reg_periksa.status_poli, reg_periksa.stts, " +
                       "penjab.png_jawab, CONCAT(reg_periksa.umurdaftar, ' ', reg_periksa.sttsumur) AS umur, " +
                       "reg_periksa.kd_pj, pasien.no_tlp, bridging_sep.no_sep, " +
                       "CASE WHEN jawaban_konsultasi_medik.no_permintaan IS NULL THEN 'Belum dijawab' ELSE 'Sudah dijawab' END AS `Status Jawab` " +
                       "FROM reg_periksa " +
                       "INNER JOIN konsultasi_medik ON konsultasi_medik.no_rawat = reg_periksa.no_rawat " +
                       "LEFT JOIN jadwal ON konsultasi_medik.kd_dokter_dikonsuli = jadwal.kd_dokter " +
                       "LEFT JOIN poliklinik ON jadwal.kd_poli = poliklinik.kd_poli " +
                       "INNER JOIN dokter ON konsultasi_medik.kd_dokter_dikonsuli = dokter.kd_dokter " +
                       "INNER JOIN pasien ON reg_periksa.no_rkm_medis = pasien.no_rkm_medis " +
                       "INNER JOIN penjab ON reg_periksa.kd_pj = penjab.kd_pj " +
                       "LEFT JOIN bridging_sep ON reg_periksa.no_rawat = bridging_sep.no_rawat " +
                       "LEFT JOIN jawaban_konsultasi_medik ON konsultasi_medik.no_permintaan = jawaban_konsultasi_medik.no_permintaan " +
                       "WHERE reg_periksa.status_lanjut = 'Ralan' " +
                       "AND reg_periksa.tgl_registrasi BETWEEN ? AND ? ";
        if (!semua) {
            query += "AND poliklinik.nm_poli LIKE ? " +
                     "AND dokter.nm_dokter LIKE ? " +
                     "AND reg_periksa.status_bayar LIKE ? " +
                     "AND (reg_periksa.no_rawat LIKE ? " +
                     "OR reg_periksa.no_rkm_medis LIKE ? " +
                     "OR pasien.nm_pasien LIKE ? " +
                     "OR dokter.nm_dokter LIKE ?)";
        }
        query += " ORDER BY " + order;
        
        pskasir = koneksi.prepareStatement(query);
        int paramIndex = 1; // Awal parameter

        // Set parameter untuk tgl_registrasi
        pskasir.setString(paramIndex++, Valid.SetTgl(DTPCari1.getSelectedItem() + ""));
        pskasir.setString(paramIndex++, Valid.SetTgl(DTPCari2.getSelectedItem() + ""));

        // Set parameter tambahan jika semua == false
        if (!semua) {
            pskasir.setString(paramIndex++, "%" + CrPoli.getText().trim() + "%");       // Poliklinik
            pskasir.setString(paramIndex++, "%" + CrPtg.getText().trim() + "%");        // Dokter
            pskasir.setString(paramIndex++, "%" + cmbStatus.getSelectedItem().toString().replaceAll("Semua", "") + "%"); // Status Bayar
            pskasir.setString(paramIndex++, "%" + TCari.getText().trim() + "%");        // no_rawat
            pskasir.setString(paramIndex++, "%" + TCari.getText().trim() + "%");        // no_rkm_medis
            pskasir.setString(paramIndex++, "%" + TCari.getText().trim() + "%");        // nm_pasien
            pskasir.setString(paramIndex++, "%" + TCari.getText().trim() + "%");        // nm_dokter
        }
        rskasir = pskasir.executeQuery();
            
        Set<String> existingData = new HashSet<>();
        while (rskasir.next()) {
            String uniqueKey = rskasir.getString("no_rawat");
            if (!existingData.contains(uniqueKey)) {
                tabModekasir2.addRow(new String[] {                 
                    rskasir.getString("kd_dokter_dikonsuli"),
                    rskasir.getString("nm_dokter"),
                    rskasir.getString("no_rkm_medis"),
                    rskasir.getString("nm_pasien") + " (" + rskasir.getString("umur") + ")",
                    rskasir.getString("nm_poli"),
                    rskasir.getString("p_jawab"),
                    rskasir.getString("almt_pj"),
                    rskasir.getString("hubunganpj"),
                    rskasir.getString("biaya_reg"),
                    rskasir.getString("png_jawab"),
                    rskasir.getString("stts"),
                    rskasir.getString("no_rawat"),
                    rskasir.getString("tgl_registrasi"),
                    rskasir.getString("jam_reg"),
                    rskasir.getString("no_reg"),
                    rskasir.getString("status_bayar"),
                    rskasir.getString("status_poli"),
                    rskasir.getString("kd_pj"),
                    rskasir.getString("kd_poli"),
                    rskasir.getString("no_tlp"),                    
                    rskasir.getString("Status Jawab")
                });
                existingData.add(uniqueKey);
            }
        }
    } catch (Exception e) {
        System.out.println("Notifikasi : " + e);
    }
    LCount.setText("" + tabModekasir2.getRowCount());
    }

    private void tampilkasir3() {             
    Valid.tabelKosong(tabModekasir3);
    try{   
        semua = CrPoli.getText().trim().equals("") && CrPtg.getText().trim().equals("") && cmbStatus.getSelectedItem().toString().equals("Semua") && TCari.getText().trim().equals("");
        
        pskasir = koneksi.prepareStatement(
            "SELECT reg_periksa.no_rawat, reg_periksa.no_reg, " 
            + "konsultasi_medik.tanggal, "
            + "TIME(konsultasi_medik.tanggal) AS jam, "
            + "konsultasi_medik.kd_dokter_dikonsuli, "
            + "dokter.nm_dokter, "
            + "reg_periksa.no_rkm_medis, "
            + "pasien.nm_pasien, "
            + "poliklinik.nm_poli, "
            + "jadwal.kd_poli, "
            + "reg_periksa.p_jawab, "
            + "reg_periksa.almt_pj, "
            + "reg_periksa.hubunganpj, "
            + "reg_periksa.biaya_reg, "
            + "reg_periksa.status_bayar, "
            + "reg_periksa.stts, "
            + "reg_periksa.status_poli, "
            + "penjab.png_jawab, "
            + "CONCAT(reg_periksa.umurdaftar, ' ', reg_periksa.sttsumur) AS umur, "
            + "reg_periksa.kd_pj, "
            + "pasien.no_tlp, "
            + "IF(jawaban_konsultasi_medik.no_permintaan IS NULL, 'Belum dijawab', 'Sudah dijawab') AS `Status Jawab` "
            + "FROM reg_periksa "
            + "INNER JOIN konsultasi_medik ON konsultasi_medik.no_rawat = reg_periksa.no_rawat "
            + "INNER JOIN dokter ON konsultasi_medik.kd_dokter_dikonsuli = dokter.kd_dokter "
            + "INNER JOIN pasien ON reg_periksa.no_rkm_medis = pasien.no_rkm_medis "
            + "LEFT JOIN jawaban_konsultasi_medik ON jawaban_konsultasi_medik.no_permintaan = konsultasi_medik.no_permintaan "
            + "LEFT JOIN jadwal ON konsultasi_medik.kd_dokter_dikonsuli = jadwal.kd_dokter "
            + "LEFT JOIN poliklinik ON jadwal.kd_poli = poliklinik.kd_poli "
            + "INNER JOIN penjab ON reg_periksa.kd_pj = penjab.kd_pj "
            + "WHERE reg_periksa.status_lanjut = 'Ranap' AND "
            + "konsultasi_medik.tanggal BETWEEN ? AND ? "
            + (semua ? "" : 
                "AND poliklinik.nm_poli LIKE ? AND "
                + "dokter.nm_dokter LIKE ? AND reg_periksa.stts LIKE ? AND "
                + "(reg_periksa.no_reg LIKE ? OR reg_periksa.no_rawat LIKE ? OR konsultasi_medik.tanggal LIKE ? OR konsultasi_medik.kd_dokter_dikonsuli LIKE ? "
                + "OR dokter.nm_dokter LIKE ? OR reg_periksa.no_rkm_medis LIKE ? OR pasien.nm_pasien LIKE ? OR poliklinik.nm_poli LIKE ? "
                + "OR reg_periksa.p_jawab LIKE ? OR penjab.png_jawab LIKE ? OR reg_periksa.almt_pj LIKE ? OR reg_periksa.hubunganpj LIKE ?) ")
            + "ORDER BY " + order);

        try {
            pskasir.setString(1, Valid.SetTgl(DTPCari1.getSelectedItem() + ""));
            pskasir.setString(2, Valid.SetTgl(DTPCari2.getSelectedItem() + ""));
            if (!semua) {
                pskasir.setString(3, "%" + CrPoli.getText() + "%");
                pskasir.setString(4, "%" + CrPtg.getText() + "%");
                pskasir.setString(5, "%" + cmbStatus.getSelectedItem().toString().replaceAll("Semua", "") + "%");
                pskasir.setString(6, "%" + TCari.getText().trim() + "%");
                pskasir.setString(7, "%" + TCari.getText().trim() + "%");
                pskasir.setString(8, "%" + TCari.getText().trim() + "%");
                pskasir.setString(9, "%" + TCari.getText().trim() + "%");
                pskasir.setString(10, "%" + TCari.getText().trim() + "%");
                pskasir.setString(11, "%" + TCari.getText().trim() + "%");
                pskasir.setString(12, "%" + TCari.getText().trim() + "%");
                pskasir.setString(13, "%" + TCari.getText().trim() + "%");
                pskasir.setString(14, "%" + TCari.getText().trim() + "%");
                pskasir.setString(15, "%" + TCari.getText().trim() + "%");
                pskasir.setString(16, "%" + TCari.getText().trim() + "%");
                pskasir.setString(17, "%" + TCari.getText().trim() + "%");
            }
            
            rskasir = pskasir.executeQuery();
            Set<String> uniqueEntries = new HashSet<>();
            
            while (rskasir.next()) {
                String rowKey = rskasir.getString("no_rawat") + "_" + rskasir.getString("tanggal") + "_" + rskasir.getString("jam");
                if (!uniqueEntries.contains(rowKey)) {
                    uniqueEntries.add(rowKey);
                    tabModekasir3.addRow(new String[] {
                        rskasir.getString("kd_dokter_dikonsuli"),
                        rskasir.getString("nm_dokter"),
                        rskasir.getString("no_rkm_medis"),
                        rskasir.getString("nm_pasien") + " (" + rskasir.getString("umur") + ")",
                        rskasir.getString("nm_poli"),
                        rskasir.getString("p_jawab"),
                        rskasir.getString("almt_pj"),
                        rskasir.getString("hubunganpj"),
                        rskasir.getString("biaya_reg"),
                        rskasir.getString("png_jawab"),
                        rskasir.getString("stts"),
                        rskasir.getString("no_rawat"),
                        rskasir.getString("tanggal"),
                        rskasir.getString("jam"),
                        rskasir.getString("no_reg"),
                        rskasir.getString("status_bayar"),
                        rskasir.getString("status_poli"),
                        rskasir.getString("kd_pj"),
                        rskasir.getString("kd_poli"),
                        rskasir.getString("no_tlp"),
                        rskasir.getString("Status Jawab")
                    });
                }
            }                
        } catch (Exception e) {
            System.out.println("Notifikasi : " + e);
        } finally {
            if (rskasir != null) {
                rskasir.close();
            }
            if (pskasir != null) {
                pskasir.close();
            }
        }            
    } catch (Exception e) {
        System.out.println("Notifikasi : " + e);
    }
    LCount.setText("" + tabModekasir3.getRowCount());        
    }

    private void getDatakasir() {
        TSEPCari.setText("");
        RujukanTerbaru.setText("");
        RujukanExpire.setText("");
        NoKartu.setText("");
        if(tbKasirRalan.getSelectedRow()!= -1){
            TNoRw.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),11).toString());
            Tanggal.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),12).toString());
            Jam.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),13).toString());
            TNoRwCari.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),11).toString());
            TNoReg.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),14).toString());
            TNoRMCari.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),2).toString());
            TPasienCari.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),3).toString());
            TSEPCari.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),20).toString());         
            RujukanTerbaru.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),26).toString());
            RujukanExpire.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),27).toString());
            NoKartu.setText(tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),28).toString());
        }
    }

