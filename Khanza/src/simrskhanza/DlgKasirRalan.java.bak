    /**
     * Tombol dibuat di luar NetBeans GUI Builder. Dengan cara ini initComponents()
     * tetap memakai ukuran asli dan tidak memicu error "code too large".
     */
    private void initTombolHasilLabRadKasir() {
        try {
            BtnHasilLabKasir = new widget.Button();
            BtnHasilLabKasir.setText("Lihat Hasil Lab");
            BtnHasilLabKasir.setToolTipText("Lihat seluruh hasil Laboratorium pasien di browser");
            BtnHasilLabKasir.setPreferredSize(new java.awt.Dimension(135, 23));
            java.net.URL iconLab = getClass().getResource("/picture/hasil_lab.png");
            if (iconLab != null) BtnHasilLabKasir.setIcon(new javax.swing.ImageIcon(iconLab));
            BtnHasilLabKasir.addActionListener(new java.awt.event.ActionListener() {
                @Override public void actionPerformed(java.awt.event.ActionEvent evt) {
                    tampilkanHasilPenunjangKasir("005", "Hasil Laboratorium", "periksa_lab");
                }
            });

            BtnHasilRadKasir = new widget.Button();
            BtnHasilRadKasir.setText("Lihat Hasil Rad");
            BtnHasilRadKasir.setToolTipText("Lihat seluruh hasil Radiologi pasien di browser");
            BtnHasilRadKasir.setPreferredSize(new java.awt.Dimension(135, 23));
            java.net.URL iconRad = getClass().getResource("/picture/hasil_rad.png");
            if (iconRad != null) BtnHasilRadKasir.setIcon(new javax.swing.ImageIcon(iconRad));
            BtnHasilRadKasir.addActionListener(new java.awt.event.ActionListener() {
                @Override public void actionPerformed(java.awt.event.ActionEvent evt) {
                    tampilkanHasilPenunjangKasir("006", "Hasil Radiologi", "periksa_radiologi");
                }
            });

            BtnHasilLabKasir.setVisible(false);
            BtnHasilRadKasir.setVisible(false);
            int urutan = panelGlass8.getComponentZOrder(cmbStatusBayar);
            if (urutan >= 0) {
                panelGlass8.add(BtnHasilLabKasir, urutan + 1);
                panelGlass8.add(BtnHasilRadKasir, urutan + 2);
            } else {
                panelGlass8.add(BtnHasilLabKasir);
                panelGlass8.add(BtnHasilRadKasir);
            }
            panelGlass8.revalidate();
            panelGlass8.repaint();
            tbKasirRalan.getSelectionModel().addListSelectionListener(new javax.swing.event.ListSelectionListener() {
                @Override public void valueChanged(javax.swing.event.ListSelectionEvent evt) {
                    if (!evt.getValueIsAdjusting()) refreshTombolHasilLabRadKasir();
                }
            });
        } catch (Exception ex) {
            System.out.println("Notifikasi inisialisasi tombol hasil Lab/Rad Kasir : " + ex);
        }
    }

    private String getNoRawatHasilKasir() {
        try {
            if (tbKasirRalan.getSelectedRow() > -1) {
                Object nilai = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 11);
                if (nilai != null) return nilai.toString().trim();
            }
        } catch (Exception ex) {
            System.out.println("Notifikasi ambil no. rawat hasil Kasir : " + ex);
        }
        return "";
    }

    private String getNamaPasienHasilKasir() {
        try {
            if (tbKasirRalan.getSelectedRow() > -1) {
                Object nilai = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 3);
                if (nilai != null) return nilai.toString().trim();
            }
        } catch (Exception ex) {
            System.out.println("Notifikasi ambil nama pasien hasil Kasir : " + ex);
        }
        return "";
    }

    private void refreshTombolHasilLabRadKasir() {
        if (BtnHasilLabKasir == null || BtnHasilRadKasir == null) return;

        // Respons UI harus langsung. Tombol lama disembunyikan sambil status pasien baru dicek.
        BtnHasilLabKasir.setVisible(false);
        BtnHasilRadKasir.setVisible(false);

        final String noRawat = getNoRawatHasilKasir();
        if (noRawat.equals("")) {
            batalkanCekStatusHasilPenunjangKasir();
            try { panelGlass8.revalidate(); panelGlass8.repaint(); } catch (Exception ex) {}
            return;
        }

        StatusHasilPenunjangKasir cache = cacheStatusHasilPenunjangKasir.get(noRawat);
        if (cache != null && (System.currentTimeMillis() - cache.dibuatPada) <= MASA_CACHE_STATUS_HASIL_KASIR_MS) {
            terapkanStatusHasilPenunjangKasir(noRawat, cache);
            return;
        }

        // Debounce singkat: saat user menekan panah/klik cepat antarbaris, hanya pasien terakhir yang dicek.
        if (timerStatusHasilPenunjangKasir == null) {
            timerStatusHasilPenunjangKasir = new javax.swing.Timer(120, new java.awt.event.ActionListener() {
                @Override
                public void actionPerformed(java.awt.event.ActionEvent e) {
                    mulaiCekStatusHasilPenunjangKasir(getNoRawatHasilKasir());
                }
            });
            timerStatusHasilPenunjangKasir.setRepeats(false);
        }
        timerStatusHasilPenunjangKasir.restart();
        try { panelGlass8.revalidate(); panelGlass8.repaint(); } catch (Exception ex) {}
    }

    private void mulaiCekStatusHasilPenunjangKasir(final String noRawat) {
        if (noRawat == null || noRawat.trim().equals("")) return;

        StatusHasilPenunjangKasir cache = cacheStatusHasilPenunjangKasir.get(noRawat);
        if (cache != null && (System.currentTimeMillis() - cache.dibuatPada) <= MASA_CACHE_STATUS_HASIL_KASIR_MS) {
            terapkanStatusHasilPenunjangKasir(noRawat, cache);
            return;
        }

        if (workerStatusHasilPenunjangKasir != null && !workerStatusHasilPenunjangKasir.isDone()) {
            workerStatusHasilPenunjangKasir.cancel(true);
        }

        final long nomorProses = ++nomorProsesStatusHasilPenunjangKasir;
        workerStatusHasilPenunjangKasir = new SwingWorker<StatusHasilPenunjangKasir, Void>() {
            @Override
            protected StatusHasilPenunjangKasir doInBackground() {
                return cekStatusHasilPenunjangKasirCepat(noRawat);
            }

            @Override
            protected void done() {
                if (isCancelled() || nomorProses != nomorProsesStatusHasilPenunjangKasir) return;
                if (!noRawat.equals(getNoRawatHasilKasir())) return;
                try {
                    StatusHasilPenunjangKasir status = get();
                    if (status != null) {
                        cacheStatusHasilPenunjangKasir.put(noRawat, status);
                        terapkanStatusHasilPenunjangKasir(noRawat, status);
                    }
                } catch (Exception ex) {
                    System.out.println("Notifikasi cek status hasil Lab/Rad Kasir : " + ex);
                }
            }
        };
        workerStatusHasilPenunjangKasir.execute();
    }

    private void terapkanStatusHasilPenunjangKasir(String noRawat, StatusHasilPenunjangKasir status) {
        if (status == null || !noRawat.equals(getNoRawatHasilKasir())) return;
        aturTampilanTombolHasilKasir(BtnHasilLabKasir, status.labSaatIni, status.labRiwayat, "Lab", "Laboratorium");
        aturTampilanTombolHasilKasir(BtnHasilRadKasir, status.radSaatIni, status.radRiwayat, "Rad", "Radiologi");
        try { panelGlass8.revalidate(); panelGlass8.repaint(); } catch (Exception ex) {}
    }

    private void batalkanCekStatusHasilPenunjangKasir() {
        if (timerStatusHasilPenunjangKasir != null) timerStatusHasilPenunjangKasir.stop();
        nomorProsesStatusHasilPenunjangKasir++;
        if (workerStatusHasilPenunjangKasir != null && !workerStatusHasilPenunjangKasir.isDone()) {
            workerStatusHasilPenunjangKasir.cancel(true);
        }
    }

    /**
     * Versi ringan untuk menentukan visibilitas tombol hasil.
     * Maksimal hanya beberapa query per pasien dan seluruhnya berjalan di SwingWorker.
     * Method lama pengambilan detail/riwayat tetap dipertahankan untuk saat tombol benar-benar dibuka.
     */
    private StatusHasilPenunjangKasir cekStatusHasilPenunjangKasirCepat(String noRawat) {
        StatusHasilPenunjangKasir status = new StatusHasilPenunjangKasir();
        if (noRawat == null || noRawat.trim().equals("")) return status;

        PreparedStatement psCek = null;
        ResultSet rsCek = null;
        try {
            psCek = koneksi.prepareStatement(
                "select " +
                "exists(select 1 from berkas_digital_perawatan b where b.no_rawat=? and b.kode='005' and trim(ifnull(b.lokasi_file,''))<>'' limit 1) as lab_digital," +
                "exists(select 1 from detail_periksa_lab d where d.no_rawat=? and trim(ifnull(d.nilai,''))<>'' limit 1) as lab_detail," +
                "exists(select 1 from berkas_digital_perawatan b where b.no_rawat=? and b.kode='006' and trim(ifnull(b.lokasi_file,''))<>'' limit 1) as rad_digital"
            );
            psCek.setString(1, noRawat);
            psCek.setString(2, noRawat);
            psCek.setString(3, noRawat);
            rsCek = psCek.executeQuery();
            if (rsCek.next()) {
                status.labSaatIni = rsCek.getBoolean("lab_digital") || rsCek.getBoolean("lab_detail");
                status.radSaatIni = rsCek.getBoolean("rad_digital");
            }
        } catch (Exception ex) {
            System.out.println("Notifikasi cek hasil aktif Kasir : " + ex);
        } finally {
            try { if (rsCek != null) rsCek.close(); } catch (Exception ex) {}
            try { if (psCek != null) psCek.close(); } catch (Exception ex) {}
        }

        if (status.labSaatIni && status.radSaatIni) return status;

        java.util.ArrayList<String> noRawatRiwayat = new java.util.ArrayList<String>();
        PreparedStatement psRiwayat = null;
        ResultSet rsRiwayat = null;
        try {
            psRiwayat = koneksi.prepareStatement(
                "select rp.no_rawat from reg_periksa rp " +
                "where rp.no_rkm_medis=(select no_rkm_medis from reg_periksa where no_rawat=? limit 1) " +
                "and rp.no_rawat<>? order by rp.tgl_registrasi desc,rp.jam_reg desc,rp.no_rawat desc limit 5"
            );
            psRiwayat.setString(1, noRawat);
            psRiwayat.setString(2, noRawat);
            rsRiwayat = psRiwayat.executeQuery();
            while (rsRiwayat.next()) {
                noRawatRiwayat.add(rsRiwayat.getString("no_rawat"));
            }
        } catch (Exception ex) {
            System.out.println("Notifikasi cek daftar riwayat hasil Kasir : " + ex);
        } finally {
            try { if (rsRiwayat != null) rsRiwayat.close(); } catch (Exception ex) {}
            try { if (psRiwayat != null) psRiwayat.close(); } catch (Exception ex) {}
        }

        if (noRawatRiwayat.isEmpty()) return status;

        StringBuilder placeholder = new StringBuilder();
        for (int idx = 0; idx < noRawatRiwayat.size(); idx++) {
            if (idx > 0) placeholder.append(',');
            placeholder.append('?');
        }

        PreparedStatement psBatch = null;
        ResultSet rsBatch = null;
        try {
            String in = placeholder.toString();
            String sql = "select " +
                (status.labSaatIni ? "0 as lab_digital_riwayat,0 as lab_detail_riwayat," :
                    "exists(select 1 from berkas_digital_perawatan b where b.no_rawat in ("+in+") and b.kode='005' and trim(ifnull(b.lokasi_file,''))<>'' limit 1) as lab_digital_riwayat," +
                    "exists(select 1 from detail_periksa_lab d where d.no_rawat in ("+in+") and trim(ifnull(d.nilai,''))<>'' limit 1) as lab_detail_riwayat,") +
                (status.radSaatIni ? "0 as rad_riwayat" :
                    "exists(select 1 from berkas_digital_perawatan b where b.no_rawat in ("+in+") and b.kode='006' and trim(ifnull(b.lokasi_file,''))<>'' limit 1) as rad_riwayat");
            psBatch = koneksi.prepareStatement(sql);
            int parameter = 1;
            if (!status.labSaatIni) {
                for (String nilai : noRawatRiwayat) psBatch.setString(parameter++, nilai);
                for (String nilai : noRawatRiwayat) psBatch.setString(parameter++, nilai);
            }
            if (!status.radSaatIni) {
                for (String nilai : noRawatRiwayat) psBatch.setString(parameter++, nilai);
            }
            rsBatch = psBatch.executeQuery();
            if (rsBatch.next()) {
                if (!status.labSaatIni) {
                    status.labRiwayat = rsBatch.getBoolean("lab_digital_riwayat") || rsBatch.getBoolean("lab_detail_riwayat");
                }
                if (!status.radSaatIni) {
                    status.radRiwayat = rsBatch.getBoolean("rad_riwayat");
                }
            }
        } catch (Exception ex) {
            System.out.println("Notifikasi cek batch riwayat hasil Kasir : " + ex);
        } finally {
            try { if (rsBatch != null) rsBatch.close(); } catch (Exception ex) {}
            try { if (psBatch != null) psBatch.close(); } catch (Exception ex) {}
        }
        return status;
    }

    private void aturTampilanTombolHasilKasir(widget.Button tombol, boolean hasilSaatIni,
            boolean hasilRiwayat, String namaSingkat, String namaLengkap) {
        if (tombol == null) return;

        tombol.setVisible(hasilSaatIni || hasilRiwayat);
        if (hasilSaatIni) {
            tombol.setText("Lihat Hasil " + namaSingkat);
            tombol.setToolTipText("Lihat Hasil " + namaLengkap + " Kunjungan Saat Ini");
            tombol.setPreferredSize(new java.awt.Dimension(135, 23));
        } else if (hasilRiwayat) {
            tombol.setText("Riwayat Hasil " + namaSingkat);
            tombol.setToolTipText("Lihat Riwayat Hasil " + namaLengkap + " dari 5 Kunjungan Terakhir");
            tombol.setPreferredSize(new java.awt.Dimension(160, 23));
        }
    }

    private boolean adaRiwayatHasilDigitalKasir(String noRawat, String kodeBerkas, String tabelPeriksa) {
        java.util.ArrayList<DataKunjunganSebelumnyaKasir> riwayat =
                ambilLimaKunjunganSebelumnyaKasir(noRawat, kodeBerkas, tabelPeriksa);
        return adaKunjunganRiwayatDenganHasilKasir(riwayat);
    }

    private boolean adaKunjunganRiwayatDenganHasilKasir(
            java.util.ArrayList<DataKunjunganSebelumnyaKasir> riwayat) {
        if (riwayat == null) return false;
        for (int i = 0; i < riwayat.size(); i++) {
            if (riwayat.get(i).hasilTersedia) return true;
        }
        return false;
    }

    private boolean adaHasilDigitalKasir(String noRawat, String kodeBerkas, String tabelPeriksa) {
        PreparedStatement psCek = null;
        ResultSet rsCek = null;
        try {
            /*
             * Hasil yang telah disalin dari riwayat disimpan pada
             * berkas_digital_perawatan. Kunjungan tujuan dapat belum mempunyai baris
             * periksa_lab/periksa_radiologi, sehingga syarat tabel pemeriksaan lama justru
             * menyembunyikan hasil salinan yang sudah berhasil dibuat.
             */
            psCek = koneksi.prepareStatement(
                "select 1 from berkas_digital_perawatan where no_rawat=? and kode=? "
                + "and trim(ifnull(lokasi_file,''))<>'' limit 1"
            );
            psCek.setString(1, noRawat);
            psCek.setString(2, kodeBerkas);
            rsCek = psCek.executeQuery();
            return rsCek.next();
        } catch (Exception ex) {
            System.out.println("Notifikasi cek file hasil Kasir : " + ex);
            return false;
        } finally {
            try { if (rsCek != null) rsCek.close(); } catch (Exception ex) {}
            try { if (psCek != null) psCek.close(); } catch (Exception ex) {}
        }
    }

