                            normdipilih="";
                        }   
                    }
                }               
            }else if(evt.getClickCount()==2){
                i=tbKasirRalan.getSelectedColumn();
                if(i==0){
                    boolean isBPJ = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 17).toString().equals("BPJ");
                    boolean isAdminUtama = akses.getkode().equals("Admin Utama");                    
                    
                    if(akses.gettindakan_ralan()==true){
                        ppBerkasDiterimaBtnPrintActionPerformed(null);
                        MnDataRalanActionPerformed(null);
                        
                    if (!isAdminUtama && isBPJ) {                     
                            MnRiwayatPerawatanICareNoKartuActionPerformed(null); // Panggil method baru hanya jika kddokter sesuai dengan kode yang login
                        }
                    }
                }else if(i==1){
                    if(akses.getberi_obat()==true){
                        MnPemberianObatActionPerformed(null);
                    }                    
                }else if(i==2){
                    //if(var.getbilling_ralan()==true){
                        MnBillingActionPerformed(null);
                    //}                    
                }else if(i==3){
                    if(MnKamarInap.isEnabled()==true){
                        MnKamarInapActionPerformed(null);
                    }                    
                }
            }
        }
}//GEN-LAST:event_tbKasirRalanMouseClicked

    private void tbKasirRalanKeyPressed(java.awt.event.KeyEvent evt) {//GEN-FIRST:event_tbKasirRalanKeyPressed
        if(tabModekasir.getRowCount()!=0){
            if((evt.getKeyCode()==KeyEvent.VK_ENTER)||(evt.getKeyCode()==KeyEvent.VK_UP)||(evt.getKeyCode()==KeyEvent.VK_DOWN)){
                try {
                    getDatakasir();
                } catch (java.lang.NullPointerException e) {
                }
            }
            
            if(evt.getKeyCode()==KeyEvent.VK_SPACE){
                i=tbKasirRalan.getSelectedColumn();
                if(i==0){
                    boolean isBPJ = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 17).toString().equals("BPJ");
                    boolean isAdminUtama = akses.getkode().equals("Admin Utama");                    
                    
                    if(akses.gettindakan_ralan()==true){
                        MnDataRalanActionPerformed(null);
                        
                    if (!isAdminUtama && isBPJ) {
                            MnRiwayatPerawatanICareNoKartuActionPerformed(null); // Panggil method baru hanya jika kddokter sesuai dengan kode yang login
                        }
                    }
                }else if(i==1){
                    if(akses.getberi_obat()==true){
                        MnPemberianObatActionPerformed(null);
                    }                    
                }else if(i==2){
                    MnBillingActionPerformed(null);
                }else if(i==3){
                    if(MnKamarInap.isEnabled()==true){
                        MnKamarInapActionPerformed(null);
                    }                    
                }
            }else if(evt.getKeyCode()==KeyEvent.VK_SHIFT){
                TCari.setText("");
                TCari.requestFocus();
            }
        }
}//GEN-LAST:event_tbKasirRalanKeyPressed

