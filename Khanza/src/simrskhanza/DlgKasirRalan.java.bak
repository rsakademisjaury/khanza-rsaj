    private void ppBerkasDiterimaBtnPrintActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_ppBerkasDiterimaBtnPrintActionPerformed
        
        if (tabModekasir.getRowCount() == 0) {
        JOptionPane.showMessageDialog(null, "Maaf, table masih kosong...!!!!");
        return;
        }
        if (TNoRw.getText().trim().equals("")) {
            JOptionPane.showMessageDialog(null, "Maaf, Silahkan anda pilih dulu dengan menklik data pada table...!!!");
            tbKasirRalan.requestFocus();
            return;
        }

        final String noRw = TNoRw.getText().trim();

        try {
            // ==== Ambil status & keberadaan mutasi ====
            String stts = Sequel.cariIsi("SELECT stts FROM reg_periksa WHERE no_rawat=?", noRw);
            stts = (stts == null) ? "" : stts.trim();

            // Mutasi yang kita maksud adalah event "Sudah Diterima"
            boolean mutasiDiterimaAda = Sequel.cariInteger(
                "SELECT COUNT(1) FROM mutasi_berkas WHERE no_rawat=? AND status='Sudah Diterima'", noRw
            ) > 0;

            // ===== Idempotency gate =====
            // Hanya EKSEKUSI jika stts='Belum' dan mutasi "Sudah Diterima" BELUM ada.
            if (!"Belum".equalsIgnoreCase(stts) || mutasiDiterimaAda) {
                // Jika status sudah 'Sudah' dan mutasi sudah ada → no-op
                // Atau status sudah 'Berkas Diterima' → no-op
                return;
            }

            // ==== Guard lain (hanya dipakai saat benar2 mau eksekusi) ====
            // Sudah masuk Ranap?
            if (Sequel.cariInteger("SELECT COUNT(1) FROM kamar_inap WHERE no_rawat=?", noRw) > 0) {
                JOptionPane.showMessageDialog(null, "Maaf, Pasien sudah masuk Kamar Inap. Gunakan billing Ranap..!!!");
                return;
            }

            // Batal?
            if (Sequel.cariInteger(
                    "SELECT COUNT(1) FROM reg_periksa WHERE no_rawat=? AND stts='Batal'", noRw) > 0) {
                JOptionPane.showMessageDialog(null, "Maaf, Pasien Batal Periksa..!!!");
                return;
            }

            // Cek SEP wajib (opsional sesuai setting)
            if (Sequel.cariInteger("SELECT COUNT(1) FROM rsaj_setting WHERE id='1' AND status='1'") > 0) {
                boolean isAdminUtama = akses.getkode().equals("Admin Utama");
                boolean isBPJ = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 17).toString().equals("BPJ");
                if (!isAdminUtama && isBPJ) {
                    String noRawatGrid = tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(), 11).toString();
                    if (Sequel.cariInteger(
                            "SELECT COUNT(1) FROM bridging_sep WHERE no_rawat=?", noRawatGrid) == 0) {
                        JOptionPane.showMessageDialog(rootPane, "Maaf, SEP belum diterbitkan, mohon hubungi Admisi ..!!");
                        return;
                    }
                }
            }

            // ===================== EKSEKUSI UTAMA (satu kali saja) =====================

//            // 1) Simpan mutasi "Sudah Diterima" (insert-or-update sesuai util 'menyimpan')
//            Sequel.menyimpan(
//                "mutasi_berkas",
//                "'" + noRw + "','Sudah Diterima',now(),now(),'0000-00-00 00:00:00','0000-00-00 00:00:00','0000-00-00 00:00:00'",
//                "status='Sudah Diterima',diterima=now()",
//                "no_rawat='" + noRw + "'"
//            );
//
//            // 2) Update jam_reg HANYA jika:
//            //    - kd_poli <> 'IGDK'
//            //    - BELUM ada SOAP (tidak ada row di pemeriksaan_ralan untuk no_rawat tsb)
//            Sequel.queryu(
//                "UPDATE reg_periksa r " +
//                "SET r.jam_reg = NOW() - INTERVAL ROUND((RAND() * (06 - 10)) + 10, 0) MINUTE " +
//                "WHERE r.no_rawat = '" + noRw + "' " +
//                "  AND r.kd_poli <> 'IGDK' " +
//                "  AND NOT EXISTS (SELECT 1 FROM pemeriksaan_ralan pr WHERE pr.no_rawat = r.no_rawat)"
//            );
//
//            // 3) Update validasi referensi_mobilejkn_bpjs dengan syarat yang sama
//            Sequel.queryu(
//                "UPDATE referensi_mobilejkn_bpjs b " +
//                "JOIN reg_periksa r ON r.no_rawat = b.no_rawat " +
//                "SET b.validasi = NOW() - INTERVAL ROUND((RAND() * (06 - 10)) + 10, 0) MINUTE " +
//                "WHERE b.no_rawat = '" + noRw + "' " +
//                "  AND r.kd_poli <> 'IGDK' " +
//                "  AND NOT EXISTS (SELECT 1 FROM pemeriksaan_ralan pr WHERE pr.no_rawat = r.no_rawat)"
//            );
//
//            // 4) Set status tampilan & DB ke 'Berkas Diterima'
//            Valid.editTable(tabModekasir, "reg_periksa", "no_rawat", TNoRw, "stts='Berkas Diterima'");
//            if (tbKasirRalan.getSelectedRow() > -1) {
//                tabModekasir.setValueAt("Berkas Diterima", tbKasirRalan.getSelectedRow(), 10);
//            }

        // ====== DEBUG Berkas Diterima (tanpa boolean return) ======
//        final String noRw = TNoRw.getText().trim();

        try {
            // --- konteks awal buat pembanding ---
            String kdPoli = Sequel.cariIsi("SELECT kd_poli FROM reg_periksa WHERE no_rawat='" + noRw + "'");
            int hasSOAP   = Sequel.cariInteger("SELECT COUNT(1) FROM pemeriksaan_ralan WHERE no_rawat='" + noRw + "' LIMIT 1");
            int hasJKN    = Sequel.cariInteger("SELECT COUNT(1) FROM referensi_mobilejkn_bpjs WHERE no_rawat='" + noRw + "' LIMIT 1");

            String jamRegBefore = Sequel.cariIsi(
                "SELECT DATE_FORMAT(jam_reg,'%Y-%m-%d %H:%i:%s') FROM reg_periksa WHERE no_rawat='" + noRw + "'"
            );
            String validasiBefore = (hasJKN > 0)
                ? Sequel.cariIsi("SELECT DATE_FORMAT(validasi,'%Y-%m-%d %H:%i:%s') FROM referensi_mobilejkn_bpjs WHERE no_rawat='" + noRw + "'")
                : null;

            // 1) Simpan mutasi "Sudah Diterima"
            try {
                int before = Sequel.cariInteger("SELECT COUNT(1) FROM mutasi_berkas WHERE no_rawat='" + noRw + "' LIMIT 1");

                Sequel.menyimpan(
                    "mutasi_berkas",
                    "'" + noRw + "','Sudah Diterima',now(),now(),'0000-00-00 00:00:00','0000-00-00 00:00:00','0000-00-00 00:00:00'",
                    "status='Sudah Diterima',diterima=now()",
                    "no_rawat='" + noRw + "'"
                );

                int after = Sequel.cariInteger("SELECT COUNT(1) FROM mutasi_berkas WHERE no_rawat='" + noRw + "' LIMIT 1");
                if (after > 0) {
                    String mode = (before == 0) ? "INSERT" : "UPDATE";
                    String ringkas = Sequel.cariIsi(
                        "SELECT CONCAT(status,' | diterima=',DATE_FORMAT(diterima,'%Y-%m-%d %H:%i:%s')) " +
                        "FROM mutasi_berkas WHERE no_rawat='" + noRw + "'"
                    );
                    System.out.println("[DEBUG] Mutasi berkas: BERHASIL (" + mode + ") no_rawat=" + noRw + " -> " + ringkas);
                } else {
                    System.out.println("[DEBUG] Mutasi berkas: GAGAL menyimpan untuk no_rawat=" + noRw);
                }
            } catch (Exception e) {
                System.out.println("[DEBUG][ERR] Mutasi berkas: " + e.getMessage());
            }

            // 2) Update jam_reg HANYA jika kd_poli <> 'IGDK' & BELUM ada SOAP
            try {
                if (!"IGDK".equalsIgnoreCase(kdPoli) && hasSOAP == 0) {
                    Sequel.queryu(
                        "UPDATE reg_periksa r " +
                        "SET r.jam_reg = NOW() - INTERVAL ROUND((RAND() * (06 - 10)) + 10, 0) MINUTE " +
                        "WHERE r.no_rawat = '" + noRw + "' " +
                        "  AND r.kd_poli <> 'IGDK' " +
                        "  AND NOT EXISTS (SELECT 1 FROM pemeriksaan_ralan pr WHERE pr.no_rawat = r.no_rawat)"
                    );

                    String jamRegAfter = Sequel.cariIsi(
                        "SELECT DATE_FORMAT(jam_reg,'%Y-%m-%d %H:%i:%s') FROM reg_periksa WHERE no_rawat='" + noRw + "'"
                    );

                    if (jamRegAfter != null && !jamRegAfter.equals(jamRegBefore)) {
                        System.out.println("[DEBUG] RegPeriksa: BERHASIL update jam_reg (" + jamRegBefore + " -> " + jamRegAfter + ") no_rawat=" + noRw);
                    } else {
                        System.out.println("[DEBUG] RegPeriksa: DILEWATI / tidak ada perubahan (syarat terpenuhi tapi nilai sama?) no_rawat=" + noRw);
                    }
                } else {
                    System.out.println("[DEBUG] RegPeriksa: DILEWATI (kd_poli=" + kdPoli + ", hasSOAP=" + hasSOAP + ")");
                }
            } catch (Exception e) {
                System.out.println("[DEBUG][ERR] RegPeriksa (update jam_reg): " + e.getMessage());
            }

            // 3) Update validasi referensi_mobilejkn_bpjs dengan syarat yang sama
            try {
                if (!"IGDK".equalsIgnoreCase(kdPoli) && hasSOAP == 0 && hasJKN > 0) {
                    Sequel.queryu(
                        "UPDATE referensi_mobilejkn_bpjs b " +
                        "JOIN reg_periksa r ON r.no_rawat = b.no_rawat " +
                        "SET b.validasi = NOW() - INTERVAL ROUND((RAND() * (06 - 10)) + 10, 0) MINUTE " +
                        "WHERE b.no_rawat = '" + noRw + "' " +
                        "  AND r.kd_poli <> 'IGDK' " +
                        "  AND NOT EXISTS (SELECT 1 FROM pemeriksaan_ralan pr WHERE pr.no_rawat = r.no_rawat)"
                    );

                    String validasiAfter = Sequel.cariIsi(
                        "SELECT DATE_FORMAT(validasi,'%Y-%m-%d %H:%i:%s') FROM referensi_mobilejkn_bpjs WHERE no_rawat='" + noRw + "'"
                    );

                    if (validasiBefore == null && validasiAfter != null) {
                        System.out.println("[DEBUG] MobileJKN: BERHASIL set validasi -> " + validasiAfter + " no_rawat=" + noRw);
                    } else if (validasiBefore != null && validasiAfter != null && !validasiAfter.equals(validasiBefore)) {
                        System.out.println("[DEBUG] MobileJKN: BERHASIL update validasi (" + validasiBefore + " -> " + validasiAfter + ") no_rawat=" + noRw);
                    } else {
                        System.out.println("[DEBUG] MobileJKN: DILEWATI / tidak ada perubahan (syarat terpenuhi tapi nilai sama?) no_rawat=" + noRw);
                    }
                } else {
                    System.out.println("[DEBUG] MobileJKN: DILEWATI (kd_poli=" + kdPoli + ", hasSOAP=" + hasSOAP + ", hasJKN=" + hasJKN + ")");
                }
            } catch (Exception e) {
                System.out.println("[DEBUG][ERR] MobileJKN (update validasi): " + e.getMessage());
            }

            // 4) Set status tampilan & DB ke 'Berkas Diterima' + log ringan
            Valid.editTable(tabModekasir, "reg_periksa", "no_rawat", TNoRw, "stts='Berkas Diterima'");
            if (tbKasirRalan.getSelectedRow() > -1) {
                tabModekasir.setValueAt("Berkas Diterima", tbKasirRalan.getSelectedRow(), 10);
                System.out.println("[DEBUG] UI: status kolom diset 'Berkas Diterima' (row=" + tbKasirRalan.getSelectedRow() + ")");
            }
        } catch (Exception e) {
            System.out.println("[DEBUG][ERR] Wrapper Berkas Diterima: " + e.getMessage());
        }


            // ===========================================================================
        } catch (Exception e) {
            System.out.println("Err ppBerkasDiterimaBtnPrintActionPerformed: " + e);
        }
    }//GEN-LAST:event_ppBerkasDiterimaBtnPrintActionPerformed

    private void MnPiutangObatActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_MnPiutangObatActionPerformed
        if(tabModekasir.getRowCount()==0){
            JOptionPane.showMessageDialog(null,"Maaf, table masih kosong...!!!!");
            TCari.requestFocus();
        }else if(TPasienCari.getText().trim().equals("")){
            JOptionPane.showMessageDialog(null,"Maaf, Silahkan anda pilih dulu dengan menklik data pada table...!!!");
            tbKasirRalan.requestFocus();
        }else{  
            if(Sequel.cariInteger("select count(kamar_inap.no_rawat) from kamar_inap where kamar_inap.no_rawat=?",TNoRw.getText())>0){
                JOptionPane.showMessageDialog(null,"Maaf, Pasien sudah masuk Kamar Inap. Gunakan billing Ranap..!!!");
            }else {
                DlgPiutang penjualan=new DlgPiutang(null,false);
                penjualan.isCek();
                penjualan.emptTeks();
                penjualan.setPasien(TNoRwCari.getText(),TNoRMCari.getText(),TPasienCari.getText());  
                penjualan.setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
                penjualan.setLocationRelativeTo(internalFrame1);
                penjualan.setVisible(true);
            }                
        }
    }//GEN-LAST:event_MnPiutangObatActionPerformed

    private void MnCetakBebasNarkobaActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_MnCetakBebasNarkobaActionPerformed
        if(TPasienCari.getText().trim().equals("")){
            JOptionPane.showMessageDialog(null,"Maaf, Silahkan anda pilih dulu data registrasi pada table...!!!");
            TCari.requestFocus();
        }else{
            if(tbKasirRalan.getSelectedRow()!= -1){
                this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
                SuratBebasNarkoba resume=new SuratBebasNarkoba(null,false);
                resume.isCek();
                resume.emptTeks();
                resume.setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
                resume.setLocationRelativeTo(internalFrame1);
                resume.setNoRm(TNoRw.getText(),TNoRMCari.getText(),TPasienCari.getText(),tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),0).toString(),tbKasirRalan.getValueAt(tbKasirRalan.getSelectedRow(),1).toString(),DTPCari1.getDate(),DTPCari2.getDate());
                resume.tampil();
                resume.setVisible(true);
                this.setCursor(Cursor.getDefaultCursor());
            }
        }
    }//GEN-LAST:event_MnCetakBebasNarkobaActionPerformed

