private boolean validasiPanggilPasien(boolean cekSepBpjs) {
    if (tabModekasir.getRowCount() == 0) {
        JOptionPane.showMessageDialog(null, "Maaf, table masih kosong...!!!!");
        TCari.requestFocus();
        return false;
    }

    if (tbKasirRalan.getSelectedRow() == -1 || TNoRw.getText().trim().equals("")) {
        JOptionPane.showMessageDialog(null, "Maaf, Silahkan anda pilih dulu dengan menklik data pada table...!!!");
        tbKasirRalan.requestFocus();
        return false;
    }

    int row = tbKasirRalan.getSelectedRow();

    String kdDokter = ambilValueTable(row, 0);
    String noRawat  = ambilValueTable(row, 11);
    String caraBayar = ambilValueTable(row, 17);
    String kdPoli   = ambilValueTable(row, 18);

    if (kdDokter.equals("") || noRawat.equals("") || kdPoli.equals("")) {
        JOptionPane.showMessageDialog(rootPane, "Data panggilan tidak lengkap. Pastikan dokter, poli, dan no. rawat sudah terisi.");
        return false;
    }

    if (cekSepBpjs) {
        if (Sequel.cariInteger("SELECT COUNT(rs.id) FROM rsaj_setting rs WHERE rs.id='1' AND rs.status='1'") > 0) {
            if (caraBayar.equalsIgnoreCase("BPJ")) {
                if (Sequel.cariInteger("SELECT COUNT(bs.no_sep) FROM bridging_sep bs WHERE bs.no_rawat='" + escSql(noRawat) + "'") == 0) {
                    JOptionPane.showMessageDialog(rootPane, "Pasien Jaminan BPJS Belum Diterbitkan SEP, mohon hubungi Admisi ..!!");
                    return false;
                }
            }
        }
    }

    return true;
}

private void kirimEventPanggilanPasien(String jenisPanggil) {
    int row = tbKasirRalan.getSelectedRow();

    String kdDokter = ambilValueTable(row, 0);
    String noRawat  = ambilValueTable(row, 11);
    String kdPoli   = ambilValueTable(row, 18);

    kdDokter = escSql(kdDokter);
    noRawat  = escSql(noRawat);
    kdPoli   = escSql(kdPoli);
    jenisPanggil = escSql(jenisPanggil);

    try {
        int tabelEventAda = Sequel.cariInteger(
            "SELECT COUNT(*) FROM information_schema.tables " +
            "WHERE table_schema=DATABASE() " +
            "AND table_name='rsaj_panggil_pasien_event'"
        );

        if (tabelEventAda == 0) {
            JOptionPane.showMessageDialog(rootPane,
                "Tabel rsaj_panggil_pasien_event belum ada.\n" +
                "Jalankan SQL tabel event panggilan pasien terlebih dahulu.");
            return;
        }

        int panggilKe = Sequel.cariInteger(
            "SELECT IFNULL(MAX(panggil_ke),0)+1 " +
            "FROM rsaj_panggil_pasien_event " +
            "WHERE no_rawat='" + noRawat + "'"
        );

        if (panggilKe <= 0) {
            panggilKe = 1;
        }

        Sequel.queryu(
            "INSERT INTO rsaj_panggil_pasien_event " +
            "(no_rawat, kd_dokter, kd_poli, jenis_panggil, status, panggil_ke, waktu_panggil, token_event) VALUES " +
            "('" + noRawat + "','" + kdDokter + "','" + kdPoli + "','" + jenisPanggil + "','MENUNGGU','" + panggilKe + "',NOW(),REPLACE(UUID(),'-',''))"
        );

        sinkronAntripoliLama(kdDokter, kdPoli, noRawat);

        if (jenisPanggil.equalsIgnoreCase("ULANG")) {
            JOptionPane.showMessageDialog(rootPane, "Panggil ulang pasien berhasil dikirim ke display.");
        } else {
            JOptionPane.showMessageDialog(rootPane, "Pasien berhasil dipanggil dan dikirim ke display.");
        }
    } catch (Exception e) {
        JOptionPane.showMessageDialog(rootPane, "Gagal mengirim panggilan pasien ke display : " + e.getMessage());
    }
}

private void sinkronAntripoliLama(String kdDokter, String kdPoli, String noRawat) {
    try {
        int ada = Sequel.cariInteger(
            "SELECT COUNT(*) FROM antripoli " +
            "WHERE kd_dokter='" + kdDokter + "' " +
            "AND kd_poli='" + kdPoli + "' " +
            "AND no_rawat='" + noRawat + "'"
        );

        if (ada == 0) {
            Sequel.queryu(
                "INSERT INTO antripoli (kd_dokter, kd_poli, status, no_rawat, waktu) VALUES " +
                "('" + kdDokter + "','" + kdPoli + "','1','" + noRawat + "',NOW())"
            );
        } else {
            Sequel.queryu(
                "UPDATE antripoli SET status='1', waktu=NOW() " +
                "WHERE kd_dokter='" + kdDokter + "' " +
                "AND kd_poli='" + kdPoli + "' " +
                "AND no_rawat='" + noRawat + "'"
            );
        }
    } catch (Exception e) {
        System.out.println("Sinkron antripoli gagal : " + e.getMessage());
    }
}

private String ambilValueTable(int row, int col) {
    try {
        Object value = tbKasirRalan.getValueAt(row, col);
        return value == null ? "" : value.toString().trim();
    } catch (Exception e) {
        return "";
    }
}

private String escSql(String text) {
    if (text == null) {
        return "";
    }
    return text.replace("\\", "\\\\").replace("'", "\\'");
}

