    private void MnDataRalan1ActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_MnDataRalan1ActionPerformed
        final long perfKlikRawatJalan = System.nanoTime();
        if(tabModekasir2.getRowCount()==0){
            JOptionPane.showMessageDialog(null,"Maaf, table masih kosong...!!!!");
            TCari.requestFocus();
        }else{
            if(tbKasirRalan2.getSelectedRow()!= -1){
                if(Sequel.cariInteger("select count(kamar_inap.no_rawat) from kamar_inap where kamar_inap.no_rawat=?",tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),10).toString())>0){
                    JOptionPane.showMessageDialog(null,"Maaf, Pasien sudah masuk Kamar Inap. Gunakan billing Ranap..!!!");
                }else{      
                    // PATCH PERFORMA RSAJ - gunakan satu referensi instance selama proses pembukaan.
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] Pra-form/validasi: "+
                            ((System.nanoTime()-perfKlikRawatJalan)/1_000_000L)+" ms");

                    long perfTahapRawatJalan = System.nanoTime();
                    final DlgRawatJalan rawatJalan = getRawatJalan();
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] getRawatJalan/constructor: "+
                            ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                    perfTahapRawatJalan = System.nanoTime();
                    rawatJalan.emptTeks();
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] emptTeks: "+
                            ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                    perfTahapRawatJalan = System.nanoTime();
                    rawatJalan.isCek();
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] isCek: "+
                            ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                    perfTahapRawatJalan = System.nanoTime();
                    rawatJalan.setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
                    rawatJalan.setLocationRelativeTo(internalFrame1);
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] size/location: "+
                            ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                    perfTahapRawatJalan = System.nanoTime();
                    rawatJalan.SetPoli(tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),13).toString());
                    rawatJalan.SetPj(tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),14).toString());
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] SetPoli/SetPj: "+
                            ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                    perfTahapRawatJalan = System.nanoTime();
                    rawatJalan.setNoRm(
                        tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),10).toString(),
                        DTPCari1.getDate(),DTPCari2.getDate(),
                        tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),0).toString(),
                        tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),1).toString()
                    );
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] setNoRm: "+
                            ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");

                    perfTahapRawatJalan = System.nanoTime();
                    rawatJalan.setVisible(true);
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] setVisible: "+
                            ((System.nanoTime()-perfTahapRawatJalan)/1_000_000L)+" ms");
                    System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] TOTAL sinkron klik->setVisible selesai: "+
                            ((System.nanoTime()-perfKlikRawatJalan)/1_000_000L)+" ms");
                    javax.swing.SwingUtilities.invokeLater(new Runnable() {
                        @Override
                        public void run() {
                            System.out.println("[PERFORMA BUKA RAWAT JALAN TAB2] TOTAL klik->EDT/render berikutnya: "+
                                    ((System.nanoTime()-perfKlikRawatJalan)/1_000_000L)+" ms");
                        }
                    });
                } 
            }                               
        }
    }//GEN-LAST:event_MnDataRalan1ActionPerformed

    private void MnHapusRujukanActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_MnHapusRujukanActionPerformed
        if(tabModekasir2.getRowCount()==0){
            JOptionPane.showMessageDialog(null,"Maaf, table masih kosong...!!!!");
            TCari.requestFocus();
        }else{
            if(tbKasirRalan2.getSelectedRow()!= -1){
                if(Sequel.cariRegistrasi(tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),10).toString())>0){
                    JOptionPane.showMessageDialog(rootPane,"Data billing sudah terverifikasi..!!");
                }else{ 
                    Sequel.queryu2("delete from rujukan_internal_poli where no_rawat=? and kd_dokter=?",2,new String[]{
                        tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),10).toString(),
                        tbKasirRalan2.getValueAt(tbKasirRalan2.getSelectedRow(),0).toString()
                    });
                    tampilkasir2();
                }
            }
        }
    }//GEN-LAST:event_MnHapusRujukanActionPerformed

