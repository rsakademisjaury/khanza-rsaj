    /**
     * Tombol aksi pada dialog OCR KTP menggunakan gaya solid yang sama dengan
     * popup Verifikasi Nama Pasien. Warna dilukis sendiri agar tidak ditimpa
     * LookAndFeel Windows/Nimbus. Tombol nonaktif tetap berwarna abu-biru dan
     * berteks putih agar keterangannya tetap mudah dibaca.
     */
    private javax.swing.JButton buatTombolAksiOcr(
            String teks, String pathIcon, boolean enabled,
            final java.awt.Color latar, final java.awt.Color latarHover
    ){
        final java.awt.Color latarNonaktif = new java.awt.Color(100, 116, 139);
        final javax.swing.JButton tombol = new javax.swing.JButton(teks) {
            @Override
            protected void paintComponent(java.awt.Graphics g) {
                java.awt.Graphics2D g2 = (java.awt.Graphics2D) g.create();
                try{
                    g2.setRenderingHint(
                            java.awt.RenderingHints.KEY_ANTIALIASING,
                            java.awt.RenderingHints.VALUE_ANTIALIAS_ON
                    );
                    g2.setColor(isEnabled() ? getBackground() : latarNonaktif);
                    g2.fillRoundRect(0, 0, getWidth() - 1, getHeight() - 1, 8, 8);

                    java.awt.Insets insets = getInsets();
                    javax.swing.Icon icon = getIcon();
                    String label = getText() == null ? "" : getText();
                    g2.setFont(getFont());
                    java.awt.FontMetrics metrik = g2.getFontMetrics();
                    int lebarIkon = icon == null ? 0 : icon.getIconWidth();
                    int tinggiIkon = icon == null ? 0 : icon.getIconHeight();
                    int jarak = (icon == null || label.equals("")) ? 0 : 8;
                    int lebarTeks = metrik.stringWidth(label);
                    int lebarIsi = lebarIkon + jarak + lebarTeks;
                    int x = Math.max(insets.left, (getWidth() - lebarIsi) / 2);

                    if(icon != null){
                        int yIkon = (getHeight() - tinggiIkon) / 2;
                        icon.paintIcon(this, g2, x, yIkon);
                    }
                    g2.setColor(java.awt.Color.WHITE);
                    int yTeks = (getHeight() - metrik.getHeight()) / 2 + metrik.getAscent();
                    g2.drawString(label, x + lebarIkon + jarak, yTeks);
                }finally{
                    g2.dispose();
                }
            }

            @Override
            protected void paintBorder(java.awt.Graphics g) {
                // Border bawaan dimatikan agar sudut tombol tetap membulat.
            }
        };
        tombol.setEnabled(enabled);
        tombol.setFont(new java.awt.Font("Segoe UI", java.awt.Font.BOLD, 12));
        tombol.setForeground(java.awt.Color.WHITE);
        tombol.setBackground(latar);
        tombol.setOpaque(false);
        tombol.setContentAreaFilled(false);
        tombol.setBorderPainted(false);
        tombol.setFocusPainted(false);
        tombol.setRolloverEnabled(false);
        tombol.setMargin(new java.awt.Insets(8, 14, 8, 14));
        tombol.setBorder(javax.swing.BorderFactory.createEmptyBorder(8, 14, 8, 14));
        tombol.setCursor(enabled
                ? new java.awt.Cursor(java.awt.Cursor.HAND_CURSOR)
                : new java.awt.Cursor(java.awt.Cursor.DEFAULT_CURSOR));
        javax.swing.ImageIcon icon = ambilIkonOcr(pathIcon, 16, 16);
        if(icon != null){
            tombol.setIcon(icon);
        }
        if(enabled){
            tombol.addMouseListener(new java.awt.event.MouseAdapter() {
                @Override
                public void mouseEntered(java.awt.event.MouseEvent e) {
                    tombol.setBackground(latarHover);
                    tombol.repaint();
                }

                @Override
                public void mouseExited(java.awt.event.MouseEvent e) {
                    tombol.setBackground(latar);
                    tombol.repaint();
                }
            });
        }
        return tombol;
    }

    private javax.swing.ImageIcon ambilIkonOcr(String pathIcon, int lebar, int tinggi){
        try{
            java.net.URL lokasi = getClass().getResource(pathIcon);
            if(lokasi != null){
                java.awt.Image img = new javax.swing.ImageIcon(lokasi).getImage().getScaledInstance(lebar, tinggi, java.awt.Image.SCALE_SMOOTH);
                return new javax.swing.ImageIcon(img);
            }
        }catch(Exception e){
            System.out.println("Notif icon OCR KTP : " + e);
        }
        return null;
    }

    private boolean nikSudahDipakaiPasienLain(String noRM, String nik){
        PreparedStatement perintah = null;
        ResultSet hasil = null;
        try{
            perintah = koneksi.prepareStatement("select no_rkm_medis from pasien where no_ktp=? and no_rkm_medis<>? limit 1");
            perintah.setString(1, nik);
            perintah.setString(2, noRM);
            hasil = perintah.executeQuery();
            return hasil.next();
        }catch(Exception e){
            System.out.println("Notif OCR KTP cek duplikasi NIK : " + e);
            return false;
        }finally{
            try{ if(hasil != null){ hasil.close(); } }catch(Exception e){}
            try{ if(perintah != null){ perintah.close(); } }catch(Exception e){}
        }
    }

    /** Mengubah hanya kolom yang dipilih petugas setelah konfirmasi eksplisit. */
    private boolean sinkronkanDataPasienDariOcr(String noRM, String nikOcr, String namaOcr, boolean ubahNik, boolean ubahNama){
        nikOcr = nikOcr == null ? "" : nikOcr.replaceAll("[^0-9]", "");
        namaOcr = bersihkanNamaOcr(namaOcr);
        if(ubahNik && !nikOcrValid(nikOcr)){
            JOptionPane.showMessageDialog(rootPane, "NIK hasil OCR belum valid. NIK harus tepat 16 digit angka.", "Sinkronisasi OCR KTP", JOptionPane.WARNING_MESSAGE);
            return false;
        }
        if(ubahNama && namaOcr.length() < 3){
            JOptionPane.showMessageDialog(rootPane, "Nama hasil OCR belum dapat digunakan. Periksa Foto KTP terlebih dahulu.", "Sinkronisasi OCR KTP", JOptionPane.WARNING_MESSAGE);
            return false;
        }
        if(!ubahNik && !ubahNama){
            return false;
        }
        if(ubahNik && nikSudahDipakaiPasienLain(noRM, nikOcr)){
            JOptionPane.showMessageDialog(rootPane,
                    "NIK hasil OCR sudah dipakai oleh pasien lain.\nSinkronisasi NIK dibatalkan untuk mencegah data pasien ganda.",
                    "Sinkronisasi OCR KTP", JOptionPane.WARNING_MESSAGE);
            return false;
        }

        String rincian = "";
        if(ubahNik){ rincian += "• NIK: " + nikOcr + "\n"; }
        if(ubahNama){ rincian += "• Nama: " + namaOcr + "\n"; }
        int konfirmasi = JOptionPane.showConfirmDialog(rootPane,
                "Data berikut akan diperbarui untuk No. RM " + noRM + ":\n\n" + rincian + "\nLanjutkan sinkronisasi?",
                "Konfirmasi Sinkronisasi Data KTP", JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);
        if(konfirmasi != JOptionPane.YES_OPTION){
            return false;
        }

        PreparedStatement perintah = null;
        try{
            String sql;
            if(ubahNik && ubahNama){
                sql = "update pasien set no_ktp=?, nm_pasien=? where no_rkm_medis=?";
                perintah = koneksi.prepareStatement(sql);
                perintah.setString(1, nikOcr);
                perintah.setString(2, namaOcr);
                perintah.setString(3, noRM);
            }else if(ubahNik){
                sql = "update pasien set no_ktp=? where no_rkm_medis=?";
                perintah = koneksi.prepareStatement(sql);
                perintah.setString(1, nikOcr);
                perintah.setString(2, noRM);
            }else{
                sql = "update pasien set nm_pasien=? where no_rkm_medis=?";
                perintah = koneksi.prepareStatement(sql);
                perintah.setString(1, namaOcr);
                perintah.setString(2, noRM);
            }
            int jumlah = perintah.executeUpdate();
            if(jumlah < 1){
                JOptionPane.showMessageDialog(rootPane, "Data pasien tidak ditemukan atau tidak ada perubahan.", "Sinkronisasi OCR KTP", JOptionPane.WARNING_MESSAGE);
                return false;
            }

            if(noRM.equals(TNoRM.getText().trim())){
                isCekPasien();
            }
            int baris = tbPetugas.getSelectedRow();
            if(ubahNama && baris >= 0 && tbPetugas.getColumnCount() > 8){
                Object nomorTabel = tbPetugas.getValueAt(baris, 7);
                if(nomorTabel != null && noRM.equals(nomorTabel.toString())){
                    tbPetugas.setValueAt(namaOcr, baris, 8);
                }
            }
            JOptionPane.showMessageDialog(rootPane,
                    "Sinkronisasi data pasien berhasil.\n" + rincian,
                    "Sinkronisasi OCR KTP", JOptionPane.INFORMATION_MESSAGE);
            return true;
        }catch(Exception e){
            JOptionPane.showMessageDialog(rootPane,
                    "Sinkronisasi data pasien gagal: " + e.getMessage(),
                    "Sinkronisasi OCR KTP", JOptionPane.WARNING_MESSAGE);
            return false;
        }finally{
            try{ if(perintah != null){ perintah.close(); } }catch(Exception e){}
        }
    }

    private void isCekPasien(){
        try {
            ps3=koneksi.prepareStatement("select pasien.nm_pasien,concat(pasien.alamat,', ',kelurahan.nm_kel,', ',kecamatan.nm_kec,', ',kabupaten.nm_kab) asal,"+
                        "pasien.namakeluarga,pasien.keluarga,pasien.kd_pj,penjab.png_jawab,if(pasien.tgl_daftar=?,'Baru','Lama') as daftar, "+
                        "TIMESTAMPDIFF(YEAR, pasien.tgl_lahir, CURDATE()) as tahun,pasien.no_peserta,pasien.jk,pasien.no_tlp, "+
                        "(TIMESTAMPDIFF(MONTH, pasien.tgl_lahir, CURDATE()) - ((TIMESTAMPDIFF(MONTH, pasien.tgl_lahir, CURDATE()) div 12) * 12)) as bulan, "+
                        "TIMESTAMPDIFF(DAY, DATE_ADD(DATE_ADD(pasien.tgl_lahir,INTERVAL TIMESTAMPDIFF(YEAR, pasien.tgl_lahir, CURDATE()) YEAR), INTERVAL TIMESTAMPDIFF(MONTH, pasien.tgl_lahir, CURDATE()) - ((TIMESTAMPDIFF(MONTH, pasien.tgl_lahir, CURDATE()) div 12) * 12) MONTH), CURDATE()) as hari "+
                        "from pasien inner join kelurahan on pasien.kd_kel=kelurahan.kd_kel "+
                        "inner join kecamatan on pasien.kd_kec=kecamatan.kd_kec "+
                        "inner join kabupaten on pasien.kd_kab=kabupaten.kd_kab "+
                        "inner join penjab on pasien.kd_pj=penjab.kd_pj "+
                        "where pasien.no_rkm_medis=?");
            try {            
                ps3.setString(1,Valid.SetTgl(DTPReg.getSelectedItem()+""));
                ps3.setString(2,TNoRM.getText());
                rs=ps3.executeQuery();
                while(rs.next()){
                    TAlmt.setText(rs.getString("asal"));
                    TPngJwb.setText(rs.getString("namakeluarga"));
                    THbngn.setText(rs.getString("keluarga"));
                    isiJenisBayarOtomatis(rs.getString("kd_pj"), rs.getString("png_jawab"));
                    TStatus.setText(rs.getString("daftar")); 
                    NoKa.setText(rs.getString("no_peserta"));
                    JK.setText(rs.getString("jk"));
                    NoTelp.setText(rs.getString("no_tlp"));
                    umur="0";
                    sttsumur="Th";
                    if(rs.getInt("tahun")>0){
                        umur=rs.getString("tahun");
                        sttsumur="Th";
                    }else if(rs.getInt("tahun")==0){
                        if(rs.getInt("bulan")>0){
                            umur=rs.getString("bulan");
                            sttsumur="Bl";
                        }else if(rs.getInt("bulan")==0){
                            umur=rs.getString("hari");
                            sttsumur="Hr";
                        }
                    }
                    
                    TPasien.setText(rs.getString("nm_pasien")+" ("+umur+" "+sttsumur+")");
                    switch (rs.getString("daftar")) {
                        case "Baru":
                            Sequel.cariIsi("select poliklinik.registrasi from poliklinik where poliklinik.kd_poli=?",TBiaya,kdpoli.getText());
                            break;
                        case "Lama":
                            Sequel.cariIsi("select poliklinik.registrasilama from poliklinik where poliklinik.kd_poli=?",TBiaya,kdpoli.getText());
                            break;
                        default:
                            Sequel.cariIsi("select poliklinik.registrasi from poliklinik where poliklinik.kd_poli=?",TBiaya,kdpoli.getText());
                            break;
                    }
                    setBiayaRegistrasiSesuaiJenisBayar();
                }
            } catch (Exception ex) {
                System.out.println(ex);
            }finally{
                if(rs != null ){
                    rs.close();
                }
                
                if(ps3 != null ){
                    ps3.close();
                }
            }
        } catch (Exception e) {
            System.out.println(e);
        }
        panggilFotoKTP();
    }


    public JTextField getTextField(){
        return TNoRw;
    }

    public JButton getButton(){
        return BtnKeluar;
    }
    
    private void isForm(){
        if(ChkInput.isSelected()==true){
            ChkInput.setVisible(false);
            PanelInput.setPreferredSize(new Dimension(WIDTH,240));
            FormInput.setVisible(true);      
            ChkInput.setVisible(true);
        }else if(ChkInput.isSelected()==false){           
            ChkInput.setVisible(false);            
            PanelInput.setPreferredSize(new Dimension(WIDTH,20));
            FormInput.setVisible(false);      
            ChkInput.setVisible(true);
        }
    }
    
    /**
     * PATCH RSAJ - menyiapkan form Registrasi untuk dibuka dari frmUtama.
     * emptTeks() dan perubahan tanggal pada isCek() sebelumnya sama-sama dapat
     * memanggil isNumber(), sehingga query MAX nomor registrasi berjalan berulang.
     * Saat pembukaan form, semua reset dilakukan dahulu lalu isNumber() dipanggil
     * tepat satu kali. Alur simpan/edit dan pemanggilan isCek() dari modul lain
     * tetap menggunakan perilaku lama.
     */
    public void siapkanPembukaan(){
        sedangMenyiapkanPembukaan=true;
        try{
            emptTeks();
            isCek();
        }finally{
            sedangMenyiapkanPembukaan=false;
        }
        isNumber();
    }

