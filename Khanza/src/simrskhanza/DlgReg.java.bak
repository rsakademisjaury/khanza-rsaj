        //DTPReg.setDate(new Date());
        TNoRM.setText("");
        TPasien.setText("");
        TPngJwb.setText("");
        THbngn.setText("");
        TAlmt.setText("");
        TStatus.setText("");
        isiPerujukOtomatis("", "");   
        NoKa.setText("");        
        if(!sedangMenyiapkanPembukaan){
            isNumber();
        }
        TNoRM.requestFocus();
        isiJenisBayarOtomatis("", "");
        tampilkanFotoKTPKosong();
        aturModeTombolSimpan();
    }

    private void getData() {
        if(tbPetugas.getSelectedRow()!= -1){
