    public DlgCariDokter getDokter() {
        if(dokter==null){
            final long mulai=System.nanoTime();
            final DlgCariDokter dialog=new DlgCariDokter(null,false);
            dokter=dialog;
            dialog.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
            dialog.addWindowListener(new WindowListener() {
                @Override public void windowOpened(WindowEvent e) {}
                @Override public void windowClosing(WindowEvent e) {}
                @Override public void windowClosed(WindowEvent e) {
                    if(akses.getform().equals("DlgReg") && dialog.getTable().getSelectedRow()!=-1){
                        if(pilihan==1){
                            isiDokterTerpilih(
                                    dialog.getTable().getValueAt(dialog.getTable().getSelectedRow(),0).toString(),
                                    dialog.getTable().getValueAt(dialog.getTable().getSelectedRow(),1).toString(),
                                    false,"");
                            KdDokter.requestFocus();
                        }else if(pilihan==2){
                            CrDokter.setText(dialog.getTable().getValueAt(dialog.getTable().getSelectedRow(),1).toString());
                            CrDokter.requestFocus();
                            tampil();
                        }else if(pilihan==3){
                            CrDokter3.setText(dialog.getTable().getValueAt(dialog.getTable().getSelectedRow(),1).toString());
                            CrDokter3.requestFocus();
                        }
                    }
                    if(dokter==dialog){
                        dokter=null;
                    }
                }
                @Override public void windowIconified(WindowEvent e) {}
                @Override public void windowDeiconified(WindowEvent e) {}
                @Override public void windowActivated(WindowEvent e) {}
                @Override public void windowDeactivated(WindowEvent e) {}
            });
            System.out.println("[PERFORMA MODUL] Pencarian Dokter siap dalam "+
                    ((System.nanoTime()-mulai)/1_000_000L)+" ms");
        }
        return dokter;
    }

    public DlgCariDokter2 getDokter2() {
        if(dokter2==null){
            final long mulai=System.nanoTime();
            final DlgCariDokter2 dialog=new DlgCariDokter2(null,false);
            dokter2=dialog;
            dialog.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
            dialog.addWindowListener(new WindowListener() {
                @Override public void windowOpened(WindowEvent e) {}
                @Override public void windowClosing(WindowEvent e) {}
                @Override public void windowClosed(WindowEvent e) {
                    if(akses.getform().equals("DlgReg") && dialog.getTable().getSelectedRow()!=-1){
                        if(pilihan==1){
                            isiDokterTerpilih(
                                    dialog.getTable().getValueAt(dialog.getTable().getSelectedRow(),0).toString(),
                                    dialog.getTable().getValueAt(dialog.getTable().getSelectedRow(),1).toString(),
                                    aktifjadwal.equals("aktif"),
                                    nilaiAmanTabel(dialog.getTable(),dialog.getTable().getSelectedRow(),13));
                            KdDokter.requestFocus();
                        }else if(pilihan==2){
                            CrDokter.setText(dialog.getTable().getValueAt(dialog.getTable().getSelectedRow(),1).toString());
                            CrDokter.requestFocus();
                            tampil();
