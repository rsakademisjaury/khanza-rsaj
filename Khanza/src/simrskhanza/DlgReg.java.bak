    public void setPasien(String NamaPasien,String Kontak,String Alamat,String TempatLahir,String TglLahir,
            String JK,String NoKartuJKN,String NIK,String nosisrute,String FaskesAsal){
        akses.setform("DlgReg");
        ChkInput.setSelected(true);
        isForm(); 
        DlgPasien dlgPasien=getPasien();
        dlgPasien.emptTeks();
        dlgPasien.isCek();
        this.nosisrute=nosisrute;
        isiPerujukOtomatis(FaskesAsal, "-");
        dlgPasien.setPasien(NamaPasien, Kontak, Alamat, TempatLahir, TglLahir, JK, NoKartuJKN, NIK);
        dlgPasien.setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
        dlgPasien.setLocationRelativeTo(internalFrame1);
        dlgPasien.setVisible(true);
    }
    
    private void initRegistrasi() {
