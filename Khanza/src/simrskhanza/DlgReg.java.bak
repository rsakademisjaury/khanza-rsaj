    private void ChkAutoRefresActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_ChkAutoRefresActionPerformed
    if (ChkAutoRefres.isSelected()) {
        if (timerPantauFinger == null) {
            otomatisRefresh();
        }

        refreshStatusPantauFinger();

        // Jika masih ada antrean pantau yang menunggu,
        // refreshStatusPantauFinger() akan membiarkan checkbox tetap aktif.
        if (ChkAutoRefres.isSelected() && !timerPantauFinger.isRunning()) {
            timerPantauFinger.start();
        }
    } else {
        if (timerPantauFinger != null) {
            timerPantauFinger.stop();
        }
    }
    }//GEN-LAST:event_ChkAutoRefresActionPerformed

    private void BtnPantauFingerBPJSActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_BtnPantauFingerBPJSActionPerformed
        if (tbPetugas.getSelectedRow() == -1) {
            JOptionPane.showMessageDialog(null, "Silakan pilih pasien pada tabel registrasi terlebih dahulu.");
            tbPetugas.requestFocus();
            return;
        }

        int baris = tbPetugas.getSelectedRow();
        String noRawat = tbPetugas.getValueAt(baris, 2) == null ? "" : tbPetugas.getValueAt(baris, 2).toString();
        String kdPj = tbPetugas.getValueAt(baris, 22) == null ? "" : tbPetugas.getValueAt(baris, 22).toString();
        String noSep = tbPetugas.getValueAt(baris, 24) == null ? "" : tbPetugas.getValueAt(baris, 24).toString();
        String statusFinger = tbPetugas.getValueAt(baris, 25) == null ? "" : tbPetugas.getValueAt(baris, 25).toString();

        if (!kdPj.equals("BPJ")) {
            JOptionPane.showMessageDialog(null, "Pantau Finger hanya untuk pasien BPJS Kesehatan.");
            return;
        }

        if (!noSep.equals("SEP Belum Terbit")) {
            JOptionPane.showMessageDialog(null, "SEP pasien sudah terbit, pemantauan finger tidak diperlukan.");
            aturTombolPantauFingerBPJS();
            return;
        }

        // PATCH RSAJ - pasien usia <17 tahun tidak menjalani Bio/Finger.
        // Tombol yang sama dipakai sebagai konfirmasi bahwa pasien sudah datang/melapor di loket.
        int usiaTahun = ambilUsiaTahunSaatRegistrasi(noRawat);
        if (usiaTahun < 0) {
            JOptionPane.showMessageDialog(null,
                "Umur pasien tidak dapat ditentukan dari tanggal lahir dan tanggal registrasi.\n" +
                "Silakan periksa kembali data tanggal lahir pasien.");
            return;
        }

        if (usiaTahun < 17) {
            if (sudahKonfirmasiHadirAnak(noRawat)) {
                JOptionPane.showMessageDialog(null,
                    "Pasien usia <17 tahun ini sudah dikonfirmasi hadir di loket.");
                aturTombolPantauFingerBPJS();
                return;
            }

            if (simpanKonfirmasiHadirAnak(noRawat)) {
                JOptionPane.showMessageDialog(null,
                    "Kedatangan pasien usia <17 tahun berhasil dikonfirmasi.\n" +
                    "Pasien tidak perlu melakukan Bio/Finger.");
                tampil();
                aturTombolPantauFingerBPJS();
            }
            return;
        }

        // Pasien usia >=17 tahun tetap menggunakan alur Pantau Finger yang lama.
        if (sudahAdaMonitorFingerBPJS(noRawat)) {
            JOptionPane.showMessageDialog(null, "Pasien sudah masuk antrean Pantau Finger BPJS.");
            aturTombolPantauFingerBPJS();
            return;
        }

        if (!statusFinger.equals("Belum Sidik Jari")) {
            JOptionPane.showMessageDialog(null, "Finger pasien sudah tercatat, silakan lanjutkan pembuatan SEP.");
            return;
        }

        String sqlPantau = "INSERT INTO bpjs_finger_monitor " +
                "(no_rawat,no_kartu,tgl_pelayanan,status,attempt_count,last_checked_at,next_check_at," +
                "response_code,response_message,requested_at,completed_at,created_at,updated_at) " +
                "SELECT rp.no_rawat,p.no_peserta,rp.tgl_registrasi,'ACTIVE',0,NULL,NOW(),NULL,NULL,NOW(),NULL,NOW(),NOW() " +
                "FROM reg_periksa rp INNER JOIN pasien p ON rp.no_rkm_medis=p.no_rkm_medis " +
                "WHERE rp.no_rawat=? AND rp.kd_pj='BPJ' " +
                "ON DUPLICATE KEY UPDATE no_kartu=VALUES(no_kartu),tgl_pelayanan=VALUES(tgl_pelayanan)," +
                "status='ACTIVE',attempt_count=0,last_checked_at=NULL,next_check_at=NOW()," +
                "response_code=NULL,response_message=NULL,requested_at=NOW(),completed_at=NULL,updated_at=NOW()";

        try (PreparedStatement psPantau = koneksi.prepareStatement(sqlPantau)) {
            psPantau.setString(1, noRawat);
            int hasil = psPantau.executeUpdate();
            if (hasil > 0) {
                JOptionPane.showMessageDialog(null,
                    "Pasien berhasil dimasukkan ke antrean Pantau Finger BPJS.\n" +
                    "Tombol ini hanya menyimpan antrean lokal dan tidak langsung menghit BPJS.");
                tampil();
                aturTombolPantauFingerBPJS();
                aktifkanAutoRefreshPantauFinger();
            } else {
                JOptionPane.showMessageDialog(null, "Data pasien BPJS tidak ditemukan.");
            }
        } catch (Exception e) {
            JOptionPane.showMessageDialog(null,
                "Gagal menyimpan antrean Pantau Finger BPJS.\n" +
                "Pastikan tabel bpjs_finger_monitor sudah dibuat.\n\n" + e.getMessage());
            System.out.println("Notifikasi Pantau Finger BPJS : " + e);
        }
    }//GEN-LAST:event_BtnPantauFingerBPJSActionPerformed

    private void MnPenatalaksanaanTerapiOkupasiActionPerformed(java.awt.event.ActionEvent evt) {                                                      
        if(tabMode.getRowCount()==0){
            JOptionPane.showMessageDialog(null,"Maaf, data registrasi sudah habis...!!!!");
            TNoRM.requestFocus();
        }else if(TPasien.getText().trim().equals("")){
            JOptionPane.showMessageDialog(null,"Maaf, Silahkan anda pilih dulu data pasien dengan menklik data pada table...!!!");
            tbPetugas.requestFocus();
        }else{
            if(tbPetugas.getSelectedRow()!= -1){
                this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
                RMPenatalaksanaanTerapiOkupasi form=new RMPenatalaksanaanTerapiOkupasi(null,false);
                form.isCek();
                form.setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
                form.setLocationRelativeTo(internalFrame1);
                form.setVisible(true);
                form.emptTeks();
                form.setNoRm(TNoRw.getText(),DTPCari2.getDate());
                form.tampil();
                this.setCursor(Cursor.getDefaultCursor());
            }
        }
    }
  
