    private void BtnKeluarActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_BtnKeluarActionPerformed
        if (timerPantauFinger != null) {
            timerPantauFinger.stop();
        }
        ChkAutoRefres.setSelected(false);
        if(pasien!=null){
            pasien.dispose();
            pasien.bahasa.dispose();
            pasien.cacat.dispose();
            pasien.golonganpolri.dispose();
            pasien.golongantni.dispose();
            pasien.jabatanpolri.dispose();
            pasien.jabatantni.dispose();
            pasien.kab.dispose();
            pasien.kec.dispose();
            pasien.kel.dispose();
            pasien.pangkatpolri.dispose();
            pasien.pangkattni.dispose();
            pasien.penjab.dispose();
            pasien.perusahaan.dispose();
            pasien.prop.dispose();
            pasien.satuanpolri.dispose();
            pasien.satuantni.dispose();
            pasien.suku.dispose();
            pasien=null;
        }
        if(dokter!=null){dokter.dispose(); dokter=null;}
        if(dokter2!=null){dokter2.dispose(); dokter2=null;}
        if(poli!=null){poli.dispose(); poli=null;}
        if(poli2!=null){poli2.dispose(); poli2=null;}
        if(rujukmasuk!=null){
            rujukmasuk.WindowPerujuk.dispose();
            rujukmasuk.dispose();
            rujukmasuk=null;
        }
        DlgSakit2.dispose();
        DlgDemografi.dispose();
        DlgCatatan.dispose();
        akses.setAktif(false);
        dispose();
}//GEN-LAST:event_BtnKeluarActionPerformed

