    // PATCH RSAJ - autocomplete registrasi menggunakan cache lokal per form.
    // Cache dimuat sekali saat diperlukan dan dipakai untuk seluruh proses
    // ketik/cari berikutnya. Query ke database tidak dijalankan per karakter.
    private static final class CachePoliAutocomplete {
        private final String kode, nama, biayaBaru, biayaLama;
        private CachePoliAutocomplete(String kode, String nama, String biayaBaru, String biayaLama) {
            this.kode = kode == null ? "" : kode;
            this.nama = nama == null ? "" : nama;
            this.biayaBaru = biayaBaru == null ? "" : biayaBaru;
            this.biayaLama = biayaLama == null ? "" : biayaLama;
        }
    }

    private static final class CacheDokterAutocomplete {
        private final String kode, nama, kodePoli, kuota;
        private final boolean dariJadwal;
        private CacheDokterAutocomplete(String kode, String nama, String kodePoli, String kuota, boolean dariJadwal) {
            this.kode = kode == null ? "" : kode;
            this.nama = nama == null ? "" : nama;
            this.kodePoli = kodePoli == null ? "" : kodePoli;
            this.kuota = kuota == null ? "" : kuota;
            this.dariJadwal = dariJadwal;
        }
    }

    private static final class CachePenjabAutocomplete {
        private final String kode, nama;
        private CachePenjabAutocomplete(String kode, String nama) {
            this.kode = kode == null ? "" : kode;
            this.nama = nama == null ? "" : nama;
        }
    }

    /** Cache daftar asal rujukan/perujuk untuk pencarian lokal pada form registrasi. */
    private static final class CachePerujukAutocomplete {
        private final String nama, alamat;
        private CachePerujukAutocomplete(String nama, String alamat) {
            this.nama = nama == null ? "" : nama;
            this.alamat = alamat == null ? "" : alamat;
        }
    }

    private final java.util.List<CachePoliAutocomplete> cachePoliAutocomplete = new java.util.ArrayList<CachePoliAutocomplete>();
    private final java.util.List<CacheDokterAutocomplete> cacheDokterAutocomplete = new java.util.ArrayList<CacheDokterAutocomplete>();
    private final java.util.List<CachePenjabAutocomplete> cachePenjabAutocomplete = new java.util.ArrayList<CachePenjabAutocomplete>();
    private final java.util.List<CachePerujukAutocomplete> cachePerujukAutocomplete = new java.util.ArrayList<CachePerujukAutocomplete>();
