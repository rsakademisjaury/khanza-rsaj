private void kdpnjKeyPressed(java.awt.event.KeyEvent evt) {//GEN-FIRST:event_kdpnjKeyPressed
       if(evt.getKeyCode()==KeyEvent.VK_PAGE_DOWN){
            boolean statusAwal = sedangMengisiJenisBayarOtomatis;
            sedangMengisiJenisBayarOtomatis = true;
            try{
                if (timerCariAutocompletePenjab != null) timerCariAutocompletePenjab.stop();
                if (popupAutocompletePenjab != null) popupAutocompletePenjab.setVisible(false);
                Sequel.cariIsi("select penjab.png_jawab from penjab where penjab.kd_pj=?",nmpnj,kdpnj.getText());
            }finally{
                sedangMengisiJenisBayarOtomatis = statusAwal;
            }
        }else if(evt.getKeyCode()==KeyEvent.VK_PAGE_UP){
            TAlmt.requestFocus();
        }else if(evt.getKeyCode()==KeyEvent.VK_ENTER){
            AsalRujukan.requestFocus();      
        }else if(evt.getKeyCode()==KeyEvent.VK_UP){
            btnPenjabActionPerformed(null);
        }
}//GEN-LAST:event_kdpnjKeyPressed

