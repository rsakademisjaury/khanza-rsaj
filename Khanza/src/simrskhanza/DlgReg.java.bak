    // PATCH RSAJ - Mengganti tombol panggil/loket menjadi pencarian rujukan BPJS mandiri berdasarkan NIK.
    private void initCekRujukanNikMandiri() {
        try {
            BtnPanggilPasien.setVisible(false);
            Panggil1.setVisible(false);
            Ulang1.setVisible(false);
            jLabel28.setVisible(false);
            sisa_antrian1.setVisible(false);
            nomor_antrian1.setVisible(false);
            loket_antrian1.setVisible(false);

            LblCekRujukanNIK = new widget.Label();
            LblCekRujukanNIK.setHorizontalAlignment(javax.swing.SwingConstants.LEFT);
            LblCekRujukanNIK.setText("NIK Pasien :");
            LblCekRujukanNIK.setName("LblCekRujukanNIK"); // NOI18N
            FormInput.add(LblCekRujukanNIK);
            LblCekRujukanNIK.setBounds(720, 180, 75, 30);

            TCekRujukanNIK = new widget.TextBox();
            TCekRujukanNIK.setName("TCekRujukanNIK"); // NOI18N
            TCekRujukanNIK.setToolTipText("Input NIK pasien 16 digit, lalu tekan Enter atau klik Cek Rujukan");
            TCekRujukanNIK.setDocument(new batasInput((byte)16).getOnlyAngka(TCekRujukanNIK));
            TCekRujukanNIK.addKeyListener(new java.awt.event.KeyAdapter() {
                public void keyPressed(java.awt.event.KeyEvent evt) {
                    if (evt.getKeyCode() == KeyEvent.VK_ENTER) {
                        BtnCekRujukanNIKActionPerformed(null);
                    }
                }
            });
            FormInput.add(TCekRujukanNIK);
            TCekRujukanNIK.setBounds(795, 180, 120, 30);
            
            BtnCekRujukanNIK = new widget.Button();
            BtnCekRujukanNIK.setIcon(new javax.swing.ImageIcon(getClass().getResource("/picture/calendar (4).png")));
            BtnCekRujukanNIK.setText("Cek Rujukan");
            BtnCekRujukanNIK.setName("BtnCekRujukanNIK"); // NOI18N
            BtnCekRujukanNIK.setToolTipText("Cari No.Kartu dari NIK dan tampilkan rujukan BPJS");
            BtnCekRujukanNIK.addActionListener(new java.awt.event.ActionListener() {
                public void actionPerformed(java.awt.event.ActionEvent evt) {
                    BtnCekRujukanNIKActionPerformed(evt);
                }
            });
            FormInput.add(BtnCekRujukanNIK);
            BtnCekRujukanNIK.setBounds(920, 180, 120, 30);

            FormInput.repaint();
        } catch (Exception e) {
            System.out.println("Notif Init Cek Rujukan NIK : " + e);
        }
    }

    private void BtnCekRujukanNIKActionPerformed(java.awt.event.ActionEvent evt) {
        String nik = TCekRujukanNIK.getText().trim();
        if (nik.equals("")) {
            Valid.textKosong(TCekRujukanNIK, "NIK Pasien");
            return;
        }
        if (nik.length() != 16) {
            JOptionPane.showMessageDialog(null, "NIK harus 16 digit.");
            TCekRujukanNIK.requestFocus();
            return;
        }

        String noKartu = "";
        PreparedStatement psCekRujukanNik = null;
        ResultSet rsCekRujukanNik = null;
        try {
            setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
            psCekRujukanNik = koneksi.prepareStatement(
                    "select no_peserta from pasien where no_ktp=? and no_peserta<>'' and no_peserta<>'-' limit 1");
            psCekRujukanNik.setString(1, nik);
            rsCekRujukanNik = psCekRujukanNik.executeQuery();
            if (rsCekRujukanNik.next()) {
                noKartu = rsCekRujukanNik.getString("no_peserta");
            }
        } catch (Exception e) {
            System.out.println("Notif Cek Rujukan NIK : " + e);
            JOptionPane.showMessageDialog(null, "Gagal mencari No.Kartu dari NIK pasien.\n" + e.getMessage());
        } finally {
            try {
                if (rsCekRujukanNik != null) {
                    rsCekRujukanNik.close();
                }
            } catch (Exception e) {
                System.out.println("Notif close rs cek rujukan nik : " + e);
            }
            try {
                if (psCekRujukanNik != null) {
                    psCekRujukanNik.close();
                }
            } catch (Exception e) {
                System.out.println("Notif close ps cek rujukan nik : " + e);
            }
            setCursor(Cursor.getDefaultCursor());
        }

        if (noKartu == null || noKartu.trim().equals("")) {
            JOptionPane.showMessageDialog(null, "No.Kartu BPJS tidak ditemukan untuk NIK : " + nik);
            TCekRujukanNIK.requestFocus();
            return;
        }

        BPJSCekRujukanKartuPCarePopup popup = new BPJSCekRujukanKartuPCarePopup(null, false);
        popup.setLocationRelativeTo(this);
        popup.setNoKartu(noKartu.trim());
        popup.setVisible(true);
    }


