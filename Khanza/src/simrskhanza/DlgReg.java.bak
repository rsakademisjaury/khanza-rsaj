    /** Membuka modul photoktp dengan autentikasi yang sama seperti photopasien. */
    private void bukaModulFotoKTP(String mode, String namaAksi){
        if(TNoRM.getText().trim().equals("") || TPasien.getText().trim().equals("")){
            Valid.textKosong(TNoRM, "pasien");
            return;
        }
        this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
        try{
            Valid.panggilUrlcamera("photoktp/login.php?act=login&mode="+mode+"&usere="+koneksiDB.USERHYBRIDWEB()+
                    "&passwordte="+koneksiDB.PASHYBRIDWEB()+"&norm="+TNoRM.getText().trim());
        }catch(Exception e){
            JOptionPane.showMessageDialog(rootPane, "Gagal membuka "+namaAksi+" : "+e.getMessage());
        }finally{
            this.setCursor(Cursor.getDefaultCursor());
        }
    }
    
    /** Membuka modul photoktp dengan autentikasi yang sama seperti photopasien. */
    private void bukaUploadFotoKTP(String mode, String namaAksi){
        if(TNoRM.getText().trim().equals("") || TPasien.getText().trim().equals("")){
            Valid.textKosong(TNoRM, "pasien");
            return;
        }
        this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
        try{
            Valid.panggilUrl("photoktp/login.php?act=login&mode="+mode+"&usere="+koneksiDB.USERHYBRIDWEB()+
                    "&passwordte="+koneksiDB.PASHYBRIDWEB()+"&norm="+TNoRM.getText().trim());
        }catch(Exception e){
            JOptionPane.showMessageDialog(rootPane, "Gagal membuka "+namaAksi+" : "+e.getMessage());
        }finally{
            this.setCursor(Cursor.getDefaultCursor());
        }
    }    

    /**
     * Memberi jeda 400 ms ketika No.RM berubah. Saat petugas berpindah cepat
     * pada tabel, hanya No.RM terakhir yang benar-benar dimuat.
     */
    private void pasangPemantauNoRMFotoKTP(){
        timerMuatFotoKTP = new Timer(DELAY_MUAT_FOTO_KTP, new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                panggilFotoKTP();
            }
        });
        timerMuatFotoKTP.setRepeats(false);

        TNoRM.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            private void jadwalkanMuatFotoKTP(){
                if(timerMuatFotoKTP != null){
                    timerMuatFotoKTP.restart();
                }
            }
            @Override public void insertUpdate(DocumentEvent e) { jadwalkanMuatFotoKTP(); }
            @Override public void removeUpdate(DocumentEvent e) { jadwalkanMuatFotoKTP(); }
            @Override public void changedUpdate(DocumentEvent e) { jadwalkanMuatFotoKTP(); }
        });
    }

    /** Mengambil No.RM dari kolom ke-8 / index 7 tabel registrasi yang dipilih. */
    private void panggilFotoKTPDariTabel(){
        int baris = tbPetugas.getSelectedRow();
        if(baris != -1 && tbPetugas.getColumnCount() > 7){
            Object noRM = tbPetugas.getValueAt(baris, 7);
            panggilFotoKTP(noRM == null ? "" : noRM.toString());
        }
    }

    private void panggilFotoKTP(){
        panggilFotoKTP(TNoRM.getText(), false);
    }

    private void panggilFotoKTP(String nomorRM){
        panggilFotoKTP(nomorRM, false);
    }

    /**
     * Memuat thumbnail Foto KTP melalui SwingWorker, sehingga thread tampilan
     * DlgReg tidak berhenti ketika jaringan/Hybrid Web lambat.
     *
     * Cache menyimpan No.RM terakhir, termasuk kondisi foto belum tersedia.
     * Tombol Muat Ulang memanggil metode ini dengan paksaMuat=true.
     */
    private void panggilFotoKTP(String nomorRM, boolean paksaMuat){
        panggilFotoKTP(nomorRM, paksaMuat, false);
    }

    /**
     * Memuat foto KTP. OCR hanya dipanggil pada Refresh manual supaya foto
     * terbaru sudah tersimpan dan petugas tidak mendapat hasil dari foto lama.
     */
    private void panggilFotoKTP(String nomorRM, boolean paksaMuat, final boolean jalankanOCR){
        final String noRM = nomorRM == null ? "" : nomorRM.trim();
        if(noRM.equals("") || !noRM.matches("[A-Za-z0-9._-]{1,20}")){
            batalkanPemuatanFotoKTP();
            noRMFotoKTPTerakhir = "";
            noRMFotoKTPDiminta = "";
            tampilkanFotoKTPKosong();
            return;
        }

        if(!paksaMuat && noRM.equals(noRMFotoKTPTerakhir)){
            return;
        }
        if(!paksaMuat && noRM.equals(noRMFotoKTPDiminta)){
            return;
        }

        batalkanPemuatanFotoKTP();
        tampilkanFotoKTPKosong();
        noRMFotoKTPDiminta = noRM;
        final long nomorProses = ++nomorProsesFotoKTP;
        LblFotoKTP.setToolTipText("Memuat thumbnail Foto KTP pasien ...");

        workerMuatFotoKTP = new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() throws Exception {
                return unduhFotoKTP(noRM, true);
            }

            @Override
            protected void done() {
                if(nomorProses != nomorProsesFotoKTP || isCancelled()){
                    return;
                }
                noRMFotoKTPDiminta = "";
                noRMFotoKTPTerakhir = noRM;
                try{
                    BufferedImage thumbnail = get();
                    if(thumbnail != null){
                        fotoKTPAsli = null;
                        noRMFotoKTP = noRM;
                        fotoKTPTersediaTerakhir = true;
                        tampilkanThumbnailFotoKTP(thumbnail);
                        if(jalankanOCR){
                            jalankanOcrFotoKTPDariWeb(noRM);
                        }
                    }else{
                        fotoKTPTersediaTerakhir = false;
                        tampilkanFotoKTPKosong();
                        if(jalankanOCR){
                            JOptionPane.showMessageDialog(rootPane,
                                    "Foto KTP pasien belum tersedia. Unggah atau ambil Foto KTP terlebih dahulu.",
                                    "OCR Foto KTP", JOptionPane.WARNING_MESSAGE);
                        }
                    }
                }catch(Exception e){
                    fotoKTPTersediaTerakhir = false;
                    tampilkanFotoKTPKosong();
                }
            }
        };
        workerMuatFotoKTP.execute();
    }

    private void batalkanPemuatanFotoKTP(){
        nomorProsesFotoKTP++;
        if(workerMuatFotoKTP != null && !workerMuatFotoKTP.isDone()){
            workerMuatFotoKTP.cancel(true);
        }
        if(workerMuatFotoKTPBesar != null && !workerMuatFotoKTPBesar.isDone()){
            workerMuatFotoKTPBesar.cancel(true);
        }
        if(workerOcrFotoKTP != null && !workerOcrFotoKTP.isDone()){
            workerOcrFotoKTP.cancel(true);
        }
    }

    /**
     * Mengunduh thumbnail untuk tampilan awal. Untuk file dari versi lama yang
     * belum mempunyai thumbnail, foto utama dipakai sebagai fallback sekali.
     */
    private BufferedImage unduhFotoKTP(String noRM, boolean thumbnail){
        String[] namaFile;
        if(thumbnail){
            namaFile = new String[]{noRM+"_thumb.jpg", noRM+"_thumb.jpeg", noRM+".jpg", noRM+".jpeg"};
        }else{
            namaFile = new String[]{noRM+".jpg", noRM+".jpeg"};
        }
        for(String nama : namaFile){
            if(Thread.currentThread().isInterrupted()){
                return null;
            }
            BufferedImage foto = unduhSatuFotoKTP(noRM, nama);
            if(foto != null){
                return foto;
            }
        }
        return null;
    }

    private BufferedImage unduhSatuFotoKTP(String noRM, String namaFile){
        HttpURLConnection koneksiFoto = null;
        InputStream inputFoto = null;
        try{
            String alamatFoto = "http://"+koneksiDB.HOSTHYBRIDWEB()+":"+
                    koneksiDB.PORTWEB()+"/"+koneksiDB.HYBRIDWEB()+
                    "/photoktp/pages/upload/"+namaFile+"?v="+System.currentTimeMillis();
            koneksiFoto = (HttpURLConnection)new URL(alamatFoto).openConnection();
            koneksiFoto.setRequestMethod("GET");
            koneksiFoto.setConnectTimeout(TIMEOUT_KONEKSI_FOTO_KTP);
            koneksiFoto.setReadTimeout(TIMEOUT_BACA_FOTO_KTP);
            koneksiFoto.setUseCaches(false);
            koneksiFoto.setRequestProperty("Cache-Control", "no-cache");

            if(koneksiFoto.getResponseCode() != HttpURLConnection.HTTP_OK){
                return null;
            }
            String tipe = koneksiFoto.getContentType();
            if(tipe != null && tipe.toLowerCase().contains("text/html")){
                return null;
            }
            inputFoto = koneksiFoto.getInputStream();
            return ImageIO.read(inputFoto);
        }catch(Exception e){
            // Foto belum tersedia atau layanan Hybrid Web sedang tidak dapat diakses.
            // Tidak menampilkan notifikasi agar alur registrasi tetap lancar.
            return null;
        }finally{
            try{
                if(inputFoto != null){
                    inputFoto.close();
                }
            }catch(Exception e){}
            if(koneksiFoto != null){
                koneksiFoto.disconnect();
            }
        }
    }

    /** Menampilkan thumbnail Foto KTP utuh pada kotak Foto KTP. */
    private void tampilkanThumbnailFotoKTP(BufferedImage thumbnail){
        LblFotoKTP.setText("");
        LblFotoKTP.setHorizontalTextPosition(javax.swing.SwingConstants.CENTER);
        LblFotoKTP.setVerticalTextPosition(javax.swing.SwingConstants.CENTER);
        LblFotoKTP.setIcon(new ImageIcon(skalaFotoKTP(thumbnail, FOTO_KTP_LEBAR, FOTO_KTP_TINGGI)));
        LblFotoKTP.setToolTipText("Foto KTP pasien. Gunakan tombol Zoom untuk melihat lebih jelas atau Unduh untuk menyimpan dokumen.");
        BtnZoomFotoKTP.setEnabled(true);
        if(BtnUnduhFotoKTP != null){
            BtnUnduhFotoKTP.setEnabled(true);
            BtnUnduhFotoKTP.setToolTipText("Cetak Foto KTP pada kertas F4/Folio");
        }
    }

    private BufferedImage skalaFotoKTP(BufferedImage sumber){
        return skalaFotoKTP(sumber, FOTO_KTP_LEBAR, FOTO_KTP_TINGGI);
    }

    /** Mempertahankan rasio asli gambar di atas latar putih. */
    private BufferedImage skalaFotoKTP(BufferedImage sumber, int lebarTarget, int tinggiTarget){
        BufferedImage hasil = new BufferedImage(lebarTarget, tinggiTarget, BufferedImage.TYPE_INT_RGB);
        Graphics2D g2 = hasil.createGraphics();
        try{
            g2.setColor(Color.WHITE);
            g2.fillRect(0, 0, lebarTarget, tinggiTarget);
            g2.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BILINEAR);
            g2.setRenderingHint(RenderingHints.KEY_RENDERING, RenderingHints.VALUE_RENDER_QUALITY);

            double faktor = Math.min((double)lebarTarget / sumber.getWidth(),
                    (double)tinggiTarget / sumber.getHeight());
            int lebar = (int)Math.round(sumber.getWidth() * faktor);
            int tinggi = (int)Math.round(sumber.getHeight() * faktor);
            int xGambar = (lebarTarget - lebar) / 2;
            int yGambar = (tinggiTarget - tinggi) / 2;
            g2.drawImage(sumber, xGambar, yGambar, lebar, tinggi, null);
        }finally{
            g2.dispose();
        }
        return hasil;
    }

    /** Ikon kamera untuk keadaan foto belum tersedia. */
    private ImageIcon buatIkonKameraKTP(){
        if(ikonKameraKTP != null){
            return ikonKameraKTP;
        }
        BufferedImage gambar = new BufferedImage(54, 40, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g2 = gambar.createGraphics();
        try{
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(new Color(95, 95, 95));
            g2.fillRoundRect(4, 10, 46, 27, 5, 5);
            g2.fillRoundRect(17, 5, 19, 8, 3, 3);
            g2.setColor(Color.WHITE);
            g2.fillOval(19, 15, 16, 16);
            g2.setColor(new Color(95, 95, 95));
            g2.fillOval(22, 18, 10, 10);
        }finally{
            g2.dispose();
        }
        ikonKameraKTP = new ImageIcon(gambar);
        return ikonKameraKTP;
    }

    /**
     * Menggunakan resource standar Khanza /picture/zoom-in.png.
     * Jangan menggambar ikon manual di sini karena pemanggilan setelah
     * initComponents() akan menimpa ikon yang dipilih pada NetBeans Form.
     */
    private ImageIcon buatIkonZoomKTP(){
        if(ikonZoomKTP != null){
            return ikonZoomKTP;
        }
        URL lokasiIkon = getClass().getResource("/picture/zoom-in.png");
        if(lokasiIkon != null){
            ikonZoomKTP = new ImageIcon(lokasiIkon);
        }else{
            // Tombol tetap dapat dipakai; periksa folder source/picture bila icon kosong.
            ikonZoomKTP = new ImageIcon();
            System.out.println("Notif Foto KTP : File icon /picture/zoom-in.png tidak ditemukan.");
        }
        return ikonZoomKTP;
    }

    private void tampilkanFotoKTPKosong(){
        fotoKTPAsli = null;
        noRMFotoKTP = "";
        LblFotoKTP.setIcon(buatIkonKameraKTP());
        LblFotoKTP.setText("<html><center>Unggah / Ambil Foto KTP<br>Pasien</center></html>");
        LblFotoKTP.setHorizontalTextPosition(javax.swing.SwingConstants.CENTER);
        LblFotoKTP.setVerticalTextPosition(javax.swing.SwingConstants.BOTTOM);
        LblFotoKTP.setToolTipText("Foto KTP belum tersedia. Gunakan tombol Kamera atau Unggah di sebelah kiri.");
        if(BtnZoomFotoKTP != null){
            BtnZoomFotoKTP.setEnabled(false);
        }
        if(BtnUnduhFotoKTP != null){
            BtnUnduhFotoKTP.setEnabled(false);
        }
    }

    /**
     * Zoom hanya mengunduh foto utama saat benar-benar diminta. Tampilan awal
     * DlgReg selalu memakai thumbnail agar perpindahan data registrasi ringan.
     */
    private void tampilkanFotoKTPBesar(){
        final String noRM = noRMFotoKTP;
        if(noRM.equals("")){
            return;
        }
        if(fotoKTPAsli != null){
            bukaDialogFotoKTPBesar(fotoKTPAsli);
            return;
        }
        if(workerMuatFotoKTPBesar != null && !workerMuatFotoKTPBesar.isDone()){
            return;
        }

        BtnZoomFotoKTP.setEnabled(false);
        BtnZoomFotoKTP.setToolTipText("Memuat foto KTP ukuran penuh ...");
        workerMuatFotoKTPBesar = new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() throws Exception {
                return unduhFotoKTP(noRM, false);
            }

            @Override
            protected void done() {
                if(!noRM.equals(noRMFotoKTP)){
                    return;
                }
                try{
                    BufferedImage foto = get();
                    if(foto != null){
                        fotoKTPAsli = foto;
                        BtnZoomFotoKTP.setEnabled(true);
                        BtnZoomFotoKTP.setToolTipText("Perbesar Foto KTP Pasien");
                        bukaDialogFotoKTPBesar(foto);
                    }else{
                        BtnZoomFotoKTP.setEnabled(fotoKTPTersediaTerakhir);
                        BtnZoomFotoKTP.setToolTipText("Foto ukuran penuh tidak ditemukan. Silakan Muat Ulang bila foto baru saja diunggah.");
                    }
                }catch(Exception e){
                    BtnZoomFotoKTP.setEnabled(fotoKTPTersediaTerakhir);
                    BtnZoomFotoKTP.setToolTipText("Gagal memuat foto ukuran penuh. Coba lagi.");
                }
            }
        };
        workerMuatFotoKTPBesar.execute();
    }

    /**
     * Menampilkan foto KTP ukuran penuh dalam dialog zoom interaktif.
     * User dapat memperbesar/memperkecil gambar agar tulisan kecil pada KTP
     * lebih mudah dibaca. Ukuran awal sengaja dibuat lebih besar dari ukuran
     * asli file bila diperlukan agar detail seperti NIK, alamat, dan tanggal
     * lahir bisa diperiksa dengan jelas. Tampilan awal menggunakan 100%.
     */
    private void bukaDialogFotoKTPBesar(final BufferedImage gambar){
        if(gambar == null){
            return;
        }

        final javax.swing.JDialog lihatFoto = new javax.swing.JDialog(this, "Zoom Foto KTP Pasien", true);
        final javax.swing.JLabel labelFoto = new javax.swing.JLabel();
        labelFoto.setHorizontalAlignment(javax.swing.SwingConstants.CENTER);
        labelFoto.setVerticalAlignment(javax.swing.SwingConstants.CENTER);
        labelFoto.setOpaque(true);
        labelFoto.setBackground(Color.WHITE);
        labelFoto.setBorder(javax.swing.BorderFactory.createCompoundBorder(
                javax.swing.BorderFactory.createLineBorder(new Color(120,120,120)),
                javax.swing.BorderFactory.createEmptyBorder(10,10,10,10)));

        final javax.swing.JScrollPane scroll = new javax.swing.JScrollPane(labelFoto);
        scroll.getViewport().setBackground(new Color(245,245,245));
        scroll.setBorder(javax.swing.BorderFactory.createEmptyBorder(6,6,6,6));

        final javax.swing.JSlider sliderZoom = new javax.swing.JSlider(25, 600, 100);
        sliderZoom.setMajorTickSpacing(25);
        sliderZoom.setMinorTickSpacing(5);
        sliderZoom.setPaintTicks(false);
        sliderZoom.setFocusable(false);

        final javax.swing.JLabel lblInfoZoom = new javax.swing.JLabel(" ");
        lblInfoZoom.setHorizontalAlignment(javax.swing.SwingConstants.RIGHT);

        final Runnable refreshZoom = new Runnable(){
            @Override
            public void run() {
                int persen = Math.max(25, Math.min(600, sliderZoom.getValue()));
                int lebar = Math.max(1, (int)Math.round(gambar.getWidth() * (persen / 100.0)));
                int tinggi = Math.max(1, (int)Math.round(gambar.getHeight() * (persen / 100.0)));
                BufferedImage skala = skalaFotoKTP(gambar, lebar, tinggi);
                labelFoto.setIcon(new ImageIcon(skala));
                labelFoto.setPreferredSize(new Dimension(lebar + 20, tinggi + 20));
                lblInfoZoom.setText("Zoom : " + persen + "%    Ukuran : " + lebar + " x " + tinggi + " px");
                labelFoto.revalidate();
            }
        };

        javax.swing.JButton btnKurang = new javax.swing.JButton("-");
        btnKurang.setFocusable(false);
        btnKurang.setMargin(new java.awt.Insets(2, 10, 2, 10));
        btnKurang.addActionListener(new java.awt.event.ActionListener(){
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                sliderZoom.setValue(Math.max(sliderZoom.getMinimum(), sliderZoom.getValue() - 10));
            }
        });

        javax.swing.JButton btnTambah = new javax.swing.JButton("+");
        btnTambah.setFocusable(false);
        btnTambah.setMargin(new java.awt.Insets(2, 10, 2, 10));
        btnTambah.addActionListener(new java.awt.event.ActionListener(){
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                sliderZoom.setValue(Math.min(sliderZoom.getMaximum(), sliderZoom.getValue() + 10));
            }
        });

        javax.swing.JButton btnReset = new javax.swing.JButton("Reset");
        btnReset.setFocusable(false);
        btnReset.addActionListener(new java.awt.event.ActionListener(){
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                sliderZoom.setValue(100);
            }
        });

        sliderZoom.addChangeListener(new javax.swing.event.ChangeListener(){
            @Override
            public void stateChanged(javax.swing.event.ChangeEvent e) {
                refreshZoom.run();
            }
        });

        scroll.addMouseWheelListener(new java.awt.event.MouseWheelListener(){
            @Override
            public void mouseWheelMoved(java.awt.event.MouseWheelEvent e) {
                if(e.isControlDown()){
                    int nilai = sliderZoom.getValue() - (e.getWheelRotation() * 10);
                    sliderZoom.setValue(Math.max(sliderZoom.getMinimum(), Math.min(sliderZoom.getMaximum(), nilai)));
                    e.consume();
                }
            }
        });

        javax.swing.JPanel panelKontrol = new javax.swing.JPanel(new java.awt.BorderLayout(8, 0));
        panelKontrol.setBorder(javax.swing.BorderFactory.createEmptyBorder(8, 8, 8, 8));
        javax.swing.JPanel panelKiri = new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT, 6, 0));
        panelKiri.add(new javax.swing.JLabel("Perbesar / Perkecil"));
        panelKiri.add(btnKurang);
        panelKiri.add(sliderZoom);
        panelKiri.add(btnTambah);
        panelKiri.add(btnReset);
        panelKontrol.add(panelKiri, java.awt.BorderLayout.WEST);
        panelKontrol.add(lblInfoZoom, java.awt.BorderLayout.CENTER);

        lihatFoto.getContentPane().setLayout(new java.awt.BorderLayout());
        lihatFoto.getContentPane().add(scroll, java.awt.BorderLayout.CENTER);
        lihatFoto.getContentPane().add(panelKontrol, java.awt.BorderLayout.SOUTH);

        java.awt.Dimension layar = java.awt.Toolkit.getDefaultToolkit().getScreenSize();
        int lebarDialog = Math.min((int)(layar.width * 0.92), 1220);
        int tinggiDialog = Math.min((int)(layar.height * 0.88), 860);
        lihatFoto.setSize(lebarDialog, tinggiDialog);
        lihatFoto.setMinimumSize(new java.awt.Dimension(820, 620));
        lihatFoto.setLocationRelativeTo(this);
        refreshZoom.run();
        lihatFoto.setVisible(true);
    }

    /**
     * Mengunduh foto asli ke komputer user. Konfirmasi eksplisit diperlukan
     * karena berkas memuat data pribadi dan hanya boleh dipakai oleh petugas
     * yang berwenang untuk administrasi/penagihan/klaim.
     */
    /**
     * Mencetak Foto KTP asli. Foto diambil ukuran penuh agar hasil cetak tetap
     * jelas, sedangkan thumbnail tetap dipakai untuk kotak kecil di DlgReg.
     */
    private void cetakFotoKTP(){
        final String noRM = noRMFotoKTP == null ? "" : noRMFotoKTP.trim();
        if(noRM.equals("")){
            JOptionPane.showMessageDialog(rootPane, "Foto KTP pasien belum tersedia untuk dicetak.", "Cetak Foto KTP", JOptionPane.WARNING_MESSAGE);
            return;
        }

        int konfirmasi = JOptionPane.showConfirmDialog(rootPane,
                "Cetak Foto KTP pasien No. RM " + noRM + " pada kertas F4/Folio?\n"
                        + "Ukuran foto 85,60 mm x 53,98 mm, margin kiri 6 cm, margin atas 2,5 cm.",
                "Konfirmasi Cetak Foto KTP", JOptionPane.YES_NO_OPTION, JOptionPane.QUESTION_MESSAGE);
        if(konfirmasi != JOptionPane.YES_OPTION){
            return;
        }

        if(fotoKTPAsli != null && noRM.equals(noRMFotoKTP)){
            bukaDialogCetakFotoKTP(fotoKTPAsli);
            return;
        }

        if(workerCetakFotoKTP != null && !workerCetakFotoKTP.isDone()){
            return;
        }
        BtnUnduhFotoKTP.setEnabled(false);
        BtnUnduhFotoKTP.setToolTipText("Memuat Foto KTP ukuran penuh untuk dicetak ...");
        workerCetakFotoKTP = new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() throws Exception {
                return unduhFotoKTP(noRM, false);
            }

            @Override
            protected void done(){
                try{
                    BufferedImage gambar = get();
                    if(gambar == null){
                        JOptionPane.showMessageDialog(rootPane,
                                "Foto KTP ukuran penuh tidak ditemukan. Silakan klik Muat Ulang Foto KTP.",
                                "Cetak Foto KTP", JOptionPane.WARNING_MESSAGE);
                    }else{
                        fotoKTPAsli = gambar;
                        bukaDialogCetakFotoKTP(gambar);
                    }
                }catch(Exception e){
                    JOptionPane.showMessageDialog(rootPane,
                            "Foto KTP gagal dimuat untuk dicetak. Periksa koneksi Hybrid Web atau coba Muat Ulang Foto KTP.\n"
                                    + (e.getMessage() == null ? "" : e.getMessage()),
                            "Cetak Foto KTP", JOptionPane.WARNING_MESSAGE);
                }finally{
                    if(BtnUnduhFotoKTP != null){
                        BtnUnduhFotoKTP.setEnabled(fotoKTPTersediaTerakhir && !noRMFotoKTP.trim().equals(""));
                        BtnUnduhFotoKTP.setToolTipText("Cetak Foto KTP pada kertas F4/Folio");
                    }
                }
            }
        };
        workerCetakFotoKTP.execute();
    }

    /**
     * Mengirim Foto KTP ke printer dengan kertas F4/Folio portrait.
     * Margin fisik: kiri 60 mm dan atas 25 mm. Ukuran foto: 85,60 x 53,98 mm.
     */
    private void bukaDialogCetakFotoKTP(final BufferedImage gambar){
        final double pointPerMm = 72d / 25.4d;
        final double lebarF4 = 210d * pointPerMm;
        final double tinggiF4 = 330d * pointPerMm;
        final double marginKiri = 60d * pointPerMm;
        final double marginAtas = 25d * pointPerMm;
        final double lebarKTP = 85.60d * pointPerMm;
        final double tinggiKTP = 53.98d * pointPerMm;

        PrinterJob pekerjaanCetak = PrinterJob.getPrinterJob();
        PageFormat formatHalaman = pekerjaanCetak.defaultPage();
        Paper kertas = new Paper();
        kertas.setSize(lebarF4, tinggiF4);
        // Posisi gambar memakai koordinat fisik halaman. Margin yang diminta
        // berada jauh dari area tidak tercetak printer pada umumnya.
        kertas.setImageableArea(0d, 0d, lebarF4, tinggiF4);
        formatHalaman.setPaper(kertas);
        formatHalaman.setOrientation(PageFormat.PORTRAIT);

        pekerjaanCetak.setPrintable(new Printable() {
            @Override
            public int print(Graphics graphics, PageFormat pageFormat, int nomorHalaman) throws PrinterException {
                if(nomorHalaman > 0){
                    return Printable.NO_SUCH_PAGE;
                }
                Graphics2D g2 = (Graphics2D)graphics.create();
                try{
                    g2.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BICUBIC);
                    g2.setRenderingHint(RenderingHints.KEY_RENDERING, RenderingHints.VALUE_RENDER_QUALITY);
                    g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                    g2.drawImage(gambar,
                            (int)Math.round(marginKiri),
                            (int)Math.round(marginAtas),
                            (int)Math.round(lebarKTP),
                            (int)Math.round(tinggiKTP), null);
                }finally{
                    g2.dispose();
                }
                return Printable.PAGE_EXISTS;
            }
        }, formatHalaman);

        if(pekerjaanCetak.printDialog()){
            try{
                pekerjaanCetak.print();
            }catch(PrinterException e){
                JOptionPane.showMessageDialog(rootPane,
                        "Foto KTP gagal dicetak: " + e.getMessage(),
                        "Cetak Foto KTP", JOptionPane.WARNING_MESSAGE);
            }
        }
    }


    /**
     * OCR diproses pada browser di halaman unggah/kamera menggunakan
     * Tesseract.js lokal. DlgReg hanya mengambil ringkasan NIK/Nama yang
     * sudah disimpan setelah foto KTP berhasil diunggah.
     */
    private void jalankanOcrFotoKTPDariWeb(final String nomorRM){
        final String noRM = nomorRM == null ? "" : nomorRM.trim();
        if(noRM.equals("") || !noRM.matches("[A-Za-z0-9._-]{1,20}")){
            return;
        }
        if(workerOcrFotoKTP != null && !workerOcrFotoKTP.isDone()){
            return;
        }

        BtnRefreshFotoKTP.setEnabled(false);
        BtnRefreshFotoKTP.setToolTipText("Membaca hasil OCR Foto KTP ...");
        workerOcrFotoKTP = new SwingWorker<HasilOcrKTP, Void>() {
            @Override
            protected HasilOcrKTP doInBackground() throws Exception {
                return bacaHasilOcrFotoKTPWeb(noRM);
            }

            @Override
            protected void done(){
                try{
                    if(isCancelled() || !noRM.equals(noRMFotoKTP)){
                        return;
                    }
                    HasilOcrKTP hasil = get();
                    if(hasil == null || !hasil.sukses()){
                        String pesan = hasil == null ? "Hasil OCR tidak tersedia." : hasil.pesan;
                        if(pesan == null || pesan.trim().equals("")){
                            pesan = "Hasil OCR belum tersedia. Unggah/ambil Foto KTP lalu tunggu proses OCR di halaman browser selesai sebelum menyimpan.";
                        }
                        JOptionPane.showMessageDialog(rootPane,
                                pesan,
                                "OCR Foto KTP", JOptionPane.WARNING_MESSAGE);
                        return;
                    }
                    tampilkanDialogPerbandinganOcrKTP(noRM, hasil);
                }catch(Exception e){
                    JOptionPane.showMessageDialog(rootPane,
                            "Hasil OCR Foto KTP tidak dapat dibaca.\n" +
                            (e.getMessage() == null ? "Coba unggah ulang Foto KTP." : e.getMessage()),
                            "OCR Foto KTP", JOptionPane.WARNING_MESSAGE);
                }finally{
                    if(BtnRefreshFotoKTP != null){
                        BtnRefreshFotoKTP.setEnabled(true);
                        BtnRefreshFotoKTP.setToolTipText("Muat Ulang Foto KTP dan Tampilkan Hasil OCR");
                    }
                }
            }
        };
        workerOcrFotoKTP.execute();
    }

    /** Mengambil ringkasan OCR dari endpoint photoktp yang terautentikasi. */
    private HasilOcrKTP bacaHasilOcrFotoKTPWeb(String noRM){
        HasilOcrKTP hasil = new HasilOcrKTP();
        HttpURLConnection koneksiOcr = null;
        InputStream input = null;
        try{
            String alamat = "http://" + koneksiDB.HOSTHYBRIDWEB() + ":" + koneksiDB.PORTWEB() + "/" +
                    koneksiDB.HYBRIDWEB() + "/photoktp/pages/ocr_result.php?norm=" +
                    java.net.URLEncoder.encode(noRM, "UTF-8") + "&usere=" +
                    java.net.URLEncoder.encode(koneksiDB.USERHYBRIDWEB(), "UTF-8") + "&passwordte=" +
                    java.net.URLEncoder.encode(koneksiDB.PASHYBRIDWEB(), "UTF-8") + "&v=" + System.currentTimeMillis();
            koneksiOcr = (HttpURLConnection)new URL(alamat).openConnection();
            koneksiOcr.setRequestMethod("GET");
            koneksiOcr.setConnectTimeout(TIMEOUT_KONEKSI_FOTO_KTP);
            koneksiOcr.setReadTimeout(TIMEOUT_BACA_FOTO_KTP);
            koneksiOcr.setUseCaches(false);
            koneksiOcr.setRequestProperty("Accept", "application/json");
            int kode = koneksiOcr.getResponseCode();
            input = kode >= 400 ? koneksiOcr.getErrorStream() : koneksiOcr.getInputStream();
            String json = bacaTeksOcrWeb(input);
            if(json.trim().equals("")){
                hasil.pesan = "Endpoint hasil OCR tidak mengirim respons.";
                return hasil;
            }
            hasil.status = ambilNilaiJsonOcr(json, "status");
            hasil.nik = ambilNilaiJsonOcr(json, "nik").replaceAll("[^0-9]", "");
            hasil.nama = bersihkanNamaOcr(ambilNilaiJsonOcr(json, "nama"));
            hasil.pesan = ambilNilaiJsonOcr(json, "pesan");
            if(hasil.status.equals("")){
                hasil.status = kode == HttpURLConnection.HTTP_OK ? "GAGAL" : "BELUM_ADA";
            }
            if(!"OK".equalsIgnoreCase(hasil.status)){
                if(hasil.pesan.equals("")){
                    hasil.pesan = kode == HttpURLConnection.HTTP_NOT_FOUND ?
                            "Hasil OCR belum tersedia. Simpan Foto KTP dari halaman unggah/kamera terlebih dahulu." :
                            "Hasil OCR tidak dapat dibaca dari Hybrid Web (HTTP " + kode + ").";
                }
                return hasil;
            }
            if(hasil.nik.equals("") && hasil.nama.equals("")){
                hasil.status = "GAGAL";
                hasil.pesan = "Hasil OCR tidak memuat NIK atau Nama. Unggah ulang Foto KTP dan periksa hasil OCR sebelum simpan.";
            }
            return hasil;
        }catch(Exception e){
            hasil.pesan = "Gagal mengambil hasil OCR dari Hybrid Web: " + (e.getMessage() == null ? "periksa koneksi." : e.getMessage());
            return hasil;
        }finally{
            try{ if(input != null){ input.close(); } }catch(Exception e){}
            if(koneksiOcr != null){ koneksiOcr.disconnect(); }
        }
    }

    private String bacaTeksOcrWeb(InputStream input) throws IOException{
        if(input == null){
            return "";
        }
        BufferedReader pembaca = new BufferedReader(new java.io.InputStreamReader(input, "UTF-8"));
        StringBuilder hasil = new StringBuilder();
        String baris;
        while((baris = pembaca.readLine()) != null){
            hasil.append(baris).append("\n");
        }
        return hasil.toString();
    }

    /** Parser JSON kecil tanpa menambah library baru ke proyek Khanza. */
    private String ambilNilaiJsonOcr(String json, String kunci){
        try{
            java.util.regex.Pattern pola = java.util.regex.Pattern.compile("\\\"" + java.util.regex.Pattern.quote(kunci) + "\\\"\\s*:\\s*\\\"((?:\\\\.|[^\\\"])*)\\\"");
            java.util.regex.Matcher cocok = pola.matcher(json == null ? "" : json);
            if(!cocok.find()){
                return "";
            }
            String data = cocok.group(1);
            StringBuilder hasil = new StringBuilder();
            for(int indeks=0; indeks<data.length(); indeks++){
                char karakter = data.charAt(indeks);
                if(karakter == '\\' && indeks+1 < data.length()){
                    char berikut = data.charAt(++indeks);
                    if(berikut == 'n'){ hasil.append('\n'); }
                    else if(berikut == 'r'){ hasil.append('\r'); }
                    else if(berikut == 't'){ hasil.append('\t'); }
                    else if(berikut == 'u' && indeks+4 < data.length()){
                        try{
                            String heksa = data.substring(indeks+1, indeks+5);
                            hasil.append((char)Integer.parseInt(heksa, 16));
                            indeks += 4;
                        }catch(Exception e){ hasil.append('u'); }
                    }else{ hasil.append(berikut); }
                }else{
                    hasil.append(karakter);
                }
            }
            return hasil.toString();
        }catch(Exception e){
            return "";
        }
    }

    private String ambilNikDariTeksOcr(String teks){
        if(teks == null || teks.trim().equals("")){
            return "";
        }
        String[] baris = teks.replace('\r', '\n').split("\\n+");
        for(int i=0; i<baris.length; i++){
            String sekarang = baris[i] == null ? "" : baris[i];
            if(barisMengandungLabelNik(sekarang)){
                StringBuilder kandidat = new StringBuilder();
                kandidat.append(sekarang).append(' ');
                if(i + 1 < baris.length){ kandidat.append(baris[i + 1]).append(' '); }
                if(i + 2 < baris.length){ kandidat.append(baris[i + 2]); }
                String nik = cariNik16Digit(kandidat.toString());
                if(!nik.equals("")){
                    return nik;
                }
            }
        }

        java.util.regex.Pattern polaKelompok = java.util.regex.Pattern.compile(
                "[0-9OQDILZSBGT|? .,:;\\-]{12,42}", java.util.regex.Pattern.CASE_INSENSITIVE);
        java.util.regex.Matcher pencari = polaKelompok.matcher(teks);
        while(pencari.find()){
            String nik = cariNik16Digit(pencari.group());
            if(!nik.equals("")){
                return nik;
            }
        }
        return "";
    }

    private boolean barisMengandungLabelNik(String baris){
        String bersih = baris == null ? "" : baris.toUpperCase(Locale.ROOT).replaceAll("[^A-Z0-9]", "");
        return bersih.matches(".*\\bN[1IL]?[IKX]\\b.*")
                || bersih.contains("NIK")
                || bersih.contains("N1K");
    }

    private String cariNik16Digit(String nilai){
        if(nilai == null){
            return "";
        }

        java.util.regex.Pattern pola = java.util.regex.Pattern.compile(
                "[0-9OQDILZSBGT|? .,:;\\-]{12,42}",
                java.util.regex.Pattern.CASE_INSENSITIVE);
        java.util.regex.Matcher pencari = pola.matcher(nilai);

        while(pencari.find()){
            String angka = normalisasiDigitOcr(pencari.group());

            if(angka.length() == 16){
                return angka;
            }

            if(angka.length() > 16){
                for(int i=0; i<=angka.length()-16; i++){
                    String potong = angka.substring(i, i + 16);
                    if(potong.matches("\\d{16}")){
                        return potong;
                    }
                }
            }
        }

        return "";
    }

    /**
     * Menormalkan karakter yang sering tertukar oleh OCR menjadi digit NIK.
     * Karakter selain digit atau kandidat angka dibuang agar validasi akhir
     * tetap hanya menerima NIK 16 digit.
     */
    private String normalisasiDigitOcr(String nilai){
        if(nilai == null){
            return "";
        }
        StringBuilder hasil = new StringBuilder();
        String sumber = nilai.toUpperCase(Locale.ROOT);
        for(int i=0; i<sumber.length(); i++){
            char karakter = sumber.charAt(i);
            switch(karakter){
                case 'O': case 'Q': case 'D':
                    hasil.append('0');
                    break;
                case 'I': case 'L': case '|':
                    hasil.append('1');
                    break;
                case 'Z':
                    hasil.append('2');
                    break;
                case 'S':
                    hasil.append('5');
                    break;
                case 'B':
                    hasil.append('8');
                    break;
                case 'G':
                    hasil.append('6');
                    break;
                case 'T':
                    hasil.append('7');
                    break;
                default:
                    if(Character.isDigit(karakter)){
                        hasil.append(karakter);
                    }
                    break;
            }
        }
        return hasil.toString();
    }

    private String ambilNamaDariTeksOcr(String teks){
        if(teks == null || teks.trim().equals("")){
            return "";
        }
        String[] baris = teks.replace('\r', '\n').split("\\n+");
        for(int i=0; i<baris.length; i++){
            String asli = baris[i] == null ? "" : baris[i];
            if(!barisMengandungLabelNama(asli)){
                continue;
            }
            String kandidat = bagianSetelahLabelNama(asli);
            if(kandidat.trim().length() < 3 && i + 1 < baris.length){
                kandidat = baris[i + 1] == null ? "" : baris[i + 1];
            }
            if(kandidat.trim().length() < 3 && i + 2 < baris.length){
                kandidat = baris[i + 2] == null ? "" : baris[i + 2];
            }
            kandidat = bersihkanNamaOcr(kandidat);
            if(!kandidat.equals("") && !adalahLabelKtp(kandidat) && kandidat.length() >= 3){
                return kandidat;
            }
        }
        return "";
    }

    private boolean barisMengandungLabelNama(String baris){
        if(baris == null){
            return false;
        }
        String gabung = baris.toUpperCase(Locale.ROOT).replaceAll("[^A-Z0-9]", "");
        String padat = gabung.replaceAll("\\s+", "").replace(" ", "");
        return padat.contains("NAMA") || padat.contains("NARNA") || padat.contains("NAMA1") || padat.contains("N4MA");
    }

    private String bagianSetelahLabelNama(String baris){
        if(baris == null){
            return "";
        }
        java.util.regex.Pattern pola = java.util.regex.Pattern.compile(
                "(?i)N\\s*(?:A|4)\\s*(?:M|R\\s*N)\\s*(?:A|4)\\s*[:;=\\-.]?\\s*(.*)$");
        java.util.regex.Matcher pencari = pola.matcher(baris);
        if(pencari.find()){
            return pencari.group(1);
        }
        int titikDua = baris.indexOf(':');
        if(titikDua >= 0 && titikDua + 1 < baris.length()){
            return baris.substring(titikDua + 1);
        }
        return "";
    }

    private boolean adalahLabelKtp(String nilai){
        String normal = nilai.toUpperCase(Locale.ROOT).replaceAll("[^A-Z]", "").replaceAll("\\s+", " ").trim();
        return normal.startsWith("NIK") || normal.startsWith("TEMPAT") || normal.startsWith("TGL")
                || normal.startsWith("TANGGAL") || normal.startsWith("JENIS") || normal.startsWith("ALAMAT")
                || normal.startsWith("AGAMA") || normal.startsWith("STATUS") || normal.startsWith("PEKERJAAN")
                || normal.startsWith("KEWARGANEGARAAN");
    }

    private String bersihkanNamaOcr(String nilai){
        if(nilai == null){
            return "";
        }
        String bersih = nilai.toUpperCase(Locale.ROOT)
                .replaceAll("[^A-Z .,'-]", " ")
                .replaceAll("\\s+", " ")
                .trim();
        if(bersih.length() > 70){
            bersih = bersih.substring(0, 70).trim();
        }
        return bersih;
    }

    /** Menampilkan teks asli Tesseract agar pola OCR yang belum terbaca dapat diperiksa. */
    private void tampilkanDialogDiagnostikOcrKTP(String pesan, String teksMentah){
        final javax.swing.JDialog dialog = new javax.swing.JDialog(this, "Diagnostik OCR Foto KTP", true);
        dialog.setLayout(new java.awt.BorderLayout(8, 8));

        javax.swing.JLabel info = new javax.swing.JLabel("<html>" + pesan.replace("\n", "<br>")
                + "<br><br>Berikut teks mentah dari Tesseract. Klik Salin lalu kirimkan hasilnya ke IT bila perlu.</html>");
        info.setBorder(javax.swing.BorderFactory.createEmptyBorder(10, 10, 0, 10));
        dialog.add(info, java.awt.BorderLayout.NORTH);

        final javax.swing.JTextArea area = new javax.swing.JTextArea(teksMentah == null ? "" : teksMentah);
        area.setEditable(false);
        area.setFont(new java.awt.Font("Monospaced", java.awt.Font.PLAIN, 12));
        area.setLineWrap(false);
        javax.swing.JScrollPane scroll = new javax.swing.JScrollPane(area);
        scroll.setPreferredSize(new java.awt.Dimension(680, 360));
        scroll.setBorder(javax.swing.BorderFactory.createEmptyBorder(0, 10, 0, 10));
        dialog.add(scroll, java.awt.BorderLayout.CENTER);

        javax.swing.JButton salin = new javax.swing.JButton("Salin Hasil OCR");
        salin.addActionListener(new java.awt.event.ActionListener(){
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                Toolkit.getDefaultToolkit().getSystemClipboard().setContents(new StringSelection(area.getText()), null);
                JOptionPane.showMessageDialog(dialog, "Teks OCR sudah disalin.");
            }
        });
        javax.swing.JButton tutup = new javax.swing.JButton("Tutup");
        tutup.addActionListener(new java.awt.event.ActionListener(){
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                dialog.dispose();
            }
        });
        javax.swing.JPanel tombol = new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.RIGHT));
        tombol.add(salin);
        tombol.add(tutup);
        dialog.add(tombol, java.awt.BorderLayout.SOUTH);
        dialog.pack();
        dialog.setLocationRelativeTo(this);
        dialog.setVisible(true);
    }

    private String normalisasiNamaOcr(String nilai){
        return bersihkanNamaOcr(nilai).replaceAll("[^A-Z]+", " ").replaceAll("\\s+", " ").trim();
    }

    private boolean nikOcrValid(String nik){
        return nik != null && nik.matches("\\d{16}");
    }

    private DataPasienOcr ambilDataPasienUntukOcr(String noRM){
        DataPasienOcr data = new DataPasienOcr();
        PreparedStatement perintah = null;
        ResultSet hasil = null;
        try{
            perintah = koneksi.prepareStatement("select no_ktp,nm_pasien from pasien where no_rkm_medis=?");
            perintah.setString(1, noRM);
            hasil = perintah.executeQuery();
            if(hasil.next()){
                data.nik = hasil.getString("no_ktp") == null ? "" : hasil.getString("no_ktp").trim();
                data.nama = hasil.getString("nm_pasien") == null ? "" : hasil.getString("nm_pasien").trim();
            }
        }catch(Exception e){
            System.out.println("Notif OCR KTP baca pasien : " + e);
        }finally{
            try{ if(hasil != null){ hasil.close(); } }catch(Exception e){}
            try{ if(perintah != null){ perintah.close(); } }catch(Exception e){}
        }
        return data;
    }

