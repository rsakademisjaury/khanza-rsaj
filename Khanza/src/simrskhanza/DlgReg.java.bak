    private void prosesPerbaruiDataRegistrasi(){
        if(sedangMemperbaruiDataRegistrasi){
            return;
        }
        terapkanBiayaRegistrasiPoliKhusus();
        if(TNoReg.getText().trim().equals("")){
            Valid.textKosong(TNoReg,"No.Regristrasi");
        }else if(TNoRw.getText().trim().equals("")){
            Valid.textKosong(TNoRw,"No.Rawat");
        }else if(TDokter.getText().trim().equals("")){
            Valid.textKosong(KdDokter,"dokter");
        }else if(TNoRM.getText().trim().equals("")||TPasien.getText().trim().equals("")){
            Valid.textKosong(TNoRM,"pasien");
        }else if(TPoli.getText().trim().equals("")){
            Valid.textKosong(kdpoli,"poliklinik");
        }else if(TBiaya.getText().trim().equals("")){
            Valid.textKosong(TBiaya,"biaya regristrasi");
        }else if(kdpnj.getText().trim().equals("")||nmpnj.getText().trim().equals("")){
            Valid.textKosong(kdpnj,"Jenis Bayar");
        }else if(!pastikanJenisBayarValidSebelumSimpan()){
            return;
        }else if(Kd2.getText().trim().equals("")){
            aturModeTombolSimpan();
            JOptionPane.showMessageDialog(rootPane,"Data registrasi belum dipilih untuk diperbarui.");
        }else if(Sequel.cariRegistrasi(Kd2.getText().trim())>0){
            JOptionPane.showMessageDialog(rootPane,"Data billing sudah terverifikasi, data tidak boleh diubah.\nSilahkan hubungi bagian kasir/keuangan ..!!");
            TCari.requestFocus();
        }else if(akses.getkode().equals("Admin Utama")){
            if(konfirmasiPerbaruiDataRegistrasi()){
                jalankanPerbaruiDataRegistrasi();
            }
        }else if(akses.getedit_registrasi()==true){
            int baris=cariBarisRegistrasi(Kd2.getText().trim());
            String waktuRegistrasi="";
            if(baris>-1){
                waktuRegistrasi=tbPetugas.getValueAt(baris,3).toString()+" "+tbPetugas.getValueAt(baris,4).toString();
            }else{
                waktuRegistrasi=Sequel.cariIsi("select concat(tgl_registrasi,' ',jam_reg) from reg_periksa where no_rawat=?",Kd2.getText().trim());
            }
            if(!waktuRegistrasi.equals("")&&Sequel.cekTanggal48jam(waktuRegistrasi,Sequel.ambiltanggalsekarang())==true){
                if(konfirmasiPerbaruiDataRegistrasi()){
                    jalankanPerbaruiDataRegistrasi();
                }
            }
        }else{
            JOptionPane.showMessageDialog(rootPane,"Maaf hak akses anda dibatasi, silahkan konfirmasi kepada admin..!!! ");
            TCari.requestFocus();
        }
    }

    private boolean isModePerbaruiDataRegistrasi(){
        return Kd2!=null&&!Kd2.getText().trim().equals("");
    }

    private void aturModeTombolSimpan(){
        if(BtnSimpan==null){
            return;
        }
        if(isModePerbaruiDataRegistrasi()){
            BtnSimpan.setText("Perbarui Data");
            BtnSimpan.setMnemonic('P');
            BtnSimpan.setToolTipText("Alt+P");
            BtnSimpan.setPreferredSize(new java.awt.Dimension(130,30));
        }else{
            BtnSimpan.setText("Simpan");
            BtnSimpan.setMnemonic('S');
            BtnSimpan.setToolTipText("Alt+S");
            BtnSimpan.setPreferredSize(new java.awt.Dimension(90,30));
        }
        if(panelGlass6!=null){
            panelGlass6.revalidate();
            panelGlass6.repaint();
        }
    }

    private int cariBarisRegistrasi(String noRawat){
        if(noRawat==null||noRawat.trim().equals("")){
            return -1;
        }
        for(int baris=0;baris<tbPetugas.getRowCount();baris++){
            Object nilai=tbPetugas.getValueAt(baris,2);
            if(nilai!=null&&noRawat.trim().equals(nilai.toString())){
                return baris;
            }
        }
        return -1;
    }

    private boolean konfirmasiPerbaruiDataRegistrasi(){
        String namaPasien=Sequel.cariIsi("select nm_pasien from pasien where no_rkm_medis=?",TNoRM.getText().trim());
        if(namaPasien==null||namaPasien.trim().equals("")){
            namaPasien=TPasien.getText().replaceFirst("\\s+\\([^)]*\\)\\s*$","").trim();
        }
        String tanggalRegistrasi=new SimpleDateFormat("dd/MM/yyyy").format(DTPReg.getDate())+" "+
                CmbJam.getSelectedItem()+":"+CmbMenit.getSelectedItem()+":"+CmbDetik.getSelectedItem();
        String pesan="Yakin ingin memperbarui data pasien :\n\n"+
                "Nama : "+namaPasien+"\n"+
                "No. RM : "+TNoRM.getText().trim()+"\n"+
                "No. Rawat : "+TNoRw.getText().trim()+"\n"+
                "Tgl. Registrasi : "+tanggalRegistrasi+"\n\n"+
                "Klik 'Ya Perbarui Data' untuk memperbarui data dan klik 'Tidak' untuk membatalkan.";
        Object[] pilihanKonfirmasi={"Ya Perbarui Data","Tidak"};
        int pilihanPengguna=JOptionPane.showOptionDialog(rootPane,pesan,"Konfirmasi Perbarui Data",
                JOptionPane.DEFAULT_OPTION,JOptionPane.QUESTION_MESSAGE,null,pilihanKonfirmasi,pilihanKonfirmasi[1]);
        return pilihanPengguna==0;
    }

    private void jalankanPerbaruiDataRegistrasi(){
        if(sedangMemperbaruiDataRegistrasi){
            return;
        }
        sedangMemperbaruiDataRegistrasi=true;
        try{
            nonaktifkanSemuaTombolSaatPerbarui();
            this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
            terapkanBiayaRegistrasiPoliKhusus();
            ganti();
        }finally{
            this.setCursor(Cursor.getDefaultCursor());
            javax.swing.SwingUtilities.invokeLater(new Runnable(){
                @Override
                public void run(){
                    pulihkanTombolSetelahPerbarui();
                    sedangMemperbaruiDataRegistrasi=false;
                }
            });
        }
    }

    private void nonaktifkanSemuaTombolSaatPerbarui(){
        statusTombolSebelumPerbarui.clear();
        simpanStatusDanNonaktifkanTombol(getContentPane());
        simpanStatusDanNonaktifkanTombol(jPopupMenu1);
        simpanStatusDanNonaktifkanTombol(jPopupMenu2);
    }

    private void simpanStatusDanNonaktifkanTombol(Component komponen){
        if(komponen==null){
            return;
        }
        if(komponen instanceof AbstractButton){
            AbstractButton tombol=(AbstractButton)komponen;
            if(!statusTombolSebelumPerbarui.containsKey(tombol)){
                statusTombolSebelumPerbarui.put(tombol,tombol.isEnabled());
            }
            tombol.setEnabled(false);
        }
        if(komponen instanceof Container){
            for(Component anak:((Container)komponen).getComponents()){
                simpanStatusDanNonaktifkanTombol(anak);
            }
        }
        if(komponen instanceof javax.swing.JMenu){
            for(Component anak:((javax.swing.JMenu)komponen).getMenuComponents()){
                simpanStatusDanNonaktifkanTombol(anak);
            }
        }
    }

    private void pulihkanTombolSetelahPerbarui(){
        for(Map.Entry<AbstractButton,Boolean> statusTombol:statusTombolSebelumPerbarui.entrySet()){
            statusTombol.getKey().setEnabled(statusTombol.getValue());
        }
        statusTombolSebelumPerbarui.clear();
        aturModeTombolSimpan();
    }

