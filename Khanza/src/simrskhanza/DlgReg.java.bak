    private void ganti(){
        terapkanBiayaRegistrasiPoliKhusus();
        String noRawatLama=Kd2.getText().trim();
        int baris=cariBarisRegistrasi(noRawatLama);
        if(Sequel.queryu2tf("update reg_periksa set no_rawat=?,no_reg=?,tgl_registrasi=?,jam_reg=?,kd_dokter=?,no_rkm_medis=?,kd_poli=?,"+
                            "p_jawab=?,almt_pj=?,biaya_reg=?,hubunganpj=?,stts_daftar=?,kd_pj=?,umurdaftar=?,sttsumur=? where no_rawat=?",16,
            new String[]{
                TNoRw.getText(),TNoReg.getText(),Valid.SetTgl(DTPReg.getSelectedItem()+""),CmbJam.getSelectedItem()+":"+CmbMenit.getSelectedItem()+":"+CmbDetik.getSelectedItem(),
                KdDokter.getText(),TNoRM.getText(),kdpoli.getText(),TPngJwb.getText(),TAlmt.getText(),TBiaya.getText(),THbngn.getText(),
                TStatus.getText(),kdpnj.getText(),umur,sttsumur,noRawatLama
            })==true){
            if(baris>-1){
                tabMode.setValueAt(TNoReg.getText(),baris,1);
                tabMode.setValueAt(TNoRw.getText(),baris,2);
                tabMode.setValueAt(Valid.SetTgl(DTPReg.getSelectedItem()+""),baris,3);
                tabMode.setValueAt(CmbJam.getSelectedItem()+":"+CmbMenit.getSelectedItem()+":"+CmbDetik.getSelectedItem(),baris,4);
                tabMode.setValueAt(KdDokter.getText(),baris,5);
                tabMode.setValueAt(TDokter.getText(),baris,6);
                tabMode.setValueAt(TNoRM.getText(),baris,7);
                tabMode.setValueAt(TPasien.getText(),baris,8);
                tabMode.setValueAt(JK.getText(),baris,9);
                tabMode.setValueAt(umur+" "+sttsumur,baris,10);
                tabMode.setValueAt(TPoli.getText(),baris,11);
                tabMode.setValueAt(nmpnj.getText(),baris,12);
                tabMode.setValueAt(TPngJwb.getText(),baris,13);
                tabMode.setValueAt(TAlmt.getText(),baris,14);
                tabMode.setValueAt(THbngn.getText(),baris,15);
                tabMode.setValueAt(Valid.SetAngka(Double.parseDouble(TBiaya.getText())),baris,16);
                tabMode.setValueAt(TStatus.getText(),baris,17);
                tabMode.setValueAt(NoTelp.getText(),baris,18);
                tabMode.setValueAt(kdpoli.getText(),baris,21);
                tabMode.setValueAt(kdpnj.getText(),baris,22);
                tbPetugas.setRowSelectionInterval(baris,baris);
            }
            Kd2.setText(TNoRw.getText());
            aturModeTombolSimpan();
        }
    }

private void otomatisRefresh() {
        if (timerPantauFinger != null) {
            timerPantauFinger.stop();
        }

        timerPantauFinger = new Timer(INTERVAL_PANTAU_FINGER, new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                if (!isVisible() || !ChkAutoRefres.isSelected()) {
                    timerPantauFinger.stop();
                    return;
                }
                refreshStatusPantauFinger();
            }
        });
        timerPantauFinger.setRepeats(true);
        timerPantauFinger.setInitialDelay(INTERVAL_PANTAU_FINGER);
    }

    private void aktifkanAutoRefreshPantauFinger() {
        if (timerPantauFinger == null) {
            otomatisRefresh();
        }
        ChkAutoRefres.setSelected(true);
        if (!timerPantauFinger.isRunning()) {
            timerPantauFinger.start();
        }
    }

    // PATCH RSAJ - kontrol tombol Pantau Finger BPJS
    private void aturTombolPantauFingerBPJS() {
        try {
            BtnPantauFingerBPJS.setVisible(false);
            BtnPantauFingerBPJS.setEnabled(false);

            if (tbPetugas == null || tbPetugas.getSelectedRow() == -1 || tabMode.getRowCount() == 0) {
                return;
            }

            int baris = tbPetugas.getSelectedRow();
            String noRawat = tbPetugas.getValueAt(baris, 2) == null ? "" : tbPetugas.getValueAt(baris, 2).toString();
            String kdPj = tbPetugas.getValueAt(baris, 22) == null ? "" : tbPetugas.getValueAt(baris, 22).toString();
            String noSep = tbPetugas.getValueAt(baris, 24) == null ? "" : tbPetugas.getValueAt(baris, 24).toString();

            if (!kdPj.equals("BPJ")) {
                BtnPantauFingerBPJS.setVisible(false);
                BtnPantauFingerBPJS.setEnabled(false);
                return;
            }

            BtnPantauFingerBPJS.setVisible(true);

            if (!noSep.equals("SEP Belum Terbit")) {
                BtnPantauFingerBPJS.setEnabled(false);
                BtnPantauFingerBPJS.setToolTipText("SEP sudah terbit, tombol Pantau Finger BPJS dinonaktifkan.");
                return;
            }

            int usiaTahun = ambilUsiaTahunSaatRegistrasi(noRawat);
            if (usiaTahun >= 0 && usiaTahun < 17) {
                if (sudahKonfirmasiHadirAnak(noRawat)) {
                    BtnPantauFingerBPJS.setEnabled(false);
                    BtnPantauFingerBPJS.setToolTipText("Pasien usia <17 tahun sudah dikonfirmasi hadir di loket.");
                } else {
                    BtnPantauFingerBPJS.setEnabled(true);
                    BtnPantauFingerBPJS.setToolTipText("Pasien usia <17 tahun: klik untuk menandai pasien sudah hadir di loket.");
                }
                return;
            }

            if (sudahAdaMonitorFingerBPJS(noRawat)) {
                BtnPantauFingerBPJS.setEnabled(false);
                BtnPantauFingerBPJS.setToolTipText("Pasien sudah ada di antrean bpjs_finger_monitor.");
                return;
            }

            BtnPantauFingerBPJS.setEnabled(true);
            BtnPantauFingerBPJS.setToolTipText("Klik untuk memasukkan pasien ke antrean Pantau Finger BPJS.");
        } catch (Exception e) {
            BtnPantauFingerBPJS.setVisible(false);
            BtnPantauFingerBPJS.setEnabled(false);
            System.out.println("Notifikasi Atur Tombol Pantau Finger BPJS : " + e);
        }
    }

    /**
     * Menghitung usia pasien pada tanggal registrasi, bukan berdasarkan tanggal hari ini.
     * Nilai -1 dikembalikan jika data umur tidak dapat ditentukan.
     */
    private int ambilUsiaTahunSaatRegistrasi(String noRawat) {
        if (noRawat == null || noRawat.trim().equals("")) {
            return -1;
        }

        String sqlUsia = "SELECT TIMESTAMPDIFF(YEAR,p.tgl_lahir,rp.tgl_registrasi) AS usia_tahun " +
                "FROM reg_periksa rp INNER JOIN pasien p ON rp.no_rkm_medis=p.no_rkm_medis " +
                "WHERE rp.no_rawat=? LIMIT 1";
        try (PreparedStatement psUsia = koneksi.prepareStatement(sqlUsia)) {
            psUsia.setString(1, noRawat);
            try (ResultSet rsUsia = psUsia.executeQuery()) {
                if (rsUsia.next()) {
                    int usia = rsUsia.getInt("usia_tahun");
                    if (!rsUsia.wasNull()) {
                        return usia;
                    }
                }
            }
        } catch (Exception e) {
            System.out.println("Notifikasi Cek Usia Pasien BPJS : " + e);
        }
        return -1;
    }

    private boolean sudahKonfirmasiHadirAnak(String noRawat) {
        if (noRawat == null || noRawat.trim().equals("")) {
            return false;
        }

        String sqlCekHadir = "SELECT no_rawat FROM bpjs_konfirmasi_hadir WHERE no_rawat=? LIMIT 1";
        try (PreparedStatement psCekHadir = koneksi.prepareStatement(sqlCekHadir)) {
            psCekHadir.setString(1, noRawat);
            try (ResultSet rsCekHadir = psCekHadir.executeQuery()) {
                return rsCekHadir.next();
            }
        } catch (Exception e) {
            System.out.println("Notifikasi Cek Konfirmasi Hadir Pasien Anak : " + e);
            return false;
        }
    }

    private boolean simpanKonfirmasiHadirAnak(String noRawat) {
        String sqlSimpanHadir = "INSERT INTO bpjs_konfirmasi_hadir " +
                "(no_rawat,no_rkm_medis,jenis_konfirmasi,usia_tahun,tanggal_konfirmasi,petugas) " +
                "SELECT rp.no_rawat,rp.no_rkm_medis,'ANAK_TANPA_FINGER'," +
                "TIMESTAMPDIFF(YEAR,p.tgl_lahir,rp.tgl_registrasi),NOW(),? " +
                "FROM reg_periksa rp INNER JOIN pasien p ON rp.no_rkm_medis=p.no_rkm_medis " +
                "WHERE rp.no_rawat=? AND rp.kd_pj='BPJ' " +
                "AND TIMESTAMPDIFF(YEAR,p.tgl_lahir,rp.tgl_registrasi)<17 " +
                "ON DUPLICATE KEY UPDATE jenis_konfirmasi=VALUES(jenis_konfirmasi)," +
                "usia_tahun=VALUES(usia_tahun),tanggal_konfirmasi=VALUES(tanggal_konfirmasi)," +
                "petugas=VALUES(petugas)";

        try (PreparedStatement psSimpanHadir = koneksi.prepareStatement(sqlSimpanHadir)) {
            psSimpanHadir.setString(1, akses.getkode());
            psSimpanHadir.setString(2, noRawat);
            return psSimpanHadir.executeUpdate() > 0;
        } catch (Exception e) {
            JOptionPane.showMessageDialog(null,
                "Gagal menyimpan konfirmasi hadir pasien usia <17 tahun.\n" +
                "Pastikan tabel bpjs_konfirmasi_hadir sudah dibuat.\n\n" + e.getMessage());
            System.out.println("Notifikasi Simpan Konfirmasi Hadir Pasien Anak : " + e);
            return false;
        }
    }

    private boolean sudahAdaMonitorFingerBPJS(String noRawat) {
        if (noRawat == null || noRawat.trim().equals("")) {
            return false;
        }

        String sqlCekMonitor = "select no_rawat from bpjs_finger_monitor where no_rawat=? limit 1";
        try (PreparedStatement psCekMonitor = koneksi.prepareStatement(sqlCekMonitor)) {
            psCekMonitor.setString(1, noRawat);
            try (ResultSet rsCekMonitor = psCekMonitor.executeQuery()) {
                return rsCekMonitor.next();
            }
        } catch (Exception e) {
            System.out.println("Notifikasi Cek Monitor Finger BPJS : " + e);
            return false;
        }
    }

    private void refreshStatusPantauFinger() {
        if (tabMode.getRowCount() == 0) {
            hentikanAutoRefreshPantauFinger();
            return;
        }

        Map<String, Integer> barisCalonPantau = new HashMap<>();
        for (int baris = 0; baris < tabMode.getRowCount(); baris++) {
            String noRawat = tabMode.getValueAt(baris, 2) == null ? "" : tabMode.getValueAt(baris, 2).toString();
            String kdPj = tabMode.getValueAt(baris, 22) == null ? "" : tabMode.getValueAt(baris, 22).toString();
            String noSep = tabMode.getValueAt(baris, 24) == null ? "" : tabMode.getValueAt(baris, 24).toString();
            String statusFinger = tabMode.getValueAt(baris, 25) == null ? "" : tabMode.getValueAt(baris, 25).toString();

            if (!noRawat.equals("") && kdPj.equals("BPJ") &&
                    noSep.equals("SEP Belum Terbit") &&
                    statusFinger.equals("Belum Sidik Jari")) {
                barisCalonPantau.put(noRawat, baris);
            }
        }

        if (barisCalonPantau.isEmpty()) {
            hentikanAutoRefreshPantauFinger();
            return;
        }

        StringBuilder parameterNoRawat = new StringBuilder();
        for (int nomor = 0; nomor < barisCalonPantau.size(); nomor++) {
            if (nomor > 0) {
                parameterNoRawat.append(",");
            }
            parameterNoRawat.append("?");
        }

        String sqlStatusFinger = "SELECT monitor.no_rawat,MAX(sidik.validasi) AS jam_sidik_jari " +
                "FROM bpjs_finger_monitor monitor " +
                "LEFT JOIN sidik_jari_bpjs sidik ON sidik.no_rawat=monitor.no_rawat " +
                "WHERE monitor.no_rawat IN (" + parameterNoRawat.toString() + ") " +
                "GROUP BY monitor.no_rawat";

        boolean adaAntreanPantau = false;
        boolean masihMenungguFinger = false;
        boolean adaPerubahan = false;

        try (PreparedStatement psStatusFinger = koneksi.prepareStatement(sqlStatusFinger)) {
            int nomorParameter = 1;
            for (String noRawat : barisCalonPantau.keySet()) {
                psStatusFinger.setString(nomorParameter++, noRawat);
            }

            try (ResultSet rsStatusFinger = psStatusFinger.executeQuery()) {
                while (rsStatusFinger.next()) {
                    adaAntreanPantau = true;
                    Integer baris = barisCalonPantau.get(rsStatusFinger.getString("no_rawat"));
                    String jamSidikJari = rsStatusFinger.getString("jam_sidik_jari");

                    if (baris != null && jamSidikJari != null && !jamSidikJari.trim().equals("")) {
                        tabMode.setValueAt(jamSidikJari, baris, 25);
                        adaPerubahan = true;
                    } else {
                        masihMenungguFinger = true;
                    }
                }
            }
        } catch (Exception e) {
            System.out.println("Notifikasi Auto Refresh Pantau Finger BPJS : " + e);
            return;
        }

        if (adaPerubahan) {
            tbPetugas.repaint();
        }

        if (!adaAntreanPantau || !masihMenungguFinger) {
            hentikanAutoRefreshPantauFinger();
        }
    }

    private void hentikanAutoRefreshPantauFinger() {
        if (timerPantauFinger != null) {
            timerPantauFinger.stop();
        }
        ChkAutoRefres.setSelected(false);
    }

}
