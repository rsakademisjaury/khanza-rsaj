        final boolean nikSama = nikValid && hasilOcr.nik.equals(dataPasien.nik == null ? "" : dataPasien.nik.replaceAll("[^0-9]", ""));
        final boolean namaSama = namaValid && normalisasiNamaOcr(hasilOcr.nama).equals(normalisasiNamaOcr(dataPasien.nama));
