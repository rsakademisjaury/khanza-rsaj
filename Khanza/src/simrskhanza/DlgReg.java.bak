                            normdipilih="";
                        }   
                    } 
                }             
            }else if(evt.getClickCount()==2){
                i=tbPetugas.getSelectedColumn();
                if(i==1){
                    if(MnKamarInap.isEnabled()==true){
                        MnKamarInapActionPerformed(null);
                    }                    
                }else if(i==2){
                    if(akses.gettindakan_ralan()==true){
                        MnRawatJalanActionPerformed(null);
                    }                    
                }else if(i==3){
                    if(akses.getberi_obat()==true){
                        MnPemberianObatActionPerformed(null);
                    }                   
                }else if(i==4){
                    if(akses.getperiksa_lab()==true){
                        MnPeriksaLabActionPerformed(null);
                    }                    
                }else if(i==5){
                    if(akses.getrujukan_masuk()==true){
                        MnRujukMasukActionPerformed(null);
                    }                    
                }else if(i==6){
                    MnCetakRegisterActionPerformed(null);
                }
            }
            
        }
        
}//GEN-LAST:event_tbPetugasMouseClicked

    private void tbPetugasKeyPressed(java.awt.event.KeyEvent evt) {//GEN-FIRST:event_tbPetugasKeyPressed
        if(tabMode.getRowCount()!=0){
            if(evt.getKeyCode()==KeyEvent.VK_SPACE){
                try {
                    getData();
                } catch (java.lang.NullPointerException e) {
                }
                i=tbPetugas.getSelectedColumn();
                if(i==1){
                    if(MnKamarInap.isEnabled()==true){
                        MnKamarInapActionPerformed(null);
                    }                    
                }else if(i==2){
                    if(akses.gettindakan_ralan()==true){
                        MnRawatJalanActionPerformed(null);
                    }                    
                }else if(i==3){
                    if(akses.getberi_obat()==true){
                        MnPemberianObatActionPerformed(null);
                    }                   
                }else if(i==4){
                    if(akses.getperiksa_lab()==true){
                        MnPeriksaLabActionPerformed(null);
                    }                    
                }else if(i==5){
                    if(akses.getrujukan_masuk()==true){
                        MnRujukMasukActionPerformed(null);
                    }                    
                }else if(i==6){
                    MnCetakRegisterActionPerformed(null);
                }else if(i==7){
                    MnBuktiPelayananRalanActionPerformed(null);
                }
            }else if(evt.getKeyCode()==KeyEvent.VK_A){                
                for(i=0;i<tbPetugas.getRowCount();i++){ 
                    tbPetugas.setValueAt(true,i,0);
                }
            }else if(evt.getKeyCode()==KeyEvent.VK_L){
                MnBarcodeRM9ActionPerformed(null);
            }else if(evt.getKeyCode()==KeyEvent.VK_Z){
                MnSPBK1ActionPerformed(null);
            }else if(evt.getKeyCode()==KeyEvent.VK_W){
                MnLembarRalanActionPerformed(null);
            }
        }
}//GEN-LAST:event_tbPetugasKeyPressed


    /**
     * Memasang autocomplete lokal untuk poli, dokter, jenis bayar, dan asal rujukan.
     * Data master dicache dalam memori dialog ini; setelah cache siap,
     * pencarian saat user mengetik tidak lagi mengirim query ke server.
     */
    private void pasangPencarianLangsungPoliDokter(){
        TPoli.setEditable(true);
        TDokter.setEditable(true);
        nmpnj.setEditable(true);
        AsalRujukan.setEditable(true);
        TPoli.setToolTipText("Ketik minimal " + MINIMUM_KARAKTER_AUTOCOMPLETE + " karakter untuk mencari poli");
        TDokter.setToolTipText("Ketik minimal " + MINIMUM_KARAKTER_AUTOCOMPLETE + " karakter untuk mencari dokter");
        nmpnj.setToolTipText("Ketik minimal " + MINIMUM_KARAKTER_AUTOCOMPLETE + " karakter untuk mencari jenis bayar");
        AsalRujukan.setToolTipText("Ketik minimal " + MINIMUM_KARAKTER_AUTOCOMPLETE + " karakter untuk mencari asal rujukan");

        popupAutocompletePoli = buatPopupAutocomplete();
        popupAutocompleteDokter = buatPopupAutocomplete();
        popupAutocompletePenjab = buatPopupAutocomplete();
        popupAutocompletePerujuk = buatPopupAutocomplete();

        tabelAutocompletePoli = buatTabelAutocomplete(modelAutocompletePoli);
        tabelAutocompleteDokter = buatTabelAutocomplete(modelAutocompleteDokter);
        tabelAutocompletePenjab = buatTabelAutocomplete(modelAutocompletePenjab);
        tabelAutocompletePerujuk = buatTabelAutocomplete(modelAutocompletePerujuk);
        sembunyikanKolomTabel(tabelAutocompletePoli, 0);
        sembunyikanKolomTabel(tabelAutocompletePoli, 2);
        sembunyikanKolomTabel(tabelAutocompletePoli, 3);
        sembunyikanKolomTabel(tabelAutocompleteDokter, 0);
        sembunyikanKolomTabel(tabelAutocompleteDokter, 2);
        sembunyikanKolomTabel(tabelAutocompletePenjab, 0);
        sembunyikanKolomTabel(tabelAutocompletePerujuk, 1);

        popupAutocompletePoli.add(buatScrollAutocomplete(tabelAutocompletePoli), java.awt.BorderLayout.CENTER);
        popupAutocompleteDokter.add(buatScrollAutocomplete(tabelAutocompleteDokter), java.awt.BorderLayout.CENTER);
        popupAutocompletePenjab.add(buatScrollAutocomplete(tabelAutocompletePenjab), java.awt.BorderLayout.CENTER);
        popupAutocompletePerujuk.add(buatScrollAutocomplete(tabelAutocompletePerujuk), java.awt.BorderLayout.CENTER);

        timerCariAutocompletePoli = new Timer(250, new ActionListener() {
            @Override public void actionPerformed(ActionEvent e) { tampilkanPilihanPoli(TPoli.getText()); }
        });
        timerCariAutocompletePoli.setRepeats(false);
        timerCariAutocompleteDokter = new Timer(250, new ActionListener() {
            @Override public void actionPerformed(ActionEvent e) { tampilkanPilihanDokter(TDokter.getText()); }
        });
        timerCariAutocompleteDokter.setRepeats(false);
        timerCariAutocompletePenjab = new Timer(250, new ActionListener() {
            @Override public void actionPerformed(ActionEvent e) { tampilkanPilihanPenjab(nmpnj.getText()); }
        });
        timerCariAutocompletePenjab.setRepeats(false);
        timerCariAutocompletePerujuk = new Timer(250, new ActionListener() {
            @Override public void actionPerformed(ActionEvent e) { tampilkanPilihanPerujuk(AsalRujukan.getText()); }
        });
        timerCariAutocompletePerujuk.setRepeats(false);

        TPoli.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent e) { perubahanTeksPoliOlehUser(); }
            @Override public void removeUpdate(DocumentEvent e) { perubahanTeksPoliOlehUser(); }
            @Override public void changedUpdate(DocumentEvent e) { perubahanTeksPoliOlehUser(); }
        });
        TDokter.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent e) { perubahanTeksDokterOlehUser(); }
            @Override public void removeUpdate(DocumentEvent e) { perubahanTeksDokterOlehUser(); }
            @Override public void changedUpdate(DocumentEvent e) { perubahanTeksDokterOlehUser(); }
        });
        nmpnj.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent e) { perubahanTeksPenjabOlehUser(); }
            @Override public void removeUpdate(DocumentEvent e) { perubahanTeksPenjabOlehUser(); }
            @Override public void changedUpdate(DocumentEvent e) { perubahanTeksPenjabOlehUser(); }
        });
        AsalRujukan.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent e) { perubahanTeksPerujukOlehUser(); }
            @Override public void removeUpdate(DocumentEvent e) { perubahanTeksPerujukOlehUser(); }
            @Override public void changedUpdate(DocumentEvent e) { perubahanTeksPerujukOlehUser(); }
        });

        TPoli.addKeyListener(new java.awt.event.KeyAdapter() {
            @Override public void keyPressed(KeyEvent evt) { navigasiAutocomplete(evt, tabelAutocompletePoli, popupAutocompletePoli, 1); }
        });
        TDokter.addKeyListener(new java.awt.event.KeyAdapter() {
            @Override public void keyPressed(KeyEvent evt) { navigasiAutocomplete(evt, tabelAutocompleteDokter, popupAutocompleteDokter, 2); }
        });
        nmpnj.addKeyListener(new java.awt.event.KeyAdapter() {
            @Override public void keyPressed(KeyEvent evt) { navigasiAutocomplete(evt, tabelAutocompletePenjab, popupAutocompletePenjab, 3); }
        });
        AsalRujukan.addKeyListener(new java.awt.event.KeyAdapter() {
            @Override public void keyPressed(KeyEvent evt) { navigasiAutocomplete(evt, tabelAutocompletePerujuk, popupAutocompletePerujuk, 4); }
        });

        tabelAutocompletePoli.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mouseClicked(java.awt.event.MouseEvent evt) {
                if (tabelAutocompletePoli.getSelectedRow() >= 0) pilihBarisAutocompletePoli();
            }
        });
        tabelAutocompleteDokter.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mouseClicked(java.awt.event.MouseEvent evt) {
                if (tabelAutocompleteDokter.getSelectedRow() >= 0) pilihBarisAutocompleteDokter();
            }
        });
        tabelAutocompletePenjab.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mouseClicked(java.awt.event.MouseEvent evt) {
                if (tabelAutocompletePenjab.getSelectedRow() >= 0) pilihBarisAutocompletePenjab();
            }
        });
        tabelAutocompletePerujuk.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mouseClicked(java.awt.event.MouseEvent evt) {
                if (tabelAutocompletePerujuk.getSelectedRow() >= 0) pilihBarisAutocompletePerujuk();
            }
        });

        pasangSembunyiPopupSaatFokusPindah(TPoli, popupAutocompletePoli);
        pasangSembunyiPopupSaatFokusPindah(TDokter, popupAutocompleteDokter);
        pasangSembunyiPopupSaatFokusPindah(nmpnj, popupAutocompletePenjab);
        pasangSembunyiPopupSaatFokusPindah(AsalRujukan, popupAutocompletePerujuk);

        petunjukCariPoli = pasangPetunjukDalamKolom(TPoli, "Ketik pencarian poli di sini");
        petunjukCariDokter = pasangPetunjukDalamKolom(TDokter, "Ketik pencarian dokter di sini");
        petunjukCariPenjab = pasangPetunjukDalamKolom(nmpnj, "Ketik pencarian jenis bayar di sini");
        petunjukCariPerujuk = pasangPetunjukDalamKolom(AsalRujukan, "Ketik pencarian asal rujukan di sini");
    }

    private javax.swing.JPopupMenu buatPopupAutocomplete(){
        javax.swing.JPopupMenu popup = new javax.swing.JPopupMenu();
        popup.setFocusable(false);
        popup.setLayout(new java.awt.BorderLayout());
        popup.setBorder(javax.swing.BorderFactory.createLineBorder(WARNA_GARIS_AUTOCOMPLETE, 1, true));
        return popup;
    }

    /** Membuat daftar ringan dengan header, baris lega, dan seleksi biru. */
    private JTable buatTabelAutocomplete(DefaultTableModel model){
        JTable tabel = new JTable(model);
        tabel.setSelectionMode(javax.swing.ListSelectionModel.SINGLE_SELECTION);
        tabel.setRowHeight(TINGGI_BARIS_AUTOCOMPLETE);
        tabel.setIntercellSpacing(new Dimension(0, 1));
        tabel.setShowVerticalLines(false);
        tabel.setShowHorizontalLines(true);
        tabel.setGridColor(WARNA_GARIS_AUTOCOMPLETE);
        tabel.setAutoResizeMode(JTable.AUTO_RESIZE_LAST_COLUMN);
        tabel.setFont(new java.awt.Font("Segoe UI", java.awt.Font.PLAIN, 12));
        tabel.setForeground(WARNA_TULISAN_NORMAL);
        tabel.setBackground(WARNA_LATAR_GENAP);
        tabel.setSelectionBackground(WARNA_PILIHAN_AKTIF);
        tabel.setSelectionForeground(WARNA_TULISAN_AKTIF);
        tabel.setFillsViewportHeight(false);
        tabel.setFocusable(true);
        tabel.setRequestFocusEnabled(true);

        final javax.swing.table.JTableHeader header = tabel.getTableHeader();
        header.setReorderingAllowed(false);
        header.setResizingAllowed(false);
        header.setPreferredSize(new Dimension(0, TINGGI_HEADER_AUTOCOMPLETE));
        header.setDefaultRenderer(new javax.swing.table.DefaultTableCellRenderer() {
            @Override
            public java.awt.Component getTableCellRendererComponent(JTable table, Object value,
                    boolean isSelected, boolean hasFocus, int row, int column) {
                javax.swing.JLabel label = (javax.swing.JLabel) super.getTableCellRendererComponent(
                        table, value, false, false, row, column);
                label.setOpaque(true);
                label.setHorizontalAlignment(javax.swing.SwingConstants.LEFT);
                label.setBorder(javax.swing.BorderFactory.createCompoundBorder(
                        javax.swing.BorderFactory.createMatteBorder(0, 0, 1, 0, WARNA_GARIS_AUTOCOMPLETE),
                        javax.swing.BorderFactory.createEmptyBorder(0, 10, 0, 10)));
                label.setFont(new java.awt.Font("Segoe UI", java.awt.Font.BOLD, 12));
                label.setBackground(WARNA_HEADER_AUTOCOMPLETE);
                label.setForeground(WARNA_TULISAN_HEADER_AUTOCOMPLETE);
                return label;
            }
        });

        tabel.setDefaultRenderer(Object.class, new javax.swing.table.DefaultTableCellRenderer() {
            @Override
            public java.awt.Component getTableCellRendererComponent(JTable table, Object value,
                    boolean isSelected, boolean hasFocus, int row, int column) {
                javax.swing.JLabel label = (javax.swing.JLabel) super.getTableCellRendererComponent(
                        table, value, isSelected, hasFocus, row, column);
                label.setOpaque(true);
                label.setHorizontalAlignment(javax.swing.SwingConstants.LEFT);
                label.setBorder(javax.swing.BorderFactory.createEmptyBorder(0, 10, 0, 10));
                label.setFont(new java.awt.Font("Segoe UI", java.awt.Font.PLAIN, 12));
                if (isSelected) {
                    label.setBackground(WARNA_PILIHAN_AKTIF);
                    label.setForeground(WARNA_TULISAN_AKTIF);
                } else {
                    label.setBackground((row % 2 == 0) ? WARNA_LATAR_GENAP : WARNA_LATAR_GANJIL);
                    label.setForeground(WARNA_TULISAN_NORMAL);
                }
                return label;
            }
        });
        return tabel;
    }

    private javax.swing.JScrollPane buatScrollAutocomplete(JTable tabel){
        javax.swing.JScrollPane scroll = new javax.swing.JScrollPane(tabel);
        scroll.setBorder(javax.swing.BorderFactory.createEmptyBorder());
        scroll.setViewportBorder(javax.swing.BorderFactory.createEmptyBorder());
        scroll.setHorizontalScrollBarPolicy(javax.swing.ScrollPaneConstants.HORIZONTAL_SCROLLBAR_NEVER);
        scroll.setVerticalScrollBarPolicy(javax.swing.ScrollPaneConstants.VERTICAL_SCROLLBAR_AS_NEEDED);
        scroll.setColumnHeaderView(tabel.getTableHeader());
        scroll.getVerticalScrollBar().setUnitIncrement(TINGGI_BARIS_AUTOCOMPLETE);
        return scroll;
    }

    private void sembunyikanKolomTabel(JTable tabel, int indeksKolom){
        TableColumn kolom = tabel.getColumnModel().getColumn(indeksKolom);
        kolom.setMinWidth(0);
        kolom.setMaxWidth(0);
        kolom.setPreferredWidth(0);
    }

    /** Label abu-abu miring yang muncul di dalam kolom saat kolom kosong. */
    private javax.swing.JLabel pasangPetunjukDalamKolom(final JTextField field, final String teks){
        final javax.swing.JLabel label = new javax.swing.JLabel(teks);
        java.awt.Font fontField = field.getFont();
        if (fontField == null) fontField = new java.awt.Font("Tahoma", java.awt.Font.PLAIN, 11);
        label.setFont(fontField.deriveFont(java.awt.Font.ITALIC));
        label.setForeground(WARNA_PETUNJUK_AUTOCOMPLETE);
        label.setHorizontalAlignment(javax.swing.SwingConstants.LEFT);
        label.setVerticalAlignment(javax.swing.SwingConstants.CENTER);
        label.setOpaque(false);
        label.setFocusable(false);
        aturPosisiPetunjukDalamKolom(field, label);
        label.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mousePressed(java.awt.event.MouseEvent evt) { field.requestFocusInWindow(); }
        });
        field.addFocusListener(new java.awt.event.FocusAdapter() {
            @Override public void focusGained(java.awt.event.FocusEvent evt) { perbaruiPetunjukDalamKolom(field, label); }
            @Override public void focusLost(java.awt.event.FocusEvent evt) { perbaruiPetunjukDalamKolom(field, label); }
        });
        field.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent e) { perbaruiPetunjukDalamKolom(field, label); }
            @Override public void removeUpdate(DocumentEvent e) { perbaruiPetunjukDalamKolom(field, label); }
            @Override public void changedUpdate(DocumentEvent e) { perbaruiPetunjukDalamKolom(field, label); }
        });
        field.addComponentListener(new java.awt.event.ComponentAdapter() {
            @Override public void componentResized(java.awt.event.ComponentEvent evt) { aturPosisiPetunjukDalamKolom(field, label); }
            @Override public void componentMoved(java.awt.event.ComponentEvent evt) { aturPosisiPetunjukDalamKolom(field, label); }
        });
        FormInput.add(label);
        FormInput.setComponentZOrder(label, 0);
        perbaruiPetunjukDalamKolom(field, label);
        FormInput.revalidate();
        FormInput.repaint();
        return label;
    }

    private void aturPosisiPetunjukDalamKolom(JTextField field, javax.swing.JLabel label){
        label.setBounds(field.getX() + 8, field.getY() + 1, Math.max(1, field.getWidth() - 16), Math.max(1, field.getHeight() - 2));
    }

    private void perbaruiPetunjukDalamKolom(JTextField field, javax.swing.JLabel label){
        if (label == null) return;
        aturPosisiPetunjukDalamKolom(field, label);
        label.setVisible(field.getText().trim().equals("") && !field.hasFocus());
        label.repaint();
    }

    private void pasangSembunyiPopupSaatFokusPindah(final JTextField field, final javax.swing.JPopupMenu popup){
        field.addFocusListener(new java.awt.event.FocusAdapter() {
            @Override public void focusLost(java.awt.event.FocusEvent evt) {
                Timer timerSembunyi = new Timer(180, new ActionListener() {
                    @Override public void actionPerformed(ActionEvent e) { popup.setVisible(false); }
                });
                timerSembunyi.setRepeats(false);
                timerSembunyi.start();
            }
        });
    }

    private void perubahanTeksPoliOlehUser(){
        if (sedangMengisiDariAutocomplete) return;
        resetPilihanPoliDanDokterJikaTidakSesuai();
        String kataKunci = TPoli.getText().trim();
        if (kataKunci.length() < MINIMUM_KARAKTER_AUTOCOMPLETE) {
            if (timerCariAutocompletePoli != null) timerCariAutocompletePoli.stop();
            modelAutocompletePoli.setRowCount(0);
            if (popupAutocompletePoli != null) popupAutocompletePoli.setVisible(false);
            return;
        }
        if (timerCariAutocompletePoli != null) timerCariAutocompletePoli.restart();
    }

    private void perubahanTeksDokterOlehUser(){
        if (sedangMengisiDariAutocomplete) return;
        resetPilihanDokterJikaTidakSesuai();
        String kataKunci = TDokter.getText().trim();
        if (kataKunci.length() < MINIMUM_KARAKTER_AUTOCOMPLETE) {
            if (timerCariAutocompleteDokter != null) timerCariAutocompleteDokter.stop();
            modelAutocompleteDokter.setRowCount(0);
            if (popupAutocompleteDokter != null) popupAutocompleteDokter.setVisible(false);
            return;
        }
        if (timerCariAutocompleteDokter != null) timerCariAutocompleteDokter.restart();
    }

    /**
     * Mengisi jenis bayar dari proses otomatis tanpa menampilkan popup.
     * Popup hanya muncul kembali setelah petugas mengetik langsung di nmpnj.
     */
    private void isiJenisBayarOtomatis(String kode, String nama){
        boolean statusAwal = sedangMengisiJenisBayarOtomatis;
        sedangMengisiJenisBayarOtomatis = true;
        try{
            if (timerCariAutocompletePenjab != null) timerCariAutocompletePenjab.stop();
            if (modelAutocompletePenjab != null) modelAutocompletePenjab.setRowCount(0);
            if (popupAutocompletePenjab != null) popupAutocompletePenjab.setVisible(false);
            kdpnj.setText(kode == null ? "" : kode);
            nmpnj.setText(nama == null ? "" : nama);
        }finally{
            sedangMengisiJenisBayarOtomatis = statusAwal;
        }
    }

    /**
     * Mengisi asal rujukan dari proses otomatis tanpa menampilkan popup.
     * Popup hanya muncul kembali setelah petugas mengetik langsung di AsalRujukan.
     */
    private void isiPerujukOtomatis(String nama, String alamat){
        boolean statusAwal = sedangMengisiPerujukOtomatis;
        sedangMengisiPerujukOtomatis = true;
        try{
            if (timerCariAutocompletePerujuk != null) timerCariAutocompletePerujuk.stop();
            if (modelAutocompletePerujuk != null) modelAutocompletePerujuk.setRowCount(0);
            if (popupAutocompletePerujuk != null) popupAutocompletePerujuk.setVisible(false);
            String namaAman = nama == null ? "" : nama;
            AsalRujukan.setText(namaAman);
            if (namaAman.trim().equals("")) {
                alamatperujuk = "";
            } else {
                alamatperujuk = (alamat == null || alamat.trim().equals("")) ? "-" : alamat.trim();
            }
        }finally{
            sedangMengisiPerujukOtomatis = statusAwal;
        }
    }

    private void perubahanTeksPenjabOlehUser(){
        // Popup hanya boleh dipicu oleh ketikan manual petugas, bukan saat
        // jenis bayar diisi otomatis dari pasien, tabel, dialog lama, atau validasi.
        if (sedangMengisiDariAutocomplete || sedangMengisiJenisBayarOtomatis) return;
        resetPilihanPenjabJikaTidakSesuai();
        String kataKunci = nmpnj.getText().trim();
        if (kataKunci.length() < MINIMUM_KARAKTER_AUTOCOMPLETE) {
            if (timerCariAutocompletePenjab != null) timerCariAutocompletePenjab.stop();
            modelAutocompletePenjab.setRowCount(0);
            if (popupAutocompletePenjab != null) popupAutocompletePenjab.setVisible(false);
            return;
        }
        if (timerCariAutocompletePenjab != null) timerCariAutocompletePenjab.restart();
    }

    /** Saat asal rujukan diketik ulang, alamat perujuk lama tidak boleh ikut tersimpan. */
    private void perubahanTeksPerujukOlehUser(){
        // Popup hanya boleh dipicu oleh ketikan manual petugas, bukan saat
        // asal rujukan diisi otomatis dari getData, dialog lama, sisrute, atau reset form.
        if (sedangMengisiDariAutocomplete || sedangMengisiPerujukOtomatis) return;
        alamatperujuk = "-";
        String kataKunci = AsalRujukan.getText().trim();
        if (kataKunci.length() < MINIMUM_KARAKTER_AUTOCOMPLETE) {
            if (timerCariAutocompletePerujuk != null) timerCariAutocompletePerujuk.stop();
            modelAutocompletePerujuk.setRowCount(0);
            if (popupAutocompletePerujuk != null) popupAutocompletePerujuk.setVisible(false);
            return;
        }
        if (timerCariAutocompletePerujuk != null) timerCariAutocompletePerujuk.restart();
    }

    /** Saat poli diketik ulang/dihapus, kode poli, dokter, kuota, dan biaya lama dibersihkan. */
    private void resetPilihanPoliDanDokterJikaTidakSesuai(){
        String kodePoli = kdpoli.getText().trim();
        String namaTerdaftar = namaPoliBerdasarkanKode(kodePoli);
        String namaTertulis = TPoli.getText().trim();
        boolean pilihanMasihValid = !kodePoli.equals("") && !namaTerdaftar.equals("")
                && namaTerdaftar.equalsIgnoreCase(namaTertulis);
        if (!pilihanMasihValid) bersihkanPilihanPoliDanDokter();
    }

    private void resetPilihanDokterJikaTidakSesuai(){
        String kodeDokter = KdDokter.getText().trim();
        String namaTerdaftar = namaDokterBerdasarkanKode(kodeDokter);
        String namaTertulis = TDokter.getText().trim();
        boolean pilihanMasihValid = !kodeDokter.equals("") && !namaTerdaftar.equals("")
                && namaTerdaftar.equalsIgnoreCase(namaTertulis);
        if (!pilihanMasihValid) bersihkanPilihanDokter();
    }

    private void resetPilihanPenjabJikaTidakSesuai(){
        String kodePenjab = kdpnj.getText().trim();
        String namaTerdaftar = namaPenjabBerdasarkanKode(kodePenjab);
        String namaTertulis = nmpnj.getText().trim();
        boolean pilihanMasihValid = !kodePenjab.equals("") && !namaTerdaftar.equals("")
                && namaTerdaftar.equalsIgnoreCase(namaTertulis);
        if (!pilihanMasihValid) {
            boolean statusAwal = sedangMengisiDariAutocomplete;
            sedangMengisiDariAutocomplete = true;
            try { kdpnj.setText(""); } finally { sedangMengisiDariAutocomplete = statusAwal; }
        }
    }

    private void bersihkanPilihanPoliDanDokter(){
        if (timerCariAutocompleteDokter != null) timerCariAutocompleteDokter.stop();
        boolean statusAwal = sedangMengisiDariAutocomplete;
        sedangMengisiDariAutocomplete = true;
        try {
            kdpoli.setText("");
            KdDokter.setText("");
            TDokter.setText("");
            TBiaya.setText("");
        } finally {
            sedangMengisiDariAutocomplete = statusAwal;
        }
        kuota = 0;
        sumberDokterAutocompleteDariJadwal = false;
        modelAutocompleteDokter.setRowCount(0);
        if (popupAutocompleteDokter != null) popupAutocompleteDokter.setVisible(false);
    }

    private void bersihkanPilihanDokter(){
        if (timerCariAutocompleteDokter != null) timerCariAutocompleteDokter.stop();
        boolean statusAwal = sedangMengisiDariAutocomplete;
        sedangMengisiDariAutocomplete = true;
        try { KdDokter.setText(""); } finally { sedangMengisiDariAutocomplete = statusAwal; }
        kuota = 0;
        sumberDokterAutocompleteDariJadwal = false;
        modelAutocompleteDokter.setRowCount(0);
        if (popupAutocompleteDokter != null) popupAutocompleteDokter.setVisible(false);
    }

    /** Mengosongkan cache konteks jadwal. Dipanggil saat tanggal/checkbox berubah. */
    private void bersihkanCacheAutocompleteKonteks(){
        konteksCachePoliAutocomplete = "";
        konteksCacheDokterAutocomplete = "";
        cachePoliAutocomplete.clear();
        cacheDokterAutocomplete.clear();
        modelAutocompletePoli.setRowCount(0);
        modelAutocompleteDokter.setRowCount(0);
        if (popupAutocompletePoli != null) popupAutocompletePoli.setVisible(false);
        if (popupAutocompleteDokter != null) popupAutocompleteDokter.setVisible(false);
    }

    /**
     * Konteks cache autocomplete. Default mengikuti jadwal tanggal registrasi;
     * hanya checkbox Tampil Luar Jadwal yang menampilkan seluruh data.
     */
    private String buatKonteksCachePoli(){
        return tampilkanLuarJadwalAutocomplete() + "|" + hariKerjaRegistrasiAutocomplete();
    }

    private String buatKonteksCacheDokter(){
        return tampilkanLuarJadwalAutocomplete() + "|" + hariKerjaRegistrasiAutocomplete();
    }

    /** Memuat daftar poli sekali per perubahan konteks tanggal/jadwal. */
    private void muatCachePoliJikaPerlu(){
        String konteks = buatKonteksCachePoli();
        if (konteks.equals(konteksCachePoliAutocomplete)) return;
        cachePoliAutocomplete.clear();
        // Hanya autocomplete: default menampilkan poli yang punya jadwal di tanggal registrasi.
        // Checkbox Tampil Luar Jadwal menjadi satu-satunya bypass.
        boolean ikutiJadwal = !tampilkanLuarJadwalAutocomplete();
        String sql = ikutiJadwal
                ? "select distinct p.kd_poli,p.nm_poli,p.registrasi,p.registrasilama "
                  + "from poliklinik p inner join jadwal j on j.kd_poli=p.kd_poli "
                  + "where j.hari_kerja=? order by p.nm_poli"
                : "select p.kd_poli,p.nm_poli,p.registrasi,p.registrasilama from poliklinik p order by p.nm_poli";
        try (PreparedStatement psCache = koneksi.prepareStatement(sql)) {
            if (ikutiJadwal) psCache.setString(1, hariKerjaRegistrasiAutocomplete());
            try (ResultSet rsCache = psCache.executeQuery()) {
                while (rsCache.next()) {
                    cachePoliAutocomplete.add(new CachePoliAutocomplete(rsCache.getString("kd_poli"),
                            rsCache.getString("nm_poli"), rsCache.getString("registrasi"),
                            rsCache.getString("registrasilama")));
                }
            }
            konteksCachePoliAutocomplete = konteks;
        } catch (Exception e) {
            konteksCachePoliAutocomplete = "";
            System.out.println("Autocomplete registrasi, muat cache poli: " + e);
        }
    }

    /** Memuat relasi dokter-poli sekali per perubahan konteks tanggal/jadwal. */
    private void muatCacheDokterJikaPerlu(){
        String konteks = buatKonteksCacheDokter();
        if (konteks.equals(konteksCacheDokterAutocomplete)) return;
        cacheDokterAutocomplete.clear();
        // Hanya autocomplete: default dokter harus punya jadwal pada hari registrasi.
        // Saat checkbox aktif, seluruh dokter ditampilkan tanpa penyaring jadwal/poli.
        boolean ikutiJadwal = !tampilkanLuarJadwalAutocomplete();
        String sql = ikutiJadwal
                ? "select d.kd_dokter,d.nm_dokter,j.kd_poli,ifnull(j.kuota,0) as kuota "
                  + "from dokter d inner join jadwal j on j.kd_dokter=d.kd_dokter "
                  + "where j.hari_kerja=? order by d.nm_dokter,j.kd_poli"
                : "select d.kd_dokter,d.nm_dokter,'' as kd_poli,0 as kuota "
                  + "from dokter d order by d.nm_dokter";
        try (PreparedStatement psCache = koneksi.prepareStatement(sql)) {
            if (ikutiJadwal) psCache.setString(1, hariKerjaRegistrasiAutocomplete());
            try (ResultSet rsCache = psCache.executeQuery()) {
                while (rsCache.next()) {
                    cacheDokterAutocomplete.add(new CacheDokterAutocomplete(rsCache.getString("kd_dokter"),
                            rsCache.getString("nm_dokter"), rsCache.getString("kd_poli"),
                            rsCache.getString("kuota"), ikutiJadwal));
                }
            }
            konteksCacheDokterAutocomplete = konteks;
        } catch (Exception e) {
            konteksCacheDokterAutocomplete = "";
            System.out.println("Autocomplete registrasi, muat cache dokter: " + e);
        }
    }

    /** Cache jenis bayar dimuat sekali untuk satu form registrasi. */
    private void muatCachePenjabJikaPerlu(){
        if (cachePenjabAutocompleteSudahDimuat) return;
        cachePenjabAutocomplete.clear();
        try (PreparedStatement psCache = koneksi.prepareStatement(
                "select kd_pj,png_jawab from penjab order by png_jawab")) {
            try (ResultSet rsCache = psCache.executeQuery()) {
                while (rsCache.next()) {
                    cachePenjabAutocomplete.add(new CachePenjabAutocomplete(rsCache.getString("kd_pj"),
                            rsCache.getString("png_jawab")));
                }
            }
            cachePenjabAutocompleteSudahDimuat = true;
        } catch (Exception e) {
            cachePenjabAutocompleteSudahDimuat = false;
            System.out.println("Autocomplete registrasi, muat cache jenis bayar: " + e);
        }
    }

    /**
     * Cache asal rujukan mengikuti sumber asli DlgRujukMasuk, yaitu riwayat
     * tabel rujuk_masuk (kolom perujuk dan alamat), bukan tabel master lain.
     * Struktur query disamakan dengan method tampil2() pada DlgRujukMasuk.
     */
    private void muatCachePerujukJikaPerlu(){
        if (cachePerujukAutocompleteSudahDimuat) return;
        cachePerujukAutocomplete.clear();
        try (PreparedStatement psCache = koneksi.prepareStatement(
                "select rujuk_masuk.perujuk,ifnull(rujuk_masuk.alamat,'') as alamat " +
                "from rujuk_masuk where ifnull(trim(rujuk_masuk.perujuk),'')<>'' " +
                "group by rujuk_masuk.perujuk order by rujuk_masuk.perujuk")) {
            try (ResultSet rsCache = psCache.executeQuery()) {
                while (rsCache.next()) {
                    cachePerujukAutocomplete.add(new CachePerujukAutocomplete(
                            rsCache.getString("perujuk"), rsCache.getString("alamat")));
                }
            }
            cachePerujukAutocompleteSudahDimuat = true;
        } catch (Exception e) {
            cachePerujukAutocompleteSudahDimuat = false;
            System.out.println("Autocomplete registrasi, muat cache asal rujukan dari rujuk_masuk: " + e);
        }
    }

    private void tampilkanPilihanPoli(String kataKunci){
        if (sedangMengisiDariAutocomplete) return;
        String kunci = kataKunci == null ? "" : kataKunci.trim();
        if (kunci.length() < MINIMUM_KARAKTER_AUTOCOMPLETE) {
            popupAutocompletePoli.setVisible(false);
            return;
        }
        muatCachePoliJikaPerlu();
        modelAutocompletePoli.setRowCount(0);
        for (CachePoliAutocomplete item : cachePoliAutocomplete) {
            if (cocokAutocomplete(kunci, item.kode, item.nama)) {
                modelAutocompletePoli.addRow(new Object[]{item.kode, item.nama, item.biayaBaru, item.biayaLama});
            }
        }
        tampilkanPopupPilihan(TPoli, popupAutocompletePoli, tabelAutocompletePoli, modelAutocompletePoli.getRowCount());
    }

    private void tampilkanPilihanDokter(String kataKunci){
        if (sedangMengisiDariAutocomplete) return;
        String kunci = kataKunci == null ? "" : kataKunci.trim();
        if (kunci.length() < MINIMUM_KARAKTER_AUTOCOMPLETE) {
            popupAutocompleteDokter.setVisible(false);
            return;
        }
        muatCacheDokterJikaPerlu();
        modelAutocompleteDokter.setRowCount(0);
        sumberDokterAutocompleteDariJadwal = !tampilkanLuarJadwalAutocomplete();
        String kodePoli = kdpoli.getText().trim();
        // Ketika checkbox tidak dicentang, dokter dibatasi ke poli yang sudah dipilih.
        // Ketika dicentang, seluruh dokter boleh muncul tanpa pembatas poli.
        boolean adaPoliValid = sumberDokterAutocompleteDariJadwal && poliSudahDipilihDenganValid();
        java.util.Set<String> dokterSudahDitampilkan = new LinkedHashSet<String>();
        for (CacheDokterAutocomplete item : cacheDokterAutocomplete) {
            if (adaPoliValid && !kodePoli.equals(item.kodePoli)) continue;
            if (!cocokAutocomplete(kunci, item.kode, item.nama)) continue;
            if (!dokterSudahDitampilkan.add(item.kode)) continue;
            modelAutocompleteDokter.addRow(new Object[]{item.kode, item.nama, item.kuota});
        }
        tampilkanPopupPilihan(TDokter, popupAutocompleteDokter, tabelAutocompleteDokter, modelAutocompleteDokter.getRowCount());
    }

    private void tampilkanPilihanPenjab(String kataKunci){
        if (sedangMengisiDariAutocomplete) return;
        String kunci = kataKunci == null ? "" : kataKunci.trim();
        if (kunci.length() < MINIMUM_KARAKTER_AUTOCOMPLETE) {
            popupAutocompletePenjab.setVisible(false);
            return;
        }
        muatCachePenjabJikaPerlu();
        modelAutocompletePenjab.setRowCount(0);
        for (CachePenjabAutocomplete item : cachePenjabAutocomplete) {
            if (cocokAutocomplete(kunci, item.kode, item.nama)) {
                modelAutocompletePenjab.addRow(new Object[]{item.kode, item.nama});
            }
        }
        tampilkanPopupPilihan(nmpnj, popupAutocompletePenjab, tabelAutocompletePenjab, modelAutocompletePenjab.getRowCount());
    }

    private void tampilkanPilihanPerujuk(String kataKunci){
        if (sedangMengisiDariAutocomplete) return;
        String kunci = kataKunci == null ? "" : kataKunci.trim();
        if (kunci.length() < MINIMUM_KARAKTER_AUTOCOMPLETE) {
            popupAutocompletePerujuk.setVisible(false);
            return;
        }
        muatCachePerujukJikaPerlu();
        modelAutocompletePerujuk.setRowCount(0);
        for (CachePerujukAutocomplete item : cachePerujukAutocomplete) {
            if (cocokAutocomplete(kunci, "", item.nama)) {
                modelAutocompletePerujuk.addRow(new Object[]{item.nama, item.alamat});
            }
        }
        tampilkanPopupPilihan(AsalRujukan, popupAutocompletePerujuk, tabelAutocompletePerujuk, modelAutocompletePerujuk.getRowCount());
    }

    private boolean tampilkanLuarJadwalAutocomplete(){
        return ChkTampilLuarJadwal != null && ChkTampilLuarJadwal.isSelected();
    }

    private boolean bolehLihatSemuaPoliAutocomplete(){
        if (akses.getkode().equals("Admin Utama")) return true;
        if (hakLihatSemuaPoliAutocomplete == null) {
            hakLihatSemuaPoliAutocomplete = Sequel.cariInteger(
                    "select count(*) from dokter_mpp where kd_dokter=? and status='4'", akses.getkode()) > 0;
        }
        return hakLihatSemuaPoliAutocomplete.booleanValue();
    }

    private String hariKerjaRegistrasiAutocomplete(){
        Calendar kalender = Calendar.getInstance(new Locale("id", "ID"));
        java.util.Date tanggal = DTPReg.getDate();
        if (tanggal != null) kalender.setTime(tanggal);
        String[] namaHari = {"Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"};
        return namaHari[kalender.get(Calendar.DAY_OF_WEEK) - 1];
    }

    private void ChkTampilLuarJadwalActionPerformed(java.awt.event.ActionEvent evt) {
        bersihkanCacheAutocompleteKonteks();
        if (TPoli.getText().trim().length() >= MINIMUM_KARAKTER_AUTOCOMPLETE) tampilkanPilihanPoli(TPoli.getText());
        if (TDokter.getText().trim().length() >= MINIMUM_KARAKTER_AUTOCOMPLETE) tampilkanPilihanDokter(TDokter.getText());
    }

    private boolean poliSudahDipilihDenganValid(){
        String kodePoli = kdpoli.getText().trim();
        return !kodePoli.equals("") && !namaPoliBerdasarkanKode(kodePoli).equals("");
    }

    private String namaPoliBerdasarkanKode(String kodePoli){
        if (kodePoli == null || kodePoli.trim().equals("")) return "";
        muatCachePoliJikaPerlu();
        for (CachePoliAutocomplete item : cachePoliAutocomplete) {
            if (kodePoli.trim().equals(item.kode)) return item.nama.trim();
        }
        return "";
    }

    private String namaDokterBerdasarkanKode(String kodeDokter){
        if (kodeDokter == null || kodeDokter.trim().equals("")) return "";
        muatCacheDokterJikaPerlu();
        for (CacheDokterAutocomplete item : cacheDokterAutocomplete) {
            if (kodeDokter.trim().equals(item.kode)) return item.nama.trim();
        }
        return "";
    }

    private String namaPenjabBerdasarkanKode(String kodePenjab){
        if (kodePenjab == null || kodePenjab.trim().equals("")) return "";
        muatCachePenjabJikaPerlu();
        for (CachePenjabAutocomplete item : cachePenjabAutocomplete) {
            if (kodePenjab.trim().equals(item.kode)) return item.nama.trim();
        }
        return "";
    }

    private boolean cocokAutocomplete(String kataKunci, String kode, String nama){
        String kunci = kataKunci == null ? "" : kataKunci.trim().toLowerCase(Locale.ROOT);
        String nilaiKode = kode == null ? "" : kode.toLowerCase(Locale.ROOT);
        String nilaiNama = nama == null ? "" : nama.toLowerCase(Locale.ROOT);
        return nilaiKode.contains(kunci) || nilaiNama.contains(kunci);
    }

    private String nilaiAmanTabel(JTable tabel, int baris, int kolom){
        try {
            if (tabel != null && baris >= 0 && baris < tabel.getRowCount()
                    && kolom >= 0 && kolom < tabel.getColumnCount()) {
                Object nilai = tabel.getValueAt(baris, kolom);
                return nilai == null ? "" : nilai.toString();
            }
        } catch (Exception e) {
            System.out.println("Autocomplete registrasi, baca tabel: " + e);
        }
        return "";
    }

    /** Popup otomatis setinggi jumlah hasil (1-11 baris) dan selebihnya scroll. */
    private void tampilkanPopupPilihan(JTextField field, javax.swing.JPopupMenu popup, JTable tabel, int jumlahBaris){
        if (jumlahBaris <= 0) {
            popup.setVisible(false);
            return;
        }
        int lebar = Math.max(1, field.getWidth());
        int barisTampil = Math.min(jumlahBaris, MAKSIMAL_TAMPIL_BARIS_AUTOCOMPLETE);
        int tinggiData = Math.max(1, barisTampil) * tabel.getRowHeight();
        int tinggiHeader = Math.max(TINGGI_HEADER_AUTOCOMPLETE, tabel.getTableHeader().getPreferredSize().height);
        int tinggiScroll = tinggiHeader + tinggiData + 2;

        for (java.awt.Component komponen : popup.getComponents()) {
            if (komponen instanceof javax.swing.JScrollPane) {
                javax.swing.JScrollPane scroll = (javax.swing.JScrollPane) komponen;
                int lebarViewport = lebar;
                if (jumlahBaris > MAKSIMAL_TAMPIL_BARIS_AUTOCOMPLETE) {
                    lebarViewport = Math.max(1, lebar - scroll.getVerticalScrollBar().getPreferredSize().width);
                }
                Dimension ukuranViewport = new Dimension(lebarViewport, tinggiData);
                tabel.setPreferredScrollableViewportSize(ukuranViewport);
                scroll.getViewport().setPreferredSize(ukuranViewport);
                scroll.setPreferredSize(new Dimension(lebar, tinggiScroll));
                scroll.setMinimumSize(new Dimension(lebar, tinggiScroll));
                scroll.setSize(lebar, tinggiScroll);
                scroll.revalidate();
                scroll.doLayout();
                break;
            }
        }
        java.awt.Insets insets = popup.getInsets();
        Dimension ukuranPopup = new Dimension(lebar, tinggiScroll + insets.top + insets.bottom);
        popup.setPreferredSize(ukuranPopup);
        popup.setPopupSize(ukuranPopup);
        popup.setSize(ukuranPopup);
        popup.revalidate();
        if (tabel.getRowCount() > 0) tabel.setRowSelectionInterval(0, 0);
        popup.show(field, 0, field.getHeight());
        popup.setPopupSize(ukuranPopup);
    }

    /** jenis: 1=poli, 2=dokter, 3=jenis bayar, 4=asal rujukan. */
    private void navigasiAutocomplete(KeyEvent evt, JTable tabel, javax.swing.JPopupMenu popup, int jenis){
        if (!popup.isVisible()) return;
        int barisTerpilih = tabel.getSelectedRow();
        if (evt.getKeyCode() == KeyEvent.VK_DOWN) {
            int berikut = Math.min(tabel.getRowCount() - 1, Math.max(0, barisTerpilih + 1));
            tabel.setRowSelectionInterval(berikut, berikut);
            tabel.scrollRectToVisible(tabel.getCellRect(berikut, 0, true));
            evt.consume();
        } else if (evt.getKeyCode() == KeyEvent.VK_UP) {
            int sebelumnya = Math.max(0, barisTerpilih - 1);
            tabel.setRowSelectionInterval(sebelumnya, sebelumnya);
            tabel.scrollRectToVisible(tabel.getCellRect(sebelumnya, 0, true));
            evt.consume();
        } else if (evt.getKeyCode() == KeyEvent.VK_ENTER) {
            if (jenis == 1) pilihBarisAutocompletePoli();
            else if (jenis == 2) pilihBarisAutocompleteDokter();
            else if (jenis == 3) pilihBarisAutocompletePenjab();
            else pilihBarisAutocompletePerujuk();
            evt.consume();
        } else if (evt.getKeyCode() == KeyEvent.VK_ESCAPE) {
            popup.setVisible(false);
            evt.consume();
        }
    }

    private void pilihBarisAutocompletePoli(){
        int baris = tabelAutocompletePoli.getSelectedRow();
        if (baris < 0) return;
        isiPoliTerpilih(nilaiAmanTabel(tabelAutocompletePoli, baris, 0),
                nilaiAmanTabel(tabelAutocompletePoli, baris, 1),
                nilaiAmanTabel(tabelAutocompletePoli, baris, 2),
                nilaiAmanTabel(tabelAutocompletePoli, baris, 3), true);
        popupAutocompletePoli.setVisible(false);
        TDokter.requestFocus();
    }

    private void pilihBarisAutocompleteDokter(){
        int baris = tabelAutocompleteDokter.getSelectedRow();
        if (baris < 0) return;
        isiDokterTerpilih(nilaiAmanTabel(tabelAutocompleteDokter, baris, 0),
                nilaiAmanTabel(tabelAutocompleteDokter, baris, 1),
                sumberDokterAutocompleteDariJadwal,
                nilaiAmanTabel(tabelAutocompleteDokter, baris, 2));
        popupAutocompleteDokter.setVisible(false);
        TNoRM.requestFocus();
    }

    private void pilihBarisAutocompletePenjab(){
        int baris = tabelAutocompletePenjab.getSelectedRow();
        if (baris < 0) return;
        isiJenisBayarOtomatis(
                nilaiAmanTabel(tabelAutocompletePenjab, baris, 0),
                nilaiAmanTabel(tabelAutocompletePenjab, baris, 1));
        setBiayaRegistrasiSesuaiJenisBayar();
        isNumber();
        popupAutocompletePenjab.setVisible(false);
        TNoRM.requestFocus();
    }

    private void pilihBarisAutocompletePerujuk(){
        int baris = tabelAutocompletePerujuk.getSelectedRow();
        if (baris < 0) return;
        isiPerujukTerpilih(nilaiAmanTabel(tabelAutocompletePerujuk, baris, 0),
                nilaiAmanTabel(tabelAutocompletePerujuk, baris, 1));
        popupAutocompletePerujuk.setVisible(false);
        BtnSimpan.requestFocus();
    }

    private void isiPerujukTerpilih(String nama, String alamat){
        boolean statusAwal = sedangMengisiDariAutocomplete;
        sedangMengisiDariAutocomplete = true;
        try {
            AsalRujukan.setText(nama == null ? "" : nama);
            alamatperujuk = (alamat == null || alamat.trim().equals("")) ? "-" : alamat.trim();
        } finally {
            sedangMengisiDariAutocomplete = statusAwal;
        }
    }

    private void isiPoliTanpaPerhitungan(String kode, String nama){
        boolean statusAwal = sedangMengisiDariAutocomplete;
        sedangMengisiDariAutocomplete = true;
        try { kdpoli.setText(kode == null ? "" : kode); TPoli.setText(nama == null ? "" : nama); }
        finally { sedangMengisiDariAutocomplete = statusAwal; }
    }

    private void isiDokterTanpaPerhitungan(String kode, String nama){
        boolean statusAwal = sedangMengisiDariAutocomplete;
        sedangMengisiDariAutocomplete = true;
        try { KdDokter.setText(kode == null ? "" : kode); TDokter.setText(nama == null ? "" : nama); }
        finally { sedangMengisiDariAutocomplete = statusAwal; }
    }

    private void isiPoliTerpilih(String kode, String nama, String biayaBaru, String biayaLama, boolean hapusDokter){
        boolean statusAwal = sedangMengisiDariAutocomplete;
        sedangMengisiDariAutocomplete = true;
        try {
            kdpoli.setText(kode == null ? "" : kode);
            TPoli.setText(nama == null ? "" : nama);
            if (hapusDokter) { KdDokter.setText(""); TDokter.setText(""); }
            if (!biayaBaru.trim().equals("") || !biayaLama.trim().equals("")) {
                switch (TStatus.getText()) {
                    case "Lama": TBiaya.setText(biayaLama); break;
                    case "Baru":
                    default: TBiaya.setText(biayaBaru); break;
                }
            }
            setBiayaRegistrasiSesuaiJenisBayar();
            isNumber();
        } finally {
            sedangMengisiDariAutocomplete = statusAwal;
        }
        modelAutocompleteDokter.setRowCount(0);
        sumberDokterAutocompleteDariJadwal = false;
        if (popupAutocompleteDokter != null) popupAutocompleteDokter.setVisible(false);
    }

    private void isiDokterTerpilih(String kode, String nama, boolean dariJadwal, String nilaiKuota){
        boolean statusAwal = sedangMengisiDariAutocomplete;
        sedangMengisiDariAutocomplete = true;
        try {
            KdDokter.setText(kode == null ? "" : kode);
            TDokter.setText(nama == null ? "" : nama);
            if (dariJadwal && nilaiKuota != null && !nilaiKuota.trim().equals("")) {
                try { kuota = Integer.parseInt(nilaiKuota.trim()); }
                catch (NumberFormatException e) { System.out.println("Autocomplete registrasi, kuota dokter tidak valid: " + nilaiKuota); }
            }
            isNumber();
        } finally {
            sedangMengisiDariAutocomplete = statusAwal;
        }
    }

private void KdDokterKeyPressed(java.awt.event.KeyEvent evt) {//GEN-FIRST:event_KdDokterKeyPressed
        if(evt.getKeyCode()==KeyEvent.VK_PAGE_DOWN){
