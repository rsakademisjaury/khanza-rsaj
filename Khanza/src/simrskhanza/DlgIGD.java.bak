    /*
     * Validasi nama pasien sebelum registrasi/IGD disimpan.
     * Dialog hanya tampil bila benar-benar ditemukan sapaan/penanda nama
     * atau gelar akademis. Normalisasi spasi tidak lagi dijadikan dasar
     * deteksi agar nama biasa tidak memunculkan dialog validasi.
     */
    private boolean memilikiSapaanNamaPasien(String namaPasien){
        String nama = namaPasien == null ? "" : namaPasien.trim();
        return POLA_SAPAAN_AWAL_NAMA_PASIEN.matcher(nama).find()
                || POLA_SAPAAN_AKHIR_NAMA_PASIEN.matcher(nama).find();
    }

    private String hapusSapaanNamaPasien(String namaPasien){
        String hasil = namaPasien == null ? "" : namaPasien.trim();
        String sebelum;

        do{
            sebelum = hasil;
            hasil = POLA_SAPAAN_AWAL_NAMA_PASIEN.matcher(hasil).replaceFirst("");
            hasil = POLA_SAPAAN_AKHIR_NAMA_PASIEN.matcher(hasil).replaceFirst("");
            hasil = hasil.replaceAll("\\s{2,}", " ").trim();
        }while(!sebelum.equals(hasil));

        return hasil.replaceAll("\\s+,", ",").replaceAll(",\\s*$", "").trim();
    }

    private boolean validasiNamaPasienSebelumSimpan(){
        /*
         * Setelah Edit Nama Manual berhasil, proses simpan dipanggil ulang
         * sekali melalui event queue. Jangan tampilkan dialog validasi untuk
         * pemanggilan ulang itu karena petugas baru saja mengonfirmasi edit.
         */
        if(lewatiValidasiNamaPasienSekali){
            lewatiValidasiNamaPasienSekali = false;
            return true;
        }

        String noRM = TNoRM.getText().trim();
        String namaLama = Sequel.cariIsi(
                "select nm_pasien from pasien where no_rkm_medis=?",
                noRM
        );
        if(namaLama == null){
            namaLama = "";
        }
        namaLama = namaLama.trim();

        if(namaLama.equals("")){
            JOptionPane.showMessageDialog(
                    rootPane,
                    "Nama master pasien tidak ditemukan. Silakan pilih pasien kembali sebelum menyimpan.",
                    "Validasi Nama Pasien",
                    JOptionPane.WARNING_MESSAGE
            );
            TNoRM.requestFocus();
            return false;
        }

        /*
         * Penting: deteksi sapaan menggunakan kecocokan pola, bukan dengan
         * membandingkan hasil normalisasi nama. Dengan demikian nama biasa
         * yang hanya memiliki spasi ganda/tanda baca tidak akan memunculkan
         * dialog validasi.
         */
        boolean adaSapaan = memilikiSapaanNamaPasien(namaLama);
        boolean adaGelarAkademis = POLA_GELAR_AKADEMIS_NAMA_PASIEN.matcher(namaLama).find();

        if(!adaSapaan && !adaGelarAkademis){
            return true;
        }

        String namaTanpaSapaan = adaSapaan ? hapusSapaanNamaPasien(namaLama) : namaLama;
        int aksi = tampilDialogValidasiNamaPasien(
                namaLama, namaTanpaSapaan, adaSapaan, adaGelarAkademis
        );

        if(aksi == AKSI_VALIDASI_NAMA_HAPUS_SAPAAN){
            if(namaTanpaSapaan.equals("")){
                JOptionPane.showMessageDialog(
                        rootPane,
                        "Nama hasil pembersihan kosong. Silakan periksa nama pasien terlebih dahulu.",
                        "Validasi Nama Pasien",
                        JOptionPane.WARNING_MESSAGE
                );
                return false;
            }
            return simpanNamaPasienDariValidasi(namaTanpaSapaan);
        }else if(aksi == AKSI_VALIDASI_NAMA_LANJUT){
            return true;
        }else if(aksi == AKSI_VALIDASI_NAMA_EDIT_MANUAL){
            /*
             * Dialog edit bersifat modal. Setelah nama berhasil disimpan,
             * jadwalkan ulang aksi Simpan agar seluruh proses registrasi/IGD
             * yang semula sedang berjalan diteruskan otomatis. Pemanggilan
             * awal dihentikan di sini untuk mencegah proses simpan ganda.
             */
            if(tampilDialogEditNamaPasien(namaLama)){
                jadwalkanSimpanSetelahEditNamaManual();
            }
            return false;
        }

        return false;
    }

    private void jadwalkanSimpanSetelahEditNamaManual(){
        if(simpanLanjutanSetelahEditNamaPasienDijadwalkan){
            return;
        }

        simpanLanjutanSetelahEditNamaPasienDijadwalkan = true;
        javax.swing.SwingUtilities.invokeLater(new Runnable() {
            @Override
            public void run() {
                try{
                    /*
                     * Panggil kembali alur simpan yang sama, sehingga semua
                     * validasi registrasi/IGD lain tetap berjalan normal.
                     * Yang dilewati hanya popup nama ini, sekali saja.
                     */
                    lewatiValidasiNamaPasienSekali = true;
                    BtnSimpanActionPerformed(null);
                }finally{
                    lewatiValidasiNamaPasienSekali = false;
                    simpanLanjutanSetelahEditNamaPasienDijadwalkan = false;
                }
            }
        });
    }

    private int tampilDialogValidasiNamaPasien(
            String namaLama, String namaTanpaSapaan,
            boolean adaSapaan, boolean adaGelarAkademis
    ){
        final int[] aksi = {AKSI_VALIDASI_NAMA_BATAL};
        final javax.swing.JDialog dialog = new javax.swing.JDialog(
                this, "Verifikasi Nama Pasien", true
        );
        dialog.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
        dialog.setResizable(false);

        javax.swing.JPanel utama = new javax.swing.JPanel(new java.awt.BorderLayout());
        utama.setBackground(java.awt.Color.WHITE);
        utama.setBorder(javax.swing.BorderFactory.createLineBorder(new java.awt.Color(211, 222, 234)));

        javax.swing.JPanel header = new javax.swing.JPanel(new java.awt.BorderLayout(14, 0));
        header.setBackground(new java.awt.Color(18, 92, 162));
        header.setBorder(javax.swing.BorderFactory.createEmptyBorder(16, 20, 16, 20));
        javax.swing.JLabel ikon = new javax.swing.JLabel(javax.swing.UIManager.getIcon("OptionPane.warningIcon"));
        ikon.setVerticalAlignment(javax.swing.SwingConstants.TOP);
        header.add(ikon, java.awt.BorderLayout.WEST);

        javax.swing.JPanel judulHeader = new javax.swing.JPanel();
        judulHeader.setOpaque(false);
        judulHeader.setLayout(new javax.swing.BoxLayout(judulHeader, javax.swing.BoxLayout.Y_AXIS));
        javax.swing.JLabel judul = new javax.swing.JLabel("Verifikasi Nama Pasien");
        judul.setForeground(java.awt.Color.WHITE);
        judul.setFont(new java.awt.Font("Segoe UI", java.awt.Font.BOLD, 18));
        javax.swing.JLabel subJudul = new javax.swing.JLabel("Pastikan identitas pasien sesuai KTP / Dukcapil sebelum pendaftaran disimpan");
        subJudul.setForeground(new java.awt.Color(225, 239, 252));
        subJudul.setFont(new java.awt.Font("Segoe UI", java.awt.Font.PLAIN, 12));
        judulHeader.add(judul);
        judulHeader.add(javax.swing.Box.createVerticalStrut(4));
        judulHeader.add(subJudul);
        header.add(judulHeader, java.awt.BorderLayout.CENTER);
        utama.add(header, java.awt.BorderLayout.NORTH);

        javax.swing.JPanel isi = new javax.swing.JPanel();
        isi.setOpaque(true);
        isi.setBackground(java.awt.Color.WHITE);
        isi.setLayout(new javax.swing.BoxLayout(isi, javax.swing.BoxLayout.Y_AXIS));
        isi.setBorder(javax.swing.BorderFactory.createEmptyBorder(18, 20, 12, 20));

        String keterangan;
        if(adaSapaan && adaGelarAkademis){
            keterangan = "Sistem menemukan sapaan/penanda nama dan gelar tambahan pada data pasien.";
        }else if(adaSapaan){
            keterangan = "Sistem menemukan sapaan/penanda nama pada data pasien.";
        }else{
            keterangan = "Sistem menemukan gelar tambahan pada data pasien.";
        }
        javax.swing.JTextArea informasi = buatAreaInformasiNama(keterangan, 13, new java.awt.Color(61, 73, 87));
        isi.add(informasi);
        isi.add(javax.swing.Box.createVerticalStrut(12));
        isi.add(buatKartuInformasiNama("NAMA SAAT INI", namaLama, new java.awt.Color(92, 105, 121)));

        if(adaSapaan){
            isi.add(javax.swing.Box.createVerticalStrut(10));
            isi.add(buatKartuInformasiNama("REKOMENDASI NAMA", namaTanpaSapaan, new java.awt.Color(23, 128, 181)));
        }

        isi.add(javax.swing.Box.createVerticalStrut(12));
        String catatan = adaSapaan
                ? "Penghapusan otomatis hanya berlaku untuk Tn., Ny., Nn., atau An. yang berdiri sendiri di awal/akhir nama."
                : "Gelar akademis tidak dihapus otomatis. Gunakan Edit Nama Manual bila perlu disesuaikan dengan KTP/Dukcapil.";
        if(adaGelarAkademis && adaSapaan){
            catatan += " Gelar akademis tetap dipertahankan dan dapat diperbaiki melalui Edit Nama Manual.";
        }
        javax.swing.JPanel catatanPanel = new javax.swing.JPanel(new java.awt.BorderLayout(9, 0));
        catatanPanel.setMaximumSize(new java.awt.Dimension(720, 58));
        catatanPanel.setBackground(new java.awt.Color(242, 247, 252));
        catatanPanel.setBorder(javax.swing.BorderFactory.createCompoundBorder(
                javax.swing.BorderFactory.createLineBorder(new java.awt.Color(205, 223, 239)),
                javax.swing.BorderFactory.createEmptyBorder(9, 11, 9, 11)
        ));
        javax.swing.JLabel ikonInfo = new javax.swing.JLabel(javax.swing.UIManager.getIcon("OptionPane.informationIcon"));
        catatanPanel.add(ikonInfo, java.awt.BorderLayout.WEST);
        catatanPanel.add(buatAreaInformasiNama(catatan, 12, new java.awt.Color(57, 78, 98)), java.awt.BorderLayout.CENTER);
        isi.add(catatanPanel);
        utama.add(isi, java.awt.BorderLayout.CENTER);

        javax.swing.JPanel footer = new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.RIGHT, 8, 11));
        footer.setBackground(new java.awt.Color(248, 250, 252));
        footer.setBorder(javax.swing.BorderFactory.createMatteBorder(1, 0, 0, 0, new java.awt.Color(222, 229, 236)));

        /*
         * Tombol menggunakan warna solid agar tetap terbaca pada semua
         * LookAndFeel Java. Saat mouse diarahkan ke tombol, warna dibuat
         * sedikit lebih gelap sebagai penanda interaksi.
         */
        final javax.swing.JButton btnBatal = buatTombolValidasiNama(
                "Batal",
                new java.awt.Color(220, 38, 38),
                new java.awt.Color(185, 28, 28)
        );
        btnBatal.addActionListener(new java.awt.event.ActionListener() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                aksi[0] = AKSI_VALIDASI_NAMA_BATAL;
                dialog.dispose();
            }
        });

        final javax.swing.JButton btnEdit = buatTombolValidasiNama(
                "Edit Nama Manual",
                new java.awt.Color(249, 115, 22),
                new java.awt.Color(194, 65, 12)
        );
        btnEdit.addActionListener(new java.awt.event.ActionListener() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                aksi[0] = AKSI_VALIDASI_NAMA_EDIT_MANUAL;
                dialog.dispose();
            }
        });

        final javax.swing.JButton btnLanjut = buatTombolValidasiNama(
                "Lanjut Simpan, data sesuai KTP",
                new java.awt.Color(37, 99, 235),
                new java.awt.Color(29, 78, 216)
        );
        btnLanjut.addActionListener(new java.awt.event.ActionListener() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                aksi[0] = AKSI_VALIDASI_NAMA_LANJUT;
                dialog.dispose();
            }
        });

        javax.swing.JButton btnHapusSapaan = null;
        if(adaSapaan){
            btnHapusSapaan = buatTombolValidasiNama(
                    "Hilangkan Sapaan & Simpan",
                    new java.awt.Color(22, 163, 74),
                    new java.awt.Color(21, 128, 61)
            );
            btnHapusSapaan.addActionListener(new java.awt.event.ActionListener() {
                @Override
                public void actionPerformed(java.awt.event.ActionEvent e) {
                    aksi[0] = AKSI_VALIDASI_NAMA_HAPUS_SAPAAN;
                    dialog.dispose();
                }
            });
            footer.add(btnHapusSapaan);
        }
        footer.add(btnLanjut);
        footer.add(btnEdit);
        footer.add(btnBatal);
        utama.add(footer, java.awt.BorderLayout.SOUTH);

        /*
         * Saat sapaan ditemukan, tombol hapus menjadi tombol utama: fokus
         * awal langsung berada di tombol itu dan Enter menjalankan aksi yang
         * sama. Untuk kasus gelar akademis tanpa sapaan, tombol utama adalah
         * Lanjut Simpan karena tidak ada penghapusan otomatis.
         */
        final javax.swing.JButton tombolFokusUtama =
                (btnHapusSapaan != null) ? btnHapusSapaan : btnLanjut;

        dialog.setContentPane(utama);
        dialog.getRootPane().setDefaultButton(tombolFokusUtama);
        dialog.addWindowListener(new java.awt.event.WindowAdapter() {
            @Override
            public void windowOpened(java.awt.event.WindowEvent e) {
                tombolFokusUtama.requestFocusInWindow();
            }
        });
        dialog.getRootPane().registerKeyboardAction(
                new java.awt.event.ActionListener() {
                    @Override
                    public void actionPerformed(java.awt.event.ActionEvent e) {
                        aksi[0] = AKSI_VALIDASI_NAMA_BATAL;
                        dialog.dispose();
                    }
                },
                javax.swing.KeyStroke.getKeyStroke(java.awt.event.KeyEvent.VK_ESCAPE, 0),
                javax.swing.JComponent.WHEN_IN_FOCUSED_WINDOW
        );
        dialog.pack();
        dialog.setSize(760, dialog.getHeight());
        dialog.setLocationRelativeTo(this);
        dialog.setVisible(true);
        return aksi[0];
    }

    private javax.swing.JPanel buatKartuInformasiNama(String judul, String isi, java.awt.Color warnaAksen){
        javax.swing.JPanel kartu = new javax.swing.JPanel(new java.awt.BorderLayout(0, 5));
        kartu.setMaximumSize(new java.awt.Dimension(720, 82));
        kartu.setBackground(java.awt.Color.WHITE);
        kartu.setBorder(javax.swing.BorderFactory.createCompoundBorder(
                javax.swing.BorderFactory.createMatteBorder(0, 4, 0, 0, warnaAksen),
                javax.swing.BorderFactory.createCompoundBorder(
                        javax.swing.BorderFactory.createLineBorder(new java.awt.Color(222, 229, 236)),
                        javax.swing.BorderFactory.createEmptyBorder(10, 12, 10, 12)
                )
        ));
        javax.swing.JLabel labelJudul = new javax.swing.JLabel(judul);
        labelJudul.setForeground(warnaAksen);
        labelJudul.setFont(new java.awt.Font("Segoe UI", java.awt.Font.BOLD, 11));
        kartu.add(labelJudul, java.awt.BorderLayout.NORTH);
        kartu.add(buatAreaInformasiNama(isi, 15, new java.awt.Color(35, 48, 62)), java.awt.BorderLayout.CENTER);
        return kartu;
    }

    private javax.swing.JTextArea buatAreaInformasiNama(String teks, int ukuran, java.awt.Color warna){
        javax.swing.JTextArea area = new javax.swing.JTextArea(teks == null ? "" : teks);
        area.setEditable(false);
        area.setFocusable(false);
        area.setOpaque(false);
        area.setLineWrap(true);
        area.setWrapStyleWord(true);
        area.setForeground(warna);
        area.setFont(new java.awt.Font("Segoe UI", java.awt.Font.PLAIN, ukuran));
        area.setBorder(javax.swing.BorderFactory.createEmptyBorder(0, 0, 0, 0));
        return area;
    }

    private javax.swing.JButton buatTombolValidasiNama(
            String teks, final java.awt.Color latar, final java.awt.Color latarHover
    ){
        /*
         * Background dilukis sendiri agar warna tombol tidak ditimpa oleh
         * LookAndFeel bawaan Windows/Nimbus. Dengan cara ini teks putih dan
         * warna tombol selalu terbaca jelas.
         */
        final javax.swing.JButton tombol = new javax.swing.JButton(teks) {
            @Override
            protected void paintComponent(java.awt.Graphics g) {
                java.awt.Graphics2D g2 = (java.awt.Graphics2D) g.create();
                try{
                    g2.setRenderingHint(
                            java.awt.RenderingHints.KEY_ANTIALIASING,
                            java.awt.RenderingHints.VALUE_ANTIALIAS_ON
                    );
                    g2.setColor(getBackground());
                    g2.fillRoundRect(0, 0, getWidth() - 1, getHeight() - 1, 8, 8);
                }finally{
                    g2.dispose();
                }
                super.paintComponent(g);
            }

            @Override
            protected void paintBorder(java.awt.Graphics g) {
                // Border bawaan dinonaktifkan karena tombol memakai sudut membulat.
            }
        };
        tombol.setFont(new java.awt.Font("Segoe UI", java.awt.Font.BOLD, 12));
        tombol.setForeground(java.awt.Color.WHITE);
        tombol.setBackground(latar);
        tombol.setOpaque(false);
        tombol.setContentAreaFilled(false);
        tombol.setBorderPainted(false);
        tombol.setFocusPainted(false);
        tombol.setRolloverEnabled(false);
        tombol.setCursor(new java.awt.Cursor(java.awt.Cursor.HAND_CURSOR));
        tombol.setBorder(javax.swing.BorderFactory.createEmptyBorder(8, 16, 8, 16));
        tombol.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override
            public void mouseEntered(java.awt.event.MouseEvent e) {
                if(tombol.isEnabled()){
                    tombol.setBackground(latarHover);
                    tombol.repaint();
                }
            }

            @Override
            public void mouseExited(java.awt.event.MouseEvent e) {
                tombol.setBackground(latar);
                tombol.repaint();
            }
        });
        return tombol;
    }

    private boolean tampilDialogEditNamaPasien(final String namaLama){
        final boolean[] berhasil = {false};
        final javax.swing.JDialog dialog = new javax.swing.JDialog(
                this, "Edit Nama Pasien", true
        );
        dialog.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
