    private void bukaVisumEtRepertum() {
        if(tabMode.getRowCount()==0){
            JOptionPane.showMessageDialog(null,"Maaf, data pasien sudah habis...!!!!");
            TNoRw.requestFocus();
        }else if(TPasien.getText().trim().equals("")){
            JOptionPane.showMessageDialog(null,"Maaf, Silahkan anda pilih dulu data registrasi pada table...!!!");
            TCari.requestFocus();
        }else{
            if(tbPetugas.getSelectedRow()!= -1){
                this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
                SuratVisum form=new SuratVisum(null,false);
                form.isCek();
                form.emptTeks();
                form.setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
                form.setLocationRelativeTo(internalFrame1);
                form.setNoRm(TNoRw.getText(),TNoRM.getText(),TPasien.getText(),KdDokter.getText(),TDokter.getText(),DTPCari1.getDate(),DTPCari2.getDate());
                form.tampil();
                form.setVisible(true);
                this.setCursor(Cursor.getDefaultCursor());
            }
        }
    }

    private void isiDataRujukanSatuSehat(SatuSehatRujukanForm dlgki) {
           String noRawat=TNoRw.getText().trim();
        String namaPasien=Sequel.cariIsi(
                "select pasien.nm_pasien from reg_periksa inner join pasien on pasien.no_rkm_medis=reg_periksa.no_rkm_medis where reg_periksa.no_rawat=?",
                noRawat);
        if(namaPasien.equals("")){
            namaPasien=TPasien.getText().trim();
        }
        String nikPasien=Sequel.cariIsi(
                "select pasien.no_ktp from reg_periksa inner join pasien on pasien.no_rkm_medis=reg_periksa.no_rkm_medis where reg_periksa.no_rawat=?",
                noRawat);
        String nikDokter=Sequel.cariIsi(
                "select pegawai.no_ktp from reg_periksa inner join pegawai on pegawai.nik=reg_periksa.kd_dokter where reg_periksa.no_rawat=?",
                noRawat);
        String idPasien="";
        String idPraktisi="";
        SatuSehatCekNIK cekViaSatuSehat=new SatuSehatCekNIK();
        if(!nikPasien.equals("")){
            idPasien=cekViaSatuSehat.tampilIDPasien(nikPasien);
        }
        if(!nikDokter.equals("")){
            idPraktisi=cekViaSatuSehat.tampilIDParktisi(nikDokter);
        }
        String idEncounter=Sequel.cariIsi("select id_encounter from satu_sehat_encounter where no_rawat=?",noRawat);
        String kodeDiagnosa=Sequel.cariIsi(
                "select diagnosa_pasien.kd_penyakit from diagnosa_pasien where diagnosa_pasien.status='Ralan' and diagnosa_pasien.prioritas='1' and diagnosa_pasien.no_rawat=?",
                noRawat);
        String namaDiagnosa=Sequel.cariIsi(
                "select penyakit.nm_penyakit from diagnosa_pasien inner join penyakit on penyakit.kd_penyakit=diagnosa_pasien.kd_penyakit where diagnosa_pasien.status='Ralan' and diagnosa_pasien.prioritas='1' and diagnosa_pasien.no_rawat=?",
                noRawat);
        String idOrganisasi=Sequel.cariIsi(
                "select satu_sehat_mapping_lokasi_ralan.id_organisasi_satusehat from reg_periksa inner join satu_sehat_mapping_lokasi_ralan on satu_sehat_mapping_lokasi_ralan.kd_poli=reg_periksa.kd_poli where reg_periksa.no_rawat=?",
                noRawat);
        String namaOrganisasi=Sequel.cariIsi(
                "select departemen.nama from reg_periksa inner join satu_sehat_mapping_lokasi_ralan on satu_sehat_mapping_lokasi_ralan.kd_poli=reg_periksa.kd_poli inner join satu_sehat_mapping_departemen on satu_sehat_mapping_departemen.id_organisasi_satusehat=satu_sehat_mapping_lokasi_ralan.id_organisasi_satusehat inner join departemen on departemen.dep_id=satu_sehat_mapping_departemen.dep_id where reg_periksa.no_rawat=?",
                noRawat);
        if(namaOrganisasi.equals("")){
            namaOrganisasi=akses.getnamars();
        }
        String tanggalRawat=Valid.SetTgl(DTPReg.getSelectedItem()+"");
        String jamRawat=CmbJam.getSelectedItem()+":"+CmbMenit.getSelectedItem()+":"+CmbDetik.getSelectedItem();
        String rencanaCarePlan=Sequel.cariIsi(
                "select pemeriksaan_ralan.rtl from pemeriksaan_ralan where pemeriksaan_ralan.no_rawat=? and pemeriksaan_ralan.rtl<>'' order by pemeriksaan_ralan.tgl_perawatan desc,pemeriksaan_ralan.jam_rawat desc limit 1",
                noRawat);
        if(rencanaCarePlan.equals("")){
            rencanaCarePlan="Rujukan IGD untuk pemeriksaan dan penanganan lebih lanjut";
        }
        String idCarePlan=Sequel.cariIsi(
                "select ifnull(satu_sehat_careplan.id_careplan,'') from pemeriksaan_ralan "+
                "left join satu_sehat_careplan on satu_sehat_careplan.no_rawat=pemeriksaan_ralan.no_rawat "+
                "and satu_sehat_careplan.tgl_perawatan=pemeriksaan_ralan.tgl_perawatan and satu_sehat_careplan.jam_rawat=pemeriksaan_ralan.jam_rawat "+
                "and satu_sehat_careplan.status='Ralan' "+
                "where pemeriksaan_ralan.no_rawat=? and pemeriksaan_ralan.rtl<>'' and ifnull(satu_sehat_careplan.id_careplan,'')<>'' "+
                "order by pemeriksaan_ralan.tgl_perawatan desc,pemeriksaan_ralan.jam_rawat desc limit 1",
                noRawat);
        String waktu=tanggalRawat+"T"+jamRawat+"+08:00";
        String dataPendukung=idEncounter.equals("") ? "" : "Encounter/"+idEncounter;
        String kodeFaskesSatuSehat=akses.getkodeppkbpjs();
        dlgki.setDataRujukan(
                "IGD", noRawat, kodeFaskesSatuSehat, idPasien, namaPasien, idPraktisi, TDokter.getText().trim(),
                idOrganisasi, namaOrganisasi, "", "", idEncounter, kodeDiagnosa, namaDiagnosa,
                waktu, rencanaCarePlan, dataPendukung, idCarePlan);
    }
}
