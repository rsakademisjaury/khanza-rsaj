        isPas();
    }

    public void SetPasien(String norm){
        ChkInput.setSelected(true);
        isForm(); 
        TNoRM.setText(norm);
        isPas();
    }
    
    public void setPasien(String NamaPasien,String Kontak,String Alamat,String TempatLahir,String TglLahir,
            String JK,String NoKartuJKN,String NIK,String nosisrute,String FaskesAsal){
        akses.setform("DlgIGD");
        ChkInput.setSelected(true);
        isForm(); 
        getPasien().emptTeks();
        getPasien().isCek();
        this.nosisrute=nosisrute;
        isiPerujukOtomatisIgd(FaskesAsal, "-");
        getPasien().setPasien(NamaPasien, Kontak, Alamat, TempatLahir, TglLahir, JK, NoKartuJKN, NIK);
        getPasien().setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
        getPasien().setLocationRelativeTo(internalFrame1);
        getPasien().setVisible(true);
    }
    

    // ================= PATCH RSAJ : BIO/FINGER + FOTO KTP IGD =================
    private void initBioFingerDanFotoKTPIGD(){
        BtnPantauFingerBPJS.setVisible(false);
        otomatisRefreshFingerIGD();
        pasangPemantauNoRMFotoKTP();
        tampilkanFotoKTPKosong();
        aturTombolFotoKTP();

        tbPetugas.getSelectionModel().addListSelectionListener(new javax.swing.event.ListSelectionListener() {
            @Override
            public void valueChanged(javax.swing.event.ListSelectionEvent e) {
                if(!e.getValueIsAdjusting()){
                    aturTombolPantauFingerBPJS();
                    panggilFotoKTPDariTabel();
                }
            }
        });
    }

    private void pantauFingerBPJSIGD(){
        if(tbPetugas.getSelectedRow() == -1){
            JOptionPane.showMessageDialog(null,"Silakan pilih pasien pada tabel IGD terlebih dahulu.");
            tbPetugas.requestFocus();
            return;
        }

        int baris = tbPetugas.getSelectedRow();
        String noRawat = nilaiTabel(tbPetugas, baris, 2);
        String kdPj = nilaiTabel(tbPetugas, baris, IDX_IGD_KD_PJ);
        String noSep = nilaiTabel(tbPetugas, baris, IDX_IGD_NO_SEP);
        String statusFinger = nilaiTabel(tbPetugas, baris, IDX_IGD_FINGER);

        if(!kdPj.equals("BPJ")){
            JOptionPane.showMessageDialog(null,"Pantau Finger hanya untuk pasien BPJS Kesehatan.");
            return;
        }
        if(!noSep.equals("SEP Belum Terbit")){
            JOptionPane.showMessageDialog(null,"SEP pasien sudah terbit, pemantauan finger tidak diperlukan.");
            aturTombolPantauFingerBPJS();
            return;
        }

        int usiaTahun = ambilUsiaTahunSaatRegistrasi(noRawat);
        if(usiaTahun < 0){
            JOptionPane.showMessageDialog(null,
                    "Umur pasien tidak dapat ditentukan dari tanggal lahir dan tanggal registrasi.\n"+
                    "Silakan periksa kembali data tanggal lahir pasien.");
            return;
        }

        if(usiaTahun < 17){
            if(sudahKonfirmasiHadirAnak(noRawat)){
                JOptionPane.showMessageDialog(null,"Pasien usia <17 tahun ini sudah dikonfirmasi hadir di loket.");
                aturTombolPantauFingerBPJS();
                return;
            }
            if(simpanKonfirmasiHadirAnak(noRawat)){
                JOptionPane.showMessageDialog(null,
                        "Kedatangan pasien usia <17 tahun berhasil dikonfirmasi.\n"+
                        "Pasien tidak perlu melakukan Bio/Finger.");
                tampil();
                aturTombolPantauFingerBPJS();
            }
            return;
        }

        if(sudahAdaMonitorFingerBPJS(noRawat)){
            JOptionPane.showMessageDialog(null,"Pasien sudah masuk antrean Pantau Finger BPJS.");
            aturTombolPantauFingerBPJS();
            aktifkanAutoRefreshPantauFingerIGD();
            return;
        }
        if(!statusFinger.equals("Belum Sidik Jari")){
            JOptionPane.showMessageDialog(null,"Finger pasien sudah tercatat, silakan lanjutkan pembuatan SEP.");
            return;
        }

        String sqlPantau = "INSERT INTO bpjs_finger_monitor " +
                "(no_rawat,no_kartu,tgl_pelayanan,status,attempt_count,last_checked_at,next_check_at,"+
                "response_code,response_message,requested_at,completed_at,created_at,updated_at) " +
                "SELECT rp.no_rawat,p.no_peserta,rp.tgl_registrasi,'ACTIVE',0,NULL,NOW(),NULL,NULL,NOW(),NULL,NOW(),NOW() " +
                "FROM reg_periksa rp INNER JOIN pasien p ON rp.no_rkm_medis=p.no_rkm_medis " +
                "WHERE rp.no_rawat=? AND rp.kd_pj='BPJ' " +
                "ON DUPLICATE KEY UPDATE no_kartu=VALUES(no_kartu),tgl_pelayanan=VALUES(tgl_pelayanan),"+
                "status='ACTIVE',attempt_count=0,last_checked_at=NULL,next_check_at=NOW(),"+
                "response_code=NULL,response_message=NULL,requested_at=NOW(),completed_at=NULL,updated_at=NOW()";

        try(PreparedStatement psPantau = koneksi.prepareStatement(sqlPantau)){
            psPantau.setString(1,noRawat);
            int hasil = psPantau.executeUpdate();
            if(hasil > 0){
                JOptionPane.showMessageDialog(null,
                        "Pasien berhasil dimasukkan ke antrean Pantau Finger BPJS.\n"+
                        "Status akan diperbarui otomatis saat Bio/Finger sudah tercatat.");
                tampil();
                aturTombolPantauFingerBPJS();
                aktifkanAutoRefreshPantauFingerIGD();
            }else{
                JOptionPane.showMessageDialog(null,"Data pasien BPJS tidak ditemukan.");
            }
        }catch(Exception e){
            JOptionPane.showMessageDialog(null,
                    "Gagal menyimpan antrean Pantau Finger BPJS.\n"+
                    "Pastikan tabel bpjs_finger_monitor sudah dibuat.\n\n"+e.getMessage());
            System.out.println("Notifikasi Pantau Finger BPJS IGD : "+e);
        }
    }

    private void otomatisRefreshFingerIGD(){
        if(timerPantauFingerIGD != null){
            timerPantauFingerIGD.stop();
        }
        timerPantauFingerIGD = new Timer(INTERVAL_PANTAU_FINGER_IGD, new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                if(!isVisible()){
                    timerPantauFingerIGD.stop();
                    return;
                }
                refreshStatusPantauFingerIGD();
            }
        });
        timerPantauFingerIGD.setRepeats(true);
        timerPantauFingerIGD.setInitialDelay(INTERVAL_PANTAU_FINGER_IGD);
    }

    private void aktifkanAutoRefreshPantauFingerIGD(){
        if(timerPantauFingerIGD == null){
            otomatisRefreshFingerIGD();
        }
        if(!timerPantauFingerIGD.isRunning()){
            timerPantauFingerIGD.start();
        }
    }

    private void hentikanAutoRefreshPantauFingerIGD(){
        if(timerPantauFingerIGD != null){
            timerPantauFingerIGD.stop();
        }
    }

    private void aturTombolPantauFingerBPJS(){
        try{
            BtnPantauFingerBPJS.setVisible(false);
            BtnPantauFingerBPJS.setEnabled(false);
            if(tbPetugas == null || tbPetugas.getSelectedRow() == -1 || tabMode.getRowCount() == 0){
                return;
            }

            int baris = tbPetugas.getSelectedRow();
            String noRawat = nilaiTabel(tbPetugas, baris, 2);
            String kdPj = nilaiTabel(tbPetugas, baris, IDX_IGD_KD_PJ);
            String noSep = nilaiTabel(tbPetugas, baris, IDX_IGD_NO_SEP);
            if(!kdPj.equals("BPJ")){
                return;
            }

            BtnPantauFingerBPJS.setVisible(true);
            if(!noSep.equals("SEP Belum Terbit")){
                BtnPantauFingerBPJS.setToolTipText("SEP sudah terbit, tombol Bio/Finger dinonaktifkan.");
                return;
            }

            int usiaTahun = ambilUsiaTahunSaatRegistrasi(noRawat);
            if(usiaTahun >= 0 && usiaTahun < 17){
                if(sudahKonfirmasiHadirAnak(noRawat)){
                    BtnPantauFingerBPJS.setToolTipText("Pasien usia <17 tahun sudah dikonfirmasi hadir di loket.");
                }else{
                    BtnPantauFingerBPJS.setEnabled(true);
                    BtnPantauFingerBPJS.setToolTipText("Pasien usia <17 tahun: klik untuk menandai pasien sudah hadir di loket.");
                }
                return;
            }

            String statusFinger = nilaiTabel(tbPetugas, baris, IDX_IGD_FINGER);
            if(!statusFinger.equals("Belum Sidik Jari")){
                BtnPantauFingerBPJS.setToolTipText("Bio/Finger pasien sudah tercatat.");
                return;
            }
            if(sudahAdaMonitorFingerBPJS(noRawat)){
                BtnPantauFingerBPJS.setToolTipText("Pasien sudah ada di antrean bpjs_finger_monitor.");
                aktifkanAutoRefreshPantauFingerIGD();
                return;
            }

            BtnPantauFingerBPJS.setEnabled(true);
            BtnPantauFingerBPJS.setToolTipText("Klik untuk memasukkan pasien ke antrean Pantau Finger BPJS.");
        }catch(Exception e){
            BtnPantauFingerBPJS.setVisible(false);
            BtnPantauFingerBPJS.setEnabled(false);
            System.out.println("Notifikasi Atur Tombol Pantau Finger BPJS IGD : "+e);
        }
    }

    private int ambilUsiaTahunSaatRegistrasi(String noRawat){
        if(noRawat == null || noRawat.trim().equals("")) return -1;
        String sqlUsia = "SELECT TIMESTAMPDIFF(YEAR,p.tgl_lahir,rp.tgl_registrasi) AS usia_tahun " +
                "FROM reg_periksa rp INNER JOIN pasien p ON rp.no_rkm_medis=p.no_rkm_medis " +
                "WHERE rp.no_rawat=? LIMIT 1";
        try(PreparedStatement psUsia = koneksi.prepareStatement(sqlUsia)){
            psUsia.setString(1,noRawat);
            try(ResultSet rsUsia = psUsia.executeQuery()){
                if(rsUsia.next()){
                    int usia = rsUsia.getInt("usia_tahun");
                    if(!rsUsia.wasNull()) return usia;
                }
            }
        }catch(Exception e){
            System.out.println("Notifikasi Cek Usia Pasien BPJS IGD : "+e);
        }
        return -1;
    }

    private boolean sudahKonfirmasiHadirAnak(String noRawat){
        if(noRawat == null || noRawat.trim().equals("")) return false;
        String sql = "SELECT no_rawat FROM bpjs_konfirmasi_hadir WHERE no_rawat=? LIMIT 1";
        try(PreparedStatement psCek = koneksi.prepareStatement(sql)){
            psCek.setString(1,noRawat);
            try(ResultSet rsCek = psCek.executeQuery()){
                return rsCek.next();
            }
        }catch(Exception e){
            System.out.println("Notifikasi Cek Konfirmasi Hadir Pasien Anak IGD : "+e);
            return false;
        }
    }

    private boolean simpanKonfirmasiHadirAnak(String noRawat){
        String sql = "INSERT INTO bpjs_konfirmasi_hadir " +
                "(no_rawat,no_rkm_medis,jenis_konfirmasi,usia_tahun,tanggal_konfirmasi,petugas) " +
                "SELECT rp.no_rawat,rp.no_rkm_medis,'ANAK_TANPA_FINGER'," +
                "TIMESTAMPDIFF(YEAR,p.tgl_lahir,rp.tgl_registrasi),NOW(),? " +
                "FROM reg_periksa rp INNER JOIN pasien p ON rp.no_rkm_medis=p.no_rkm_medis " +
                "WHERE rp.no_rawat=? AND rp.kd_pj='BPJ' " +
                "AND TIMESTAMPDIFF(YEAR,p.tgl_lahir,rp.tgl_registrasi)<17 " +
                "ON DUPLICATE KEY UPDATE jenis_konfirmasi=VALUES(jenis_konfirmasi)," +
                "usia_tahun=VALUES(usia_tahun),tanggal_konfirmasi=VALUES(tanggal_konfirmasi),petugas=VALUES(petugas)";
        try(PreparedStatement psSimpan = koneksi.prepareStatement(sql)){
            psSimpan.setString(1,akses.getkode());
            psSimpan.setString(2,noRawat);
            return psSimpan.executeUpdate() > 0;
        }catch(Exception e){
            JOptionPane.showMessageDialog(null,
                    "Gagal menyimpan konfirmasi hadir pasien usia <17 tahun.\n"+
                    "Pastikan tabel bpjs_konfirmasi_hadir sudah dibuat.\n\n"+e.getMessage());
            System.out.println("Notifikasi Simpan Konfirmasi Hadir Pasien Anak IGD : "+e);
            return false;
        }
    }

    private boolean sudahAdaMonitorFingerBPJS(String noRawat){
        if(noRawat == null || noRawat.trim().equals("")) return false;
        String sql = "select no_rawat from bpjs_finger_monitor where no_rawat=? limit 1";
        try(PreparedStatement psCek = koneksi.prepareStatement(sql)){
            psCek.setString(1,noRawat);
            try(ResultSet rsCek = psCek.executeQuery()){
                return rsCek.next();
            }
        }catch(Exception e){
            System.out.println("Notifikasi Cek Monitor Finger BPJS IGD : "+e);
            return false;
        }
    }

    private void refreshStatusPantauFingerIGD(){
        if(tabMode.getRowCount() == 0){
            hentikanAutoRefreshPantauFingerIGD();
            return;
        }

        Map<String,Integer> barisCalonPantau = new HashMap<String,Integer>();
        for(int baris=0; baris<tabMode.getRowCount(); baris++){
            String noRawat = nilaiModelIGD(baris,2);
            String kdPj = nilaiModelIGD(baris,IDX_IGD_KD_PJ);
            String noSep = nilaiModelIGD(baris,IDX_IGD_NO_SEP);
            String statusFinger = nilaiModelIGD(baris,IDX_IGD_FINGER);
            if(!noRawat.equals("") && kdPj.equals("BPJ") && noSep.equals("SEP Belum Terbit") &&
                    statusFinger.equals("Belum Sidik Jari")){
                barisCalonPantau.put(noRawat,baris);
            }
        }
        if(barisCalonPantau.isEmpty()){
            hentikanAutoRefreshPantauFingerIGD();
            return;
        }

        StringBuilder parameter = new StringBuilder();
        for(int i=0;i<barisCalonPantau.size();i++){
            if(i>0) parameter.append(",");
            parameter.append("?");
        }
        String sql = "SELECT monitor.no_rawat,MAX(sidik.validasi) AS jam_sidik_jari " +
                "FROM bpjs_finger_monitor monitor " +
                "LEFT JOIN sidik_jari_bpjs sidik ON sidik.no_rawat=monitor.no_rawat " +
                "WHERE monitor.no_rawat IN ("+parameter.toString()+") GROUP BY monitor.no_rawat";

        boolean adaAntrean = false;
        boolean masihMenunggu = false;
        boolean adaPerubahan = false;
        try(PreparedStatement psStatus = koneksi.prepareStatement(sql)){
            int p=1;
            for(String noRawat:barisCalonPantau.keySet()) psStatus.setString(p++,noRawat);
            try(ResultSet rsStatus = psStatus.executeQuery()){
                while(rsStatus.next()){
                    adaAntrean = true;
                    Integer baris = barisCalonPantau.get(rsStatus.getString("no_rawat"));
                    String jam = rsStatus.getString("jam_sidik_jari");
                    if(baris != null && jam != null && !jam.trim().equals("")){
                        tabMode.setValueAt(jam,baris,IDX_IGD_FINGER);
                        adaPerubahan = true;
                    }else{
                        masihMenunggu = true;
                    }
                }
            }
        }catch(Exception e){
            System.out.println("Notifikasi Auto Refresh Pantau Finger BPJS IGD : "+e);
            return;
        }

        if(adaPerubahan){
            tbPetugas.repaint();
            aturTombolPantauFingerBPJS();
        }
        if(!adaAntrean || !masihMenunggu){
            hentikanAutoRefreshPantauFingerIGD();
        }
    }

    private String nilaiModelIGD(int baris, int kolom){
        try{
            Object nilai = tabMode.getValueAt(baris,kolom);
            return nilai == null ? "" : nilai.toString();
        }catch(Exception e){
            return "";
        }
    }


    private void ambilFotoKTP(){
        bukaModulFotoKTP("kamera", "kamera Foto KTP");
    }

    private void unggahFotoKTP(){
        bukaUploadFotoKTP("unggah", "unggah hasil scan Foto KTP");
    }

    private void bukaModulFotoKTP(String mode, String namaAksi){
        if(TNoRM.getText().trim().equals("") || TPasien.getText().trim().equals("")){
            Valid.textKosong(TNoRM, "pasien");
            return;
        }
        this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
        try{
            Valid.panggilUrlcamera("photoktp/login.php?act=login&mode="+mode+"&usere="+koneksiDB.USERHYBRIDWEB()+
                    "&passwordte="+koneksiDB.PASHYBRIDWEB()+"&norm="+TNoRM.getText().trim());
        }catch(Exception e){
            JOptionPane.showMessageDialog(rootPane, "Gagal membuka "+namaAksi+" : "+e.getMessage());
        }finally{
            this.setCursor(Cursor.getDefaultCursor());
        }
    }

    private void bukaUploadFotoKTP(String mode, String namaAksi){
        if(TNoRM.getText().trim().equals("") || TPasien.getText().trim().equals("")){
            Valid.textKosong(TNoRM, "pasien");
            return;
        }
        this.setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
        try{
            Valid.panggilUrl("photoktp/login.php?act=login&mode="+mode+"&usere="+koneksiDB.USERHYBRIDWEB()+
                    "&passwordte="+koneksiDB.PASHYBRIDWEB()+"&norm="+TNoRM.getText().trim());
        }catch(Exception e){
            JOptionPane.showMessageDialog(rootPane, "Gagal membuka "+namaAksi+" : "+e.getMessage());
        }finally{
            this.setCursor(Cursor.getDefaultCursor());
        }
    }

    private void pasangPemantauNoRMFotoKTP(){
        timerMuatFotoKTP = new Timer(DELAY_MUAT_FOTO_KTP, new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                panggilFotoKTP();
            }
        });
        timerMuatFotoKTP.setRepeats(false);

        TNoRM.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            private void jadwalkanMuatFotoKTP(){
                aturTombolFotoKTP();
                if(timerMuatFotoKTP != null){
                    timerMuatFotoKTP.restart();
                }
            }
            @Override public void insertUpdate(DocumentEvent e) { jadwalkanMuatFotoKTP(); }
            @Override public void removeUpdate(DocumentEvent e) { jadwalkanMuatFotoKTP(); }
            @Override public void changedUpdate(DocumentEvent e) { jadwalkanMuatFotoKTP(); }
        });
    }

    private void panggilFotoKTPDariTabel(){
        int baris = tbPetugas.getSelectedRow();
        if(baris != -1 && tbPetugas.getColumnCount() > 7){
            Object noRM = tbPetugas.getValueAt(baris, 7);
            panggilFotoKTP(noRM == null ? "" : noRM.toString());
        }
    }

    private void panggilFotoKTP(){
        panggilFotoKTP(TNoRM.getText(), false);
    }

    private void panggilFotoKTP(String nomorRM){
        panggilFotoKTP(nomorRM, false);
    }

    private void panggilFotoKTP(String nomorRM, boolean paksaMuat){
        final String noRM = nomorRM == null ? "" : nomorRM.trim();
        if(noRM.equals("") || !noRM.matches("[A-Za-z0-9._-]{1,20}")){
            batalkanPemuatanFotoKTP();
            noRMFotoKTPTerakhir = "";
            noRMFotoKTPDiminta = "";
            tampilkanFotoKTPKosong();
            return;
        }

        if(!paksaMuat && noRM.equals(noRMFotoKTPTerakhir)){
            return;
        }
        if(!paksaMuat && noRM.equals(noRMFotoKTPDiminta)){
            return;
        }

        batalkanPemuatanFotoKTP();
        tampilkanFotoKTPKosong();
        noRMFotoKTPDiminta = noRM;
        final long nomorProses = ++nomorProsesFotoKTP;
        LblFotoKTP.setToolTipText("Memuat thumbnail Foto KTP pasien ...");

        workerMuatFotoKTP = new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() throws Exception {
                return unduhFotoKTP(noRM, true);
            }

            @Override
            protected void done() {
                if(nomorProses != nomorProsesFotoKTP || isCancelled()){
                    return;
                }
                noRMFotoKTPDiminta = "";
                noRMFotoKTPTerakhir = noRM;
                try{
                    BufferedImage thumbnail = get();
                    if(thumbnail != null){
                        fotoKTPAsli = null;
                        noRMFotoKTP = noRM;
                        fotoKTPTersediaTerakhir = true;
                        tampilkanThumbnailFotoKTP(thumbnail);
                    }else{
                        fotoKTPTersediaTerakhir = false;
                        tampilkanFotoKTPKosong();
                    }
                }catch(Exception e){
                    fotoKTPTersediaTerakhir = false;
                    tampilkanFotoKTPKosong();
                }
            }
        };
        workerMuatFotoKTP.execute();
    }

    private void batalkanPemuatanFotoKTP(){
        nomorProsesFotoKTP++;
        if(workerMuatFotoKTP != null && !workerMuatFotoKTP.isDone()){
            workerMuatFotoKTP.cancel(true);
        }
        if(workerMuatFotoKTPBesar != null && !workerMuatFotoKTPBesar.isDone()){
            workerMuatFotoKTPBesar.cancel(true);
        }
        if(workerCetakFotoKTP != null && !workerCetakFotoKTP.isDone()){
            workerCetakFotoKTP.cancel(true);
        }
    }

    private void aturTombolFotoKTP(){
        boolean adaPasien = TNoRM != null && !TNoRM.getText().trim().equals("");
        if(BtnAmbilFotoKTP != null) BtnAmbilFotoKTP.setEnabled(adaPasien);
        if(BtnUnggahFotoKTP != null) BtnUnggahFotoKTP.setEnabled(adaPasien);
        if(BtnRefreshFotoKTP != null) BtnRefreshFotoKTP.setEnabled(adaPasien);
    }


    private BufferedImage unduhFotoKTP(String noRM, boolean thumbnail){
        String[] namaFile;
        if(thumbnail){
            namaFile = new String[]{noRM+"_thumb.jpg", noRM+"_thumb.jpeg", noRM+".jpg", noRM+".jpeg"};
        }else{
            namaFile = new String[]{noRM+".jpg", noRM+".jpeg"};
        }
        for(String nama : namaFile){
            if(Thread.currentThread().isInterrupted()){
                return null;
            }
            BufferedImage foto = unduhSatuFotoKTP(noRM, nama);
            if(foto != null){
                return foto;
            }
        }
        return null;
    }

    private BufferedImage unduhSatuFotoKTP(String noRM, String namaFile){
        HttpURLConnection koneksiFoto = null;
        InputStream inputFoto = null;
        try{
            String alamatFoto = "http://"+koneksiDB.HOSTHYBRIDWEB()+":"+
                    koneksiDB.PORTWEB()+"/"+koneksiDB.HYBRIDWEB()+
                    "/photoktp/pages/upload/"+namaFile+"?v="+System.currentTimeMillis();
            koneksiFoto = (HttpURLConnection)new URL(alamatFoto).openConnection();
            koneksiFoto.setRequestMethod("GET");
            koneksiFoto.setConnectTimeout(TIMEOUT_KONEKSI_FOTO_KTP);
            koneksiFoto.setReadTimeout(TIMEOUT_BACA_FOTO_KTP);
            koneksiFoto.setUseCaches(false);
            koneksiFoto.setRequestProperty("Cache-Control", "no-cache");

            if(koneksiFoto.getResponseCode() != HttpURLConnection.HTTP_OK){
                return null;
            }
            String tipe = koneksiFoto.getContentType();
            if(tipe != null && tipe.toLowerCase().contains("text/html")){
                return null;
            }
            inputFoto = koneksiFoto.getInputStream();
            return ImageIO.read(inputFoto);
        }catch(Exception e){
            // Foto belum tersedia atau layanan Hybrid Web sedang tidak dapat diakses.
            // Tidak menampilkan notifikasi agar alur registrasi tetap lancar.
            return null;
        }finally{
            try{
                if(inputFoto != null){
                    inputFoto.close();
                }
            }catch(Exception e){}
            if(koneksiFoto != null){
                koneksiFoto.disconnect();
            }
        }
    }

    private void tampilkanThumbnailFotoKTP(BufferedImage thumbnail){
        LblFotoKTP.setText("");
        LblFotoKTP.setHorizontalTextPosition(javax.swing.SwingConstants.CENTER);
        LblFotoKTP.setVerticalTextPosition(javax.swing.SwingConstants.CENTER);
        LblFotoKTP.setIcon(new ImageIcon(skalaFotoKTP(thumbnail, FOTO_KTP_LEBAR, FOTO_KTP_TINGGI)));
        LblFotoKTP.setToolTipText("Foto KTP pasien. Gunakan tombol Zoom untuk melihat lebih jelas atau Unduh untuk menyimpan dokumen.");
        BtnZoomFotoKTP.setEnabled(true);
        if(BtnUnduhFotoKTP != null){
            BtnUnduhFotoKTP.setEnabled(true);
            BtnUnduhFotoKTP.setToolTipText("Cetak Foto KTP pada kertas F4/Folio");
        }
        aturTombolFotoKTP();
    }

    private BufferedImage skalaFotoKTP(BufferedImage sumber){
        return skalaFotoKTP(sumber, FOTO_KTP_LEBAR, FOTO_KTP_TINGGI);
    }

    private BufferedImage skalaFotoKTP(BufferedImage sumber, int lebarTarget, int tinggiTarget){
        BufferedImage hasil = new BufferedImage(lebarTarget, tinggiTarget, BufferedImage.TYPE_INT_RGB);
        Graphics2D g2 = hasil.createGraphics();
        try{
            g2.setColor(Color.WHITE);
            g2.fillRect(0, 0, lebarTarget, tinggiTarget);
            g2.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BILINEAR);
            g2.setRenderingHint(RenderingHints.KEY_RENDERING, RenderingHints.VALUE_RENDER_QUALITY);

            double faktor = Math.min((double)lebarTarget / sumber.getWidth(),
                    (double)tinggiTarget / sumber.getHeight());
            int lebar = (int)Math.round(sumber.getWidth() * faktor);
            int tinggi = (int)Math.round(sumber.getHeight() * faktor);
            int xGambar = (lebarTarget - lebar) / 2;
            int yGambar = (tinggiTarget - tinggi) / 2;
            g2.drawImage(sumber, xGambar, yGambar, lebar, tinggi, null);
        }finally{
            g2.dispose();
        }
        return hasil;
    }

    private ImageIcon buatIkonKameraKTP(){
        if(ikonKameraKTP != null){
            return ikonKameraKTP;
        }
        BufferedImage gambar = new BufferedImage(54, 40, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g2 = gambar.createGraphics();
        try{
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(new Color(95, 95, 95));
            g2.fillRoundRect(4, 10, 46, 27, 5, 5);
            g2.fillRoundRect(17, 5, 19, 8, 3, 3);
            g2.setColor(Color.WHITE);
            g2.fillOval(19, 15, 16, 16);
            g2.setColor(new Color(95, 95, 95));
            g2.fillOval(22, 18, 10, 10);
        }finally{
            g2.dispose();
        }
        ikonKameraKTP = new ImageIcon(gambar);
        return ikonKameraKTP;
    }

    private ImageIcon buatIkonZoomKTP(){
        if(ikonZoomKTP != null){
            return ikonZoomKTP;
        }
        URL lokasiIkon = getClass().getResource("/picture/zoom-in.png");
        if(lokasiIkon != null){
            ikonZoomKTP = new ImageIcon(lokasiIkon);
        }else{
            // Tombol tetap dapat dipakai; periksa folder source/picture bila icon kosong.
            ikonZoomKTP = new ImageIcon();
            System.out.println("Notif Foto KTP : File icon /picture/zoom-in.png tidak ditemukan.");
        }
        return ikonZoomKTP;
    }

    private void tampilkanFotoKTPKosong(){
        fotoKTPAsli = null;
        noRMFotoKTP = "";
        LblFotoKTP.setIcon(buatIkonKameraKTP());
        LblFotoKTP.setText("<html><center>Unggah / Ambil Foto KTP<br>Pasien</center></html>");
        LblFotoKTP.setHorizontalTextPosition(javax.swing.SwingConstants.CENTER);
        LblFotoKTP.setVerticalTextPosition(javax.swing.SwingConstants.BOTTOM);
        LblFotoKTP.setToolTipText("Foto KTP belum tersedia. Gunakan tombol Kamera atau Unggah di sebelah kiri.");
        if(BtnZoomFotoKTP != null){
            BtnZoomFotoKTP.setEnabled(false);
        }
        if(BtnUnduhFotoKTP != null){
            BtnUnduhFotoKTP.setEnabled(false);
        }
        aturTombolFotoKTP();
    }

    private void tampilkanFotoKTPBesar(){
        final String noRM = noRMFotoKTP;
        if(noRM.equals("")){
            return;
        }
        if(fotoKTPAsli != null){
            bukaDialogFotoKTPBesar(fotoKTPAsli);
            return;
        }
        if(workerMuatFotoKTPBesar != null && !workerMuatFotoKTPBesar.isDone()){
            return;
        }

        BtnZoomFotoKTP.setEnabled(false);
        BtnZoomFotoKTP.setToolTipText("Memuat foto KTP ukuran penuh ...");
        workerMuatFotoKTPBesar = new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() throws Exception {
                return unduhFotoKTP(noRM, false);
            }

            @Override
            protected void done() {
                if(!noRM.equals(noRMFotoKTP)){
                    return;
                }
                try{
                    BufferedImage foto = get();
                    if(foto != null){
                        fotoKTPAsli = foto;
                        BtnZoomFotoKTP.setEnabled(true);
                        BtnZoomFotoKTP.setToolTipText("Perbesar Foto KTP Pasien");
                        bukaDialogFotoKTPBesar(foto);
                    }else{
                        BtnZoomFotoKTP.setEnabled(fotoKTPTersediaTerakhir);
                        BtnZoomFotoKTP.setToolTipText("Foto ukuran penuh tidak ditemukan. Silakan Muat Ulang bila foto baru saja diunggah.");
                    }
                }catch(Exception e){
                    BtnZoomFotoKTP.setEnabled(fotoKTPTersediaTerakhir);
                    BtnZoomFotoKTP.setToolTipText("Gagal memuat foto ukuran penuh. Coba lagi.");
                }
            }
        };
        workerMuatFotoKTPBesar.execute();
    }

    private void bukaDialogFotoKTPBesar(final BufferedImage gambar){
        if(gambar == null){
            return;
        }

        final javax.swing.JDialog lihatFoto = new javax.swing.JDialog(this, "Zoom Foto KTP Pasien", true);
        final javax.swing.JLabel labelFoto = new javax.swing.JLabel();
        labelFoto.setHorizontalAlignment(javax.swing.SwingConstants.CENTER);
        labelFoto.setVerticalAlignment(javax.swing.SwingConstants.CENTER);
        labelFoto.setOpaque(true);
        labelFoto.setBackground(Color.WHITE);
        labelFoto.setBorder(javax.swing.BorderFactory.createCompoundBorder(
                javax.swing.BorderFactory.createLineBorder(new Color(120,120,120)),
                javax.swing.BorderFactory.createEmptyBorder(10,10,10,10)));

        final javax.swing.JScrollPane scroll = new javax.swing.JScrollPane(labelFoto);
        scroll.getViewport().setBackground(new Color(245,245,245));
        scroll.setBorder(javax.swing.BorderFactory.createEmptyBorder(6,6,6,6));

        final javax.swing.JSlider sliderZoom = new javax.swing.JSlider(25, 600, 100);
        sliderZoom.setMajorTickSpacing(25);
        sliderZoom.setMinorTickSpacing(5);
        sliderZoom.setPaintTicks(false);
        sliderZoom.setFocusable(false);

        final javax.swing.JLabel lblInfoZoom = new javax.swing.JLabel(" ");
        lblInfoZoom.setHorizontalAlignment(javax.swing.SwingConstants.RIGHT);

        final Runnable refreshZoom = new Runnable(){
            @Override
            public void run() {
                int persen = Math.max(25, Math.min(600, sliderZoom.getValue()));
                int lebar = Math.max(1, (int)Math.round(gambar.getWidth() * (persen / 100.0)));
                int tinggi = Math.max(1, (int)Math.round(gambar.getHeight() * (persen / 100.0)));
                BufferedImage skala = skalaFotoKTP(gambar, lebar, tinggi);
                labelFoto.setIcon(new ImageIcon(skala));
                labelFoto.setPreferredSize(new Dimension(lebar + 20, tinggi + 20));
                lblInfoZoom.setText("Zoom : " + persen + "%    Ukuran : " + lebar + " x " + tinggi + " px");
                labelFoto.revalidate();
            }
        };

        javax.swing.JButton btnKurang = new javax.swing.JButton("-");
        btnKurang.setFocusable(false);
        btnKurang.setMargin(new java.awt.Insets(2, 10, 2, 10));
        btnKurang.addActionListener(new java.awt.event.ActionListener(){
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                sliderZoom.setValue(Math.max(sliderZoom.getMinimum(), sliderZoom.getValue() - 10));
            }
        });

        javax.swing.JButton btnTambah = new javax.swing.JButton("+");
        btnTambah.setFocusable(false);
        btnTambah.setMargin(new java.awt.Insets(2, 10, 2, 10));
        btnTambah.addActionListener(new java.awt.event.ActionListener(){
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                sliderZoom.setValue(Math.min(sliderZoom.getMaximum(), sliderZoom.getValue() + 10));
            }
        });

        javax.swing.JButton btnReset = new javax.swing.JButton("Reset");
        btnReset.setFocusable(false);
        btnReset.addActionListener(new java.awt.event.ActionListener(){
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                sliderZoom.setValue(100);
            }
        });

        sliderZoom.addChangeListener(new javax.swing.event.ChangeListener(){
            @Override
            public void stateChanged(javax.swing.event.ChangeEvent e) {
                refreshZoom.run();
            }
        });

        scroll.addMouseWheelListener(new java.awt.event.MouseWheelListener(){
            @Override
            public void mouseWheelMoved(java.awt.event.MouseWheelEvent e) {
                if(e.isControlDown()){
                    int nilai = sliderZoom.getValue() - (e.getWheelRotation() * 10);
                    sliderZoom.setValue(Math.max(sliderZoom.getMinimum(), Math.min(sliderZoom.getMaximum(), nilai)));
                    e.consume();
                }
            }
        });

        javax.swing.JPanel panelKontrol = new javax.swing.JPanel(new java.awt.BorderLayout(8, 0));
        panelKontrol.setBorder(javax.swing.BorderFactory.createEmptyBorder(8, 8, 8, 8));
        javax.swing.JPanel panelKiri = new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT, 6, 0));
        panelKiri.add(new javax.swing.JLabel("Perbesar / Perkecil"));
        panelKiri.add(btnKurang);
        panelKiri.add(sliderZoom);
        panelKiri.add(btnTambah);
        panelKiri.add(btnReset);
        panelKontrol.add(panelKiri, java.awt.BorderLayout.WEST);
        panelKontrol.add(lblInfoZoom, java.awt.BorderLayout.CENTER);

        lihatFoto.getContentPane().setLayout(new java.awt.BorderLayout());
        lihatFoto.getContentPane().add(scroll, java.awt.BorderLayout.CENTER);
        lihatFoto.getContentPane().add(panelKontrol, java.awt.BorderLayout.SOUTH);

        java.awt.Dimension layar = java.awt.Toolkit.getDefaultToolkit().getScreenSize();
        int lebarDialog = Math.min((int)(layar.width * 0.92), 1220);
        int tinggiDialog = Math.min((int)(layar.height * 0.88), 860);
        lihatFoto.setSize(lebarDialog, tinggiDialog);
        lihatFoto.setMinimumSize(new java.awt.Dimension(820, 620));
        lihatFoto.setLocationRelativeTo(this);
        refreshZoom.run();
        lihatFoto.setVisible(true);
    }

    private void cetakFotoKTP(){
        final String noRM = noRMFotoKTP == null ? "" : noRMFotoKTP.trim();
        if(noRM.equals("")){
            JOptionPane.showMessageDialog(rootPane, "Foto KTP pasien belum tersedia untuk dicetak.", "Cetak Foto KTP", JOptionPane.WARNING_MESSAGE);
            return;
        }

        int konfirmasi = JOptionPane.showConfirmDialog(rootPane,
                "Cetak Foto KTP pasien No. RM " + noRM + " pada kertas F4/Folio?\n"
                        + "Ukuran foto 85,60 mm x 53,98 mm, margin kiri 6 cm, margin atas 2,5 cm.",
                "Konfirmasi Cetak Foto KTP", JOptionPane.YES_NO_OPTION, JOptionPane.QUESTION_MESSAGE);
        if(konfirmasi != JOptionPane.YES_OPTION){
            return;
        }

        if(fotoKTPAsli != null && noRM.equals(noRMFotoKTP)){
            bukaDialogCetakFotoKTP(fotoKTPAsli);
            return;
        }

        if(workerCetakFotoKTP != null && !workerCetakFotoKTP.isDone()){
            return;
        }
        BtnUnduhFotoKTP.setEnabled(false);
        BtnUnduhFotoKTP.setToolTipText("Memuat Foto KTP ukuran penuh untuk dicetak ...");
        workerCetakFotoKTP = new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() throws Exception {
                return unduhFotoKTP(noRM, false);
            }

            @Override
            protected void done(){
                try{
                    BufferedImage gambar = get();
                    if(gambar == null){
                        JOptionPane.showMessageDialog(rootPane,
                                "Foto KTP ukuran penuh tidak ditemukan. Silakan klik Muat Ulang Foto KTP.",
                                "Cetak Foto KTP", JOptionPane.WARNING_MESSAGE);
                    }else{
                        fotoKTPAsli = gambar;
                        bukaDialogCetakFotoKTP(gambar);
                    }
                }catch(Exception e){
                    JOptionPane.showMessageDialog(rootPane,
                            "Foto KTP gagal dimuat untuk dicetak. Periksa koneksi Hybrid Web atau coba Muat Ulang Foto KTP.\n"
                                    + (e.getMessage() == null ? "" : e.getMessage()),
                            "Cetak Foto KTP", JOptionPane.WARNING_MESSAGE);
                }finally{
                    if(BtnUnduhFotoKTP != null){
                        BtnUnduhFotoKTP.setEnabled(fotoKTPTersediaTerakhir && !noRMFotoKTP.trim().equals(""));
                        BtnUnduhFotoKTP.setToolTipText("Cetak Foto KTP pada kertas F4/Folio");
                    }
                }
            }
        };
        workerCetakFotoKTP.execute();
    }

    private void bukaDialogCetakFotoKTP(final BufferedImage gambar){
        final double pointPerMm = 72d / 25.4d;
        final double lebarF4 = 210d * pointPerMm;
        final double tinggiF4 = 330d * pointPerMm;
        final double marginKiri = 60d * pointPerMm;
        final double marginAtas = 25d * pointPerMm;
        final double lebarKTP = 85.60d * pointPerMm;
        final double tinggiKTP = 53.98d * pointPerMm;

        PrinterJob pekerjaanCetak = PrinterJob.getPrinterJob();
        PageFormat formatHalaman = pekerjaanCetak.defaultPage();
        Paper kertas = new Paper();
        kertas.setSize(lebarF4, tinggiF4);
        // Posisi gambar memakai koordinat fisik halaman. Margin yang diminta
        // berada jauh dari area tidak tercetak printer pada umumnya.
        kertas.setImageableArea(0d, 0d, lebarF4, tinggiF4);
        formatHalaman.setPaper(kertas);
        formatHalaman.setOrientation(PageFormat.PORTRAIT);

        pekerjaanCetak.setPrintable(new Printable() {
            @Override
            public int print(Graphics graphics, PageFormat pageFormat, int nomorHalaman) throws PrinterException {
                if(nomorHalaman > 0){
                    return Printable.NO_SUCH_PAGE;
                }
                Graphics2D g2 = (Graphics2D)graphics.create();
                try{
                    g2.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BICUBIC);
                    g2.setRenderingHint(RenderingHints.KEY_RENDERING, RenderingHints.VALUE_RENDER_QUALITY);
                    g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                    g2.drawImage(gambar,
                            (int)Math.round(marginKiri),
                            (int)Math.round(marginAtas),
                            (int)Math.round(lebarKTP),
                            (int)Math.round(tinggiKTP), null);
                }finally{
                    g2.dispose();
                }
                return Printable.PAGE_EXISTS;
            }
        }, formatHalaman);

        if(pekerjaanCetak.printDialog()){
            try{
                pekerjaanCetak.print();
            }catch(PrinterException e){
                JOptionPane.showMessageDialog(rootPane,
                        "Foto KTP gagal dicetak: " + e.getMessage(),
                        "Cetak Foto KTP", JOptionPane.WARNING_MESSAGE);
            }
        }
    }

