    Valid.tabelKosong(tabMode);
    try {
        ps = koneksi.prepareStatement(
            "select reg_periksa.no_reg,reg_periksa.no_rawat,reg_periksa.tgl_registrasi,reg_periksa.jam_reg," +
            "reg_periksa.kd_dokter,dokter.nm_dokter,reg_periksa.no_rkm_medis,pasien.nm_pasien,pasien.jk,concat(reg_periksa.umurdaftar,' ',reg_periksa.sttsumur)as umur,poliklinik.nm_poli," +
            "reg_periksa.p_jawab,reg_periksa.almt_pj,reg_periksa.hubunganpj,reg_periksa.biaya_reg,reg_periksa.stts_daftar,penjab.png_jawab,reg_periksa.stts,reg_periksa.kd_pj,reg_periksa.status_bayar," +
            "CASE " +
            "     WHEN reg_periksa.status_lanjut = 'Ranap' " +
            "          AND EXISTS (" +
            "              SELECT 1 FROM berkas_digital_perawatan " +
            "              WHERE berkas_digital_perawatan.no_rawat = reg_periksa.no_rawat " +
            "                AND berkas_digital_perawatan.kode = 'SOD') " +
            "          THEN 'ADA SO' " +
            "     WHEN reg_periksa.status_lanjut = 'Ranap' THEN 'TIDAK ADA SO' " +
            "     ELSE 'RAWAT JALAN' END AS SO, " +
            "DATE_FORMAT((" +
            "     SELECT MAX(ki.tgl_keluar) " +
            "     FROM reg_periksa ri " +
            "     INNER JOIN kamar_inap ki ON ki.no_rawat=ri.no_rawat " +
            "     WHERE ri.no_rkm_medis=reg_periksa.no_rkm_medis " +
            "       AND ri.status_lanjut='Ranap' " +
            "       AND ki.stts_pulang NOT IN ('-','Pindah Kamar') " +
            "       AND ki.tgl_keluar IS NOT NULL " +
            "       AND ki.tgl_keluar<>'0000-00-00 00:00:00' " +
            "       AND ki.tgl_keluar<CONCAT(reg_periksa.tgl_registrasi,' 00:00:00')" +
            "), '%Y-%m-%d') AS last_ranap, " +
            "DATE_FORMAT((" +
            "     SELECT MAX(rr.tgl_registrasi) " +
            "     FROM reg_periksa rr " +
            "     WHERE rr.no_rkm_medis=reg_periksa.no_rkm_medis " +
            "       AND rr.status_lanjut='Ralan' " +
            "       AND rr.tgl_registrasi<reg_periksa.tgl_registrasi" +
            "), '%Y-%m-%d') AS last_ralan, " +
            "IF(reg_periksa.kd_pj='BPJ',IF(bridging_sep.no_sep IS NULL,'SEP Belum Terbit',bridging_sep.no_sep),'-') AS no_sep, " +
            "IF(reg_periksa.kd_pj='BPJ',IF(sdk.no_rawat IS NOT NULL,sdk.jam_val," +
            "IF(khadir.no_rawat IS NOT NULL,DATE_FORMAT(khadir.tanggal_konfirmasi,'%Y-%m-%d %H:%i:%s'),'Belum Sidik Jari')),'-') AS jam_sidik_jari " +
            "from reg_periksa " +
            "inner join dokter inner join pasien inner join poliklinik inner join penjab " +
            "on reg_periksa.kd_dokter=dokter.kd_dokter and reg_periksa.no_rkm_medis=pasien.no_rkm_medis " +
            "and reg_periksa.kd_pj=penjab.kd_pj and reg_periksa.kd_poli=poliklinik.kd_poli " +
            "left join bridging_sep on reg_periksa.no_rawat=bridging_sep.no_rawat " +
            "left join (select sj.no_rawat,MAX(sj.validasi) as jam_val from sidik_jari_bpjs sj " +
            "where sj.validasi>=? and sj.validasi<DATE_ADD(?,INTERVAL 1 DAY) group by sj.no_rawat) sdk " +
            "on reg_periksa.no_rawat=sdk.no_rawat " +
            "left join bpjs_konfirmasi_hadir khadir on reg_periksa.no_rawat=khadir.no_rawat " +
            "where poliklinik.kd_poli='IGDK' and reg_periksa.tgl_registrasi between ? and ? " +
            (TCari.getText().trim().equals("") ? "" :
                "and (reg_periksa.no_reg like ? or reg_periksa.no_rawat like ? or reg_periksa.tgl_registrasi like ? or " +
                "reg_periksa.kd_dokter like ? or dokter.nm_dokter like ? or reg_periksa.no_rkm_medis like ? or " +
                "reg_periksa.stts_daftar like ? or pasien.nm_pasien like ? or poliklinik.nm_poli like ? or " +
                "reg_periksa.p_jawab like ? or reg_periksa.almt_pj like ? or reg_periksa.hubunganpj like ? or " +
                "penjab.png_jawab like ?) ") + terbitsep +
            " order by reg_periksa.no_rawat"
        );
        try {
            String tglAwalFinger = Valid.SetTgl(DTPCari1.getSelectedItem() + "");
            String tglAkhirFinger = Valid.SetTgl(DTPCari2.getSelectedItem() + "");
            ps.setString(1, tglAwalFinger);
            ps.setString(2, tglAkhirFinger);
            ps.setString(3, tglAwalFinger);
            ps.setString(4, tglAkhirFinger);
            if (!TCari.getText().trim().equals("")) {
                ps.setString(5,  "%" + TCari.getText().trim() + "%");
                ps.setString(6,  "%" + TCari.getText().trim() + "%");
                ps.setString(7,  "%" + TCari.getText().trim() + "%");
                ps.setString(8,  "%" + TCari.getText().trim() + "%");
                ps.setString(9,  "%" + TCari.getText().trim() + "%");
                ps.setString(10, "%" + TCari.getText().trim() + "%");
                ps.setString(11, "%" + TCari.getText().trim() + "%");
                ps.setString(12, "%" + TCari.getText().trim() + "%");
                ps.setString(13, "%" + TCari.getText().trim() + "%");
                ps.setString(14, "%" + TCari.getText().trim() + "%");
                ps.setString(15, "%" + TCari.getText().trim() + "%");
                ps.setString(16, "%" + TCari.getText().trim() + "%");
                ps.setString(17, "%" + TCari.getText().trim() + "%");
            }
            rs = ps.executeQuery();
            while (rs.next()) {
                String tglRegStr = rs.getString(3);
                String riwayat = "-";

                try {
                    java.time.LocalDate tglReg = java.time.LocalDate.parse(tglRegStr);
                    String lastPulangStr = rs.getString("last_ranap");
                    String lastRalanStr = rs.getString("last_ralan");

                    java.time.LocalDate lastRanap = null, lastRalan = null;
                    if (lastPulangStr != null && !lastPulangStr.trim().equals("")) {
                        lastRanap = java.time.LocalDate.parse(lastPulangStr);
                    }
                    if (lastRalanStr != null && !lastRalanStr.trim().equals("")) {
                        lastRalan = java.time.LocalDate.parse(lastRalanStr);
                    }

                    java.time.LocalDate lastDate = null;
                    String sumber = "";
                    if (lastRanap != null && (lastRalan == null || !lastRalan.isAfter(lastRanap))) {
                        lastDate = lastRanap;
                        sumber = "Ranap";
                    }
                    if (lastRalan != null && (lastRanap == null || lastRalan.isAfter(lastRanap))) {
                        lastDate = lastRalan;
                        sumber = "Ralan";
                    }

                    if (lastDate != null) {
                        long hari = java.time.temporal.ChronoUnit.DAYS.between(lastDate, tglReg);
                        if (hari >= 0) {
                            if (hari > 60) {
                                riwayat = "1 Tahun " + sumber;
                            } else if (hari > 30) {
                                riwayat = "1 Bulan " + sumber;
                            } else {
                                riwayat = hari + " hari " + sumber;
                            }
                        }
                    }
                } catch (Exception exHari) {
                    System.out.println("Hitung Riwayat Terakhir: " + exHari);
                }

                tabMode.addRow(new Object[]{
                    false, rs.getString(1), rs.getString(2), rs.getString(3), rs.getString(4),
                    rs.getString(5), rs.getString(6), rs.getString(7), rs.getString(8), rs.getString(9),
                    rs.getString(10), rs.getString(11), rs.getString(12), rs.getString(13), rs.getString(14),
                    Valid.SetAngka(rs.getDouble(15)), rs.getString(16), rs.getString(17), rs.getString(18),
                    rs.getString("kd_pj"), rs.getString("status_bayar"), rs.getString("SO"),
                    riwayat, rs.getString("no_sep"), rs.getString("jam_sidik_jari")
                });
            }
        } catch (Exception e) {
            System.out.println("Notif : " + e);
        } finally {
            if (rs != null) { rs.close(); }
            if (ps != null) { ps.close(); }
        }
    } catch (Exception e) {
        System.out.println("Notifikasi : " + e);
    }
    LCount.setText("" + tabMode.getRowCount());
    aturTombolPantauFingerBPJS();

    }

