    /*
     * Validasi nama pasien sebelum simpan.
     * Penghapusan otomatis hanya untuk sapaan/penanda yang berdiri sendiri
     * di awal atau akhir nama: Tn., Ny., Nn., dan An. Gelar akademis hanya
     * menjadi pengingat dan tidak pernah dihapus otomatis.
     */
    private static final Pattern POLA_SAPAAN_AWAL_NAMA_PASIEN = Pattern.compile(
            "(?i)^\\s*(?:tn|ny|nn|an)\\s*\\.?\\s+(?=\\S)"
    );
    private static final Pattern POLA_SAPAAN_AKHIR_NAMA_PASIEN = Pattern.compile(
            "(?i)(?:\\s*,\\s*|\\s+)(?:tn|ny|nn|an)\\s*\\.?\\s*$"
    );
    private static final Pattern POLA_GELAR_AKADEMIS_NAMA_PASIEN = Pattern.compile(
            "(?i)(^|[\\s,])(?:dr|drs|dra|prof|ir|h|hj|kh|ust|ustadz|"
            + "s\\s*\\.\\s*[a-z]{1,10}(?:\\s*\\.\\s*[a-z]{1,5})?|"
            + "m\\s*\\.\\s*[a-z]{1,10}(?:\\s*\\.\\s*[a-z]{1,5})?|"
            + "sp\\s*\\.\\s*[a-z]{1,10}|ph\\s*\\.\\s*d|mba|mm)\\.?($|[\\s,])"
    );
    private static final int AKSI_VALIDASI_NAMA_BATAL = 0;
    private static final int AKSI_VALIDASI_NAMA_HAPUS_SAPAAN = 1;
    private static final int AKSI_VALIDASI_NAMA_LANJUT = 2;
    private static final int AKSI_VALIDASI_NAMA_EDIT_MANUAL = 3;

    /*
     * Menjaga alur simpan setelah petugas menyimpan Edit Nama Manual.
     * Nilai bypass hanya berlaku sekali, khusus untuk pemanggilan ulang
     * tombol Simpan yang dijadwalkan setelah nama pasien sukses diperbarui.
     */
    private boolean lewatiValidasiNamaPasienSekali = false;
    private boolean simpanLanjutanSetelahEditNamaPasienDijadwalkan = false;

