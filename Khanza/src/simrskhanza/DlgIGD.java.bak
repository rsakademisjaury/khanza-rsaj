    private String nilaiTabel(javax.swing.JTable tabel, int row, int col) {
        try {
            Object nilai = tabel.getValueAt(row, col);
            return nilai == null ? "" : nilai.toString();
        } catch (Exception e) {
            return "";
        }
    }
