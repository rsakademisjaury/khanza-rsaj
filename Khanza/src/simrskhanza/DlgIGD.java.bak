    private void formWindowOpened(java.awt.event.WindowEvent evt) {//GEN-FIRST:event_formWindowOpened
        // Beri kesempatan Swing menggambar form terlebih dahulu; query tabel
        // tetap memakai fungsi tampil() yang sama dan tidak mengubah hasil data.
        LCount.setText("Memuat data IGD ...");
        javax.swing.Timer tundaMuat=new javax.swing.Timer(80, new ActionListener() {
            @Override public void actionPerformed(ActionEvent e) {
                tampil();
            }
        });
        tundaMuat.setRepeats(false);
        tundaMuat.start();
    }//GEN-LAST:event_formWindowOpened

    private void MnPeriksaRadiologiActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_MnPeriksaRadiologiActionPerformed
