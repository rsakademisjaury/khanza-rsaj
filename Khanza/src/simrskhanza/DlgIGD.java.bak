    // PATCH RSAJ - autocomplete IGD memakai cache lokal per form.
    // Data dokter, jenis bayar, dan asal rujukan dimuat sekali saat diperlukan.
    private static final class CacheDokterIgd {
        private final String kode, nama;
        private CacheDokterIgd(String kode, String nama) {
            this.kode = kode == null ? "" : kode;
            this.nama = nama == null ? "" : nama;
        }
    }
    private static final class CachePenjabIgd {
        private final String kode, nama;
        private CachePenjabIgd(String kode, String nama) {
            this.kode = kode == null ? "" : kode;
            this.nama = nama == null ? "" : nama;
        }
    }
    private static final class CachePerujukIgd {
        private final String nama, alamat;
        private CachePerujukIgd(String nama, String alamat) {
            this.nama = nama == null ? "" : nama;
            this.alamat = alamat == null ? "" : alamat;
        }
    }
    private final java.util.List<CacheDokterIgd> cacheDokterIgd = new java.util.ArrayList<CacheDokterIgd>();
    private final java.util.List<CachePenjabIgd> cachePenjabIgd = new java.util.ArrayList<CachePenjabIgd>();
    private final java.util.List<CachePerujukIgd> cachePerujukIgd = new java.util.ArrayList<CachePerujukIgd>();
    private boolean cacheDokterIgdSiap = false;
    private boolean cachePenjabIgdSiap = false;
    private boolean cachePerujukIgdSiap = false;

