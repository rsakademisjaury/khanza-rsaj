        javax.swing.JPanel utama = new javax.swing.JPanel(new java.awt.BorderLayout());
        utama.setBackground(java.awt.Color.WHITE);
        utama.setBorder(javax.swing.BorderFactory.createLineBorder(new java.awt.Color(211, 222, 234)));

        javax.swing.JPanel header = new javax.swing.JPanel(new java.awt.BorderLayout(12, 0));
        header.setBackground(new java.awt.Color(18, 92, 162));
        header.setBorder(javax.swing.BorderFactory.createEmptyBorder(15, 18, 15, 18));
        header.add(new javax.swing.JLabel(javax.swing.UIManager.getIcon("OptionPane.informationIcon")), java.awt.BorderLayout.WEST);
        javax.swing.JPanel judulHeader = new javax.swing.JPanel();
        judulHeader.setOpaque(false);
        judulHeader.setLayout(new javax.swing.BoxLayout(judulHeader, javax.swing.BoxLayout.Y_AXIS));
        javax.swing.JLabel judul = new javax.swing.JLabel("Edit Nama Pasien");
        judul.setForeground(java.awt.Color.WHITE);
        judul.setFont(new java.awt.Font("Segoe UI", java.awt.Font.BOLD, 17));
        javax.swing.JLabel subJudul = new javax.swing.JLabel("Perbarui nama sesuai KTP / Dukcapil, kemudian simpan perubahan");
        subJudul.setForeground(new java.awt.Color(225, 239, 252));
        subJudul.setFont(new java.awt.Font("Segoe UI", java.awt.Font.PLAIN, 12));
        judulHeader.add(judul);
        judulHeader.add(javax.swing.Box.createVerticalStrut(3));
        judulHeader.add(subJudul);
        header.add(judulHeader, java.awt.BorderLayout.CENTER);
        utama.add(header, java.awt.BorderLayout.NORTH);

        javax.swing.JPanel isi = new javax.swing.JPanel();
        isi.setBackground(java.awt.Color.WHITE);
        isi.setLayout(new javax.swing.BoxLayout(isi, javax.swing.BoxLayout.Y_AXIS));
        isi.setBorder(javax.swing.BorderFactory.createEmptyBorder(18, 20, 16, 20));
        javax.swing.JLabel label = new javax.swing.JLabel("NAMA PASIEN");
        label.setForeground(new java.awt.Color(65, 84, 102));
        label.setFont(new java.awt.Font("Segoe UI", java.awt.Font.BOLD, 11));
        isi.add(label);
        isi.add(javax.swing.Box.createVerticalStrut(6));
        final javax.swing.JTextField txtNama = new javax.swing.JTextField(namaLama);
        txtNama.setFont(new java.awt.Font("Segoe UI", java.awt.Font.PLAIN, 15));
        txtNama.setBorder(javax.swing.BorderFactory.createCompoundBorder(
                javax.swing.BorderFactory.createLineBorder(new java.awt.Color(147, 185, 222)),
                javax.swing.BorderFactory.createEmptyBorder(9, 10, 9, 10)
        ));
        txtNama.setMaximumSize(new java.awt.Dimension(560, 42));
        isi.add(txtNama);
        isi.add(javax.swing.Box.createVerticalStrut(10));
        javax.swing.JTextArea petunjuk = buatAreaInformasiNama(
                "Perubahan ini langsung memperbarui kolom pasien.nm_pasien untuk nomor RM yang sedang dipilih.",
                12, new java.awt.Color(84, 98, 113)
        );
        isi.add(petunjuk);
        utama.add(isi, java.awt.BorderLayout.CENTER);

        javax.swing.JPanel footer = new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.RIGHT, 8, 11));
        footer.setBackground(new java.awt.Color(248, 250, 252));
        footer.setBorder(javax.swing.BorderFactory.createMatteBorder(1, 0, 0, 0, new java.awt.Color(222, 229, 236)));
        final javax.swing.JButton btnBatal = buatTombolValidasiNama("Batal", new java.awt.Color(220, 38, 38), new java.awt.Color(185, 28, 28));
        btnBatal.addActionListener(new java.awt.event.ActionListener() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                dialog.dispose();
            }
        });
        final javax.swing.JButton btnSimpan = buatTombolValidasiNama("Simpan Perubahan", new java.awt.Color(20, 126, 94), new java.awt.Color(16, 102, 76));
        btnSimpan.addActionListener(new java.awt.event.ActionListener() {
            @Override
            public void actionPerformed(java.awt.event.ActionEvent e) {
                String namaBaru = txtNama.getText() == null ? "" : txtNama.getText().trim();
                if(namaBaru.equals("")){
                    JOptionPane.showMessageDialog(
                            dialog,
                            "Nama pasien tidak boleh kosong.",
                            "Edit Nama Pasien",
                            JOptionPane.WARNING_MESSAGE
                    );
                    txtNama.requestFocus();
                    return;
                }
                if(namaBaru.equals(namaLama) || simpanNamaPasienDariValidasi(namaBaru)){
                    berhasil[0] = true;
                    dialog.dispose();
                }
            }
        });
        footer.add(btnSimpan);
        footer.add(btnBatal);
        utama.add(footer, java.awt.BorderLayout.SOUTH);

        dialog.setContentPane(utama);
        dialog.getRootPane().setDefaultButton(btnSimpan);
        dialog.getRootPane().registerKeyboardAction(
                new java.awt.event.ActionListener() {
                    @Override
                    public void actionPerformed(java.awt.event.ActionEvent e) {
                        dialog.dispose();
                    }
                },
                javax.swing.KeyStroke.getKeyStroke(java.awt.event.KeyEvent.VK_ESCAPE, 0),
                javax.swing.JComponent.WHEN_IN_FOCUSED_WINDOW
        );
        dialog.pack();
        dialog.setSize(600, dialog.getHeight());
        dialog.setLocationRelativeTo(this);
        dialog.setVisible(true);
        return berhasil[0];
    }

    private boolean simpanNamaPasienDariValidasi(String namaBaru){
        PreparedStatement psNamaPasien = null;

        try{
            psNamaPasien = koneksi.prepareStatement(
                    "update pasien set nm_pasien=? where no_rkm_medis=?"
            );
            psNamaPasien.setString(1, namaBaru);
            psNamaPasien.setString(2, TNoRM.getText().trim());

            if(psNamaPasien.executeUpdate() > 0){
                // Memuat ulang data form agar nama yang tampil sama dengan master pasien.
                isCekPasien();
                return true;
            }

            JOptionPane.showMessageDialog(
                    rootPane,
                    "Nama pasien tidak dapat diperbarui. Silakan pilih pasien kembali dan ulangi proses simpan.",
                    "Validasi Nama Pasien",
                    JOptionPane.ERROR_MESSAGE
            );
        }catch(Exception e){
            System.out.println("Notif Validasi Nama Pasien : "+e);
            JOptionPane.showMessageDialog(
                    rootPane,
                    "Terjadi kesalahan saat memperbarui nama pasien.\n"
                    +"Pendaftaran dibatalkan agar data tidak tersimpan sebagian.",
                    "Validasi Nama Pasien",
                    JOptionPane.ERROR_MESSAGE
            );
        }finally{
            if(psNamaPasien != null){
                try{
                    psNamaPasien.close();
                }catch(Exception e){
                    System.out.println("Notif Validasi Nama Pasien : "+e);
                }
            }
        }

        return false;
    }

