                                JOptionPane.showMessageDialog(rootPane,"Tidak bisa digabung karena No.RM berbeda");
                            }
                            norawatdipilih="";
                            normdipilih="";
                        }   
                    } 
                }               
            }else if(evt.getClickCount()==2){
                i=tbPetugas.getSelectedColumn();
                if(i==1){
                    if(MnKamarInap.isEnabled()==true){
                        MnKamarInapActionPerformed(null);
                    }                    
                }else if(i==2){
                    boolean isBPJ = tbPetugas.getValueAt(tbPetugas.getSelectedRow(), 17).toString().equals("BPJ");
                    boolean isAdminUtama = akses.getkode().equals("Admin Utama");                    
                    
                    if(akses.gettindakan_ralan()==true){
                        MnRawatJalanActionPerformed(null);
                        
                    if (!isAdminUtama && isBPJ) {
                        
                        // Periksa apakah kode dokter yang login sama dengan kode dokter yang tertera di kddokter
//                        if (kddokter.getText().equals(akses.getkode())) {
                    
                            MnRiwayatPerawatanICareNoKartuActionPerformed(null); // Panggil method baru hanya jika kddokter sesuai dengan kode yang login
                        }
                    }                                
                }else if(i==3){
                    if(akses.getberi_obat()==true){
                        MnPemberianObatActionPerformed(null);
                    }                   
                }else if(i==4){
                    if(akses.getperiksa_lab()==true){
                        MnPeriksaLabActionPerformed(null);
                    }                    
                }else if(i==5){
                    if(akses.getrujukan_masuk()==true){
                        MnRujukMasukActionPerformed(null);
                    }                    
                }
            }
            
        }
        
}//GEN-LAST:event_tbPetugasMouseClicked

    private void tbPetugasKeyPressed(java.awt.event.KeyEvent evt) {//GEN-FIRST:event_tbPetugasKeyPressed
        if(tabMode.getRowCount()!=0){
            if(evt.getKeyCode()==KeyEvent.VK_SPACE){
                i=tbPetugas.getSelectedColumn();
                if(i==1){
                    if(MnKamarInap.isEnabled()==true){
                        MnKamarInapActionPerformed(null);
                    }                    
                }else if(i==2){
                    boolean isBPJ = tbPetugas.getValueAt(tbPetugas.getSelectedRow(), 17).toString().equals("BPJ");
                    boolean isAdminUtama = akses.getkode().equals("Admin Utama");
                    
                    if(akses.gettindakan_ralan()==true){
                        MnRawatJalanActionPerformed(null);
                        
                    if (!isAdminUtama && isBPJ) {
                        
                        // Periksa apakah kode dokter yang login sama dengan kode dokter yang tertera di kddokter
//                        if (kddokter.getText().equals(akses.getkode())) {
                    
                            MnRiwayatPerawatanICareNoKartuActionPerformed(null); // Panggil method baru hanya jika kddokter sesuai dengan kode yang login
                        }
                    }                                
                }else if(i==3){
                    if(akses.getberi_obat()==true){
                        MnPemberianObatActionPerformed(null);
                    }                   
                }else if(i==4){
                    if(akses.getperiksa_lab()==true){
                        MnPeriksaLabActionPerformed(null);
                    }                    
                }else if(i==5){
                    if(akses.getrujukan_masuk()==true){
                        MnRujukMasukActionPerformed(null);
                    }                    
                }
            }else if(evt.getKeyCode()==KeyEvent.VK_L){
                MnBarcodeRM9ActionPerformed(null);
            }else if(evt.getKeyCode()==KeyEvent.VK_Z){
                MnSPBK1ActionPerformed(null);
            }else if(evt.getKeyCode()==KeyEvent.VK_W){
                MnLembarRalanActionPerformed(null);
            }
        }
}//GEN-LAST:event_tbPetugasKeyPressed


    /**
     * Autocomplete IGD: cache hanya hidup selama DlgIGD ini terbuka.
     * Dokter, jenis bayar, dan asal rujukan tidak lagi query database per ketikan.
     */
    private void pasangAutocompleteIGD(){
        popupDokterIgd = new javax.swing.JPopupMenu();
        popupPenjabIgd = new javax.swing.JPopupMenu();
        popupPerujukIgd = new javax.swing.JPopupMenu();

        tabelDokterIgd = buatTabelAutocompleteIgd(modelDokterIgd);
        tabelPenjabIgd = buatTabelAutocompleteIgd(modelPenjabIgd);
        tabelPerujukIgd = buatTabelAutocompleteIgd(modelPerujukIgd);

        sembunyikanKolomAutocompleteIgd(tabelDokterIgd, 0);
        sembunyikanKolomAutocompleteIgd(tabelPenjabIgd, 0);
        tabelDokterIgd.getColumnModel().getColumn(1).setPreferredWidth(Math.max(1, TDokter.getWidth()));
        tabelPenjabIgd.getColumnModel().getColumn(1).setPreferredWidth(Math.max(1, nmpnj.getWidth()));
        tabelPerujukIgd.getColumnModel().getColumn(0).setPreferredWidth(210);
        tabelPerujukIgd.getColumnModel().getColumn(1).setPreferredWidth(130);

        popupDokterIgd.add(buatScrollAutocompleteIgd(tabelDokterIgd));
        popupPenjabIgd.add(buatScrollAutocompleteIgd(tabelPenjabIgd));
        popupPerujukIgd.add(buatScrollAutocompleteIgd(tabelPerujukIgd));

        timerDokterIgd = new Timer(250, new ActionListener() {
            @Override public void actionPerformed(ActionEvent evt) {
                tampilkanPilihanDokterIgd(TDokter.getText());
            }
        });
        timerDokterIgd.setRepeats(false);
        timerPenjabIgd = new Timer(250, new ActionListener() {
            @Override public void actionPerformed(ActionEvent evt) {
                tampilkanPilihanPenjabIgd(nmpnj.getText());
            }
        });
        timerPenjabIgd.setRepeats(false);
        timerPerujukIgd = new Timer(250, new ActionListener() {
            @Override public void actionPerformed(ActionEvent evt) {
                tampilkanPilihanPerujukIgd(AsalRujukan.getText());
            }
        });
        timerPerujukIgd.setRepeats(false);

        TDokter.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent evt) { perubahanTeksDokterIgd(); }
            @Override public void removeUpdate(DocumentEvent evt) { perubahanTeksDokterIgd(); }
            @Override public void changedUpdate(DocumentEvent evt) { perubahanTeksDokterIgd(); }
        });
        nmpnj.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent evt) { perubahanTeksPenjabIgd(); }
            @Override public void removeUpdate(DocumentEvent evt) { perubahanTeksPenjabIgd(); }
            @Override public void changedUpdate(DocumentEvent evt) { perubahanTeksPenjabIgd(); }
        });
        AsalRujukan.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent evt) { perubahanTeksPerujukIgd(); }
            @Override public void removeUpdate(DocumentEvent evt) { perubahanTeksPerujukIgd(); }
            @Override public void changedUpdate(DocumentEvent evt) { perubahanTeksPerujukIgd(); }
        });

        TDokter.addKeyListener(new java.awt.event.KeyAdapter() {
            @Override public void keyPressed(KeyEvent evt) {
                navigasiAutocompleteIgd(evt, tabelDokterIgd, popupDokterIgd, 1);
            }
        });
        nmpnj.addKeyListener(new java.awt.event.KeyAdapter() {
            @Override public void keyPressed(KeyEvent evt) {
                navigasiAutocompleteIgd(evt, tabelPenjabIgd, popupPenjabIgd, 2);
            }
        });

        tabelDokterIgd.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mouseClicked(java.awt.event.MouseEvent evt) {
                if (evt.getClickCount() >= 1) pilihDokterAutocompleteIgd();
            }
        });
        tabelPenjabIgd.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mouseClicked(java.awt.event.MouseEvent evt) {
                if (evt.getClickCount() >= 1) pilihPenjabAutocompleteIgd();
            }
        });
        tabelPerujukIgd.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mouseClicked(java.awt.event.MouseEvent evt) {
                if (evt.getClickCount() >= 1) pilihPerujukAutocompleteIgd();
            }
        });

        pasangSembunyiPopupIgd(TDokter, popupDokterIgd);
        pasangSembunyiPopupIgd(nmpnj, popupPenjabIgd);
        pasangSembunyiPopupIgd(AsalRujukan, popupPerujukIgd);

        petunjukDokterIgd = pasangPetunjukIgd(TDokter, "ketik pencarian dokter di sini");
        petunjukPenjabIgd = pasangPetunjukIgd(nmpnj, "ketik pencarian jenis bayar di sini");
        petunjukPerujukIgd = pasangPetunjukIgd(AsalRujukan, "ketik asal rujukan di sini");
    }

    private JTable buatTabelAutocompleteIgd(final DefaultTableModel model){
        JTable tabel = new JTable(model);
        tabel.setRowHeight(BARIS_AUTOCOMPLETE_IGD);
        tabel.setFont(new java.awt.Font("Tahoma", java.awt.Font.PLAIN, 11));
        tabel.setSelectionMode(javax.swing.ListSelectionModel.SINGLE_SELECTION);
        tabel.setShowGrid(true);
        tabel.setGridColor(GARIS_AUTOCOMPLETE_IGD);
        tabel.setAutoResizeMode(JTable.AUTO_RESIZE_LAST_COLUMN);
        tabel.getTableHeader().setReorderingAllowed(false);
        tabel.getTableHeader().setResizingAllowed(false);
        tabel.getTableHeader().setPreferredSize(new Dimension(1, HEADER_AUTOCOMPLETE_IGD));
        tabel.getTableHeader().setBackground(HEADER_AUTOCOMPLETE_BG_IGD);
        tabel.getTableHeader().setForeground(HEADER_AUTOCOMPLETE_FG_IGD);
        tabel.getTableHeader().setFont(new java.awt.Font("Tahoma", java.awt.Font.BOLD, 11));
        tabel.setDefaultRenderer(Object.class, new javax.swing.table.DefaultTableCellRenderer() {
            @Override public java.awt.Component getTableCellRendererComponent(
                    JTable table, Object value, boolean selected, boolean focused, int row, int column) {
                javax.swing.JLabel label = (javax.swing.JLabel) super.getTableCellRendererComponent(
                        table, value, selected, focused, row, column);
                label.setBorder(javax.swing.BorderFactory.createEmptyBorder(0, 7, 0, 7));
                if (selected) {
                    label.setBackground(PILIH_AUTOCOMPLETE_IGD);
                    label.setForeground(TEKS_PILIH_AUTOCOMPLETE_IGD);
                } else {
                    label.setBackground((row % 2 == 0) ? LATAR_GENAP_AUTOCOMPLETE_IGD : LATAR_GANJIL_AUTOCOMPLETE_IGD);
                    label.setForeground(TEKS_NORMAL_AUTOCOMPLETE_IGD);
                }
                return label;
            }
        });
        return tabel;
    }

    private javax.swing.JScrollPane buatScrollAutocompleteIgd(JTable tabel){
        javax.swing.JScrollPane scroll = new javax.swing.JScrollPane(tabel);
        scroll.setBorder(javax.swing.BorderFactory.createEmptyBorder());
        scroll.setViewportBorder(javax.swing.BorderFactory.createEmptyBorder());
        scroll.setHorizontalScrollBarPolicy(javax.swing.ScrollPaneConstants.HORIZONTAL_SCROLLBAR_NEVER);
        scroll.setVerticalScrollBarPolicy(javax.swing.ScrollPaneConstants.VERTICAL_SCROLLBAR_AS_NEEDED);
        scroll.setColumnHeaderView(tabel.getTableHeader());
        scroll.getVerticalScrollBar().setUnitIncrement(BARIS_AUTOCOMPLETE_IGD);
        return scroll;
    }

    private void sembunyikanKolomAutocompleteIgd(JTable tabel, int kolom){
        TableColumn column = tabel.getColumnModel().getColumn(kolom);
        column.setMinWidth(0);
        column.setMaxWidth(0);
        column.setPreferredWidth(0);
    }

    private javax.swing.JLabel pasangPetunjukIgd(final JTextField field, final String teks){
        final javax.swing.JLabel label = new javax.swing.JLabel(teks);
        java.awt.Font font = field.getFont();
        if (font == null) font = new java.awt.Font("Tahoma", java.awt.Font.PLAIN, 11);
        label.setFont(font.deriveFont(java.awt.Font.ITALIC));
        label.setForeground(PETUNJUK_AUTOCOMPLETE_IGD);
        label.setOpaque(false);
        label.setFocusable(false);
        label.setHorizontalAlignment(javax.swing.SwingConstants.LEFT);
        label.setVerticalAlignment(javax.swing.SwingConstants.CENTER);
        aturPosisiPetunjukIgd(field, label);
        label.addMouseListener(new java.awt.event.MouseAdapter() {
            @Override public void mousePressed(java.awt.event.MouseEvent evt) { field.requestFocusInWindow(); }
        });
        field.addFocusListener(new java.awt.event.FocusAdapter() {
            @Override public void focusGained(java.awt.event.FocusEvent evt) { perbaruiPetunjukIgd(field, label); }
            @Override public void focusLost(java.awt.event.FocusEvent evt) { perbaruiPetunjukIgd(field, label); }
        });
        field.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            @Override public void insertUpdate(DocumentEvent evt) { perbaruiPetunjukIgd(field, label); }
            @Override public void removeUpdate(DocumentEvent evt) { perbaruiPetunjukIgd(field, label); }
            @Override public void changedUpdate(DocumentEvent evt) { perbaruiPetunjukIgd(field, label); }
        });
        field.addComponentListener(new java.awt.event.ComponentAdapter() {
            @Override public void componentResized(java.awt.event.ComponentEvent evt) { aturPosisiPetunjukIgd(field, label); }
            @Override public void componentMoved(java.awt.event.ComponentEvent evt) { aturPosisiPetunjukIgd(field, label); }
        });
        FormInput.add(label);
        FormInput.setComponentZOrder(label, 0);
        perbaruiPetunjukIgd(field, label);
        FormInput.revalidate();
        FormInput.repaint();
        return label;
    }

    private void aturPosisiPetunjukIgd(JTextField field, javax.swing.JLabel label){
        label.setBounds(field.getX() + 8, field.getY() + 1, Math.max(1, field.getWidth() - 16), Math.max(1, field.getHeight() - 2));
    }

    private void perbaruiPetunjukIgd(JTextField field, javax.swing.JLabel label){
        if (label == null) return;
        aturPosisiPetunjukIgd(field, label);
        label.setVisible(field.getText().trim().equals("") && !field.hasFocus());
        label.repaint();
    }

    /*
     * Popup autocomplete adalah lightweight popup. Pada beberapa komputer/tema Java,
     * pemanggilan popup.show() dapat memicu focusLost sesaat pada TextBox. Patch awal
     * langsung menutup popup 180 ms setelah focusLost sehingga hasil pencarian terlihat
     * seperti berkedip. Timer di bawah hanya menutup popup bila fokus benar-benar sudah
     * berpindah ke komponen lain, bukan ketika fokus masih di field atau berada di tabel
     * popup.
     */
    private void pasangSembunyiPopupIgd(final JTextField field, final javax.swing.JPopupMenu popup){
        final Timer[] timerSembunyi = new Timer[1];
        field.addFocusListener(new java.awt.event.FocusAdapter() {
            @Override public void focusGained(java.awt.event.FocusEvent evt) {
                if (timerSembunyi[0] != null) timerSembunyi[0].stop();
            }

            @Override public void focusLost(java.awt.event.FocusEvent evt) {
                if (timerSembunyi[0] != null) timerSembunyi[0].stop();
                timerSembunyi[0] = new Timer(300, new ActionListener() {
                    @Override public void actionPerformed(ActionEvent event) {
                        java.awt.Component pemilikFokus = java.awt.KeyboardFocusManager
                                .getCurrentKeyboardFocusManager().getFocusOwner();
                        boolean fokusMasihDiAutocomplete = field.isFocusOwner()
                                || (pemilikFokus != null
                                    && (pemilikFokus == field
                                        || javax.swing.SwingUtilities.isDescendingFrom(pemilikFokus, popup)));
                        if (!fokusMasihDiAutocomplete) {
                            popup.setVisible(false);
                        }
                    }
                });
                timerSembunyi[0].setRepeats(false);
                timerSembunyi[0].start();
            }
        });
    }

    private void perubahanTeksDokterIgd(){
        if (sedangIsiAutocompleteIgd) return;
        resetDokterIgdJikaTidakSesuai();
        String kata = TDokter.getText().trim();
        if (kata.length() < MIN_AUTOCOMPLETE_IGD) {
            timerDokterIgd.stop();
            modelDokterIgd.setRowCount(0);
            popupDokterIgd.setVisible(false);
            return;
        }
        timerDokterIgd.restart();
    }

    private void perubahanTeksPenjabIgd(){
        // Popup jenis bayar hanya berasal dari ketikan manual petugas.
        if (sedangIsiAutocompleteIgd || sedangIsiJenisBayarOtomatisIgd) return;
        resetPenjabIgdJikaTidakSesuai();
        String kata = nmpnj.getText().trim();
        if (kata.length() < MIN_AUTOCOMPLETE_IGD) {
            timerPenjabIgd.stop();
            modelPenjabIgd.setRowCount(0);
            popupPenjabIgd.setVisible(false);
            return;
        }
        timerPenjabIgd.restart();
    }

    private void perubahanTeksPerujukIgd(){
        if (sedangIsiAutocompleteIgd) return;
        alamatperujuk = "-";
        String kata = AsalRujukan.getText().trim();
        if (kata.length() < MIN_AUTOCOMPLETE_IGD) {
            timerPerujukIgd.stop();
            modelPerujukIgd.setRowCount(0);
            popupPerujukIgd.setVisible(false);
            return;
        }
        timerPerujukIgd.restart();
    }

    private void resetDokterIgdJikaTidakSesuai(){
        String kode = KdDokter.getText().trim();
        String nama = namaDokterIgdBerdasarkanKode(kode);
        if (kode.equals("") || nama.equals("") || !nama.equalsIgnoreCase(TDokter.getText().trim())) {
            boolean awal = sedangIsiAutocompleteIgd;
            sedangIsiAutocompleteIgd = true;
            try { KdDokter.setText(""); } finally { sedangIsiAutocompleteIgd = awal; }
        }
    }

    private void resetPenjabIgdJikaTidakSesuai(){
        String kode = kdpnj.getText().trim();
        String nama = namaPenjabIgdBerdasarkanKode(kode);
        if (kode.equals("") || nama.equals("") || !nama.equalsIgnoreCase(nmpnj.getText().trim())) {
            boolean awal = sedangIsiAutocompleteIgd;
            sedangIsiAutocompleteIgd = true;
            try { kdpnj.setText(""); } finally { sedangIsiAutocompleteIgd = awal; }
        }
    }

    /** Cache autocomplete IGD dibatasi untuk dokter dengan spesialisasi IGD (kd_sps=SP001). */
    private void muatCacheDokterIgdJikaPerlu(){
        if (cacheDokterIgdSiap) return;
        cacheDokterIgd.clear();
        try (PreparedStatement psCache = koneksi.prepareStatement(
                "select kd_dokter,nm_dokter from dokter where kd_sps='SP001' order by nm_dokter")) {
            try (ResultSet rsCache = psCache.executeQuery()) {
                while (rsCache.next()) {
                    cacheDokterIgd.add(new CacheDokterIgd(
                            rsCache.getString("kd_dokter"), rsCache.getString("nm_dokter")));
                }
            }
            cacheDokterIgdSiap = true;
        } catch (Exception e) {
            cacheDokterIgdSiap = false;
            System.out.println("Autocomplete IGD, muat cache dokter: " + e);
        }
    }

    private void muatCachePenjabIgdJikaPerlu(){
        if (cachePenjabIgdSiap) return;
        cachePenjabIgd.clear();
        try (PreparedStatement psCache = koneksi.prepareStatement(
                "select kd_pj,png_jawab from penjab order by png_jawab")) {
            try (ResultSet rsCache = psCache.executeQuery()) {
                while (rsCache.next()) {
                    cachePenjabIgd.add(new CachePenjabIgd(
                            rsCache.getString("kd_pj"), rsCache.getString("png_jawab")));
                }
            }
            cachePenjabIgdSiap = true;
        } catch (Exception e) {
            cachePenjabIgdSiap = false;
            System.out.println("Autocomplete IGD, muat cache jenis bayar: " + e);
        }
    }

    private void muatCachePerujukIgdJikaPerlu(){
        if (cachePerujukIgdSiap) return;
        cachePerujukIgd.clear();
        try (PreparedStatement psCache = koneksi.prepareStatement(
                "select rujuk_masuk.perujuk,ifnull(rujuk_masuk.alamat,'') as alamat " +
                "from rujuk_masuk where ifnull(trim(rujuk_masuk.perujuk),'')<>'' " +
                "group by rujuk_masuk.perujuk order by rujuk_masuk.perujuk")) {
            try (ResultSet rsCache = psCache.executeQuery()) {
                while (rsCache.next()) {
                    cachePerujukIgd.add(new CachePerujukIgd(
                            rsCache.getString("perujuk"), rsCache.getString("alamat")));
                }
            }
            cachePerujukIgdSiap = true;
        } catch (Exception e) {
            cachePerujukIgdSiap = false;
            System.out.println("Autocomplete IGD, muat cache asal rujukan: " + e);
        }
    }

    private void tampilkanPilihanDokterIgd(String kataKunci){
        if (sedangIsiAutocompleteIgd) return;
        String kata = kataKunci == null ? "" : kataKunci.trim();
        if (kata.length() < MIN_AUTOCOMPLETE_IGD) { popupDokterIgd.setVisible(false); return; }
        muatCacheDokterIgdJikaPerlu();
        modelDokterIgd.setRowCount(0);
        for (CacheDokterIgd item : cacheDokterIgd) {
            if (cocokAutocompleteIgd(kata, item.kode, item.nama)) {
                modelDokterIgd.addRow(new Object[]{item.kode, item.nama});
            }
        }
        tampilkanPopupIgd(TDokter, popupDokterIgd, tabelDokterIgd, modelDokterIgd.getRowCount());
    }

    private void tampilkanPilihanPenjabIgd(String kataKunci){
        if (sedangIsiAutocompleteIgd || sedangIsiJenisBayarOtomatisIgd) return;
        String kata = kataKunci == null ? "" : kataKunci.trim();
        if (kata.length() < MIN_AUTOCOMPLETE_IGD) { popupPenjabIgd.setVisible(false); return; }
        muatCachePenjabIgdJikaPerlu();
        modelPenjabIgd.setRowCount(0);
        for (CachePenjabIgd item : cachePenjabIgd) {
            if (cocokAutocompleteIgd(kata, item.kode, item.nama)) {
                modelPenjabIgd.addRow(new Object[]{item.kode, item.nama});
            }
        }
        tampilkanPopupIgd(nmpnj, popupPenjabIgd, tabelPenjabIgd, modelPenjabIgd.getRowCount());
    }

    private void tampilkanPilihanPerujukIgd(String kataKunci){
        if (sedangIsiAutocompleteIgd) return;
        String kata = kataKunci == null ? "" : kataKunci.trim();
        if (kata.length() < MIN_AUTOCOMPLETE_IGD) { popupPerujukIgd.setVisible(false); return; }
        muatCachePerujukIgdJikaPerlu();
        modelPerujukIgd.setRowCount(0);
        for (CachePerujukIgd item : cachePerujukIgd) {
            if (cocokAutocompleteIgd(kata, "", item.nama) || cocokAutocompleteIgd(kata, "", item.alamat)) {
                modelPerujukIgd.addRow(new Object[]{item.nama, item.alamat});
            }
        }
        tampilkanPopupIgd(AsalRujukan, popupPerujukIgd, tabelPerujukIgd, modelPerujukIgd.getRowCount());
    }

    private String namaDokterIgdBerdasarkanKode(String kode){
        if (kode == null || kode.trim().equals("")) return "";
        muatCacheDokterIgdJikaPerlu();
        for (CacheDokterIgd item : cacheDokterIgd) if (kode.trim().equals(item.kode)) return item.nama.trim();
        return "";
    }

    private String namaPenjabIgdBerdasarkanKode(String kode){
        if (kode == null || kode.trim().equals("")) return "";
        muatCachePenjabIgdJikaPerlu();
        for (CachePenjabIgd item : cachePenjabIgd) if (kode.trim().equals(item.kode)) return item.nama.trim();
        return "";
    }

    private boolean cocokAutocompleteIgd(String kata, String kode, String nama){
        String kunci = kata == null ? "" : kata.trim().toLowerCase(java.util.Locale.ROOT);
        String nilaiKode = kode == null ? "" : kode.toLowerCase(java.util.Locale.ROOT);
        String nilaiNama = nama == null ? "" : nama.toLowerCase(java.util.Locale.ROOT);
        return nilaiKode.contains(kunci) || nilaiNama.contains(kunci);
    }

    private String nilaiTabelAutocompleteIgd(JTable tabel, int row, int column){
        try {
            Object nilai = tabel.getValueAt(row, column);
            return nilai == null ? "" : nilai.toString();
        } catch (Exception e) {
            return "";
        }
    }

    /** Popup mengikuti jumlah hasil 1 sampai 11 baris; selebihnya memakai scroll. */
    private void tampilkanPopupIgd(JTextField field, javax.swing.JPopupMenu popup, JTable tabel, int jumlah){
        if (jumlah <= 0) { popup.setVisible(false); return; }
        int lebar = Math.max(1, field.getWidth());
        int baris = Math.min(jumlah, MAX_BARIS_AUTOCOMPLETE_IGD);
        int tinggiData = Math.max(1, baris) * tabel.getRowHeight();
        int tinggiHeader = Math.max(HEADER_AUTOCOMPLETE_IGD, tabel.getTableHeader().getPreferredSize().height);
        int tinggi = tinggiHeader + tinggiData + 2;
        for (java.awt.Component component : popup.getComponents()) {
            if (component instanceof javax.swing.JScrollPane) {
                javax.swing.JScrollPane scroll = (javax.swing.JScrollPane) component;
                int lebarViewport = jumlah > MAX_BARIS_AUTOCOMPLETE_IGD
                        ? Math.max(1, lebar - scroll.getVerticalScrollBar().getPreferredSize().width) : lebar;
                Dimension viewport = new Dimension(lebarViewport, tinggiData);
                tabel.setPreferredScrollableViewportSize(viewport);
                scroll.getViewport().setPreferredSize(viewport);
                scroll.setPreferredSize(new Dimension(lebar, tinggi));
                scroll.setMinimumSize(new Dimension(lebar, tinggi));
                scroll.setSize(lebar, tinggi);
                scroll.revalidate();
                scroll.doLayout();
                break;
            }
        }
        java.awt.Insets insets = popup.getInsets();
        Dimension ukuran = new Dimension(lebar, tinggi + insets.top + insets.bottom);
        popup.setPreferredSize(ukuran);
        popup.setPopupSize(ukuran);
        popup.setSize(ukuran);
        popup.revalidate();
        tabel.setRowSelectionInterval(0, 0);
        popup.show(field, 0, field.getHeight());
        popup.setPopupSize(ukuran);
        // Jaga fokus tetap di kolom input agar popup tidak dianggap kehilangan fokus
        // segera setelah tampil. Ini juga membuat panah/Enter tetap bekerja dari field.
        javax.swing.SwingUtilities.invokeLater(new Runnable() {
            @Override public void run() {
                if (field.isShowing() && popup.isVisible() && !field.hasFocus()) {
                    field.requestFocusInWindow();
                }
            }
        });
    }

    /** jenis: 1=dokter, 2=jenis bayar, 3=asal rujukan. */
    private boolean navigasiAutocompleteIgd(KeyEvent evt, JTable tabel, javax.swing.JPopupMenu popup, int jenis){
        if (popup == null || tabel == null || !popup.isVisible()) return false;
        int selected = tabel.getSelectedRow();
        if (evt.getKeyCode() == KeyEvent.VK_DOWN) {
            int next = Math.min(tabel.getRowCount() - 1, Math.max(0, selected + 1));
            tabel.setRowSelectionInterval(next, next);
            tabel.scrollRectToVisible(tabel.getCellRect(next, 0, true));
        } else if (evt.getKeyCode() == KeyEvent.VK_UP) {
            int previous = Math.max(0, selected - 1);
            tabel.setRowSelectionInterval(previous, previous);
            tabel.scrollRectToVisible(tabel.getCellRect(previous, 0, true));
        } else if (evt.getKeyCode() == KeyEvent.VK_ENTER) {
            if (jenis == 1) pilihDokterAutocompleteIgd();
            else if (jenis == 2) pilihPenjabAutocompleteIgd();
            else pilihPerujukAutocompleteIgd();
        } else if (evt.getKeyCode() == KeyEvent.VK_ESCAPE) {
            popup.setVisible(false);
        } else {
            return false;
        }
        evt.consume();
        return true;
    }

    private void pilihDokterAutocompleteIgd(){
        int row = tabelDokterIgd.getSelectedRow();
        if (row < 0) return;
        isiDokterOtomatisIgd(nilaiTabelAutocompleteIgd(tabelDokterIgd, row, 0),
                nilaiTabelAutocompleteIgd(tabelDokterIgd, row, 1));
        isNumber();
        popupDokterIgd.setVisible(false);
        TNoRM.requestFocus();
    }

    private void pilihPenjabAutocompleteIgd(){
        int row = tabelPenjabIgd.getSelectedRow();
        if (row < 0) return;
        isiJenisBayarOtomatisIgd(nilaiTabelAutocompleteIgd(tabelPenjabIgd, row, 0),
                nilaiTabelAutocompleteIgd(tabelPenjabIgd, row, 1));
        popupPenjabIgd.setVisible(false);
        AsalRujukan.requestFocus();
    }

    private void pilihPerujukAutocompleteIgd(){
        int row = tabelPerujukIgd.getSelectedRow();
        if (row < 0) return;
        isiPerujukOtomatisIgd(nilaiTabelAutocompleteIgd(tabelPerujukIgd, row, 0),
                nilaiTabelAutocompleteIgd(tabelPerujukIgd, row, 1));
        popupPerujukIgd.setVisible(false);
        BtnSimpan.requestFocus();
    }

    private void isiDokterOtomatisIgd(String kode, String nama){
        boolean awal = sedangIsiAutocompleteIgd;
        sedangIsiAutocompleteIgd = true;
        try {
            if (timerDokterIgd != null) timerDokterIgd.stop();
            if (popupDokterIgd != null) popupDokterIgd.setVisible(false);
            KdDokter.setText(kode == null ? "" : kode);
            TDokter.setText(nama == null ? "" : nama);
        } finally { sedangIsiAutocompleteIgd = awal; }
    }

    private void isiJenisBayarDariKodeIgd(){
        String kode = kdpnj.getText().trim();
        String nama = "";
        if (!kode.equals("")) {
            nama = Sequel.cariIsi("select penjab.png_jawab from penjab where penjab.kd_pj=?", kode);
        }
        isiJenisBayarOtomatisIgd(kode, nama);
    }

    /** Pengisian otomatis tidak boleh memunculkan popup Jenis Bayar. */
    private void isiJenisBayarOtomatisIgd(String kode, String nama){
        boolean awal = sedangIsiJenisBayarOtomatisIgd;
        sedangIsiJenisBayarOtomatisIgd = true;
        try {
            if (timerPenjabIgd != null) timerPenjabIgd.stop();
            if (popupPenjabIgd != null) popupPenjabIgd.setVisible(false);
            kdpnj.setText(kode == null ? "" : kode);
            nmpnj.setText(nama == null ? "" : nama);
        } finally { sedangIsiJenisBayarOtomatisIgd = awal; }
    }

    private void isiPerujukOtomatisIgd(String nama, String alamat){
        boolean awal = sedangIsiAutocompleteIgd;
        sedangIsiAutocompleteIgd = true;
        try {
            if (timerPerujukIgd != null) timerPerujukIgd.stop();
            if (popupPerujukIgd != null) popupPerujukIgd.setVisible(false);
            AsalRujukan.setText(nama == null ? "" : nama);
            alamatperujuk = (alamat == null || alamat.trim().equals("")) ? "-" : alamat.trim();
        } finally { sedangIsiAutocompleteIgd = awal; }
    }

    /** Dokter yang diketik harus menghasilkan kd_dokter valid sebelum simpan. */
    private boolean validasiDokterAutocompleteIgd(){
        String kode = KdDokter.getText().trim();
        String nama = TDokter.getText().trim();
        muatCacheDokterIgdJikaPerlu();
        if (kode.equals("") && !nama.equals("")) {
            String kodeDitemukan = "", namaDitemukan = "";
            for (CacheDokterIgd item : cacheDokterIgd) {
                if (item.nama.equalsIgnoreCase(nama)) {
                    if (!kodeDitemukan.equals("") && !kodeDitemukan.equals(item.kode)) {
                        JOptionPane.showMessageDialog(null, "Nama dokter lebih dari satu. Silakan pilih dari autocomplete.");
                        TDokter.requestFocus();
                        return false;
                    }
                    kodeDitemukan = item.kode;
                    namaDitemukan = item.nama;
                }
            }
            if (!kodeDitemukan.equals("")) {
                isiDokterOtomatisIgd(kodeDitemukan, namaDitemukan);
                return true;
            }
        }
        if (kode.equals("") || namaDokterIgdBerdasarkanKode(kode).equals("")
                || !namaDokterIgdBerdasarkanKode(kode).equalsIgnoreCase(nama)) {
            JOptionPane.showMessageDialog(null, "Dokter belum valid. Pilih dari autocomplete atau tombol Pilih Dokter.");
            TDokter.requestFocus();
            return false;
        }
        return true;
    }

    /** Mencegah kd_pj tidak valid dan error foreign key saat simpan. */
    private boolean validasiJenisBayarAutocompleteIgd(){
        String kode = kdpnj.getText().trim();
        String nama = nmpnj.getText().trim();
        muatCachePenjabIgdJikaPerlu();
        if (kode.equals("") && !nama.equals("")) {
            String kodeDitemukan = "", namaDitemukan = "";
            for (CachePenjabIgd item : cachePenjabIgd) {
                if (item.nama.equalsIgnoreCase(nama)) {
                    if (!kodeDitemukan.equals("") && !kodeDitemukan.equals(item.kode)) {
                        JOptionPane.showMessageDialog(null, "Nama jenis bayar lebih dari satu. Silakan pilih dari autocomplete.");
                        nmpnj.requestFocus();
                        return false;
                    }
                    kodeDitemukan = item.kode;
                    namaDitemukan = item.nama;
                }
            }
            if (!kodeDitemukan.equals("")) {
                isiJenisBayarOtomatisIgd(kodeDitemukan, namaDitemukan);
                return true;
            }
        }
        if (kode.equals("") || namaPenjabIgdBerdasarkanKode(kode).equals("")
                || !namaPenjabIgdBerdasarkanKode(kode).equalsIgnoreCase(nama)) {
            JOptionPane.showMessageDialog(null, "Jenis bayar belum valid. Pilih dari autocomplete atau tombol Pilih Jenis Bayar.");
            nmpnj.requestFocus();
            return false;
        }
        return true;
    }

private void KdDokterKeyPressed(java.awt.event.KeyEvent evt) {//GEN-FIRST:event_KdDokterKeyPressed
        if(evt.getKeyCode()==KeyEvent.VK_PAGE_DOWN){
            isNumber();
            isiDokterOtomatisIgd(KdDokter.getText(), getDokter().tampil3(KdDokter.getText()));
        }else if(evt.getKeyCode()==KeyEvent.VK_UP){
            BtnDokterActionPerformed(null);
        }else{
            isNumber();
            isiDokterOtomatisIgd(KdDokter.getText(), getDokter().tampil3(KdDokter.getText()));
            Valid.pindah(evt,CmbDetik,TNoRM);
        }
}//GEN-LAST:event_KdDokterKeyPressed

