package simrskhanza;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.geom.RoundRectangle2D;
import java.util.ArrayList;
import java.util.List;

/**
 * ToastJawaban - green themed toast for "Jawaban Konsultasi" notifications.
 *
 * Usage:
 *   ToastJawaban.showSuccess(parentComponent,
 *       "<html><b>Jawaban Konsul Baru</b><br/>Klik untuk membuka</html>",
 *       9000,
 *       () -> openInboxJawaban(),
 *       "notifikasi.wav");
 *
 * Notes:
 *  - Supports HTML message.
 *  - onClick is optional; pass null if you don't need a click action.
 *  - soundFileName is accepted for signature compatibility; play sound externally.
 *  - Stacks toasts at the bottom-right of the parent window/screen.
 *
 * Java 8+ compatible (works on Java 15).
 */
public final class ToastJawaban {

    private static final int ARC = 16;
    private static final int PADDING = 14;
    private static final int MAX_WIDTH = 360;
    private static final int MARGIN = 20; // distance from screen edges
    private static final int STACK_GAP = 10; // gap between stacked toasts

    // Track active toasts so they stack
    private static final List<JWindow> ACTIVE = new ArrayList<>();

    private ToastJawaban() {}

    /** Green success toast (recommended for jawaban konsul). */
    public static void showSuccess(Component parent, String htmlMessage, int durationMs, Runnable onClick, String soundFileName) {
        Color bg     = new Color(0xE9F7EF);  // soft green
        Color fg     = new Color(0x1B5E20);  // dark green text
        Color border = new Color(0xA5D6A7);  // light green border
        Icon icon = tryLoadIcon("/picture/reply_green.png");
        if (icon == null) {
            // fallback to a standard info icon
            icon = UIManager.getIcon("OptionPane.informationIcon");
        }
        show(parent, htmlMessage, durationMs, onClick, bg, fg, border, icon);
    }

    /** Blue info (optional helper if needed). */
    public static void showInfo(Component parent, String htmlMessage, int durationMs, Runnable onClick, String soundFileName) {
        Color bg     = new Color(0xE8F1FD);
        Color fg     = new Color(0x0D47A1);
        Color border = new Color(0x90CAF9);
        Icon icon = UIManager.getIcon("OptionPane.informationIcon");
        show(parent, htmlMessage, durationMs, onClick, bg, fg, border, icon);
    }

    private static Icon tryLoadIcon(String path) {
        try {
            java.net.URL u = ToastJawaban.class.getResource(path);
            if (u != null) return new ImageIcon(u);
        } catch (Throwable ignore) {}
        return null;
    }

    private static void show(Component parent, String htmlMessage, int durationMs, Runnable onClick,
                             Color bg, Color fg, Color border, Icon icon) {
        final Window baseWindow = parent instanceof Window ? (Window) parent : SwingUtilities.getWindowAncestor(parent);
        final JWindow w = new JWindow(baseWindow);
        w.setAlwaysOnTop(true);
        w.setBackground(new Color(0,0,0,0)); // transparent window

        // Main content with rounded corners
        JPanel content = new RoundedPanel(bg, border);
        content.setLayout(new BorderLayout(10,10));
        content.setBorder(BorderFactory.createEmptyBorder(PADDING, PADDING, PADDING, PADDING));

        JLabel lbl = new JLabel(htmlMessage);
        lbl.setForeground(fg);
        if (icon != null) {
            lbl.setIcon(icon);
            lbl.setIconTextGap(10);
        }
        content.add(lbl, BorderLayout.CENTER);

        // Optional close button (small × at top-right)
        JButton btnClose = new JButton("\u2715");
        btnClose.setOpaque(false);
        btnClose.setContentAreaFilled(false);
        btnClose.setBorder(BorderFactory.createEmptyBorder(4, 8, 4, 8));
        btnClose.setForeground(fg);
        btnClose.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        btnClose.addActionListener(e -> hideToast(w));
        content.add(btnClose, BorderLayout.EAST);

        // Click action on content
        if (onClick != null) {
            MouseAdapter ma = new MouseAdapter() {
                @Override public void mouseClicked(MouseEvent e) {
                    try { onClick.run(); } catch (Throwable ignore) {}
                    hideToast(w);
                }
            };
            content.addMouseListener(ma);
            lbl.addMouseListener(ma);
        }

        w.setContentPane(content);
        w.pack();

        // Constrain width
        int width = Math.min(MAX_WIDTH, w.getPreferredSize().width);
        int height = w.getPreferredSize().height;
        Dimension finalSize = new Dimension(width, height);
        w.setSize(finalSize);

        // Position bottom-right of the parent window (or screen if parent is null)
        Rectangle bounds = getReferenceBounds(baseWindow);
        int x = bounds.x + bounds.width - MARGIN - finalSize.width;
        int y = bounds.y + bounds.height - MARGIN - finalSize.height;

        // Adjust for stacking
        synchronized (ACTIVE) {
            int shift = 0;
            for (int i = ACTIVE.size() - 1; i >= 0; i--) {
                JWindow other = ACTIVE.get(i);
                if (other.isShowing()) {
                    shift += other.getHeight() + STACK_GAP;
                } else {
                    ACTIVE.remove(i);
                }
            }
            y -= shift;
            ACTIVE.add(w);
        }

        // Show
        w.setLocation(x, y);
        w.setVisible(true);

        // Auto hide timer
        if (durationMs > 0) {
            new Timer(durationMs, new ActionListener() {
                @Override public void actionPerformed(ActionEvent e) {
                    hideToast(w);
                }
            }).start();
        }
    }

    private static Rectangle getReferenceBounds(Window baseWindow) {
        try {
            if (baseWindow != null && baseWindow.isShowing()) {
                Point p = baseWindow.getLocationOnScreen();
                return new Rectangle(p.x, p.y, baseWindow.getWidth(), baseWindow.getHeight());
            }
        } catch (IllegalComponentStateException ignore) {}
        // fallback to primary screen bounds minus insets
        Rectangle s = GraphicsEnvironment.getLocalGraphicsEnvironment()
                .getDefaultScreenDevice().getDefaultConfiguration().getBounds();
        Insets insets = Toolkit.getDefaultToolkit().getScreenInsets(
                GraphicsEnvironment.getLocalGraphicsEnvironment()
                        .getDefaultScreenDevice().getDefaultConfiguration());
        return new Rectangle(s.x + insets.left, s.y + insets.top,
                s.width - insets.left - insets.right,
                s.height - insets.top - insets.bottom);
    }

    private static void hideToast(JWindow w) {
        if (w == null) return;
        try {
            w.setVisible(false);
            w.dispose();
        } catch (Throwable ignore) {}
        synchronized (ACTIVE) {
            ACTIVE.remove(w);
        }
    }

    // Rounded background panel
    static final class RoundedPanel extends JPanel {
        private final Color bg;
        private final Color border;
        RoundedPanel(Color bg, Color border) {
            this.bg = bg;
            this.border = border;
            setOpaque(false);
        }
        @Override protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            int w = getWidth(), h = getHeight();
            Shape shape = new RoundRectangle2D.Float(0, 0, w-1, h-1, ARC, ARC);

            // subtle shadow
            g2.setColor(new Color(0,0,0,30));
            g2.fill(new RoundRectangle2D.Float(2, 3, w-1, h-1, ARC, ARC));

            // background
            g2.setColor(bg);
            g2.fill(shape);

            // border
            if (border != null) {
                g2.setColor(border);
                g2.draw(shape);
            }
            g2.dispose();
            super.paintComponent(g);
        }
    }
}
