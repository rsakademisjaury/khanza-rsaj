    private void BtnCheckinActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_BtnCheckinActionPerformed
        
        int row = tbJnsPerawatan.getSelectedRow();
        if (row >= 0) {
            String jamPraktek = tbJnsPerawatan.getValueAt(row, 9).toString();
            String estimasi = tbJnsPerawatan.getValueAt(row, 10).toString();
            String tanggalPeriksa = tbJnsPerawatan.getValueAt(row, 6).toString();
            String tanggalSekarang= Sequel.cariIsi("SELECT CURDATE()");

            if(!tanggalPeriksa.equals(tanggalSekarang)){
               JOptionPane.showMessageDialog(null,
                    "Tidak dapat melakukan checkin, tanggal periksa tidak sesuai dengan tanggal hari ini....!!!",
                    "Info", JOptionPane.ERROR_MESSAGE); 
            } else {
                if(tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),13).toString().equals("Batal")){
                    int pilihan = JOptionPane.showConfirmDialog(
                            this,
                            "Pasien berstatus batal. Yakin untuk melakukan checkin untuk pasien ini??",
                            "Konfirmasi Checkin",
                            JOptionPane.YES_NO_OPTION
                    );

                    if (pilihan == JOptionPane.YES_OPTION) {
                        if(SettingCheckin.equals("1")){
                            if (cekWaktuCheckin(jamPraktek, estimasi)) {
                                checkin();
                            }
                        } else {
                            checkin();
                        }
                    }
                } else {
                    if(SettingCheckin.equals("1")){
                        if (cekWaktuCheckin(jamPraktek, estimasi)) {
                            checkin();
                        }
                    } else {
                        checkin();
                    }
                }
                
                
            }
            
        }
    }//GEN-LAST:event_BtnCheckinActionPerformed

