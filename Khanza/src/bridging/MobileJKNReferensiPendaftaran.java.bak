    private void tampil() {
        LoadingUtils.showModernLoading(this, "Memuat data...", () -> {
            Valid.tabelKosong(tabMode);
            try{
                ps=koneksi.prepareStatement(
                       "SELECT referensi_mobilejkn_bpjs.no_rawat,referensi_mobilejkn_bpjs.norm,pasien.nm_pasien,referensi_mobilejkn_bpjs.nohp,referensi_mobilejkn_bpjs.nomorkartu,"+
                       "referensi_mobilejkn_bpjs.nik,referensi_mobilejkn_bpjs.tanggalperiksa,referensi_mobilejkn_bpjs.kodepoli,referensi_mobilejkn_bpjs.kodedokter,referensi_mobilejkn_bpjs.jampraktek,"+
                       "referensi_mobilejkn_bpjs.jeniskunjungan,referensi_mobilejkn_bpjs.nomorreferensi,referensi_mobilejkn_bpjs.status,referensi_mobilejkn_bpjs.validasi,"+
                       "referensi_mobilejkn_bpjs.nobooking,referensi_mobilejkn_bpjs.estimasidilayani FROM referensi_mobilejkn_bpjs INNER JOIN pasien ON referensi_mobilejkn_bpjs.norm=pasien.no_rkm_medis "+
                       "WHERE referensi_mobilejkn_bpjs.tanggalperiksa BETWEEN ? AND ? "+(TCari.getText().equals("")?"":
                       "and (referensi_mobilejkn_bpjs.no_rawat LIKE ? OR referensi_mobilejkn_bpjs.norm LIKE ? OR pasien.nm_pasien LIKE ? OR "+
                       "referensi_mobilejkn_bpjs.nohp LIKE ? OR referensi_mobilejkn_bpjs.nomorkartu LIKE ? OR referensi_mobilejkn_bpjs.nik LIKE ? OR "+
                       "referensi_mobilejkn_bpjs.jeniskunjungan LIKE ? OR referensi_mobilejkn_bpjs.nomorreferensi LIKE ? OR referensi_mobilejkn_bpjs.status LIKE ?) ")+
                       "order by referensi_mobilejkn_bpjs.tanggalperiksa");
                try {
                    ps.setString(1,Valid.SetTgl(DTPCari1.getSelectedItem()+""));
                    ps.setString(2,Valid.SetTgl(DTPCari2.getSelectedItem()+""));
                    if(!TCari.getText().trim().equals("")){
                        ps.setString(3,"%"+TCari.getText()+"%");
                        ps.setString(4,"%"+TCari.getText()+"%");
                        ps.setString(5,"%"+TCari.getText()+"%");
                        ps.setString(6,"%"+TCari.getText()+"%");
                        ps.setString(7,"%"+TCari.getText()+"%");
                        ps.setString(8,"%"+TCari.getText()+"%");
                        ps.setString(9,"%"+TCari.getText()+"%");
                        ps.setString(10,"%"+TCari.getText()+"%");
                        ps.setString(11,"%"+TCari.getText()+"%");
                    }

                    rs=ps.executeQuery();
                    while(rs.next()){
                        tabMode.addRow(new Object[]{
                            rs.getString("no_rawat"),rs.getString("norm"),rs.getString("nm_pasien"),
                            rs.getString("nohp"),rs.getString("nomorkartu"),rs.getString("nik"),
                            rs.getString("tanggalperiksa"),Sequel.cariIsi("select maping_poli_bpjs.nm_poli_bpjs from maping_poli_bpjs where maping_poli_bpjs.kd_poli_bpjs=?",rs.getString("kodepoli")),
                            Sequel.cariIsi("select maping_dokter_dpjpvclaim.nm_dokter_bpjs from maping_dokter_dpjpvclaim where maping_dokter_dpjpvclaim.kd_dokter_bpjs=?",rs.getString("kodedokter")),
                            rs.getString("jampraktek"),konversiTimestamp(rs.getLong("estimasidilayani")),rs.getString("jeniskunjungan"),rs.getString("nomorreferensi"),
                            rs.getString("status"),rs.getString("validasi"),rs.getString("nobooking")
                        });
                    }
                } catch (Exception e) {
                    System.out.println("Notif : "+e);
                } finally{
                    if(rs!=null){
                        rs.close();
                    }
                    if(ps!=null){
                        ps.close();
                    }
                }
            }catch(Exception e){
                System.out.println("Notifikasi : "+e);
            }
            LCount.setText(""+tabMode.getRowCount());
        });
    }
    
    private static String konversiTimestamp(long estimasidilayani) {
        return Instant.ofEpochMilli(estimasidilayani)
                      .atZone(ZONE)
                      .format(FORMAT);
    }
    
    public static boolean cekWaktuCheckin(String jamPraktek, String estimasiDilayani) {
        DateTimeFormatter fmtPraktek = DateTimeFormatter.ofPattern("HH:mm");
        DateTimeFormatter fmtEstimasi = DateTimeFormatter.ofPattern("HH:mm:ss");

        String[] parts = jamPraktek.split("-");
        LocalTime selesai = LocalTime.parse(parts[1].trim(), fmtPraktek);

        LocalTime estimasi = LocalTime.parse(estimasiDilayani, fmtEstimasi);
        LocalTime now = LocalTime.now();
        
        long sisaPraktekMenit = Math.max(0,(long) Math.ceil(Duration.between(now, selesai).getSeconds() / 60.0));
        long estimasiMenit = Math.max(0,(long) Math.ceil(Duration.between(now, estimasi).getSeconds() / 60.0));

        if (now.isAfter(selesai)) {
            JOptionPane.showMessageDialog(null,
                    "Tidak dapat melakukan checkin, jam praktek sudah habis.....!!!",
                    "Info", JOptionPane.ERROR_MESSAGE);
            return false;
        }
        
        if (sisaPraktekMenit < 30) {
            JOptionPane.showMessageDialog(null,
                    "Tidak dapat melakukan checkin, jam praktek akan berakhir kurang dari 30 menit lagi.....!!!",
                    "Info", JOptionPane.ERROR_MESSAGE);
            return false;
        }

        if (estimasiMenit > 30) {
            JOptionPane.showMessageDialog(null,
                    "Tidak dapat melakukan checkin, estimasi dilayani masih lebih dari 30 menit.....!!!",
                    "Info", JOptionPane.ERROR_MESSAGE);
            return false;
        }

        return true;
    }
    
    private void getData() {
        int row = tbJnsPerawatan.getSelectedRow();
        noRawat.setText("");
        noRM.setText("");
        namaPasien.setText("");
        noKartu.setText("");
        tanggal.setText("");
        noReferensi.setText("");
        status.setText("");
        if (row != -1) {
            // Jika tabel bisa di-sort / filter
            int modelRow = tbJnsPerawatan.convertRowIndexToModel(row);

            noRawat.setText(tbJnsPerawatan.getModel().getValueAt(modelRow,0).toString());
            noRM.setText(tbJnsPerawatan.getModel().getValueAt(modelRow,1).toString());
            namaPasien.setText(tbJnsPerawatan.getModel().getValueAt(modelRow,2).toString());
            noKartu.setText(tbJnsPerawatan.getModel().getValueAt(modelRow,4).toString());
            tanggal.setText(tbJnsPerawatan.getModel().getValueAt(modelRow,6).toString());
            noReferensi.setText(tbJnsPerawatan.getModel().getValueAt(modelRow,12).toString());
            status.setText(tbJnsPerawatan.getModel().getValueAt(modelRow,13).toString());   
        }   
    }
    
    private void checkin(){
        if(tbJnsPerawatan.getSelectedRow()!= -1){
            if(Sequel.mengedittf("referensi_mobilejkn_bpjs","nobooking=?","status='Checkin',validasi=now()",1,new String[]{
                tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),15).toString()
            })==true){
                Sequel.mengedittf("reg_periksa","no_rawat=?","tgl_registrasi = CURDATE(), jam_reg = CURTIME()",1,new String[]{
                    tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),0).toString()
                });
                Sequel.meghapus("referensi_mobilejkn_bpjs_batal","nobooking",tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),15).toString());
                tampil();
            }
        }else{
            JOptionPane.showMessageDialog(null,"Silahkan pilih dulu data..!!");
        }
        
    }
    
    private void belum(){
        if(tbJnsPerawatan.getSelectedRow()!= -1){
            if(Sequel.mengedittf("referensi_mobilejkn_bpjs","nobooking=?","status='Belum',validasi='0000-00-00 00:00:00'",1,new String[]{
                tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),15).toString()
            })==true){
                Sequel.meghapus("referensi_mobilejkn_bpjs_batal","nobooking",tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),15).toString());
                tampil();
            }
        }else{
            JOptionPane.showMessageDialog(null,"Silahkan pilih dulu data..!!");
        }
    }
    
    private void batal(){
        if(tbJnsPerawatan.getSelectedRow()!= -1){
            if(Sequel.mengedittf("referensi_mobilejkn_bpjs","nobooking=?","status='Batal',validasi=now()",1,new String[]{
                tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),15).toString()
            })==true){
                Sequel.menyimpan2("referensi_mobilejkn_bpjs_batal","?,?,?,now(),?,?,?",6,new String[]{
                    tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),1).toString(),tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),0).toString(), 
                    tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),12).toString(),"Dibatalkan Oleh Admin","Belum",tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),15).toString()
                });
                tampil();
            }
        }else{
            JOptionPane.showMessageDialog(null,"Silahkan pilih dulu data yang mau dibatalkan..!!");
        }
    }
