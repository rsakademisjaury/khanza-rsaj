    private void BtnCheckinPrioritasActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_BtnCheckinPrioritasActionPerformed
        // TODO add your handling code here:
        String tanggalPeriksa = tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),6).toString();
        String tanggalSekarang= Sequel.cariIsi("SELECT CURDATE()");
        
        if(tbJnsPerawatan.getValueAt(tbJnsPerawatan.getSelectedRow(),13).toString().equals("Batal")){
            int pilihan = JOptionPane.showConfirmDialog(
                    this,
                    "Pasien berstatus batal. Yakin untuk melakukan checkin untuk pasien ini??",
                    "Konfirmasi Checkin",
                    JOptionPane.YES_NO_OPTION
            );

            if (pilihan == JOptionPane.YES_OPTION) {
                if(!tanggalPeriksa.equals(tanggalSekarang)){
                    JOptionPane.showMessageDialog(null,
                         "Tidak dapat melakukan checkin, tanggal periksa tidak sesuai dengan tanggal hari ini....!!!",
                         "Info", JOptionPane.ERROR_MESSAGE); 
                } else {
                    checkin();
                }
            }
        } else {
            if(!tanggalPeriksa.equals(tanggalSekarang)){
                JOptionPane.showMessageDialog(null,
                     "Tidak dapat melakukan checkin, tanggal periksa tidak sesuai dengan tanggal hari ini....!!!",
                     "Info", JOptionPane.ERROR_MESSAGE); 
            } else {
                checkin();
            }
        }
    }//GEN-LAST:event_BtnCheckinPrioritasActionPerformed

