                                        "\"metadata\": {\n" +
                                            "\"method\":\"inacbg_grouper_final\"\n" +
                                        "},\n" +
                                        "\"data\": {\n" +
                                            "\"nomor_sep\":\""+Tsep.getText().trim()+"\"\n" +
