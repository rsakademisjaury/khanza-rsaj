            finalINA.setVisible(false);
            kirimonline.setVisible(false);
            cetakEklaim.setVisible(false);
            
            for (int i = 0; i < h_diag.length; i++) {
                h_diag[i].setEnabled(true);
            }
            
            for (int i = 0; i < h_diag2.length; i++) {
