        if (dKeluar != null) {
            psUpsertForm.setDate(idx++, new java.sql.Date(dKeluar.getTime()));
        } else {
            psUpsertForm.setNull(idx++, java.sql.Types.DATE);
        }

        // 13. jam_keluar
        psUpsertForm.setString(idx++, jam_keluar.getSelectedItem() + "");

        // 14. menit_keluar
